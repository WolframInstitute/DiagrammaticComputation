Notebook[{

Cell[CellGroupData[{
Cell["DiagramConversion", "GuideTitle",
 CellID->942062912,ExpressionUUID->"a3a3c038-ca24-47b7-9945-83f1c1312fe3"],

Cell[TextData[{
 "A diagram is a useful intermediate representation between many graphical \
data structures: graphs, trees, hypergraphs, tensor expressions, neural \
networks, lambda terms and system models all have diagrammatic readings. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ToDiagram"]], 
    "paclet:WolframDiagrammaticComputation/ref/ToDiagram", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "17149559-3fbe-4a9d-97ae-8ae6299d87a6"],
 " is the universal entry point for getting ",
 StyleBox["into", "TI"],
 " the diagram representation; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramFunction"]], 
    "paclet:WolframDiagrammaticComputation/ref/DiagramFunction", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "62ee0ea1-e0a8-4ede-abbf-435537cec351"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramTensor"]], 
    "paclet:WolframDiagrammaticComputation/ref/DiagramTensor", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3c3f5668-9eca-414e-8ff8-3ff2d1ca44c7"],
 " are the dual exits back to ordinary Wolfram Language expressions; and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TensorDiagram"]], 
    "paclet:WolframDiagrammaticComputation/ref/TensorDiagram", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "caa5c334-cc21-4904-8230-89307a256dcd"],
 " imports the tensor side directly."
}], "GuideAbstract",
 CellID->2001916300,ExpressionUUID->"ef0ab37b-2e0d-4399-8f7e-82603ccbe925"]
}, Open  ]],

Cell[CellGroupData[{

Cell["", "GuideFunctionsSection",
 CellID->1866139230,ExpressionUUID->"a0ea3657-4c83-4862-93c8-ecf80cebc774"],

Cell["Importing to a diagram", "GuideFunctionsSubsection",ExpressionUUID->"547b9d2a-aad6-41a5-8e11-1446bf7394cd"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ToDiagram"]], 
    "paclet:WolframDiagrammaticComputation/ref/ToDiagram", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "40753126-f154-47e7-9015-8aea440da4d0"],
 " \[LongDash] ",
 "\[LongDash] convert graphs, trees, hypergraphs, NetGraphs, lambda terms and \
system models to a diagram"
}], "GuideText",ExpressionUUID->"e6e8d859-2cde-4a52-98e8-3e8dc5b443cf"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TensorDiagram"]], 
    "paclet:WolframDiagrammaticComputation/ref/TensorDiagram", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "61978a8c-4924-4f15-a263-948f14e8e557"],
 " \[LongDash] ",
 "\[LongDash] convert a tensor expression to a diagram"
}], "GuideText",ExpressionUUID->"f8461356-3bd9-451f-aa52-3ea7d3ad518b"],

Cell["Exporting from a diagram", "GuideFunctionsSubsection",ExpressionUUID->"1da14b83-aa49-4056-b5c3-590bb584bbce"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramFunction"]], 
    "paclet:WolframDiagrammaticComputation/ref/DiagramFunction", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "d40df06c-abb6-4b53-83ec-29959563cdd7"],
 " \[LongDash] ",
 "\[LongDash] extract a pure function from a diagram"
}], "GuideText",ExpressionUUID->"69db2a3f-f458-4156-a5b8-a2dfc5e1f10a"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramTensor"]], 
    "paclet:WolframDiagrammaticComputation/ref/DiagramTensor", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "df292928-cece-405a-ae2b-ba1ce48c2eb3"],
 " \[LongDash] ",
 "\[LongDash] extract a symbolic tensor expression from a diagram"
}], "GuideText",ExpressionUUID->"af0c1d37-4bd8-49df-ba3b-3bbda52c0abe"]
}, Open  ]],

