Notebook[{

Cell[CellGroupData[{
Cell["DiagramConversion", "GuideTitle",
 CellID->942062912,ExpressionUUID->"a3a3c038-ca24-47b7-9945-83f1c1312fe3"],

Cell[TextData[{
 "A diagram is a useful intermediate representation between many graphical \
data structures: graphs, trees, hypergraphs, tensor expressions, neural \
networks, lambda terms and system models all have diagrammatic readings. ",
 Cell[BoxData[
  ButtonBox["ToDiagram",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/ToDiagram"]], 
  "InlineFormula",ExpressionUUID->"169e7c25-0488-4a43-b388-74646e6d1064"],
 " is the universal entry point for getting ",
 StyleBox["into", "TI"],
 " the diagram representation; ",
 Cell[BoxData[
  ButtonBox["DiagramFunction",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/DiagramFunction"]],
   "InlineFormula",ExpressionUUID->"d8471e40-c553-44f0-9d2c-04fba848fd6d"],
 " and ",
 Cell[BoxData[
  ButtonBox["DiagramTensor",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/DiagramTensor"]], 
  "InlineFormula",ExpressionUUID->"2c48e7f2-eef8-4110-97c9-b9abd4936e38"],
 " are the dual exits back to ordinary Wolfram Language expressions; and ",
 Cell[BoxData[
  ButtonBox["TensorDiagram",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/TensorDiagram"]], 
  "InlineFormula",ExpressionUUID->"a6a8a3ad-b6f0-401e-b035-4c9f7c05c3da"],
 " imports the tensor side directly."
}], "GuideAbstract",
 CellID->2001916300,ExpressionUUID->"ef0ab37b-2e0d-4399-8f7e-82603ccbe925"]
}, Open  ]],

Cell[CellGroupData[{

Cell["", "GuideFunctionsSection",
 CellID->1866139230,ExpressionUUID->"a0ea3657-4c83-4862-93c8-ecf80cebc774"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["ToDiagram",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/ToDiagram"]], 
  "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "bc20779d-8f88-4ab3-826e-81feb43c3fd5"],
 " \[LongDash] ",
 "\[LongDash] convert graphs, trees, hypergraphs, NetGraphs, lambda terms and \
system models to a diagram"
}], "GuideText",ExpressionUUID->"3748ae62-4222-4430-ba99-121210cf69b5"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["TensorDiagram",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/TensorDiagram"]], 
  "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "04c59673-b8e1-4e54-870b-45cdf60701c7"],
 " \[LongDash] ",
 "\[LongDash] convert a tensor expression to a diagram"
}], "GuideText",ExpressionUUID->"edabb19b-2d5f-4a28-b4ce-4cc85fe061f5"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["DiagramFunction",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/DiagramFunction"]],
   "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "fe3daea3-c4dc-4f5a-89c9-a2abbbf3d3fa"],
 " \[LongDash] ",
 "\[LongDash] extract a pure function from a diagram"
}], "GuideText",ExpressionUUID->"8aafe62a-87f2-405a-8f67-0cf4eb499b38"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["DiagramTensor",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/DiagramTensor"]], 
  "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "0d2ea809-c921-47a0-ba51-b0d70eac587d"],
 " \[LongDash] ",
 "\[LongDash] extract a symbolic tensor expression from a diagram"
}], "GuideText",ExpressionUUID->"23f5a4ad-7053-4611-a29d-5f8bbfa52e01"]
}, Open  ]],

