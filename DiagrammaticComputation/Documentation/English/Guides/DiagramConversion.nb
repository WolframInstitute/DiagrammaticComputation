Notebook[{

Cell[CellGroupData[{
Cell["DiagramConversion", "GuideTitle",
 CellID->942062912,ExpressionUUID->"a3a3c038-ca24-47b7-9945-83f1c1312fe3"],

Cell[TextData[{
 "A diagram is a useful intermediate representation between many graphical \
data structures: graphs, trees, hypergraphs, tensor expressions, neural \
networks, lambda terms and system models all have diagrammatic readings. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ToDiagram"]], 
    "paclet:Wolfram/DiagrammaticComputation/ref/ToDiagram", 
    "Wolfram/DiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b861555e-e36e-4e39-9e97-947b3d49f3ec"],
 " is the universal entry point for getting ",
 StyleBox["into", "TI"],
 " the diagram representation; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramFunction"]], 
    "paclet:Wolfram/DiagrammaticComputation/ref/DiagramFunction", 
    "Wolfram/DiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "67d2f5ef-841c-4652-a88a-8845b7a9405f"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramTensor"]], 
    "paclet:Wolfram/DiagrammaticComputation/ref/DiagramTensor", 
    "Wolfram/DiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "26ecda64-2db6-4723-9178-233e88a7f726"],
 " are the dual exits back to ordinary Wolfram Language expressions; and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TensorDiagram"]], 
    "paclet:Wolfram/DiagrammaticComputation/ref/TensorDiagram", 
    "Wolfram/DiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3fc25335-ce82-4610-b910-492605e4878f"],
 " imports the tensor side directly."
}], "GuideAbstract",
 CellID->2001916300,ExpressionUUID->"ef0ab37b-2e0d-4399-8f7e-82603ccbe925"]
}, Open  ]],

Cell[CellGroupData[{

Cell["", "GuideFunctionsSection",
 CellID->1866139230,ExpressionUUID->"a0ea3657-4c83-4862-93c8-ecf80cebc774"],

Cell["Importing to a diagram", "GuideFunctionsSubsection",ExpressionUUID->"bbf0443c-140c-4432-83f5-297a3afac471"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ToDiagram"]], 
    "paclet:Wolfram/DiagrammaticComputation/ref/ToDiagram", 
    "Wolfram/DiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "82ebc776-b067-4bd2-8ac8-977302f73b9c"],
 " \[LongDash] ",
 "\[LongDash] convert graphs, trees, hypergraphs, NetGraphs, lambda terms and \
system models to a diagram"
}], "GuideText",ExpressionUUID->"604a5b05-9f6f-40e1-8f62-0977c7014048"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TensorDiagram"]], 
    "paclet:Wolfram/DiagrammaticComputation/ref/TensorDiagram", 
    "Wolfram/DiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "91847864-9a61-4790-b85c-09733033387e"],
 " \[LongDash] ",
 "\[LongDash] convert a tensor expression to a diagram"
}], "GuideText",ExpressionUUID->"a93c35f1-25ff-4069-be29-b832bbb1e70e"],

Cell["Exporting from a diagram", "GuideFunctionsSubsection",ExpressionUUID->"d956eca7-7765-4a5f-a835-dcf7f4afd3ed"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramFunction"]], 
    "paclet:Wolfram/DiagrammaticComputation/ref/DiagramFunction", 
    "Wolfram/DiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "5c6c5e5d-428e-4891-9499-4a76f7b0c3e0"],
 " \[LongDash] ",
 "\[LongDash] extract a pure function from a diagram"
}], "GuideText",ExpressionUUID->"7cecb00a-daad-4c44-aadf-ca4514eca2a8"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramTensor"]], 
    "paclet:Wolfram/DiagrammaticComputation/ref/DiagramTensor", 
    "Wolfram/DiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "adeb0326-ab17-41c9-87d6-21fc8f5993bf"],
 " \[LongDash] ",
 "\[LongDash] extract a symbolic tensor expression from a diagram"
}], "GuideText",ExpressionUUID->"7f526807-f04f-4e84-b510-df6b0573013c"]
}, Open  ]],

