Notebook[{

Cell[CellGroupData[{
Cell["DiagramRewriting", "GuideTitle",
 CellID->942062912,ExpressionUUID->"a3a3c038-ca24-47b7-9945-83f1c1312fe3"],

Cell[TextData[{
 "A ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramRule"]], 
    "paclet:Wolfram/DiagrammaticComputation/ref/DiagramRule", 
    "Wolfram/DiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "883147ab-ef9d-48be-8499-2836f36ea870"],
 " describes how a piece of a diagram is replaced by another piece. Matching \
is done against the diagram's ",
 StyleBox["hypergraph", "TI"],
 " view \[LongDash] ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramHypergraph"]], 
    "paclet:Wolfram/DiagrammaticComputation/ref/DiagramHypergraph", 
    "Wolfram/DiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d82d4a43-e49c-49ec-9b27-629df3a60265"],
 " \[LongDash] so the rules are insensitive to embedding and naming. The \
rewriting front-end (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramReplace"]], 
    "paclet:Wolfram/DiagrammaticComputation/ref/DiagramReplace", 
    "Wolfram/DiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9ef2a83b-68b5-4235-b4e1-d643ee9a5142"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramReplaceList"]], 
    "paclet:Wolfram/DiagrammaticComputation/ref/DiagramReplaceList", 
    "Wolfram/DiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2e05de31-41fd-44ed-be1b-cae232df5a05"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramNestReplace"]], 
    "paclet:Wolfram/DiagrammaticComputation/ref/DiagramNestReplace", 
    "Wolfram/DiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8d1015b8-e396-4eb4-bcbc-54049bd5506d"],
 ") mirrors the ordinary ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Replace"]], "paclet:ref/Replace"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3352616d-afb2-4eb6-8c97-f2e23d676bd4"],
 "/",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ReplaceList"]], "paclet:ref/ReplaceList"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c9108d50-d723-4b64-be4c-f71f5c934ca2"],
 "/ ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ReplaceRepeated"]], "paclet:ref/ReplaceRepeated"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c4dde7b0-486c-4cef-8f0f-577f2dbeb469"],
 " family; a small library of named schemas (commutation, eraser, \
annihilation, propagation) provides the standard structural laws that come up \
in ZX-style and process-theoretic calculi."
}], "GuideAbstract",
 CellID->2001916300,ExpressionUUID->"ef0ab37b-2e0d-4399-8f7e-82603ccbe925"]
}, Open  ]],

