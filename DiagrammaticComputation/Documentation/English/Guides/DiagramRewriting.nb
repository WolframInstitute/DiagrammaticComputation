Notebook[{

Cell[CellGroupData[{
Cell["DiagramRewriting", "GuideTitle",
 CellID->942062912,ExpressionUUID->"a3a3c038-ca24-47b7-9945-83f1c1312fe3"],

Cell[TextData[{
 "A ",
 Cell[BoxData[
  ButtonBox["DiagramRule",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/DiagramRule"]], 
  "InlineFormula",ExpressionUUID->"a7a5e54c-5b14-4e9a-b4f8-7a98a7e1f6b3"],
 " describes how a piece of a diagram is replaced by another piece. Matching \
is done against the diagram's ",
 StyleBox["hypergraph", "TI"],
 " view \[LongDash] ",
 Cell[BoxData[
  ButtonBox["DiagramHypergraph",
   BaseStyle->"Link",
   ButtonData->
    "paclet:Wolfram/DiagrammaticComputation/ref/DiagramHypergraph"]], 
  "InlineFormula",ExpressionUUID->"b165756d-c04c-461d-be2b-4efdc353efc4"],
 " \[LongDash] so the rules are insensitive to embedding and naming. The \
rewriting front-end (",
 Cell[BoxData[
  ButtonBox["DiagramReplace",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/DiagramReplace"]], 
  "InlineFormula",ExpressionUUID->"d9a9eecd-907f-4257-b09e-2ba17d50715b"],
 ", ",
 Cell[BoxData[
  ButtonBox["DiagramReplaceList",
   BaseStyle->"Link",
   ButtonData->
    "paclet:Wolfram/DiagrammaticComputation/ref/DiagramReplaceList"]], 
  "InlineFormula",ExpressionUUID->"064d8ee1-422f-4b9f-aae6-979017236fd0"],
 ", ",
 Cell[BoxData[
  ButtonBox["DiagramNestReplace",
   BaseStyle->"Link",
   ButtonData->
    "paclet:Wolfram/DiagrammaticComputation/ref/DiagramNestReplace"]], 
  "InlineFormula",ExpressionUUID->"cdcadf07-8afc-40f6-a86a-80aef12c297d"],
 ") mirrors the ordinary ",
 Cell[BoxData[
  ButtonBox["Replace",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Replace"]], "InlineFormula",ExpressionUUID->
  "bb45d6bb-fc9d-45f9-8ab7-de73647cb9fb"],
 "/",
 Cell[BoxData[
  ButtonBox["ReplaceList",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/ReplaceList"]], "InlineFormula",ExpressionUUID->
  "53946ed6-c87d-4331-9457-13c35f00f821"],
 "/ ",
 Cell[BoxData[
  ButtonBox["ReplaceRepeated",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/ReplaceRepeated"]], "InlineFormula",ExpressionUUID->
  "e63ef1c4-d7e4-4e1f-b09b-bca32697786b"],
 " family; a small library of named schemas (commutation, eraser, \
annihilation, propagation) provides the standard structural laws that come up \
in ZX-style and process-theoretic calculi."
}], "GuideAbstract",
 CellID->2001916300,ExpressionUUID->"ef0ab37b-2e0d-4399-8f7e-82603ccbe925"]
}, Open  ]],

