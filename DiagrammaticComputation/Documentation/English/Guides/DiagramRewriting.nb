Notebook[{

Cell[CellGroupData[{
Cell["DiagramRewriting", "GuideTitle",
 CellID->942062912,ExpressionUUID->"a3a3c038-ca24-47b7-9945-83f1c1312fe3"],

Cell[TextData[{
 "A ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramRule"]], 
    "paclet:WolframDiagrammaticComputation/ref/DiagramRule", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "02b9e311-ba9b-4258-9737-202c61bb6a8a"],
 " describes how a piece of a diagram is replaced by another piece. Matching \
is done against the diagram's ",
 StyleBox["hypergraph", "TI"],
 " view \[LongDash] ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramHypergraph"]], 
    "paclet:WolframDiagrammaticComputation/ref/DiagramHypergraph", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "fe595761-296b-4742-ae8f-000cfb8ffd0b"],
 " \[LongDash] so the rules are insensitive to embedding and naming. The \
rewriting front-end (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramReplace"]], 
    "paclet:WolframDiagrammaticComputation/ref/DiagramReplace", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "317055e5-98b9-43f6-824d-4b78453c7186"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramReplaceList"]], 
    "paclet:WolframDiagrammaticComputation/ref/DiagramReplaceList", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ea80d72e-fbf2-49e2-87ee-44ed5f15a5ac"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramNestReplace"]], 
    "paclet:WolframDiagrammaticComputation/ref/DiagramNestReplace", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8b23467c-efbd-4433-89d5-83c7d52959ff"],
 ") mirrors the ordinary ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Replace"]], "paclet:ref/Replace"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3c008c5d-2705-488b-a927-3a8746aa9090"],
 "/",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ReplaceList"]], "paclet:ref/ReplaceList"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9e0a3cc6-d482-426d-bc8b-ba4077fc14ff"],
 "/ ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ReplaceRepeated"]], "paclet:ref/ReplaceRepeated"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9835ab55-8980-400c-b077-1cde30ffeab2"],
 " family; a small library of named schemas (commutation, eraser, \
annihilation, propagation) provides the standard structural laws that come up \
in ZX-style and process-theoretic calculi."
}], "GuideAbstract",
 CellID->2001916300,ExpressionUUID->"ef0ab37b-2e0d-4399-8f7e-82603ccbe925"]
}, Open  ]],

