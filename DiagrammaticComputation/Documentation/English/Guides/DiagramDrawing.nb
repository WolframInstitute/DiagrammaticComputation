Cell[CellGroupData[{
Cell["DiagramDrawing", "GuideTitle",
 CellID->942062912,ExpressionUUID->"a3a3c038-ca24-47b7-9945-83f1c1312fe3"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["DiagramDraw",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/DiagramDraw"]], 
  "InlineFormula",ExpressionUUID->"a4a94ce4-45e0-4100-aa15-dea4054573bb"],
 " opens an interactive canvas where boxes, ports and wires can be placed by \
hand and the resulting ",
 Cell[BoxData[
  ButtonBox["Diagram",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/Diagram"]], 
  "InlineFormula",ExpressionUUID->"30753e61-700b-474b-b777-9580d3468b9d"],
 " expression copy-pasted back into a notebook. It is the diagram analogue of \
built-ins like ",
 Cell[BoxData[
  ButtonBox["MoleculeDraw",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/MoleculeDraw"]], "InlineFormula",ExpressionUUID->
  "c2b3848a-6152-4986-9d90-db695308ac2a"],
 " \[LongDash] useful for sketching small examples and exporting them as \
symbolic diagrams."
}], "GuideAbstract",
 CellID->2001916300,ExpressionUUID->"ef0ab37b-2e0d-4399-8f7e-82603ccbe925"]
}, Open  ]],

