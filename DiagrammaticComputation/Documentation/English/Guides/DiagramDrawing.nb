Cell[CellGroupData[{
Cell["DiagramDrawing", "GuideTitle",
 CellID->942062912,ExpressionUUID->"a3a3c038-ca24-47b7-9945-83f1c1312fe3"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramDraw"]], 
    "paclet:WolframDiagrammaticComputation/ref/DiagramDraw", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "605906d7-adbc-4131-8185-40f5a66cf26b"],
 " opens an interactive canvas where boxes, ports and wires can be placed by \
hand and the resulting ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Diagram"]], 
    "paclet:WolframDiagrammaticComputation/ref/Diagram", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "84735c65-f9a9-4642-9ba7-0a0abd288721"],
 " expression copy-pasted back into a notebook. It is the diagram analogue of \
built-ins like ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["MoleculeDraw"]], "paclet:ref/MoleculeDraw"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "283a1c3a-3f05-4912-a88e-21aef76e562a"],
 " \[LongDash] useful for sketching small examples and exporting them as \
symbolic diagrams."
}], "GuideAbstract",
 CellID->2001916300,ExpressionUUID->"ef0ab37b-2e0d-4399-8f7e-82603ccbe925"]
}, Open  ]],

