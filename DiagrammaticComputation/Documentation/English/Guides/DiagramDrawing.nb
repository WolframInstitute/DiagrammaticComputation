Cell[CellGroupData[{
Cell["DiagramDrawing", "GuideTitle",
 CellID->942062912,ExpressionUUID->"a3a3c038-ca24-47b7-9945-83f1c1312fe3"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramDraw"]], 
    "paclet:Wolfram/DiagrammaticComputation/ref/DiagramDraw", 
    "Wolfram/DiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "74d57592-c2fe-4142-9672-5b9a272592f0"],
 " opens an interactive canvas where boxes, ports and wires can be placed by \
hand and the resulting ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Diagram"]], 
    "paclet:Wolfram/DiagrammaticComputation/ref/Diagram", 
    "Wolfram/DiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5861e6ea-2125-4352-ab7b-1aec79b9f705"],
 " expression copy-pasted back into a notebook. It is the diagram analogue of \
built-ins like ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["MoleculeDraw"]], "paclet:ref/MoleculeDraw"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8a7a6516-addb-4d15-9ea3-338693e19aee"],
 " \[LongDash] useful for sketching small examples and exporting them as \
symbolic diagrams."
}], "GuideAbstract",
 CellID->2001916300,ExpressionUUID->"ef0ab37b-2e0d-4399-8f7e-82603ccbe925"]
}, Open  ]],

