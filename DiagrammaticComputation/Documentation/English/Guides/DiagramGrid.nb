Notebook[{

Cell[CellGroupData[{
Cell["DiagramGrid", "GuideTitle",
 CellID->942062912,ExpressionUUID->"a3a3c038-ca24-47b7-9945-83f1c1312fe3"],

Cell[TextData[{
 "A diagram is ",
 StyleBox["grid-arrangeable", "TI"],
 " when it can be drawn as a rectangular grid of cells in which composition \
runs vertically and product runs horizontally. This guide covers the tools \
that turn an arbitrary composite diagram into a grid: row and column \
constructors that build grids directly, ",
 Cell[BoxData[
  ButtonBox["DiagramGrid",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/DiagramGrid"]], 
  "InlineFormula",ExpressionUUID->"d96d2891-dbe7-4bda-8101-45bcb7475d91"],
 " which renders the grid, ",
 Cell[BoxData[
  ButtonBox["DiagramArrange",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/DiagramArrange"]], 
  "InlineFormula",ExpressionUUID->"3944adc5-882e-4d93-a409-bd062e4a5bfb"],
 " which inserts identities, permutations and spiders so the diagram ",
 StyleBox["can", "TI"],
 " be gridded, and ",
 Cell[BoxData[
  ButtonBox["DiagramDecompose",
   BaseStyle->"Link",
   ButtonData->
    "paclet:Wolfram/DiagrammaticComputation/ref/DiagramDecompose"]], 
  "InlineFormula",ExpressionUUID->"0814d125-4451-41b2-b41a-bc4ef24c4484"],
 " which recovers the expression tree of subdiagrams from a built diagram."
}], "GuideAbstract",
 CellID->2001916300,ExpressionUUID->"ef0ab37b-2e0d-4399-8f7e-82603ccbe925"]
}, Open  ]],

