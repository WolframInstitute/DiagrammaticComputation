Notebook[{

Cell[CellGroupData[{
Cell["DiagramGrid", "GuideTitle",
 CellID->942062912,ExpressionUUID->"a3a3c038-ca24-47b7-9945-83f1c1312fe3"],

Cell[TextData[{
 "A diagram is ",
 StyleBox["grid-arrangeable", "TI"],
 " when it can be drawn as a rectangular grid of cells in which composition \
runs vertically and product runs horizontally. This guide covers the tools \
that turn an arbitrary composite diagram into a grid: row and column \
constructors that build grids directly, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramGrid"]], 
    "paclet:WolframDiagrammaticComputation/ref/DiagramGrid", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ec838111-6b83-4581-a729-5c0588f43bc5"],
 " which renders the grid, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramArrange"]], 
    "paclet:WolframDiagrammaticComputation/ref/DiagramArrange", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b8acec73-6b0d-412d-b99c-461ff0e22528"],
 " which inserts identities, permutations and spiders so the diagram ",
 StyleBox["can", "TI"],
 " be gridded, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramDecompose"]], 
    "paclet:WolframDiagrammaticComputation/ref/DiagramDecompose", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "461ba989-70ff-4cfa-95ca-21c4474e3738"],
 " which recovers the expression tree of subdiagrams from a built diagram."
}], "GuideAbstract",
 CellID->2001916300,ExpressionUUID->"ef0ab37b-2e0d-4399-8f7e-82603ccbe925"]
}, Open  ]],

