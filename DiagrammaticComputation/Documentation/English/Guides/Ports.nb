Notebook[{

Cell[CellGroupData[{
Cell["Ports", "GuideTitle",
 CellID->942062912,ExpressionUUID->"a3a3c038-ca24-47b7-9945-83f1c1312fe3"],

Cell[TextData[{
 "A ",
 Cell[BoxData[
  ButtonBox["Port",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/Port"]], 
  "InlineFormula",ExpressionUUID->"2f3b53a0-e4bd-4a5e-b24a-4b76710ee729"],
 " is the typed endpoint of a diagram. Every ",
 Cell[BoxData[
  ButtonBox["Diagram",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/Diagram"]], 
  "InlineFormula",ExpressionUUID->"d02f6a60-581a-40c2-8b7f-6f907325d7b9"],
 " carries a list of input ports and a list of output ports; composing \
diagrams works by matching ports of compatible ",
 StyleBox["types", "TI"],
 ". Ports have a small algebra of their own \[LongDash] they can be made dual \
(reversed in direction), tensored together with ",
 Cell[BoxData[
  ButtonBox["PortProduct",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/PortProduct"]], 
  "InlineFormula",ExpressionUUID->"986773ab-609a-4a65-ae1e-54872f650741"],
 ", summed with ",
 Cell[BoxData[
  ButtonBox["PortSum",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/PortSum"]], 
  "InlineFormula",ExpressionUUID->"d6fc6b13-7ca1-494e-95a4-9fb57a52266e"],
 ", raised to a power, tagged with context-specific annotations, and tested \
with predicates. This guide collects the operations that build and transform \
ports independently of the diagrams they appear in."
}], "GuideAbstract",
 CellID->2001916300,ExpressionUUID->"ef0ab37b-2e0d-4399-8f7e-82603ccbe925"]
}, Open  ]],

Cell[CellGroupData[{

