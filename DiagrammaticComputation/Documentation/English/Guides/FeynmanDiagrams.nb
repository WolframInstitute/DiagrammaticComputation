  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "48dad887-3615-4706-ba9b-39ee74e66f48"],
 " \[LongDash] ",
 "\[LongDash] convert a FeynArts topology to a graph"
}], "GuideText",ExpressionUUID->"c0613076-cb61-40a5-a53d-fff0999f057d"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TopologyGraphs"]], 
    "paclet:Wolfram/DiagrammaticComputation/ref/TopologyGraphs", 
    "Wolfram/DiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "c67095bb-2363-4e5b-b9b0-7f9be21b79ac"],
 " \[LongDash] ",
 "\[LongDash] convert a FeynArts topology list, one graph per field \
insertion"
}], "GuideText",ExpressionUUID->"64e7e7db-50c6-488e-8cfb-a5fb843f0749"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TopologyGraphics"]], 
    "paclet:Wolfram/DiagrammaticComputation/ref/TopologyGraphics", 
    "Wolfram/DiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "ba641441-45fd-4b1f-adf8-e8fe96ec0d54"],
 " \[LongDash] ",
 "\[LongDash] FeynArts graphics data for a topology with insertions"
}], "GuideText",ExpressionUUID->"02d07b4e-7f81-40d9-ac3f-f975376652e6"],

Cell[TextData[{
 Cell[BoxData[
