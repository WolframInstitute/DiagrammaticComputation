  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "63a41c83-3d90-4456-a1be-26f2ac163457"],
 " \[LongDash] ",
 "\[LongDash] propagator line-style function (straight, dashed, wiggly, helix)"
}], "GuideText",ExpressionUUID->"35dd354e-9376-4948-a5ae-e458ebcc5342"]
}, Open  ]],

