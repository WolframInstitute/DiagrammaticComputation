  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "5ba80efd-6cab-4791-80c2-e3c126b92a2e"],
 " \[LongDash] ",
 "\[LongDash] convert a FeynArts topology to a graph"
}], "GuideText",ExpressionUUID->"3e329f5d-a413-405b-8e76-15f6b5166cf4"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TopologyGraphs"]], 
    "paclet:WolframDiagrammaticComputation/ref/TopologyGraphs", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "64369d9d-69e5-4ae2-a53f-ddc51b4d0dde"],
 " \[LongDash] ",
 "\[LongDash] convert a FeynArts topology list, one graph per field \
insertion"
}], "GuideText",ExpressionUUID->"ea4e74dc-fc05-4740-b14d-1439a83eb2e0"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TopologyGraphics"]], 
