Notebook[{

Cell[CellGroupData[{
Cell["FeynmanDiagrams", "GuideTitle",
 CellID->942062912,ExpressionUUID->"a3a3c038-ca24-47b7-9945-83f1c1312fe3"],

Cell[TextData[{
 "Feynman diagrams are a particular use of the diagrammatic calculus where \
vertices are field interactions and edges (wires) are propagators. These \
functions bridge ",
 ButtonBox["FeynArts",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://www.feynarts.de"], None}],
 " and the diagram representation: topologies created with ",
 Cell[BoxData[
 "FeynArts`CreateTopologies"], "InlineFormula",ExpressionUUID->
  "91737d50-45f5-48dc-bd74-0e1b714e7aea"],
 " (optionally with field insertions from ",
 Cell[BoxData[
 "FeynArts`InsertFields"], "InlineFormula",ExpressionUUID->
  "d55c9dd3-b385-48b1-9ff9-d99f87a1274d"],
 ") convert to graphs and on to ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Diagram"]], 
    "paclet:Wolfram/DiagrammaticComputation/ref/Diagram", 
    "Wolfram/DiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1aea1e4a-bbdc-41f6-abb9-0c13fb4d0fb7"],
 " networks, with propagators drawn in the conventional wiggly / dashed / \
solid-line styles. FeynArts must be installed and loaded for these functions \
to operate."
}], "GuideAbstract",
 CellID->2001916300,ExpressionUUID->"ef0ab37b-2e0d-4399-8f7e-82603ccbe925"]
}, Open  ]],

Cell[CellGroupData[{

Cell["", "GuideFunctionsSection",
 CellID->1866139230,ExpressionUUID->"a0ea3657-4c83-4862-93c8-ecf80cebc774"],

