   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "c27a69f7-22fc-4e09-8b36-b09c8d55ca02"],
 " \[LongDash] ",
 "\[LongDash] render a topology in the FeynArts house style"
}], "GuideText",ExpressionUUID->"e358644e-9f54-45ae-91bd-675dcbeeb2f3"],

