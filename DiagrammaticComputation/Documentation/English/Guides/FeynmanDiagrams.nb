    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "b5b147ee-3959-4c6c-86af-12b27983c4c7"],
 " \[LongDash] ",
 "\[LongDash] FeynArts graphics data for a topology with insertions"
}], "GuideText",ExpressionUUID->"6a4d45e1-a8d3-4ccb-a3c3-9a869b8f35e9"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
