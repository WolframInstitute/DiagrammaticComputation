  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "e8ccafda-475f-43fa-8e34-8de2ef22a25c"],
 " \[LongDash] ",
 "\[LongDash] convert a FeynArts topology to a graph"
}], "GuideText",ExpressionUUID->"eb99cf17-00a7-4a32-8891-dc85b71a392f"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TopologyGraphs"]], 
    "paclet:WolframDiagrammaticComputation/ref/TopologyGraphs", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "0aff3aa5-41d3-4847-96db-4791c63e1a25"],
 " \[LongDash] ",
 "\[LongDash] convert a FeynArts topology list, one graph per field \
insertion"
}], "GuideText",ExpressionUUID->"ba25c422-9c7a-4cfd-a94e-791447dc1b93"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
