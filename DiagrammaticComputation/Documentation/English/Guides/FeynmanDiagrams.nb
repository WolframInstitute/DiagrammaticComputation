  TaggingRules->{"PageType" -> "Function"},ExpressionUUID->
  "9af8eba1-62ca-4ce2-8b8d-6880e51d7f26"],
 " \[LongDash] ",
 "\[LongDash] construct a diagram network from a topology graph"
}], "GuideText",ExpressionUUID->"2196151a-ed4a-446b-a9b3-06b50462af25"],

Cell[TextData[{
