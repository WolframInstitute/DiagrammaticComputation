Notebook[{

Cell[CellGroupData[{
Cell["DiagramSurgery", "GuideTitle",
 CellID->942062912,ExpressionUUID->"a3a3c038-ca24-47b7-9945-83f1c1312fe3"],

Cell[TextData[{
 "A composite diagram has a tree of subdiagrams that mirrors its \
compositional structure, and these subdiagrams can be inspected, matched and \
edited the same way ordinary expressions can. The functions in this guide are \
the diagram analogues of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Position"]], "paclet:ref/Position"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "89da36cf-fe95-4116-b25a-d35f393912e7"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Cases"]], "paclet:ref/Cases"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a0dea11a-922f-4c2b-bfcf-c3510257b28f"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Map"]], "paclet:ref/Map"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "26f0c586-a0c8-4531-a948-950851f6fdbf"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["MapAt"]], "paclet:ref/MapAt"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7c554b75-ae58-4947-b913-10a6645c48ce"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Extract"]], "paclet:ref/Extract"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "93601774-11ba-49d2-a58b-f5906a6effab"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Insert"]], "paclet:ref/Insert"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "bcb8f473-4f3d-4159-8676-3a81ccbd2135"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Delete"]], "paclet:ref/Delete"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "79a73301-e414-4e14-9318-8f8bf2c79609"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ReplacePart"]], "paclet:ref/ReplacePart"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ea4b1136-3e48-4b79-b1f8-664f649d5d9b"],
 " \[LongDash] they work on the diagram's subdiagram tree, using ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramPattern"]], 
    "paclet:Wolfram/DiagrammaticComputation/ref/DiagramPattern", 
    "Wolfram/DiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c82833aa-84e9-4f44-9392-dab35595ddaa"],
 " for matching. This is the plumbing under ",
 Cell[BoxData[
 "DiagramRewriting"], "InlineFormula",ExpressionUUID->
  "eaf9adce-20a8-4d24-9263-5f48abccfe25"],
 "; reach for it when you want non-pattern edits or want to write a custom \
rewriter."
}], "GuideAbstract",
 CellID->2001916300,ExpressionUUID->"ef0ab37b-2e0d-4399-8f7e-82603ccbe925"]
}, Open  ]],

