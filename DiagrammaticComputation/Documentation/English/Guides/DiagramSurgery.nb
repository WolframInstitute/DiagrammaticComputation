Notebook[{

Cell[CellGroupData[{
Cell["DiagramSurgery", "GuideTitle",
 CellID->942062912,ExpressionUUID->"a3a3c038-ca24-47b7-9945-83f1c1312fe3"],

Cell[TextData[{
 "A composite diagram has a tree of subdiagrams that mirrors its \
compositional structure, and these subdiagrams can be inspected, matched and \
edited the same way ordinary expressions can. The functions in this guide are \
the diagram analogues of ",
 Cell[BoxData[
  ButtonBox["Position",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Position"]], "InlineFormula",ExpressionUUID->
  "8f647c0c-ec33-4c92-bff3-a1f5126580a5"],
 ", ",
 Cell[BoxData[
  ButtonBox["Cases",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Cases"]], "InlineFormula",ExpressionUUID->
  "b2df7c30-f7ff-4802-a3c2-dec89c21f37a"],
 ", ",
 Cell[BoxData[
  ButtonBox["Map",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Map"]], "InlineFormula",ExpressionUUID->
  "90972d0d-2436-4d05-89e1-4868461b3df5"],
 ", ",
 Cell[BoxData[
  ButtonBox["MapAt",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/MapAt"]], "InlineFormula",ExpressionUUID->
  "37ffee5e-d745-4a27-b417-6c46f9ae40d7"],
 ", ",
 Cell[BoxData[
  ButtonBox["Extract",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Extract"]], "InlineFormula",ExpressionUUID->
  "a724c04c-9c11-47a3-a91b-c3a1c5e00dc0"],
 ", ",
 Cell[BoxData[
  ButtonBox["Insert",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Insert"]], "InlineFormula",ExpressionUUID->
  "68655543-6c4c-42ee-9b3a-fb8808be7184"],
 ", ",
 Cell[BoxData[
  ButtonBox["Delete",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Delete"]], "InlineFormula",ExpressionUUID->
  "2c42c247-8178-4e04-9231-6ec0b9280f85"],
 " and ",
 Cell[BoxData[
  ButtonBox["ReplacePart",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/ReplacePart"]], "InlineFormula",ExpressionUUID->
  "7c5fecb7-ca21-4dac-b9ed-74dde069cf9a"],
 " \[LongDash] they work on the diagram's subdiagram tree, using ",
 Cell[BoxData[
  ButtonBox["DiagramPattern",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/DiagramPattern"]], 
  "InlineFormula",ExpressionUUID->"bad29fad-993b-4872-a53e-518be03fba09"],
 " for matching. This is the plumbing under ",
 Cell[BoxData[
 "DiagramRewriting"], "InlineFormula",ExpressionUUID->
  "9f48d5bd-fab0-4a13-a899-eef7a60620a2"],
 "; reach for it when you want non-pattern edits or want to write a custom \
rewriter."
}], "GuideAbstract",
 CellID->2001916300,ExpressionUUID->"ef0ab37b-2e0d-4399-8f7e-82603ccbe925"]
}, Open  ]],

