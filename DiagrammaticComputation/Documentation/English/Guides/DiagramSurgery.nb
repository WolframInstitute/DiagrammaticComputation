Notebook[{

Cell[CellGroupData[{
Cell["DiagramSurgery", "GuideTitle",
 CellID->942062912,ExpressionUUID->"a3a3c038-ca24-47b7-9945-83f1c1312fe3"],

Cell[TextData[{
 "A composite diagram has a tree of subdiagrams that mirrors its \
compositional structure, and these subdiagrams can be inspected, matched and \
edited the same way ordinary expressions can. The functions in this guide are \
the diagram analogues of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Position"]], "paclet:ref/Position"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4a4f8dec-67eb-4912-bc47-4ede4abb4ec1"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Cases"]], "paclet:ref/Cases"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "951328d3-7afe-4f10-9509-0ff2237ad7b7"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Map"]], "paclet:ref/Map"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "63a63641-833e-4bb1-b6f9-3dec70bb05de"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["MapAt"]], "paclet:ref/MapAt"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1b7e8233-3c5e-4bb0-bc74-69714925bd5b"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Extract"]], "paclet:ref/Extract"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "fd5ca6f4-ada8-4fde-ab4b-c441ebdbc507"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Insert"]], "paclet:ref/Insert"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9017f449-059d-4093-9b8d-476782bd52c2"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Delete"]], "paclet:ref/Delete"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "73c8441f-9c7f-49b2-ad22-3ca3ccaf8b1c"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ReplacePart"]], "paclet:ref/ReplacePart"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ccd6c215-a03f-4a2e-9b20-887d9b270eb6"],
 " \[LongDash] they work on the diagram's subdiagram tree, using ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramPattern"]], 
    "paclet:WolframDiagrammaticComputation/ref/DiagramPattern", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f77ea46e-68e2-4559-981c-e40fd0c85a8d"],
 " for matching. This is the plumbing under ",
 Cell[BoxData[
 "DiagramRewriting"], "InlineFormula",ExpressionUUID->
  "6cb49aa3-7b70-49f0-9616-63950db01e19"],
 "; reach for it when you want non-pattern edits or want to write a custom \
rewriter."
}], "GuideAbstract",
 CellID->2001916300,ExpressionUUID->"ef0ab37b-2e0d-4399-8f7e-82603ccbe925"]
}, Open  ]],

