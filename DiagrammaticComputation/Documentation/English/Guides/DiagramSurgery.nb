Notebook[{

Cell[CellGroupData[{
Cell["DiagramSurgery", "GuideTitle",
 CellID->942062912,ExpressionUUID->"a3a3c038-ca24-47b7-9945-83f1c1312fe3"],

Cell[TextData[{
 "A composite diagram has a tree of subdiagrams that mirrors its \
compositional structure, and these subdiagrams can be inspected, matched and \
edited the same way ordinary expressions can. The functions in this guide are \
the diagram analogues of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Position"]], "paclet:ref/Position"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a1b71c8c-709c-4e3b-b79a-975b4d01024c"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Cases"]], "paclet:ref/Cases"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "dbcb9610-8946-4aa4-9037-765bbfc6a882"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Map"]], "paclet:ref/Map"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f36334b7-19f2-4f0c-bc1d-ed37b32fec7a"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["MapAt"]], "paclet:ref/MapAt"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "af01bb78-8ae0-4d90-8628-3e9381499f17"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Extract"]], "paclet:ref/Extract"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "29944503-cf5f-4fb7-8155-7560a4bc2916"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Insert"]], "paclet:ref/Insert"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e2229809-d740-42e4-8441-693c9013c6c4"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Delete"]], "paclet:ref/Delete"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4c1feebe-459f-438d-bca9-5de0cdc3b80a"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ReplacePart"]], "paclet:ref/ReplacePart"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "44e83b26-b35b-45ba-ac30-852055dd40cc"],
 " \[LongDash] they work on the diagram's subdiagram tree, using ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramPattern"]], 
    "paclet:Wolfram/DiagrammaticComputation/ref/DiagramPattern", 
    "Wolfram/DiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "239853fe-e070-45ff-a233-dd8228225d12"],
 " for matching. This is the plumbing under ",
 Cell[BoxData[
 "DiagramRewriting"], "InlineFormula",ExpressionUUID->
  "0f8e1b1c-ed46-4ff5-8717-0a476723a841"],
 "; reach for it when you want non-pattern edits or want to write a custom \
rewriter."
}], "GuideAbstract",
 CellID->2001916300,ExpressionUUID->"ef0ab37b-2e0d-4399-8f7e-82603ccbe925"]
}, Open  ]],

