Notebook[{

Cell[CellGroupData[{
Cell["Rewriting Diagrams", "Title",
 CellID->509267359,ExpressionUUID->"4ddb5767-1f00-4973-a411-49eacd07850d"],

Cell[TextData[{
 "Diagram rewriting replaces a piece of a diagram matching a pattern with \
another piece, reconnecting the wires. Matching happens on the diagram's \
hypergraph structure, so rules are insensitive to layout and port naming \
\[LongDash] formal pattern symbols in port positions bind to whatever wiring \
the match finds. This tech note builds rewrite rules for algebraic laws and \
applies them with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramReplaceList"]], 
    "paclet:Wolfram/DiagrammaticComputation/ref/DiagramReplaceList", 
    "Wolfram/DiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b5dc8554-1955-4f78-aa3e-a5a84f52cf05"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramReplace"]], 
    "paclet:Wolfram/DiagrammaticComputation/ref/DiagramReplace", 
    "Wolfram/DiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f31454b6-52a3-4a01-86f7-eb50e2f43de5"],
 "."
}], "Text",ExpressionUUID->"0d03662e-36ed-4479-96dc-e717efbec733"],

Cell[BoxData[
 RowBox[{"<<", " ", "Wolfram`DiagrammaticComputation`"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"0fb4f353-5321-4407-acfc-6f5f5e6bcadf"],

Cell["Structural Rules", "Section",ExpressionUUID->"78a7496e-dfd4-422b-9dd3-843c572cfaff"],

Cell[TextData[{
 "A rewrite rule is a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Rule"]], "paclet:ref/Rule"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0fb90e41-cee3-4124-a2dc-8829c8a705ca"],
 " between two diagrams whose ports carry patterns. Associativity of a binary \
operation ",
 Cell[BoxData[
  FormBox[
   StyleBox["f", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "f7bdac60-148a-4ddc-8bce-7759309cc933"],
 " rewires the parenthesisation of a double application:"
}], "Text",ExpressionUUID->"adde8ab1-1279-47e1-a759-9c82dbdd696b"],

