Cell["\<\
These rules drive lambda-calculus evaluation as interaction nets: beta \
reduction is an annihilation between a lambda node and an application node, \
and copy/erase rules implement sharing and garbage collection.\
\>", "Text",ExpressionUUID->"67d09066-6272-444a-add8-3b6a78b47345"],

Cell["Inspecting the Matcher", "Section",ExpressionUUID->"8c9040cf-0d00-4c53-ba1b-bb78b04a4e49"],

