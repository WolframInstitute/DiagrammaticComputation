        RowBox[{"p_", ",", " ", "p3_"}], "}"}], ",", " ", "p4_"}], "]"}], ",",
      " ", 
     RowBox[{"Diagram", "[", 
      RowBox[{"f_", ",", " ", 
       RowBox[{"{", 
        RowBox[{"p1_", ",", " ", "p2_"}], "}"}], ",", " ", "p_"}], "]"}]}], 
    "]"}], " ", "->", "\n", "  ", 
   RowBox[{"DiagramComposition", "[", 
    RowBox[{
     RowBox[{"Diagram", "[", 
      RowBox[{"f", ",", " ", 
       RowBox[{"{", 
        RowBox[{"p1", ",", " ", "p"}], "}"}], ",", " ", "p4"}], "]"}], ",", 
     " ", 
     RowBox[{"Diagram", "[", 
