Cell[BoxData[
 RowBox[{"d2", " ", "=", " ", 
  RowBox[{"DiagramComposition", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"DiagramNetwork", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"Diagram", "[", 
       RowBox[{
        RowBox[{"Interpretation", "[", 
         RowBox[{"\"\<A\>\"", ",", " ", 
          RowBox[{"RandomReal", "[", 
           RowBox[{"1", ",", " ", 
            RowBox[{"{", 
             RowBox[{"2", ",", " ", "3"}], "}"}]}], "]"}]}], "]"}], ",", " ", 
        "a", ",", " ", "b"}], "]"}], ",", "\n", "    ", 
      RowBox[{"Diagram", "[", 
       RowBox[{
        RowBox[{"Interpretation", "[", 
         RowBox[{"\"\<B\>\"", ",", " ", 
          RowBox[{"RandomReal", "[", 
           RowBox[{"1", ",", " ", 
            RowBox[{"{", 
             RowBox[{"2", ",", " ", "3", ",", " ", "4"}], "}"}]}], "]"}]}], 
         "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"b", ",", " ", "c"}], "}"}], ",", " ", "a"}], "]"}]}], "\n", 
     "  ", "]"}], ",", "\n", "  ", 
    RowBox[{"Diagram", "[", 
     RowBox[{
      RowBox[{"Interpretation", "[", 
       RowBox[{"\"\<C\>\"", ",", " ", 
