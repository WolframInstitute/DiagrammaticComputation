 "Stack the steps with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ColumnDiagram"]], 
    "paclet:Wolfram/DiagrammaticComputation/ref/ColumnDiagram", 
    "Wolfram/DiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b8c90185-8811-470a-94cd-1364823c86bb"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RowDiagram"]], 
    "paclet:Wolfram/DiagrammaticComputation/ref/RowDiagram", 
    "Wolfram/DiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d934c31e-6286-42d9-93e5-1c34ac496664"],
 "; matching resource names wire automatically:"
}], "Text",ExpressionUUID->"8c36e9a6-b5f2-4117-b6c0-9fc22582001e"],

