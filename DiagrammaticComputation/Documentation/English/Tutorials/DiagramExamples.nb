Cell["Executable Dataflow with Parallelism", "Section",ExpressionUUID->"ead5a921-4383-4506-9b50-14148503b5d8"],

Cell["\<\
Annotated diagrams run as functions (see the introduction tech note). \
Functions in independent branches can run on parallel kernels:\
\>", "Text",ExpressionUUID->"40272812-25e5-4d76-b949-184761dbbf6a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"parallel", " ", "=", " ", 
  RowBox[{"DiagramProduct", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"Diagram", "[", 
     RowBox[{
      RowBox[{"Annotation", "[", 
       RowBox[{"\"\<f\>\"", ",", " ", 
        RowBox[{"\"\<Function\>\"", " ", "->", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"{", 
             RowBox[{"$KernelID", ",", " ", "#1"}], "}"}], "}"}], " ", "&"}], 
          ")"}]}]}], "]"}], ",", " ", "a", ",", " ", "b"}], "]"}], ",", "\n", 
    "  ", 
    RowBox[{"Diagram", "[", 
     RowBox[{
      RowBox[{"Annotation", "[", 
       RowBox[{"\"\<g\>\"", ",", " ", 
        RowBox[{"\"\<Function\>\"", " ", "->", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"{", 
             RowBox[{"$KernelID", ",", " ", "#1", ",", " ", "#2"}], "}"}], 
            "}"}], " ", "&"}], ")"}]}]}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "z"}], "}"}], ",", " ", "z"}], "]"}]}], "\n", 
   "]"}]}]], "Input",
 CellLabel->
  "In[17]:= ",ExpressionUUID->"41a37069-579b-40ce-aab0-d3f96b2a8a95"],

