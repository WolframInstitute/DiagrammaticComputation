Cell[BoxData[
 RowBox[{"ColumnDiagram", "[", 
  RowBox[{"{", "\n", "  ", 
   RowBox[{
    RowBox[{"RowDiagram", "[", 
     RowBox[{"{", 
      RowBox[{"egg", ",", " ", "egg", ",", " ", 
       RowBox[{"IdentityDiagram", "[", "\"\<sugar\>\"", "]"}]}], "}"}], "]"}],
     ",", "\n", "  ", 
    RowBox[{"RowDiagram", "[", 
     RowBox[{"{", 
      RowBox[{"whisk", ",", " ", "beat"}], "}"}], "]"}], ",", "\n", "  ", 
    "stir", ",", "\n", "  ", "fold"}], "\n", "}"}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"6ec8034d-ab41-4047-9bbc-f7fbe816f8b9"],

