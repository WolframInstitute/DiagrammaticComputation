Cell[TextData[{
 "Stack the steps with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ColumnDiagram"]], 
    "paclet:WolframDiagrammaticComputation/ref/ColumnDiagram", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ce549df8-61db-4ac9-af80-aa2a812ffaf3"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RowDiagram"]], 
    "paclet:WolframDiagrammaticComputation/ref/RowDiagram", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "fea60c17-fc39-4c7c-aa8e-72067589bf94"],
 "; matching resource names wire automatically:"
}], "Text",ExpressionUUID->"78f06d0b-432b-4667-b61d-89484f6d05d6"],

