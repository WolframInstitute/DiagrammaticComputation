Cell[BoxData[
 RowBox[{"{", "\n", "  ", 
  RowBox[{
   RowBox[{"egg", " ", "=", " ", 
    RowBox[{"Diagram", "[", 
     RowBox[{"\"\<Crack Egg\>\"", ",", " ", "\"\<egg\>\"", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<white\>\"", ",", " ", "\"\<yolk\>\""}], "}"}]}], "]"}]}], 
   ",", "\n", "  ", 
   RowBox[{"beat", " ", "=", " ", 
    RowBox[{"Diagram", "[", 
     RowBox[{"\"\<Beat\>\"", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<yolk\>\"", ",", " ", "\"\<yolk\>\"", ",", 
        " ", "\"\<sugar\>\""}], "}"}], ",", " ", "\"\<yolky paste\>\""}], 
     "]"}]}], ",", "\n", "  ", 
   RowBox[{"whisk", " ", "=", " ", 
    RowBox[{"Diagram", "[", 
     RowBox[{"\"\<Whisk\>\"", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<white\>\"", ",", " ", "\"\<white\>\""}], "}"}], ",", 
      " ", "\"\<whisked whites\>\""}], "]"}]}], ",", "\n", "  ", 
   RowBox[{"stir", " ", "=", " ", 
    RowBox[{"Diagram", "[", 
     RowBox[{"\"\<Stir\>\"", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<yolky paste\>\"", ",", " ", "\"\<mascarpone\>\""}], "}"}],
       ",", " ", "\"\<thick paste\>\""}], "]"}]}], ",", "\n", "  ", 
   RowBox[{"fold", " ", "=", " ", 
    RowBox[{"Diagram", "[", 
     RowBox[{"\"\<Fold\>\"", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<whisked whites\>\"", ",", " ", "\"\<thick paste\>\""}], 
       "}"}], ",", " ", "\"\<crema di mascarpone\>\""}], "]"}]}]}], "\n", 
  "}"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"85b2ec83-c9e8-433b-8cec-0b6f1ace1962"],

