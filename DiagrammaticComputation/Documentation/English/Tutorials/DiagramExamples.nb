Cell[BoxData[
 RowBox[{"ColumnDiagram", "[", 
  RowBox[{"{", "\n", "  ", 
   RowBox[{
    RowBox[{"RowDiagram", "[", 
     RowBox[{"{", 
      RowBox[{"egg", ",", " ", "egg", ",", " ", 
       RowBox[{"IdentityDiagram", "[", "\"\<sugar\>\"", "]"}]}], "}"}], "]"}],
     ",", "\n", "  ", 
    RowBox[{"RowDiagram", "[", 
     RowBox[{"{", 
      RowBox[{"whisk", ",", " ", "beat"}], "}"}], "]"}], ",", "\n", "  ", 
    "stir", ",", "\n", "  ", "fold"}], "\n", "}"}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"0a7fa34c-08c8-4867-aba9-b1ed7775f854"],

