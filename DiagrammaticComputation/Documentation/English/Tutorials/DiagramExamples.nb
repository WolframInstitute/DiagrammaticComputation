Notebook[{

Cell[CellGroupData[{
Cell["Diagram Examples", "Title",
 CellID->509267359,ExpressionUUID->"4ddb5767-1f00-4973-a411-49eacd07850d"],

Cell["\<\
A gallery of worked examples: modeling a recipe as a dataflow diagram, \
building sorting networks from permutations, round-tripping between diagrams \
and symbolic tensors, and viewing trees and graphs as diagram grids.\
\>", "Text",ExpressionUUID->"7d6d84e8-c80f-461d-98d7-35be6d123f8a"],

Cell[BoxData[
 RowBox[{"<<", " ", "Wolfram`DiagrammaticComputation`"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"7ba5c739-74d5-481d-aae9-36f4da541480"],

Cell["A Recipe as a Dataflow", "Section",ExpressionUUID->"bf92e3d6-e233-4919-b8f6-a937cbfec4c9"],

Cell["\<\
Any process whose steps consume and produce named resources is a diagram. The \
classic tiramisu cream:\
\>", "Text",ExpressionUUID->"341841f9-6fd6-460f-8aab-f08ae90ae3bc"],

