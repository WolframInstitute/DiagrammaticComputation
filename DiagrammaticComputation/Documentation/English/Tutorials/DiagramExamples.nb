Cell["Executable Dataflow with Parallelism", "Section",ExpressionUUID->"b28ae06d-492e-499e-b4e9-82cac289b713"],

Cell["\<\
Annotated diagrams run as functions (see the introduction tech note). \
Functions in independent branches can run on parallel kernels:\
\>", "Text",ExpressionUUID->"1ffa2170-64b3-42de-9286-66f79b322f45"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"parallel", " ", "=", " ", 
  RowBox[{"DiagramProduct", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"Diagram", "[", 
     RowBox[{
      RowBox[{"Annotation", "[", 
       RowBox[{"\"\<f\>\"", ",", " ", 
        RowBox[{"\"\<Function\>\"", " ", "->", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"{", 
             RowBox[{"$KernelID", ",", " ", "#1"}], "}"}], "}"}], " ", "&"}], 
          ")"}]}]}], "]"}], ",", " ", "a", ",", " ", "b"}], "]"}], ",", "\n", 
    "  ", 
    RowBox[{"Diagram", "[", 
     RowBox[{
      RowBox[{"Annotation", "[", 
       RowBox[{"\"\<g\>\"", ",", " ", 
        RowBox[{"\"\<Function\>\"", " ", "->", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"{", 
             RowBox[{"$KernelID", ",", " ", "#1", ",", " ", "#2"}], "}"}], 
            "}"}], " ", "&"}], ")"}]}]}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "z"}], "}"}], ",", " ", "z"}], "]"}]}], "\n", 
   "]"}]}]], "Input",
 CellLabel->
  "In[17]:= ",ExpressionUUID->"c5f17a2b-dff6-47f1-8662-ecfda73d3b8d"],

