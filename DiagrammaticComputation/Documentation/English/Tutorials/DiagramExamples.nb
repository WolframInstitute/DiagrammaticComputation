Cell[TextData[{
 "Since the network is nothing but wires, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SimplifyDiagram"]], 
    "paclet:Wolfram/DiagrammaticComputation/ref/SimplifyDiagram", 
    "Wolfram/DiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "44ccbad3-23bb-4d0e-a7c2-cfba68b4cfa8"],
 " contracts it to the overall permutation:"
}], "Text",ExpressionUUID->"04b265c8-d25a-4404-848b-bcdec567808f"],

