Cell[BoxData[
 RowBox[{"{", "\n", "  ", 
  RowBox[{
   RowBox[{"egg", " ", "=", " ", 
    RowBox[{"Diagram", "[", 
     RowBox[{"\"\<Crack Egg\>\"", ",", " ", "\"\<egg\>\"", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<white\>\"", ",", " ", "\"\<yolk\>\""}], "}"}]}], "]"}]}], 
   ",", "\n", "  ", 
   RowBox[{"beat", " ", "=", " ", 
    RowBox[{"Diagram", "[", 
     RowBox[{"\"\<Beat\>\"", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<yolk\>\"", ",", " ", "\"\<yolk\>\"", ",", 
        " ", "\"\<sugar\>\""}], "}"}], ",", " ", "\"\<yolky paste\>\""}], 
     "]"}]}], ",", "\n", "  ", 
   RowBox[{"whisk", " ", "=", " ", 
    RowBox[{"Diagram", "[", 
     RowBox[{"\"\<Whisk\>\"", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<white\>\"", ",", " ", "\"\<white\>\""}], "}"}], ",", 
      " ", "\"\<whisked whites\>\""}], "]"}]}], ",", "\n", "  ", 
   RowBox[{"stir", " ", "=", " ", 
    RowBox[{"Diagram", "[", 
     RowBox[{"\"\<Stir\>\"", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<yolky paste\>\"", ",", " ", "\"\<mascarpone\>\""}], "}"}],
       ",", " ", "\"\<thick paste\>\""}], "]"}]}], ",", "\n", "  ", 
   RowBox[{"fold", " ", "=", " ", 
    RowBox[{"Diagram", "[", 
     RowBox[{"\"\<Fold\>\"", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<whisked whites\>\"", ",", " ", "\"\<thick paste\>\""}], 
       "}"}], ",", " ", "\"\<crema di mascarpone\>\""}], "]"}]}]}], "\n", 
  "}"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"a8c59202-5411-45c0-be86-cc0c118f85fa"],

