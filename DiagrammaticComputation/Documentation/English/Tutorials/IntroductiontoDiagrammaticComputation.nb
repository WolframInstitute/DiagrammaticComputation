Cell[TextData[{
 "The parallel composition above can also be done directly using ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramProduct"]], 
    "paclet:WolframDiagrammaticComputation/ref/DiagramProduct", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "dd32a31a-7091-48bf-a1a7-ffb989f63273"],
 " in any order; this ensures that ports of horizontally composed diagrams \
never wire together:"
}], "Text",ExpressionUUID->"64654c09-e790-44f8-a96e-8e86cdcd07bc"],

