     RowBox[{"\"\<Shape\>\"", " ", "->", " ", "#"}]}], "]"}], " ", "&"}], " ",
   "/@", " ", 
  RowBox[{"{", 
   RowBox[{
   "Automatic", ",", " ", "\"\<RoundedRectangle\>\"", ",", 
    " ", "\"\<Triangle\>\"", ",", " ", "\"\<UpsideDownTriangle\>\"", ",", 
    " ", "\"\<Disk\>\"", ",", " ", "\"\<Point\>\"", ",", 
    " ", "\"\<Wire\>\""}], "}"}]}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"5229e292-780b-46da-b28d-0944e98bb1a5"],

