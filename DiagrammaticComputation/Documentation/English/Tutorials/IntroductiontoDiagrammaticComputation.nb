Notebook[{

Cell[CellGroupData[{
Cell["Introduction to Diagrammatic Computation", "Title",
 CellID->509267359,ExpressionUUID->"4ddb5767-1f00-4973-a411-49eacd07850d"],

Cell["\<\
Diagrammatic Computation involves representing operations and their \
connections visually, much like diagrams in mathematics or engineering. This \
approach emphasizes modular building blocks that can be composed in various \
ways to model complex systems. To illustrate these concepts computationally, \
we start by loading the paclet:\
\>", "Text",ExpressionUUID->"5a186cb2-8a32-40c6-bdb5-f2ecfdc25973"],

Cell[BoxData[
 RowBox[{"PacletInstall", "[", "\"\<Wolfram/DiagrammaticComputation\>\"", 
  "]"}]], "Input",ExpressionUUID->"3ef941c0-b258-4078-b390-7d250c4c4403"],

Cell[BoxData[
 RowBox[{"<<", " ", "Wolfram`DiagrammaticComputation`"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"aac6909b-7b8a-436e-843f-a2bc789b247e"],

Cell["Core Ideas of Diagrammatic Thinking", "Section",ExpressionUUID->"6294c714-e044-43c3-8235-9643ec4fa7c0"],

Cell["\<\
At its essence, diagrammatic computation treats computations as abstract \
structures: boxes representing operations, with ports for inputs and outputs. \
These can be wired together to form larger diagrams, revealing patterns and \
relationships that might be less apparent in linear code. The focus is on \
composition, modularity, and visualization, rather than specific applications.\
\>", "Text",ExpressionUUID->"7343e5db-de06-4291-a67a-27a90fafdda8"],

Cell["Constructing a Diagram", "Section",ExpressionUUID->"f2e19fc4-4e40-432f-9ed7-5050f6f4bf5a"],

Cell[TextData[{
 "Consider representing addition with two inputs ",
 Cell[BoxData[
  FormBox[
   StyleBox["x", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "7f09ecff-be4f-4366-8674-0aa6ba58e0e7"],
 " and ",
 Cell[BoxData[
  FormBox[
   StyleBox["y", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "9953f622-7c12-4d3c-b325-2b0915a3de70"],
 " and one output ",
 Cell[BoxData[
  FormBox[
   StyleBox["z", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "1b3aa2a2-2faf-410b-a4a4-64a1391875d2"],
 ":"
}], "Text",ExpressionUUID->"f1143ec8-6f38-4bae-acfd-1875eacbe7c5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Diagram", "[", 
  RowBox[{"Plus", ",", " ", 
   RowBox[{"{", 
    RowBox[{"x", ",", " ", "y"}], "}"}], ",", " ", "z"}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"89aca7b3-3272-46f1-ac91-3fc9daf39fad"],

Cell[BoxData[
 GraphicsBox[
  NamespaceBox["Diagram",
   DynamicModuleBox[{Typeset`d = HoldComplete[
     Wolfram`DiagrammaticComputation`Diagram`Diagram[<|
      "DiagramOptions" -> {
        "PortArrows" -> {{Automatic, Automatic}, {Automatic}}, 
         "PortLabels" -> {{Automatic, Automatic}, {Automatic}}}, "Expression" :> 
       Plus, "InputPorts" -> {
         Wolfram`DiagrammaticComputation`Port`Port[<|
          "Expression" :> 
           Wolfram`DiagrammaticComputation`Port`PortDual[MTNB$auosip2uix5p`x],
            "NeutralQ" -> False, "Tags" -> {}, "Type" -> 
           SuperStar[\[FormalCapitalT]]|>], 
         Wolfram`DiagrammaticComputation`Port`Port[<|
          "Expression" :> 
           Wolfram`DiagrammaticComputation`Port`PortDual[MTNB$auosip2uix5p`y],
            "NeutralQ" -> False, "Tags" -> {}, "Type" -> 
           SuperStar[\[FormalCapitalT]]|>]}, "OutputPorts" -> {
         Wolfram`DiagrammaticComputation`Port`Port[<|
          "Expression" :> MTNB$auosip2uix5p`z, "NeutralQ" -> False, 
           "Tags" -> {}, "Type" -> \[FormalCapitalT]|>]}|>]]}, 
    {Arrowheads[Small], 
     {EdgeForm[{LightDarkSwitched[
       GrayLevel[0], 
       GrayLevel[1]], Opacity[0.5]}], FaceForm[LightDarkSwitched[
       RGBColor[0.952941188969422, 0.9529411889694224, 0.9529411889694221], 
       GrayLevel[0.62]]], 
      GeometricTransformationBox[
       RectangleBox[
        NCache[{Rational[-1, 2], Rational[-1, 2]}, {-0.5, -0.5}]], {{{1, 0}, {
        0, 1}}, {0, 0}}]}, {{{
        ArrowBox[{{-0.2666666666666667, 0.75}, {-0.2666666666666667, 0.5}}], 
        InsetBox[
         InterpretationBox[
          TagBox["x",
           HoldForm],
          
          Wolfram`DiagrammaticComputation`Port`Port[<|
           "Expression" :> MTNB$auosip2uix5p`x, "NeutralQ" -> False, 
            "Tags" -> {}, "Type" -> \[FormalCapitalT]|>],
          Tooltip->"\[FormalCapitalT]"], {-0.2666666666666667, 0.875}]}, {
        ArrowBox[{{0.2666666666666666, 0.75}, {0.2666666666666666, 0.5}}], 
        InsetBox[
         InterpretationBox[
          TagBox["y",
           HoldForm],
          
          Wolfram`DiagrammaticComputation`Port`Port[<|
           "Expression" :> MTNB$auosip2uix5p`y, "NeutralQ" -> False, 
            "Tags" -> {}, "Type" -> \[FormalCapitalT]|>],
          Tooltip->"\[FormalCapitalT]"], {0.2666666666666666, 0.875}]}}, {
       ArrowBox[{{0., -0.5}, {0., -0.75}}], InsetBox[
        InterpretationBox[
         TagBox["z",
          HoldForm],
         Wolfram`DiagrammaticComputation`Port`Port[<|
          "Expression" :> MTNB$auosip2uix5p`z, "NeutralQ" -> False, 
           "Tags" -> {}, "Type" -> \[FormalCapitalT]|>],
         Tooltip->"\[FormalCapitalT]"], {0., -0.875}]}}, 
     {LightDarkSwitched[
       GrayLevel[0], 
       GrayLevel[1]], InsetBox[
       TagBox["Plus",
        HoldForm], {0, 0}]}}]],
  BaseStyle->{
   GraphicsBoxOptions -> {ImageSize -> Tiny}, 
    Wolfram`DiagrammaticComputation`Diagram`Private`GraphicsHighlightColor -> 
    RGBColor[1, 0, 1]},
  FormatType->StandardForm]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"51edafee-b05f-4536-a396-a1647e4d3ca9"]
}, Open  ]],

Cell[TextData[{
 "This creates a symbolic diagram: a box labeled ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Plus"]], "paclet:ref/Plus"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4cadab57-675f-44cd-9ae9-3b803f26e216"],
 " with input ports ",
 Cell[BoxData[
  FormBox[
   StyleBox["x", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "881dfe3a-3977-4045-a5d1-6471b6ad818a"],
 " and ",
 Cell[BoxData[
  FormBox[
   StyleBox["y", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "b5c7e1b9-60ea-44a3-9fa1-cf740c480bc0"],
 ", and a single output port ",
 Cell[BoxData[
  FormBox[
   StyleBox["z", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "93856b98-ab1f-43e7-8ac4-ad9acc20d0d6"],
 ". It remains unevaluated, serving as a blueprint. By default, such diagrams \
format visually, showing wires connecting the ports to the operation."
}], "Text",ExpressionUUID->"1cc59d99-85be-4f74-8732-212907fe9b3e"],

Cell["\<\
There are a few custom shapes that will be useful for changing diagram \
default appearance:\
\>", "Text",ExpressionUUID->"66e5ab07-fe02-49dc-b422-8727f2e92a64"],

