     RowBox[{
      RowBox[{"Diagram", "[", 
       RowBox[{"A", ",", " ", "a", ",", " ", "c"}], "]"}], " ", "\[CircleTimes]",
       " ", 
      RowBox[{"Diagram", "[", 
       RowBox[{"B", ",", " ", "b"}], "]"}]}], ")"}], " ", "/*", " ", 
    RowBox[{"Diagram", "[", 
     RowBox[{"C", ",", " ", 
      RowBox[{"{", 
       RowBox[{"c", ",", " ", "b"}], "}"}], ",", " ", "e"}], "]"}]}], 
   "]"}]}]], "Input",
