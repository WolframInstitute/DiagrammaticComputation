   RowBox[{"double", ",", " ", "z", ",", " ", "x"}], "]"}]}]], "Input",
 CellLabel->
  "In[12]:= ",ExpressionUUID->"1bd2ea19-c4ee-4740-b003-dc8d09534fea"],

Cell[BoxData[
 GraphicsBox[
  NamespaceBox["Diagram",
   DynamicModuleBox[{Typeset`d = HoldComplete[
     Wolfram`DiagrammaticComputation`Diagram`Diagram[<|
      "DiagramOptions" -> {
