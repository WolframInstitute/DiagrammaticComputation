Cell[BoxData[
 RowBox[{"double2", " ", "=", " ", 
  RowBox[{"Diagram", "[", 
   RowBox[{"double", ",", " ", "z", ",", " ", "x"}], "]"}]}]], "Input",
 CellLabel->
  "In[12]:= ",ExpressionUUID->"f56421ca-6ce3-4b3f-a540-bfd37b851587"],

