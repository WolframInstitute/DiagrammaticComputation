     RowBox[{"\"\<Shape\>\"", " ", "->", " ", "#"}]}], "]"}], " ", "&"}], " ",
   "/@", " ", 
  RowBox[{"{", 
   RowBox[{
   "Automatic", ",", " ", "\"\<RoundedRectangle\>\"", ",", 
    " ", "\"\<Triangle\>\"", ",", " ", "\"\<UpsideDownTriangle\>\"", ",", 
    " ", "\"\<Disk\>\"", ",", " ", "\"\<Point\>\"", ",", 
    " ", "\"\<Wire\>\""}], "}"}]}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"a41ff4b5-fb31-40b5-b91f-af0904036689"],

