 CellLabel->
  "In[11]:= ",ExpressionUUID->"4f679e15-3f48-4a0f-bbbf-14fedbaec57d"],

Cell[BoxData[
 GraphicsBox[
  NamespaceBox["Diagram",
   DynamicModuleBox[{Typeset`d = HoldComplete[
