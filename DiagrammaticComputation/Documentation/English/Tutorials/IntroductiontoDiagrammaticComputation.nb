 CellLabel->
  "Out[14]= ",ExpressionUUID->"6c49182d-9e0e-464d-80b9-96fc4b3e1e90"]
}, Open  ]],

Cell[TextData[{
 "The parallel composition above can also be done directly using ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramProduct"]], 
    "paclet:Wolfram/DiagrammaticComputation/ref/DiagramProduct", 
    "Wolfram/DiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4407091a-e87f-4f81-a4cf-2e283fa6b55b"],
 " in any order; this ensures that ports of horizontally composed diagrams \
never wire together:"
}], "Text",ExpressionUUID->"f80c7217-1c1d-4af3-9857-a08858a16c00"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"DiagramProduct", "[", 
  RowBox[{"increment", ",", " ", "double"}], "]"}]], "Input",
 CellLabel->
  "In[15]:= ",ExpressionUUID->"b18d0dc5-1883-47a3-b1d5-2ff1fabf22c3"],

Cell[BoxData[
 GraphicsBox[
  NamespaceBox["Diagram",
   DynamicModuleBox[{Typeset`d = HoldComplete[
     Wolfram`DiagrammaticComputation`Diagram`Diagram[<|
      "DiagramOptions" -> {
        "PortArrows" -> {{Automatic, Automatic}, {Automatic, Automatic}}}, 
       "Expression" :> 
       Wolfram`DiagrammaticComputation`Diagram`DiagramProduct[
         Wolfram`DiagrammaticComputation`Diagram`Diagram[<|
          "DiagramOptions" -> {
            "PortArrows" -> {{Automatic}, {Automatic}}, 
             "PortLabels" -> {{Automatic}, {Automatic}}}, "Expression" :> 
           "[+1]", "InputPorts" -> {
             
             Wolfram`DiagrammaticComputation`Port`Port[<|
              "Expression" :> 
               Wolfram`DiagrammaticComputation`Port`PortDual[
