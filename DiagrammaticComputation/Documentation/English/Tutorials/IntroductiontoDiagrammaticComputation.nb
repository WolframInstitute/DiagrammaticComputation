Cell[TextData[{
 "The result may be unexpected because port ",
 Cell[BoxData[
  FormBox[
   StyleBox["z", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "830f2791-9e99-4e0b-9dd4-9e67e4acc411"],
 " is followed by port ",
 Cell[BoxData[
  FormBox[
   StyleBox["x", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "44350435-bae3-4e4a-b041-bc7077a6578a"],
 ", which do not match, so the diagrams compose horizontally in parallel. To \
fix this, it is possible to reassign ports for a diagram. For example, a new \
double diagram with adjusted port names can be constructed like this:"
}], "Text",ExpressionUUID->"ab66fb98-6df5-4104-bef9-394091b5527a"],

