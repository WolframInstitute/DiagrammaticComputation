Cell["\<\
Which, after turning into a function, would produce a different result:\
\>", "Text",ExpressionUUID->"afdea085-10b4-48ee-a666-965bc88866f2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"z", " ", "|->", " ", 
      RowBox[{"z", " ", "+", " ", "1"}]}], ")"}], " ", "/*", " ", 
    RowBox[{"(", 
     RowBox[{"y", " ", "|->", " ", 
      RowBox[{"2", " ", "y"}]}], ")"}]}], ")"}], "@", "3"}]], "Input",
 CellLabel->
  "In[14]:= ",ExpressionUUID->"2b6c5fd4-8a1f-414a-a545-9ac4ddb97ba0"],

