               Arrowheads[{{Small, 0.5}}], {
                Arrow[
                 
                 BSplineCurve[{{0.37245805378155705`, -0.043588968481196685`} + 
                   VectorSymbol["p", 2], {
                    0.9311451344538927, -0.1089724212029917} + 
                   VectorSymbol["p", 2], {-0.39518344913408887`, 
                    0.2152441440097385} + 
                   VectorSymbol["q", 2], {-0.13172781637802963`, 
                    0.07174804800324616} + VectorSymbol["q", 2]}]]}}, {
              VectorSymbol["p", 2] :> Part[#, 1], VectorSymbol["q", 2] :> 
               Part[#, -1], 
