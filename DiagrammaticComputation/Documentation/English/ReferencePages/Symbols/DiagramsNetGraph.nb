                 Pattern[Wolfram`DiagrammaticComputation`Diagram`Private`expr, 
                  Blank[]]] :> 
               Wolfram`DiagrammaticComputation`Diagram`Private`expr}], 
            Wolfram`DiagrammaticComputation`Diagram`Private`wireLabel$ = 
            Replace[
              Replace[
               (#3& )[{{0., -0.5}, {0., -0.75}}, {{0., 0.5}, {0., 0.75}}, 
                
                Wolfram`DiagrammaticComputation`Port`Port[<|
                 "Expression" :> 
