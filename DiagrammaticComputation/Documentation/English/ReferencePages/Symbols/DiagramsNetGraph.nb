                    Pattern[Wolfram`DiagrammaticComputation`Diagram`Private`a, 
                    Blank[]]], 
                    Pattern[Wolfram`DiagrammaticComputation`Diagram`Private`a, 
                    Blank[]]]] :> 
                    Line[Wolfram`DiagrammaticComputation`Diagram`Private`a]}]]\
, MaxCellMeasure -> {"Length", 0.1}]]]}, 
                  If[
                   MatchQ[
                   Wolfram`DiagrammaticComputation`Diagram`Private`center$, {
                    PatternTest[
                    Blank[], NumericQ], 
                    PatternTest[
                    Blank[], NumericQ]}], 
                   Wolfram`DiagrammaticComputation`Diagram`Private`center$, 
                   
                   ReplaceAll[{0.05586870806723357, -0.006538345272179502} + 
                    Rational[
                    1, 2] ({0.5359616853198038, 0.10627172280674678`} + 
                    VectorSymbol["p", 2] + VectorSymbol["q", 2]), {
                    VectorSymbol["p", 2] :> Part[#, 1], VectorSymbol["q", 2] :> 
