                  "Type" -> \[FormalCapitalT]|>]}|>]}}, 
       BaseStyle -> {FormatType -> StandardForm}, 
       EdgeShapeFunction -> {DirectedEdge[2, 
           HoldForm[
           Wolfram`DiagrammaticComputation`Diagram`Rewriting`Rules`c], {{2, 1,
            1}, {1, 1, 1}}] -> (
          With[{Wolfram`DiagrammaticComputation`Diagram`Private`edgeShape$ = 
