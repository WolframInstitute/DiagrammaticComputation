Cell[BoxData[
 GraphicsBox[
  NamespaceBox["NetworkGraphics",
   DynamicModuleBox[{Typeset`graph = HoldComplete[
     Graph[{1, 2, 
       HoldForm[Wolfram`DiagrammaticComputation`Diagram`Rewriting`Rules`a], 
       HoldForm[
       Wolfram`DiagrammaticComputation`Diagram`Rewriting`Rules`c]}, {{{1, 
       2}, {2, 4}, {3, 1}}, Null, {{{2, 1, 1}, 
         HoldForm[
         Wolfram`DiagrammaticComputation`Diagram`Rewriting`Rules`b], {1, 1, 
         1}}, {{2, 1, 1}, {1, 1, 1}}, {{2, 1, 1}, {1, 1, 1}}}}, {
      AnnotationRules -> {
        HoldForm[
          Wolfram`DiagrammaticComputation`Diagram`Rewriting`Rules`c] -> {
          "Diagram" -> 
           Wolfram`DiagrammaticComputation`Diagram`Diagram[<|
             "DiagramOptions" -> {
               "PortArrows" -> {{Automatic}, {}}, 
                "PortLabels" -> {{Automatic}, Automatic}, "Shape" -> 
                "Wires"[{}], "ShowLabel" -> False, 
                "FloatingPorts" -> {False, True}}, "Expression" :> "Copy", 
              "InputPorts" -> {
                
                Wolfram`DiagrammaticComputation`Port`Port[<|
                 "Expression" :> 
                  Wolfram`DiagrammaticComputation`Port`PortDual[
                   Wolfram`DiagrammaticComputation`Diagram`Rewriting`Rules`c],
                   "NeutralQ" -> False, "Tags" -> {{2, 2, 1}}, "Type" -> 
                  SuperStar[\[FormalCapitalT]]|>]}, "OutputPorts" -> {}|>]}, 
         HoldForm[
          Wolfram`DiagrammaticComputation`Diagram`Rewriting`Rules`a] -> {
          "Diagram" -> 
           Wolfram`DiagrammaticComputation`Diagram`Diagram[<|
             "DiagramOptions" -> {
               "Shape" -> "Wires"[{}], "PortArrows" -> {{}, {
                   Placed[Automatic, {{0., -0.5}, {0., -0.75}}]}}, 
                "PortLabels" -> {{}, {Automatic}}, 
                "FloatingPorts" -> {True, False}, "ShowLabel" -> False}, 
              "Expression" :> "Copy", "InputPorts" -> {}, "OutputPorts" -> {
                
                Wolfram`DiagrammaticComputation`Port`Port[<|
                 "Expression" :> 
                  Wolfram`DiagrammaticComputation`Diagram`Rewriting`Rules`a, 
                  "NeutralQ" -> False, "Tags" -> {{1, 1, 1}}, 
                  "Type" -> \[FormalCapitalT]|>]}|>]}, 
         2 -> {"Diagram" -> 
           Wolfram`DiagrammaticComputation`Diagram`Diagram[<|
             "DiagramOptions" -> {
               "PortArrows" -> {{Automatic}, {Automatic}}, 
                "PortLabels" -> {{Automatic}, {Automatic}}}, "Expression" :> 
              "B", "InputPorts" -> {
                
                Wolfram`DiagrammaticComputation`Port`Port[<|
                 "Expression" :> 
                  Wolfram`DiagrammaticComputation`Port`PortDual[
                   Wolfram`DiagrammaticComputation`Diagram`Rewriting`Rules`b],
