Cell[CellGroupData[{
Cell["DiagramGraphics", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"1a513ba3-1d13-4496-b950-cdfc0a9645c0"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["DiagramGraphics",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/DiagramGraphics"],
    "[", 
   StyleBox["d", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "c07b5804-de9f-4cbc-85a1-55302117dd56"],
 " ",
 "returns a graphical representation of the diagram ",
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "01c14aca-9697-40c1-b26a-255e345ec3b0"],
 " as a single labelled node with attached input and output ports.",
 "\n"
}], "Usage",ExpressionUUID->"deea392b-e5fb-41f1-a9f5-28dabe6c3fc4"],

Cell[TextData[{
 "Used by ",
 Cell[BoxData[
  ButtonBox["Diagram",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/Diagram"]], 
  "InlineFormula",ExpressionUUID->"2b3ee7c7-7f47-403b-86b3-6176459fdb15"],
 " itself to render an opaque diagram. Unlike ",
 Cell[BoxData[
  ButtonBox["DiagramGrid",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/DiagramGrid"]], 
  "InlineFormula",ExpressionUUID->"813964bc-74b7-4563-a5f1-9a9e4051abfd"],
 ", it does ",
 StyleBox["not", "TI"],
 " decompose composite diagrams into a grid of subdiagrams \[LongDash] the \
whole diagram is shown as one box."
}], "Notes",ExpressionUUID->"3806b0ec-c9e3-4a96-a227-7c983d78fca8"],

Cell[TextData[{
 "Accepts the same shape-, port-, and label-related options as ",
