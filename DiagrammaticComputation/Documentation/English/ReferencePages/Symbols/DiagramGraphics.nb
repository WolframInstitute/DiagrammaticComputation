Cell[CellGroupData[{
Cell["DiagramGraphics", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"8c989173-346e-4b48-be37-44ed3c043a4d"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DiagramGraphics"]], 
     "paclet:Wolfram/DiagrammaticComputation/ref/DiagramGraphics", 
     "Wolfram/DiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["d", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "ae65a5a6-1036-44ce-8527-7039e528eefd"],
 " ",
 "returns a graphical representation of the diagram ",
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "ceb2f3d2-8bd7-4096-9795-928036d731ba"],
 " as a single labelled node with attached input and output ports.",
 "\n"
}], "Usage",ExpressionUUID->"3daee53d-a359-4bd3-ab3b-8a0de420ec1a"],

Cell[TextData[{
 "Used by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Diagram"]], 
    "paclet:Wolfram/DiagrammaticComputation/ref/Diagram", 
    "Wolfram/DiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e51a244d-3eab-4951-a144-f61b119c8746"],
 " itself to render an opaque diagram. Unlike ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramGrid"]], 
    "paclet:Wolfram/DiagrammaticComputation/ref/DiagramGrid", 
    "Wolfram/DiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2ebe1745-8ffd-420f-b5a3-af61a09d91e1"],
 ", it does ",
 StyleBox["not", "TI"],
 " decompose composite diagrams into a grid of subdiagrams \[LongDash] the \
whole diagram is shown as one box."
}], "Notes",ExpressionUUID->"6d1b97e5-3f08-4963-9572-de5779523f8b"],

