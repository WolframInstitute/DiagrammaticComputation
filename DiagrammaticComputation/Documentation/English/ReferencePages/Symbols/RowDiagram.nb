Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"RowDiagram", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"Diagram", "[", 
     RowBox[{"\"\<A\>\"", ",", " ", "a", ",", " ", "b"}], "]"}], ",", " ", 
    RowBox[{"Diagram", "[", 
     RowBox[{"\"\<B\>\"", ",", " ", "c", ",", " ", "d"}], "]"}]}], "}"}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"3fedba8e-b974-44d2-8cfe-71f1d779dac4"],

