 Cell[BoxData[
  RowBox[{
   ButtonBox["RowDiagram",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/RowDiagram"], "[", 
   RowBox[{"{", 
    RowBox[{
     SubscriptBox[
      StyleBox["d", "TI"], 
      StyleBox["1", "TR"]], ",", " ", 
     SubscriptBox[
      StyleBox["d", "TI"], 
      StyleBox["2", "TR"]], ",", " ", "\[Ellipsis]"}], "}"}], "]"}]], 
  "InlineFormula",ExpressionUUID->"47d9b091-de11-4985-a289-71066c4743bf"],
 " ",
 "arranges the diagrams ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["d", "TI"], 
    StyleBox["i", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "9e9c0428-cd01-415d-81df-5653c5eba242"],
 " in a horizontal row.",
 "\n"
}], "Usage",ExpressionUUID->"5fc95906-7ab4-48f1-8fd1-e65efe138d8f"],

Cell[TextData[{
 "Equivalent in structure to ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["DiagramProduct",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/DiagramProduct"], 
   "[", 
   RowBox[{
    SubscriptBox[
     StyleBox["d", "TI"], 
     StyleBox["1", "TR"]], ",", " ", 
    SubscriptBox[
     StyleBox["d", "TI"], 
     StyleBox["2", "TR"]], ",", " ", "\[Ellipsis]"}], "]"}]], "InlineFormula",
  ExpressionUUID->"bfaab44d-9039-4eae-a51b-adb36e9200a1"],
 " but with default port-arrow display tuned for a row layout."
}], "Notes",ExpressionUUID->"3a04d71d-7815-4f4f-ad5a-5d781d6836ba"]
}, Open  ]],

