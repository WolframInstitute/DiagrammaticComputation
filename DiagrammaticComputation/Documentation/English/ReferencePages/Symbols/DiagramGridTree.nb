Cell[CellGroupData[{
Cell["DiagramGridTree", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"b06622e7-ddf4-4c90-a320-940aaa343155"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["DiagramGridTree",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/DiagramGridTree"],
    "[", 
   StyleBox["d", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "9eaa6731-74e3-4e31-99e0-9f6c7acc3a95"],
 " ",
 "returns the hierarchical tree of grid cells that ",
 Cell[BoxData[
  ButtonBox["DiagramGrid",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/DiagramGrid"]], 
  "InlineFormula",ExpressionUUID->"e882c5fa-b4d7-4218-b3ed-30c665b70b0e"],
 " uses to render the diagram ",
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "e7670d82-25c6-4efd-89dd-aadc88cc17f8"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"32a5bbba-30fa-4de5-9415-c9ee92cbb6cc"],

Cell["\<\
Each node of the tree corresponds to a grid cell; leaf cells are singleton \
subdiagrams and inner cells are nested grids.\
\>", "Notes",ExpressionUUID->"84931dd4-3f11-4cac-b1ae-276bb504762c"],

Cell[TextData[{
 "Useful for inspecting or customising how a composite diagram will be laid \
out before calling ",
 Cell[BoxData[
  ButtonBox["DiagramGrid",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/DiagramGrid"]], 
  "InlineFormula",ExpressionUUID->"63089139-6065-4bdf-b1c1-28eb039eabab"],
 "."
}], "Notes",ExpressionUUID->"1f214ff8-d058-4575-a5c9-f88e67f102c1"]
}, Open  ]],

