Cell[BoxData[
 RowBox[{"DiagramGridTree", " ", "@", " ", 
  RowBox[{"DiagramComposition", "[", 
   RowBox[{
    RowBox[{"Diagram", "[", 
     RowBox[{"\"\<A\>\"", ",", " ", "b", ",", " ", "a"}], "]"}], ",", " ", 
    RowBox[{"Diagram", "[", 
     RowBox[{"\"\<B\>\"", ",", " ", "c", ",", " ", "b"}], "]"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"ce08de31-9bec-4d93-8ef1-292fb9b76cc3"],

