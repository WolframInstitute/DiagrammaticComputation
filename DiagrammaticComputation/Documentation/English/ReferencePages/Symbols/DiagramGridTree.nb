Cell[BoxData[
 RowBox[{"DiagramGridTree", " ", "@", " ", 
  RowBox[{"DiagramComposition", "[", 
   RowBox[{
    RowBox[{"Diagram", "[", 
     RowBox[{"\"\<A\>\"", ",", " ", "b", ",", " ", "a"}], "]"}], ",", " ", 
    RowBox[{"Diagram", "[", 
     RowBox[{"\"\<B\>\"", ",", " ", "c", ",", " ", "b"}], "]"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"124940d1-54ec-4ab3-8395-68a74113433d"],

