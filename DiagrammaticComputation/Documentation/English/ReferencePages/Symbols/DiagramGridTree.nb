Cell["\<\
Each node of the tree corresponds to a grid cell; leaf cells are singleton \
subdiagrams and inner cells are nested grids.\
\>", "Notes",ExpressionUUID->"2548c500-4a0f-4686-a4e0-1ad5698b5bd6"],

Cell[TextData[{
