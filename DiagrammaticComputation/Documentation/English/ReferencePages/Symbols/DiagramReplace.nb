Notebook[{

Cell[CellGroupData[{
Cell["DiagramReplace", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"8e40d4fc-e22d-417c-ab9a-833ebc3c4dc1"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DiagramReplace"]], 
     "paclet:WolframDiagrammaticComputation/ref/DiagramReplace", 
     "WolframDiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["d", "TI"], ",", " ", 
    RowBox[{
     StyleBox["src", "TI"], " ", "->", " ", 
     StyleBox["tgt", "TI"]}]}], "]"}]], "InlineFormula",ExpressionUUID->
  "8dc5eca0-e8ef-43a5-b340-22012cccd737"],
 " ",
 "rewrites the first match of the diagram ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"s", "r", "c"}], "TI"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"0270c0c9-1352-4d37-b0ae-e36bda799e21"],
 " in ",
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "1104f072-9b7d-4990-a8b5-7208c4e4e16e"],
 " to ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"t", "g", "t"}], "TI"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"8fdb3c44-851b-4f55-ac21-b26712f18adb"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"8f745c82-c6ab-490e-a575-bb431864a3af"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DiagramReplace"]], 
     "paclet:WolframDiagrammaticComputation/ref/DiagramReplace", 
     "WolframDiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["d", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["rule", "TI"], 
       StyleBox["1", "TR"]], ",", " ", 
      SubscriptBox[
       StyleBox["rule", "TI"], 
       StyleBox["2", "TR"]], ",", " ", "\[Ellipsis]"}], "}"}]}], "]"}]], 
  "InlineFormula",ExpressionUUID->"53dd03ac-e2a4-46ff-b179-fd1f3f2e14ba"],
 " ",
 "tries each rule in turn, applying the first that matches.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"b0169104-712e-4d93-874f-125ccd4c77c5"],
 Cell[BoxData[
  RowBox[{
   RowBox[{"DiagramReplace", "[", 
    StyleBox["rule", "TI"], "]"}], "[", 
   StyleBox["d", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "b202f486-2879-4f8e-9e0a-caad81e1fa27"],
 " ",
 "is the operator form."
}], "Usage",ExpressionUUID->"857c49a4-1f9f-43c5-b6a1-1cb7864acf1e"],

Cell[TextData[{
 "Matching is performed against the hypergraph view of ",
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "de98bc1e-30cb-4435-890e-b16b613103a3"],
 " (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramHypergraph"]], 
    "paclet:WolframDiagrammaticComputation/ref/DiagramHypergraph", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3edb6a4b-fcf8-42e2-9c21-fb6cddd7414e"],
 "), so port names in the rule bind to the matched wiring rather than having \
to match literally."
}], "Notes",ExpressionUUID->"21ea54ff-f23e-44d9-9b51-b027e9d90d48"],

Cell[TextData[{
 "If no rule matches, ",
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "3b6f9974-21f0-462a-b487-b1cee4f3742b"],
 " is returned unchanged."
}], "Notes",ExpressionUUID->"16794285-c404-4e62-82ac-ac363676ec8a"],

Cell[TextData[{
 "Only the ",
 StyleBox["first", "TI"],
 " match is rewritten. To enumerate every possible single rewrite use ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramReplaceList"]], 
    "paclet:WolframDiagrammaticComputation/ref/DiagramReplaceList", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2b55da5b-b96a-4ea5-975a-e42961f7a7d7"],
 "; to apply rules repeatedly use ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramNestReplace"]], 
    "paclet:WolframDiagrammaticComputation/ref/DiagramNestReplace", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f9376404-060e-4f8c-a57e-be253a6ac9d6"],
 "."
}], "Notes",ExpressionUUID->"73676ea7-325e-43b7-a4c7-ca27590902b6"]
}, Open  ]],

