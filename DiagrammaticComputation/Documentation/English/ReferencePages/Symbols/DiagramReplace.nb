Notebook[{

Cell[CellGroupData[{
Cell["DiagramReplace", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"4a2e3bce-95fd-4fb7-a6af-e145b35f3016"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DiagramReplace"]], 
     "paclet:WolframDiagrammaticComputation/ref/DiagramReplace", 
     "WolframDiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["d", "TI"], ",", " ", 
    RowBox[{
     StyleBox["src", "TI"], " ", "->", " ", 
     StyleBox["tgt", "TI"]}]}], "]"}]], "InlineFormula",ExpressionUUID->
  "923457e7-b95c-4eb0-be15-4c13677b9c12"],
 " ",
 "rewrites the first match of the diagram ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"s", "r", "c"}], "TI"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"7605d3be-00f6-4ba7-b16a-9176a5afc049"],
 " in ",
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "67b8078c-e2a9-4de9-b30b-b33c8bb72082"],
 " to ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"t", "g", "t"}], "TI"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"c4e6856c-0d4e-4ad0-8157-1ca953e243ee"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"30879ac2-ab3b-45ab-ba8f-40b580ba6e8d"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DiagramReplace"]], 
     "paclet:WolframDiagrammaticComputation/ref/DiagramReplace", 
     "WolframDiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["d", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["rule", "TI"], 
       StyleBox["1", "TR"]], ",", " ", 
      SubscriptBox[
       StyleBox["rule", "TI"], 
       StyleBox["2", "TR"]], ",", " ", "\[Ellipsis]"}], "}"}]}], "]"}]], 
  "InlineFormula",ExpressionUUID->"7984dded-68de-40db-9db8-bec9d4e7a23c"],
 " ",
 "tries each rule in turn, applying the first that matches.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"2e9e640c-b726-44dd-834d-3f2ae9ab7570"],
 Cell[BoxData[
  RowBox[{
   RowBox[{"DiagramReplace", "[", 
    StyleBox["rule", "TI"], "]"}], "[", 
   StyleBox["d", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "09ed12e4-22fc-4f77-b58c-f0596831b829"],
 " ",
 "is the operator form."
}], "Usage",ExpressionUUID->"29638143-328f-484a-90e7-49494c5715a2"],

Cell[TextData[{
 "Matching is performed against the hypergraph view of ",
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "fdbc840a-ec48-4ff3-a31f-eb3abb70e154"],
 " (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramHypergraph"]], 
    "paclet:WolframDiagrammaticComputation/ref/DiagramHypergraph", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b3c29ead-a3e0-4397-bade-db53141fad03"],
 "), so port names in the rule bind to the matched wiring rather than having \
to match literally."
}], "Notes",ExpressionUUID->"d582598c-73d2-443e-81fe-0e3817d7aa39"],

Cell[TextData[{
 "If no rule matches, ",
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "ebc8c46e-0e1a-4527-aecb-0c790a512965"],
 " is returned unchanged."
}], "Notes",ExpressionUUID->"efe10193-4191-4ea6-ba17-943aaaa21b94"],

Cell[TextData[{
 "Only the ",
 StyleBox["first", "TI"],
 " match is rewritten. To enumerate every possible single rewrite use ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramReplaceList"]], 
    "paclet:WolframDiagrammaticComputation/ref/DiagramReplaceList", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5730e0a8-2da3-4fe6-b913-75622f762520"],
 "; to apply rules repeatedly use ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramNestReplace"]], 
    "paclet:WolframDiagrammaticComputation/ref/DiagramNestReplace", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "bd20eb2e-ba87-4980-9cff-67c95c2cc5e8"],
 "."
}], "Notes",ExpressionUUID->"3145da81-9380-451e-87ce-6aba05883163"]
}, Open  ]],

