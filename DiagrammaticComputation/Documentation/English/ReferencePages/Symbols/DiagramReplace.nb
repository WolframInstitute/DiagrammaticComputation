Notebook[{

Cell[CellGroupData[{
Cell["DiagramReplace", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"9c1bd161-4227-4f1c-b7c5-198ca4756a72"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DiagramReplace"]], 
     "paclet:Wolfram/DiagrammaticComputation/ref/DiagramReplace", 
     "Wolfram/DiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["d", "TI"], ",", " ", 
    RowBox[{
     StyleBox["src", "TI"], " ", "->", " ", 
     StyleBox["tgt", "TI"]}]}], "]"}]], "InlineFormula",ExpressionUUID->
  "eedbc16a-cc72-4886-b38e-0e55787ee3e8"],
 " ",
 "rewrites the first match of the diagram ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"s", "r", "c"}], "TI"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"f84499f0-5cda-48f4-b650-66c0c1099052"],
 " in ",
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "587ea7f9-2949-4422-83eb-e694d504b6e6"],
 " to ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"t", "g", "t"}], "TI"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"9020ae40-5306-413b-88c5-a3d0c71a884f"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"07fdcdd6-3bfb-4263-854b-d8e3cd0006b8"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DiagramReplace"]], 
     "paclet:Wolfram/DiagrammaticComputation/ref/DiagramReplace", 
     "Wolfram/DiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["d", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["rule", "TI"], 
       StyleBox["1", "TR"]], ",", " ", 
      SubscriptBox[
       StyleBox["rule", "TI"], 
       StyleBox["2", "TR"]], ",", " ", "\[Ellipsis]"}], "}"}]}], "]"}]], 
  "InlineFormula",ExpressionUUID->"e0989496-a69e-4fe7-8684-a3dafd6e31f1"],
 " ",
 "tries each rule in turn, applying the first that matches.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"93634da1-3afe-4c9d-b5e1-2ee26c7f35fe"],
 Cell[BoxData[
  RowBox[{
   RowBox[{"DiagramReplace", "[", 
    StyleBox["rule", "TI"], "]"}], "[", 
   StyleBox["d", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "2082aac1-3355-4177-87cd-62f12435ee04"],
 " ",
 "is the operator form."
}], "Usage",ExpressionUUID->"58650777-eb59-4098-aea2-acf0c8e4370d"],

Cell[TextData[{
 "Matching is performed against the hypergraph view of ",
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "f1170bf0-1500-4938-b89c-fd258aa2393f"],
 " (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramHypergraph"]], 
    "paclet:Wolfram/DiagrammaticComputation/ref/DiagramHypergraph", 
    "Wolfram/DiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "81d2093d-6df1-4015-973f-568ef41037a3"],
 "), so port names in the rule bind to the matched wiring rather than having \
to match literally."
}], "Notes",ExpressionUUID->"881d54b9-2528-41a9-9da1-619a23debd0e"],

Cell[TextData[{
 "If no rule matches, ",
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "0b275ef6-ef11-4658-b05e-75b398b50782"],
 " is returned unchanged."
}], "Notes",ExpressionUUID->"bd42a47a-089f-438c-a0c2-1e682dd1fe5d"],

Cell[TextData[{
 "Only the ",
 StyleBox["first", "TI"],
 " match is rewritten. To enumerate every possible single rewrite use ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramReplaceList"]], 
    "paclet:Wolfram/DiagrammaticComputation/ref/DiagramReplaceList", 
    "Wolfram/DiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "02102c55-006e-48ee-a28c-d525ad55a9b6"],
 "; to apply rules repeatedly use ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramNestReplace"]], 
    "paclet:Wolfram/DiagrammaticComputation/ref/DiagramNestReplace", 
    "Wolfram/DiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "abec1b2b-5faa-4e18-a59a-e62ea63079c7"],
 "."
}], "Notes",ExpressionUUID->"92da84b9-58b4-4eea-b49c-4610e1c97f80"]
}, Open  ]],

