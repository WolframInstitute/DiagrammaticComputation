Cell["Replace a subdiagram inside a composition:", "ExampleText",ExpressionUUID->"8ae236e8-c503-4337-bd87-cad8929eb730"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"DiagramReplace", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"DiagramComposition", "[", 
    RowBox[{
     RowBox[{"Diagram", "[", 
      RowBox[{"\"\<A\>\"", ",", " ", "b", ",", " ", "a"}], "]"}], ",", " ", 
     RowBox[{"Diagram", "[", 
      RowBox[{"\"\<B\>\"", ",", " ", "c", ",", " ", "b"}], "]"}]}], "]"}], ",",
    "\n", "  ", 
   RowBox[{
    RowBox[{"Diagram", "[", 
     RowBox[{"\"\<A\>\"", ",", " ", "\[FormalY]", ",", " ", "\[FormalX]"}], 
     "]"}], " ", "->", " ", 
    RowBox[{"Diagram", "[", 
     RowBox[{"\"\<X\>\"", ",", " ", "\[FormalY]", ",", " ", "\[FormalX]"}], 
     "]"}]}]}], "\n", "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"2a78063f-fed8-41c9-a530-6397c176e4d0"],

Cell[BoxData[
 GraphicsBox[
  NamespaceBox["Diagram",
   DynamicModuleBox[{Typeset`d = HoldComplete[
     Wolfram`DiagrammaticComputation`Diagram`Diagram[<|
      "DiagramOptions" -> {
        "PortArrows" -> {{Automatic}, {Automatic}}, 
         "PortLabels" -> {{Automatic}, {Automatic}}, "BinarySpiders" -> False,
          "RowSort" -> True}, "Expression" :> 
       Wolfram`DiagrammaticComputation`Diagram`DiagramComposition[
         Wolfram`DiagrammaticComputation`Diagram`Diagram[<|
          "DiagramOptions" -> {
            "Center" -> Automatic, "PortArrows" -> {{Automatic}, {Automatic}},
              "PortLabels" -> {{Automatic}, {Automatic}}}, "Expression" :> 
           "X", "InputPorts" -> {
             
             Wolfram`DiagrammaticComputation`Port`Port[<|
              "Expression" :> 
               Wolfram`DiagrammaticComputation`Diagram`Rewriting`Rules`b, 
               "NeutralQ" -> False, 
               "Tags" -> {{2, 2, 1}, {2, 1, 1}, {2, 1, 1}, {2, 1, 1}}, 
               "Type" -> \[FormalCapitalT]|>]}, "OutputPorts" -> {
             
             Wolfram`DiagrammaticComputation`Port`Port[<|
              "Expression" :> 
               Wolfram`DiagrammaticComputation`Diagram`Rewriting`Rules`a, 
               "NeutralQ" -> False, "Tags" -> {{1, 2, 1}, {2, 2, 1}}, 
               "Type" -> \[FormalCapitalT]|>]}|>], 
         Wolfram`DiagrammaticComputation`Diagram`Diagram[<|
          "DiagramOptions" -> {
            "Center" -> Automatic, "PortArrows" -> {{Automatic}, {Automatic}},
              "PortLabels" -> {{Automatic}, {Automatic}}, "Shape" -> 
             "Wires"[{{1, 2}}], "ShowLabel" -> False, 
             "FloatingPorts" -> {False, True}}, "Expression" :> "Copy", 
           "InputPorts" -> {
             
             Wolfram`DiagrammaticComputation`Port`Port[<|
              "Expression" :> 
               Wolfram`DiagrammaticComputation`Port`PortDual[
                Wolfram`DiagrammaticComputation`Diagram`Rewriting`Rules`b], 
               "NeutralQ" -> False, 
               "Tags" -> {{2, 2, 1}, {2, 1, 1}, {2, 1, 1}, {1, 2, 1}}, "Type" -> 
               SuperStar[\[FormalCapitalT]]|>]}, "OutputPorts" -> {
             
             Wolfram`DiagrammaticComputation`Port`Port[<|
              "Expression" :> 
               Wolfram`DiagrammaticComputation`Port`PortDual[
                Wolfram`DiagrammaticComputation`Diagram`Rewriting`Rules`b], 
               "NeutralQ" -> False, 
               "Tags" -> {{2, 2, 1}, {2, 1, 1}, {2, 1, 1}, {2, 1, 1}}, "Type" -> 
               SuperStar[\[FormalCapitalT]]|>]}|>], 
         Wolfram`DiagrammaticComputation`Diagram`Diagram[<|
          "DiagramOptions" -> {
            "Center" -> Automatic, "PortArrows" -> {{Automatic}, {Automatic}},
              "PortLabels" -> {{Automatic}, {Automatic}}, 
             "PortFunction" -> (Replace[
               (#["TaggedFullName"]& )[#], 
               Pattern[Wolfram`DiagrammaticComputation`Diagram`Private`x, 
                 Except[
                  Blank[HoldForm]]] :> 
               HoldForm[
                Wolfram`DiagrammaticComputation`Diagram`Private`x]]& )}, 
           "Expression" :> "B", "InputPorts" -> {
             
             Wolfram`DiagrammaticComputation`Port`Port[<|
              "Expression" :> 
               Wolfram`DiagrammaticComputation`Port`PortDual[
                Wolfram`DiagrammaticComputation`Diagram`Rewriting`Rules`c], 
               "NeutralQ" -> False, "Tags" -> {{2, 1, 1}, {1, 1, 1}}, "Type" -> 
               SuperStar[\[FormalCapitalT]]|>]}, "OutputPorts" -> {
             
             Wolfram`DiagrammaticComputation`Port`Port[<|
              "Expression" :> 
               Wolfram`DiagrammaticComputation`Diagram`Rewriting`Rules`b, 
               "NeutralQ" -> False, 
               "Tags" -> {{2, 2, 1}, {2, 1, 1}, {2, 1, 1}, {1, 2, 1}}, 
               "Type" -> \[FormalCapitalT]|>]}|>]], "InputPorts" -> {
         Wolfram`DiagrammaticComputation`Port`Port[<|
          "Expression" :> 
           Wolfram`DiagrammaticComputation`Port`PortDual[
            Wolfram`DiagrammaticComputation`Diagram`Rewriting`Rules`c], 
           "NeutralQ" -> False, "Tags" -> {{2, 1, 1}, {1, 1, 1}}, "Type" -> 
           SuperStar[\[FormalCapitalT]]|>]}, "OutputPorts" -> {
         Wolfram`DiagrammaticComputation`Port`Port[<|
          "Expression" :> 
           Wolfram`DiagrammaticComputation`Diagram`Rewriting`Rules`a, 
           "NeutralQ" -> False, "Tags" -> {{1, 2, 1}, {2, 2, 1}}, 
           "Type" -> \[FormalCapitalT]|>]}|>]]}, {{
      {Arrowheads[Small], 
       {EdgeForm[{LightDarkSwitched[
         GrayLevel[0], 
         GrayLevel[1]], Opacity[0.5]}], FaceForm[LightDarkSwitched[
         RGBColor[0.952941188969422, 0.9529411889694224, 0.9529411889694221], 
         
         GrayLevel[0.62]]], 
        GeometricTransformationBox[
         RectangleBox[{0.5, 0.5}], {{{1., 0.}, {0., 1.}}, {0., 0.}}]}, {{}, {
         ArrowBox[{{1., 0.5}, {1., 0.25}}], InsetBox[
          InterpretationBox[
           TagBox["a",
            HoldForm],
           
           Wolfram`DiagrammaticComputation`Port`Port[<|
            "Expression" :> 
             Wolfram`DiagrammaticComputation`Diagram`Rewriting`Rules`a, 
             "NeutralQ" -> False, "Tags" -> {{1, 2, 1}, {2, 2, 1}}, 
             "Type" -> \[FormalCapitalT]|>],
           Tooltip->"\[FormalCapitalT]"], {1., 0.125}]}}, 
       {LightDarkSwitched[
         GrayLevel[0], 
         GrayLevel[1]], InsetBox[
         TagBox["\<\"X\"\>",
          HoldForm], {1., 1.}]}}, 
      {Arrowheads[Small], 
       {EdgeForm[{LightDarkSwitched[
         GrayLevel[0], 
         GrayLevel[1]], Opacity[0.5]}], FaceForm[LightDarkSwitched[
         RGBColor[0.952941188969422, 0.9529411889694224, 0.9529411889694221], 
         
         GrayLevel[0.62]]], 
        {Haloing[], 
         BSplineCurveBox[{{1., 3.5}, {1., 3.25}, {1., 2.75}, {1., 
          2.5}}]}}, {{}, {}}, 
       {LightDarkSwitched[
         GrayLevel[0], 
         GrayLevel[1]], InsetBox["\<\"\\t\\t\\t\"\>", {1., 3.}]}}, 
      {Arrowheads[Small], 
       {EdgeForm[{LightDarkSwitched[
         GrayLevel[0], 
         GrayLevel[1]], Opacity[0.5]}], FaceForm[LightDarkSwitched[
         RGBColor[0.952941188969422, 0.9529411889694224, 0.9529411889694221], 
         
         GrayLevel[0.62]]], 
        GeometricTransformationBox[
         RectangleBox[{0.5, 4.5}], {{{1., 0.}, {0., 1.}}, {0., 0.}}]}, {{
         ArrowBox[{{1., 5.75}, {1., 5.5}}], InsetBox[
          InterpretationBox[
           TagBox["c",
            HoldForm],
           
           Wolfram`DiagrammaticComputation`Port`Port[<|
            "Expression" :> 
             Wolfram`DiagrammaticComputation`Diagram`Rewriting`Rules`c, 
             "NeutralQ" -> False, "Tags" -> {{2, 1, 1}, {1, 1, 1}}, 
             "Type" -> \[FormalCapitalT]|>],
           Tooltip->"\[FormalCapitalT]"], {1., 5.875}]}, {}}, 
       {LightDarkSwitched[
         GrayLevel[0], 
         GrayLevel[1]], InsetBox[
         TagBox["\<\"B\"\>",
          HoldForm], {1., 5.}]}}}, {
      {Arrowheads[{{Small, 0.5}}], {}, 
       ArrowBox[
        BSplineCurveBox[{{1., 4.5}, {1., 4.25}, {1., 3.75}, {1., 3.5}}]], 
       InsetBox[
        TemplateBox[{"b"},
         "ClickToCopy"], {0.9, 4.}]}, 
      {Arrowheads[{{Small, 0.5}}], {}, 
       ArrowBox[
        BSplineCurveBox[{{1., 1.5}, {1., 1.75}, {1., 2.25}, {1., 2.5}}]], 
       InsetBox[
        TemplateBox[{"b"},
         "ClickToCopy"], {0.9, 2.}]}}, {}, {}, 
     {EdgeForm[{LightDarkSwitched[
       GrayLevel[0], 
       GrayLevel[1]], Thickness[Tiny]}], FaceForm[None]}}]],
  BaseStyle->{
   GraphicsBoxOptions -> {ImageSize -> Medium}, 
    Wolfram`DiagrammaticComputation`Diagram`Private`GraphicsHighlightColor -> 
    RGBColor[1, 0, 1]},
  FormatType->StandardForm]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"9fdbab9a-0dd5-4cc3-8574-abf7bd398330"]
}, Open  ]],

