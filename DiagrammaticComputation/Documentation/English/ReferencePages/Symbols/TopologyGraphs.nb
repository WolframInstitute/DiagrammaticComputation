Cell["\<\
Insert Standard Model fields and get one graph per insertion:\
\>", "ExampleText",ExpressionUUID->"38ba3338-8b74-4c47-9fa8-ea3900390414"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ins", " ", "=", " ", 
   RowBox[{"InsertFields", "[", 
    RowBox[{
     RowBox[{"CreateTopologies", "[", 
      RowBox[{"0", ",", " ", 
       RowBox[{"2", " ", "->", " ", "2"}]}], "]"}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"F", "[", 
         RowBox[{"2", ",", " ", 
          RowBox[{"{", "1", "}"}]}], "]"}], ",", " ", 
        RowBox[{"-", 
         RowBox[{"F", "[", 
          RowBox[{"2", ",", " ", 
           RowBox[{"{", "1", "}"}]}], "]"}]}]}], "}"}], " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"F", "[", 
         RowBox[{"2", ",", " ", 
          RowBox[{"{", "2", "}"}]}], "]"}], ",", " ", 
        RowBox[{"-", 
         RowBox[{"F", "[", 
          RowBox[{"2", ",", " ", 
           RowBox[{"{", "2", "}"}]}], "]"}]}]}], "}"}]}], ",", "\n", "  ", 
     RowBox[{"InsertionLevel", " ", "->", " ", 
      RowBox[{"{", "Classes", "}"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"TopologyGraphs", "[", "ins", "]"}]}], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"b8d08aed-04e6-467a-8df0-5eaeaf137747"],

