Insert Standard Model fields and get one graph per insertion:\
\>", "ExampleText",ExpressionUUID->"159ac1f9-5bc0-4a64-8323-6cdecc48e5b6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ins", " ", "=", " ", 
   RowBox[{"InsertFields", "[", 
    RowBox[{
     RowBox[{"CreateTopologies", "[", 
      RowBox[{"0", ",", " ", 
       RowBox[{"2", " ", "->", " ", "2"}]}], "]"}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"F", "[", 
         RowBox[{"2", ",", " ", 
          RowBox[{"{", "1", "}"}]}], "]"}], ",", " ", 
        RowBox[{"-", 
         RowBox[{"F", "[", 
          RowBox[{"2", ",", " ", 
           RowBox[{"{", "1", "}"}]}], "]"}]}]}], "}"}], " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"F", "[", 
         RowBox[{"2", ",", " ", 
          RowBox[{"{", "2", "}"}]}], "]"}], ",", " ", 
        RowBox[{"-", 
         RowBox[{"F", "[", 
          RowBox[{"2", ",", " ", 
           RowBox[{"{", "2", "}"}]}], "]"}]}]}], "}"}]}], ",", "\n", "  ", 
     RowBox[{"InsertionLevel", " ", "->", " ", 
      RowBox[{"{", "Classes", "}"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"TopologyGraphs", "[", "ins", "]"}]}], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"770bccb8-1a48-4281-acc4-8867e6bda91a"],

