Cell["\<\
Insert Standard Model fields and get one graph per insertion:\
\>", "ExampleText",ExpressionUUID->"cb7b3851-a37a-4829-ba0f-2ae75755423b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ins", " ", "=", " ", 
   RowBox[{"InsertFields", "[", 
    RowBox[{
     RowBox[{"CreateTopologies", "[", 
      RowBox[{"0", ",", " ", 
       RowBox[{"2", " ", "->", " ", "2"}]}], "]"}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"F", "[", 
         RowBox[{"2", ",", " ", 
          RowBox[{"{", "1", "}"}]}], "]"}], ",", " ", 
        RowBox[{"-", 
         RowBox[{"F", "[", 
          RowBox[{"2", ",", " ", 
           RowBox[{"{", "1", "}"}]}], "]"}]}]}], "}"}], " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"F", "[", 
         RowBox[{"2", ",", " ", 
          RowBox[{"{", "2", "}"}]}], "]"}], ",", " ", 
        RowBox[{"-", 
         RowBox[{"F", "[", 
          RowBox[{"2", ",", " ", 
           RowBox[{"{", "2", "}"}]}], "]"}]}]}], "}"}]}], ",", "\n", "  ", 
     RowBox[{"InsertionLevel", " ", "->", " ", 
      RowBox[{"{", "Classes", "}"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"TopologyGraphs", "[", "ins", "]"}]}], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"02fd3e35-7363-41d0-a507-387c0b95511e"],

