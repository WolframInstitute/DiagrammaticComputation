Cell[CellGroupData[{
Cell["DiagramProduct", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"e8e5cabc-446b-4c0b-8fac-fc69004e1f1c"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["DiagramProduct",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/DiagramProduct"], 
   "[", 
   RowBox[{
    SubscriptBox[
     StyleBox["d", "TI"], 
     StyleBox["1", "TR"]], ",", " ", 
    SubscriptBox[
     StyleBox["d", "TI"], 
     StyleBox["2", "TR"]], ",", " ", 
    SubscriptBox[
     StyleBox["d", "TI"], 
     StyleBox["3", "TR"]], ",", " ", "\[Ellipsis]"}], "]"}]], "InlineFormula",
  ExpressionUUID->"c4392add-c602-46b3-9589-f3638bb1e657"],
 " ",
 "represents the parallel (tensor) composition of the diagrams ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["d", "TI"], 
    StyleBox["i", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "68cf56d0-a7ba-4a2d-bac1-fdf195f4817f"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"955ecd74-3da3-4382-a51b-b35cba6d14ab"],

Cell[TextData[{
 "The product diagram has as inputs the ",
 Cell[BoxData[
  ButtonBox["PortProduct",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/PortProduct"]], 
  "InlineFormula",ExpressionUUID->"2fef9dbc-d0a2-4be9-aa68-33635a4df0df"],
 " of the inputs of the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["d", "TI"], 
    StyleBox["i", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "bb8bfe55-5a30-4901-b2c8-fe1eace58dca"],
 " in order, and as outputs the ",
 Cell[BoxData[
  ButtonBox["PortProduct",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/PortProduct"]], 
  "InlineFormula",ExpressionUUID->"970e8de0-361b-4fdf-860b-69148975abe4"],
 " of the outputs in order."
}], "Notes",ExpressionUUID->"fb6f9438-c7e5-4e3a-b599-551701c69360"],

Cell[TextData[{
 "The infix shorthand ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["d", "TI"], 
    StyleBox["1", "TR"]], " ", "\[CircleTimes]", " ", 
