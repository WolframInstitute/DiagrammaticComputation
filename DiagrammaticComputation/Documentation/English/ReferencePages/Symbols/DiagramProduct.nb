 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TensorProduct"]], "paclet:ref/TensorProduct"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
