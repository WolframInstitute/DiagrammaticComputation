   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3cba9d5c-7a9a-4432-bb91-37a7ba18b825"],
 ". The layout-level analogue is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RowDiagram"]], 
