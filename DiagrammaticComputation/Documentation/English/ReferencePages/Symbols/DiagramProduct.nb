   ButtonData->"paclet:ref/KroneckerProduct"]], "InlineFormula",
  ExpressionUUID->"f3d5f9ec-7342-4aac-9f2d-d7031b15255a"],
 ". The layout-level analogue is ",
 Cell[BoxData[
  ButtonBox["RowDiagram",
