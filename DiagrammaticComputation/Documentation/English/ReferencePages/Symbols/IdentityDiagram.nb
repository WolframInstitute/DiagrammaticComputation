       StyleBox["q", "TI"], 
       StyleBox["n", "TI"]]}], "}"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"a289ec72-646b-411a-bfda-58755e294942"],
 " ",
 "creates a parallel bundle of identities with the specified input and output \
ports."
}], "Usage",ExpressionUUID->"b766d047-d809-4313-bb44-66e22af82f5a"],

Cell[TextData[{
 "The identity diagram is the unit of ",
 Cell[BoxData[
  ButtonBox["DiagramComposition",
