Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"37c6d86a-239f-4dde-a6d3-0ccc1df360b3"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["IdentityDiagram",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/IdentityDiagram"],
    "[", 
   StyleBox["p", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "a3cd5c39-f3fd-485e-8eb4-b72a2893df96"],
 " ",
 "creates an identity diagram with a single input port ",
 Cell[BoxData[
  FormBox[
   StyleBox["p", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "8c707dc8-388d-431b-9e58-5bf19e0720cf"],
 " and matching output port \[LongDash] a \"pass-through wire\" on ",
 Cell[BoxData[
  FormBox[
   StyleBox["p", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "8df492d5-debf-4106-9234-b5a1fdbd815a"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"b86bfb27-4bd1-45e3-aa85-c3b5478c3c3d"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["IdentityDiagram",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/IdentityDiagram"],
    "[", 
   RowBox[{"{", 
    RowBox[{
     SubscriptBox[
      StyleBox["p", "TI"], 
      StyleBox["1", "TR"]], ",", " ", 
     SubscriptBox[
      StyleBox["p", "TI"], 
      StyleBox["2", "TR"]], ",", " ", "\[Ellipsis]"}], "}"}], "]"}]], 
  "InlineFormula",ExpressionUUID->"4eb78e57-5903-4a04-b1b2-bc36743636a5"],
 " ",
 "creates a diagram consisting of multiple identities, one per port.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"bbab4e33-2685-42d3-b4b6-454808a93d62"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["IdentityDiagram",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/IdentityDiagram"],
    "[", 
   RowBox[{
    StyleBox["p", "TI"], " ", "->", " ", 
    StyleBox["q", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "73a77ff6-9adb-4ad0-95ad-4bed7cab32e7"],
 " ",
 "creates an identity-shaped diagram with input port ",
 Cell[BoxData[
  FormBox[
   StyleBox["p", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "70fe2103-262f-4d8d-9ca2-8179c4874834"],
 " and output port ",
 Cell[BoxData[
  FormBox[
   StyleBox["q", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "830a63bd-f4ed-4116-af16-01a50807af4e"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"c5cdfc30-4006-4131-b3db-bc6e104b998f"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["IdentityDiagram",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/IdentityDiagram"],
    "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["p", "TI"], 
       StyleBox["1", "TR"]], ",", " ", "\[Ellipsis]", ",", " ", 
      SubscriptBox[
       StyleBox["p", "TI"], 
       StyleBox["n", "TI"]]}], "}"}], " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["q", "TI"], 
       StyleBox["1", "TR"]], ",", " ", "\[Ellipsis]", ",", " ", 
