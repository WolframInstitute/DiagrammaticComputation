Cell["A parallel bundle with renaming:", "ExampleText",ExpressionUUID->"bef84017-9bf6-4974-8a77-3f8f26f38694"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"IdentityDiagram", "[", 
