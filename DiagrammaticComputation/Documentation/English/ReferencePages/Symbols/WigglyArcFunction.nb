   StyleBox["shape", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "18d7b6c5-da6b-443f-8166-e6790af79aaf"],
 " ",
 "returns a function that renders a curve in the propagator line style ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"s", "h", "a", "p", "e"}], "TI"], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"a2491271-2845-4721-8d7b-bd9605dc7937"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"2c93dc10-e82f-4943-b9ad-d53a8c1917a2"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["WigglyArcFunction"]], 
     "paclet:WolframDiagrammaticComputation/ref/WigglyArcFunction", 
     "WolframDiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["shape", "TI"], ",", " ", 
    StyleBox["k", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "c8a58be0-e970-4eb3-b942-15bdd7ac373f"],
 " ",
 "bends the curve into an arc with curvature ",
 Cell[BoxData[
  FormBox[
   StyleBox["k", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "18718492-d70e-4670-8834-9d703d9071dc"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"c20e2873-a9ff-4df5-8e13-19a712e95ead"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["WigglyArcFunction"]], 
     "paclet:WolframDiagrammaticComputation/ref/WigglyArcFunction", 
     "WolframDiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["shape", "TI"], ",", " ", 
    StyleBox["k", "TI"], ",", " ", 
    StyleBox["arrow", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "149fd4f1-7bc0-47a1-915d-b5f7d56ac64a"],
 " ",
 "adds an arrowhead with direction ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"a", "r", "r", "o", "w"}], "TI"], TraditionalForm]], 
