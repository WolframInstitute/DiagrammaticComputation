}], "Usage",ExpressionUUID->"24af8e5a-7164-43ae-9f9a-6c45366752b3"],

Cell["\<\
The returned function accepts a list of points or a curve primitive and \
produces graphics primitives.\
\>", "Notes",ExpressionUUID->"6a5209a0-edd2-4eb4-921b-98dc062b1b60"],

