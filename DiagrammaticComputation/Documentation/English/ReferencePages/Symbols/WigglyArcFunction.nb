   StyleBox["shape", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "63d6089d-febb-4f36-868e-53101d65ecab"],
 " ",
 "returns a function that renders a curve in the propagator line style ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"s", "h", "a", "p", "e"}], "TI"], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"41a8e447-5fc5-4cce-b90e-78c866898b82"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"acf84001-4d4e-4150-98c5-07c93eac70d8"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["WigglyArcFunction"]], 
     "paclet:WolframDiagrammaticComputation/ref/WigglyArcFunction", 
     "WolframDiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["shape", "TI"], ",", " ", 
    StyleBox["k", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "bf1b4d06-102e-4884-8514-c53cb4a1bb6c"],
 " ",
 "bends the curve into an arc with curvature ",
 Cell[BoxData[
  FormBox[
   StyleBox["k", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "95937587-6a16-4675-97c7-29b28b77c04f"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"bafe5446-4109-46fe-83c4-8aef13217d14"],
