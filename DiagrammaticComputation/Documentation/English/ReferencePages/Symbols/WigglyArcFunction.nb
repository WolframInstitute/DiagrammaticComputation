    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["shape", "TI"], ",", " ", 
    StyleBox["k", "TI"], ",", " ", 
    StyleBox["arrow", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "fa6767f9-f469-4c2c-a206-aa7c393e4814"],
 " ",
 "adds an arrowhead with direction ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"a", "r", "r", "o", "w"}], "TI"], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"add05ea7-1bd4-418f-8c11-d09eb207dc57"],
 " (1 forward, \[Minus]1 backward, 0 none)."
}], "Usage",ExpressionUUID->"fe444043-e92f-44a8-a0ae-5a5d43d4d90a"],

Cell["\<\
The returned function accepts a list of points or a curve primitive and \
produces graphics primitives.\
\>", "Notes",ExpressionUUID->"4b430bc5-7636-4b8d-9c23-332c3c8b0a79"],

