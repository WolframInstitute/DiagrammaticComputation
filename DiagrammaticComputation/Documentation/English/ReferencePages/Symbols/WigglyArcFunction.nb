Cell[TextData[{
 "Shapes other than the straight and dashed ones are rendered through the \
WiggleLine resource function, whose options (",
 Cell[BoxData["\"\<Amplitude\>\""], "InlineFormula",ExpressionUUID->
  "07b40d68-388f-4aa7-b136-53e69bc3cc44"],
 ", ",
 Cell[BoxData["\"\<Frequency\>\""], "InlineFormula",ExpressionUUID->
  "bddf98c9-fc8a-454e-b96d-a742e4486d36"],
 ", ",
 Cell[BoxData["\"\<TaperFraction\>\""], "InlineFormula",ExpressionUUID->
  "59ec7a70-ddda-413e-879e-ffe399765205"],
 ", \[Ellipsis]) can be passed through."
}], "Notes",ExpressionUUID->"10c505de-86f3-46e6-bfaf-47f61ee4e723"],

