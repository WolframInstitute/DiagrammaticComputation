  "a93e23e6-2ef4-4858-bbec-dab6abcab394"],
 ", ",
 Cell[BoxData["\"\<TaperFraction\>\""], "InlineFormula",ExpressionUUID->
  "7a092691-7b64-451c-9bdf-c812a6df46ad"],
 ", \[Ellipsis]) can be passed through."
}], "Notes",ExpressionUUID->"eee85c30-ee6c-4eb7-97b5-293faf37d2d2"],

