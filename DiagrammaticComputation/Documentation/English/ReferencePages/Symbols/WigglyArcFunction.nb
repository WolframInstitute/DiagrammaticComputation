Cell[TextData[{
 "Shapes other than the straight and dashed ones are rendered through the \
WiggleLine resource function, whose options (",
 Cell[BoxData["\"\<Amplitude\>\""], "InlineFormula",ExpressionUUID->
  "e76adc01-82c7-4ebd-b22b-95aa0f7823d7"],
 ", ",
