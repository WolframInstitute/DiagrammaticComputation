Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"32cd5eec-8c12-481c-bdf8-2dcf9f327614"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["WigglyArcFunction"]], 
     "paclet:Wolfram/DiagrammaticComputation/ref/WigglyArcFunction", 
     "Wolfram/DiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["shape", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "b26fc413-f8dc-4a27-9920-dbb047555860"],
 " ",
 "returns a function that renders a curve in the propagator line style ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"s", "h", "a", "p", "e"}], "TI"], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"2463e800-dfc9-4f26-9ed9-c02cd887a8ed"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"8bd52f8b-f484-4594-af2e-5580835cf514"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["WigglyArcFunction"]], 
     "paclet:Wolfram/DiagrammaticComputation/ref/WigglyArcFunction", 
     "Wolfram/DiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["shape", "TI"], ",", " ", 
    StyleBox["k", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "3159d50a-8a2a-48eb-8b7a-16a1e826e07a"],
 " ",
 "bends the curve into an arc with curvature ",
 Cell[BoxData[
  FormBox[
   StyleBox["k", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "11343c57-6a74-4ff7-a6bd-ad191ec57816"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"f1e1902c-4dca-4acc-bf2f-eb6096cc0f86"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["WigglyArcFunction"]], 
     "paclet:Wolfram/DiagrammaticComputation/ref/WigglyArcFunction", 
     "Wolfram/DiagrammaticComputation Package Symbol"},
