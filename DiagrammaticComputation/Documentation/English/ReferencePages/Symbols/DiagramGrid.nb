Cell[CellGroupData[{
Cell["DiagramGrid", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"f83559d6-317f-4244-b799-e6d9a723b8aa"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["DiagramGrid",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/DiagramGrid"], "[", 
   StyleBox["d", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "d638113b-fb1a-4206-8cc1-1a1873fceff4"],
 " ",
 "arranges the diagram ",
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "1536caba-c206-4c91-8395-b58c90c8efb3"],
 " into a grid and returns its graphics representation, with composition \
running vertically and product running horizontally.",
 "\n"
}], "Usage",ExpressionUUID->"93b80eb4-07a8-41c8-a01d-0cfc0c1ee3ef"],

Cell["\<\
Each subdiagram is placed in a cell; wires are drawn between matching ports \
of adjacent cells. The grid expands automatically to accommodate \
compositions, products and nested structure.\
\>", "Notes",ExpressionUUID->"e0eb46b1-8b67-4255-93f6-280f8414ac68"],

Cell[TextData[{
 "For diagrams that are not natively grid-arrangeable, first run ",
 Cell[BoxData[
  ButtonBox["DiagramArrange",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/DiagramArrange"]], 
  "InlineFormula",ExpressionUUID->"ddc62574-7e71-4a8e-9205-416b6ea942d6"],
 " to insert identities, permutations and spiders."
}], "Notes",ExpressionUUID->"ba811baf-54f5-480a-936e-47fc8c342be0"],

