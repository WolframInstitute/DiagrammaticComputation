   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "aa47a916-15d2-4f4b-8239-544e76b14b7f"],
 " is the multi-cell counterpart of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramGraphics"]], 
    "paclet:WolframDiagrammaticComputation/ref/DiagramGraphics", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d932ed01-44ab-4134-8009-696d0f2ce60e"],
 ", which renders a diagram as a single opaque node. Use ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramDecompose"]], 
    "paclet:WolframDiagrammaticComputation/ref/DiagramDecompose", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4880d120-c290-462c-9f6d-36e254ed2c54"],
 " to recover the underlying expression tree."
}], "ExampleText",ExpressionUUID->"e66f6450-5ffd-45f4-99c5-229e56437e22"]
