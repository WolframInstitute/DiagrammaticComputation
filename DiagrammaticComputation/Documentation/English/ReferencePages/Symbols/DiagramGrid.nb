Cell[CellGroupData[{
Cell["DiagramGrid", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"1913cce2-c9ba-43cd-995b-c2a7c451f1e3"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DiagramGrid"]], 
     "paclet:WolframDiagrammaticComputation/ref/DiagramGrid", 
     "WolframDiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["d", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "77298d1f-5dad-46b9-b41d-81dd8df5a955"],
 " ",
 "arranges the diagram ",
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "9ebaf8a2-7e81-4cf2-ba04-5047d184da89"],
 " into a grid and returns its graphics representation, with composition \
running vertically and product running horizontally.",
 "\n"
}], "Usage",ExpressionUUID->"dffbda26-0edb-4166-b159-8162d805c880"],

Cell["\<\
Each subdiagram is placed in a cell; wires are drawn between matching ports \
of adjacent cells. The grid expands automatically to accommodate \
compositions, products and nested structure.\
\>", "Notes",ExpressionUUID->"96737a1f-361f-4a46-b904-13da55ee1313"],

Cell[TextData[{
 "For diagrams that are not natively grid-arrangeable, first run ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramArrange"]], 
    "paclet:WolframDiagrammaticComputation/ref/DiagramArrange", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0ef64ca1-2a4b-484a-bb18-621d0e5bdf5c"],
 " to insert identities, permutations and spiders."
}], "Notes",ExpressionUUID->"9afb352a-c930-4e88-b412-16fd95b00efd"],

