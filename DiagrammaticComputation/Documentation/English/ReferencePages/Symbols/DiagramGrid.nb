Cell["Render a product of two diagrams as a grid:", "ExampleText",ExpressionUUID->"e4b8cfa5-b9a5-4397-8dae-883ce2c57f9a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"DiagramGrid", " ", "@", " ", 
  RowBox[{"DiagramProduct", "[", 
   RowBox[{
    RowBox[{"Diagram", "[", 
     RowBox[{"\"\<A\>\"", ",", " ", 
      RowBox[{"{", 
       RowBox[{"a", ",", " ", "b"}], "}"}], ",", " ", "c"}], "]"}], ",", " ", 
    
    RowBox[{"Diagram", "[", 
     RowBox[{"\"\<B\>\"", ",", " ", "d", ",", " ", "e"}], "]"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"1b6199cc-2716-4a3d-8815-d471c4b28de3"],

