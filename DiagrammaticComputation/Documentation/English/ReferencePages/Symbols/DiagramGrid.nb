Cell["\<\
Render a product of two diagrams as a grid: Render a composition: Render a \
small network:\
\>", "ExampleText",ExpressionUUID->"e4c1d2d9-6d4f-4ff3-be5f-0cac10223e17"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"DiagramGrid", " ", "@", " ", 
  RowBox[{"DiagramProduct", "[", 
   RowBox[{
    RowBox[{"Diagram", "[", 
     RowBox[{"\"\<A\>\"", ",", " ", 
      RowBox[{"{", 
       RowBox[{"a", ",", " ", "b"}], "}"}], ",", " ", "c"}], "]"}], ",", " ", 
    
    RowBox[{"Diagram", "[", 
     RowBox[{"\"\<B\>\"", ",", " ", "d", ",", " ", "e"}], "]"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"689e41a7-6590-4482-a0dc-ef99b7c3486d"],

