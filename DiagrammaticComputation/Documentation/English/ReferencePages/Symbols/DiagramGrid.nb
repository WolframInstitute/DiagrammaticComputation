Cell["Render a product of two diagrams as a grid:", "ExampleText",ExpressionUUID->"dda0de42-e435-4bd3-bb1e-b4eac867adb8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"DiagramGrid", " ", "@", " ", 
  RowBox[{"DiagramProduct", "[", 
   RowBox[{
    RowBox[{"Diagram", "[", 
     RowBox[{"\"\<A\>\"", ",", " ", 
      RowBox[{"{", 
       RowBox[{"a", ",", " ", "b"}], "}"}], ",", " ", "c"}], "]"}], ",", " ", 
    
    RowBox[{"Diagram", "[", 
     RowBox[{"\"\<B\>\"", ",", " ", "d", ",", " ", "e"}], "]"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"0400d652-2f74-4db1-89f4-4cbe7f70a6fa"],

