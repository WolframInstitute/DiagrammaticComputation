Cell[CellGroupData[{
Cell["DiagramGrid", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"24d837ee-977a-4ff0-a3e2-4491e181e286"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DiagramGrid"]], 
     "paclet:Wolfram/DiagrammaticComputation/ref/DiagramGrid", 
     "Wolfram/DiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["d", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "2865ee8e-3167-48e6-94de-5149a028d249"],
 " ",
 "arranges the diagram ",
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "915f40c9-70b8-4042-9d01-8eedeb26a8af"],
 " into a grid and returns its graphics representation, with composition \
running vertically and product running horizontally.",
 "\n"
}], "Usage",ExpressionUUID->"40be19b4-23ed-47f2-aeac-16455dcf3826"],

Cell["\<\
Each subdiagram is placed in a cell; wires are drawn between matching ports \
of adjacent cells. The grid expands automatically to accommodate \
compositions, products and nested structure.\
\>", "Notes",ExpressionUUID->"b1a9c9d2-5551-4414-9b4e-e82d9e071685"],

Cell[TextData[{
 "For diagrams that are not natively grid-arrangeable, first run ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramArrange"]], 
    "paclet:Wolfram/DiagrammaticComputation/ref/DiagramArrange", 
    "Wolfram/DiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c60e3d9c-e462-4fbc-bdee-9528726bdbb6"],
 " to insert identities, permutations and spiders."
}], "Notes",ExpressionUUID->"85fa4f9a-894a-4957-be46-eed0160e9ad7"],

