Cell[TextData[{
 Cell[BoxData[
  ButtonBox["DiagramGrid",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/DiagramGrid"]], 
  "InlineFormula",ExpressionUUID->"3ba86e7c-2062-4cdc-a627-ac9889de343f"],
 " is the multi-cell counterpart of ",
 Cell[BoxData[
  ButtonBox["DiagramGraphics",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/DiagramGraphics"]],
   "InlineFormula",ExpressionUUID->"3988c6c0-ad83-4efb-b101-e845b745a6b1"],
 ", which renders a diagram as a single opaque node. Use ",
 Cell[BoxData[
  ButtonBox["DiagramDecompose",
   BaseStyle->"Link",
   ButtonData->
    "paclet:Wolfram/DiagrammaticComputation/ref/DiagramDecompose"]], 
  "InlineFormula",ExpressionUUID->"c64f1220-ce21-4ed5-bd90-6fdf48c780b7"],
 " to recover the underlying expression tree."
}], "ExampleText",ExpressionUUID->"e8520487-e16e-4256-a82d-896fa4cffae2"]
}, Open  ]]
}, Open  ]],

