Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"8232b996-3152-4864-8ed1-c7213cf3d5d4"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DiagramMap"]], 
     "paclet:Wolfram/DiagrammaticComputation/ref/DiagramMap", 
     "Wolfram/DiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["f", "TI"], ",", " ", 
    StyleBox["d", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "4b170dcf-b4c2-4777-8eb4-9a03d63eafbc"],
 " ",
 "applies the function ",
 Cell[BoxData[
  FormBox[
   StyleBox["f", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "f7bf17c2-195b-4961-8b9f-9937736a423c"],
 " to every singleton subdiagram of ",
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "cb58b1b9-808e-4fa8-b440-58e3c944a7f4"],
 " and returns the rebuilt diagram.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"5677a1e7-b76c-4fcb-8306-8b25b33030c4"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DiagramMap"]], 
     "paclet:Wolfram/DiagrammaticComputation/ref/DiagramMap", 
     "Wolfram/DiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["f", "TI"], ",", " ", 
    StyleBox["d", "TI"], ",", " ", 
    StyleBox["lvl", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "514f06ec-a9d7-4451-9072-39264f96cb26"],
 " ",
 "descends at most ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"l", "v", "l"}], "TI"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"1fb8ca82-9081-4ffe-b64b-fb13b60924ef"],
 " levels, applying ",
 Cell[BoxData[
  FormBox[
   StyleBox["f", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "5b9624c2-a706-4098-8f79-d0967859ddcc"],
 " to whatever subdiagrams it reaches there.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"07bf6de3-99d5-4d05-b284-db6910ac22f0"],
 Cell[BoxData[
  RowBox[{
   RowBox[{"DiagramMap", "[", 
    StyleBox["f", "TI"], "]"}], "[", 
   StyleBox["d", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "33f2c901-bda4-4842-8199-6ee04ec986d0"],
 " ",
 "is the operator form."
}], "Usage",ExpressionUUID->"d38e856b-f3e7-4094-8f95-93f7ded56704"],

Cell[TextData[{
 "Compositions, products, sums and networks are traversed and rebuilt with \
their options; ",
 Cell[BoxData[
  FormBox[
   StyleBox["f", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "e58ccd5b-5d5c-48a0-8fae-3a516b6f0b5b"],
 " transforms the leaves and is expected to return something ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
