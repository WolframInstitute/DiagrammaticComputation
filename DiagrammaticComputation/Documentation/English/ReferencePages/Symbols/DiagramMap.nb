Cell[BoxData[
 RowBox[{"DiagramMap", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Diagram", "[", 
     RowBox[{
      RowBox[{"Style", "[", 
       RowBox[{
        RowBox[{"#", "[", "\"\<Expression\>\"", "]"}], ",", " ", "Red"}], 
       "]"}], ",", " ", "##2"}], "]"}], " ", "&"}], ",", "\n", "  ", 
   RowBox[{"DiagramComposition", "[", 
    RowBox[{
     RowBox[{"Diagram", "[", 
      RowBox[{"\"\<A\>\"", ",", " ", "b", ",", " ", "a"}], "]"}], ",", " ", 
     RowBox[{"Diagram", "[", 
      RowBox[{"\"\<B\>\"", ",", " ", "c", ",", " ", "b"}], "]"}]}], "]"}]}], 
  "\n", "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"e5ed6282-1a6d-4c21-96f3-551717bed407"],

