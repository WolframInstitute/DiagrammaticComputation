   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1fee02a3-5f98-4d92-a0e5-1b7849dfdab2"],
 " accepts."
}], "Notes",ExpressionUUID->"f533f0f4-b532-4855-9f3f-6329e00219e8"],

Cell[TextData[{
 "With a finite level, subtrees below the cutoff are passed to ",
