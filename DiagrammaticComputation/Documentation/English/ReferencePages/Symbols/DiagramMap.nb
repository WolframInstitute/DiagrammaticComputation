Cell[BoxData[
 RowBox[{"DiagramMap", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Diagram", "[", 
     RowBox[{
      RowBox[{"Style", "[", 
       RowBox[{
        RowBox[{"#", "[", "\"\<Expression\>\"", "]"}], ",", " ", "Red"}], 
       "]"}], ",", " ", "##2"}], "]"}], " ", "&"}], ",", "\n", "  ", 
   RowBox[{"DiagramComposition", "[", 
    RowBox[{
     RowBox[{"Diagram", "[", 
      RowBox[{"\"\<A\>\"", ",", " ", "b", ",", " ", "a"}], "]"}], ",", " ", 
     RowBox[{"Diagram", "[", 
      RowBox[{"\"\<B\>\"", ",", " ", "c", ",", " ", "b"}], "]"}]}], "]"}]}], 
  "\n", "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"b0ca11ff-e1dc-430f-8c08-fb03ccbc2410"],

