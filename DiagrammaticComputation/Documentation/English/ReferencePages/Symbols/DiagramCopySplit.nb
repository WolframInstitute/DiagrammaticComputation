Notebook[{

Cell[CellGroupData[{
Cell["DiagramCopySplit", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"021480a9-12d4-4d72-bb7d-3ace36a3c37a"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DiagramCopySplit"]], 
     "paclet:Wolfram/DiagrammaticComputation/ref/DiagramCopySplit", 
     "Wolfram/DiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["d", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "26104ab4-b73c-42d9-9b42-dbd8b4bcebf8"],
 " ",
 "rewrites a copy of ",
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "3a404e9e-d03f-4a2d-962d-c70b2679a3a8"],
 " into the composition of two parallel copies of ",
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "45a53c28-326d-46a0-bc1d-497e15babc1d"],
 ", distributing a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CopyDiagram"]], 
    "paclet:Wolfram/DiagrammaticComputation/ref/CopyDiagram", 
    "Wolfram/DiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "664449f6-edf3-4187-90cf-6a60ba3032b0"],
 " across ",
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d0942237-2071-47f6-b24a-7f3471812fcf"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"4ff4508a-ceee-41b9-a994-cc73fa7545ec"],

Cell[TextData[{
 "Encodes the law ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["copy", "TI"], " ", "\[SmallCircle]", " ", 
    StyleBox["d", "TI"]}], " ", "=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      StyleBox["d", "TI"], " ", "\[CircleTimes]", " ", 
      StyleBox["d", "TI"]}], ")"}], " ", "\[SmallCircle]", " ", 
    StyleBox["copy", "TI"]}]}]], "InlineFormula",ExpressionUUID->
  "2b32cd51-5d49-42a6-a86a-658cac961026"],
 " when ",
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "8bca6815-c489-43f0-8204-c1cacabf5f5f"],
 " is a ",
 StyleBox["natural", "TI"],
 " diagram (one whose meaning duplicates across the classical structure)."
}], "Notes",ExpressionUUID->"6d45a63c-4021-46db-bf04-de2b132fcc41"]
}, Open  ]],

