Notebook[{

Cell[CellGroupData[{
Cell["DiagramCopySplit", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"d857d5be-f497-4131-ae12-f07a54c917a5"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["DiagramCopySplit",
    BaseStyle->"Link",
    ButtonData->
     "paclet:Wolfram/DiagrammaticComputation/ref/DiagramCopySplit"], "[", 
   StyleBox["d", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "4bf00c8a-25d1-4bb6-84e7-b1d9eeb10afd"],
 " ",
 "rewrites a copy of ",
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "b3c50591-6d5a-4a90-bb78-b793f6ac48a2"],
 " into the composition of two parallel copies of ",
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "022fe78c-951b-48aa-964e-e178c38f0f6f"],
 ", distributing a ",
 Cell[BoxData[
  ButtonBox["CopyDiagram",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/CopyDiagram"]], 
  "InlineFormula",ExpressionUUID->"5ce1bccd-28c1-4154-94aa-d862b239c6e7"],
 " across ",
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d0597f4f-295a-4ec5-927d-b831189528f0"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"a467ea8c-181c-423c-9a9e-eeb555ffcfb8"],

Cell[TextData[{
 "Encodes the law ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    StyleBox["copy", "TI"], " ", "\[SmallCircle]", " ", 
    StyleBox["d", "TI"]}], " ", "=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      StyleBox["d", "TI"], " ", "\[CircleTimes]", " ", 
      StyleBox["d", "TI"]}], ")"}], " ", "\[SmallCircle]", " ", 
    StyleBox["copy", "TI"]}]}]], "InlineFormula",ExpressionUUID->
  "af38cd7b-436c-401a-b0e8-2934b5b22160"],
 " when ",
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "4695db18-51ae-4470-8515-d75f93f7f9e7"],
 " is a ",
 StyleBox["natural", "TI"],
 " diagram (one whose meaning duplicates across the classical structure)."
}], "Notes",ExpressionUUID->"2dffd846-c8e0-4c20-b012-2df11f5fb71a"]
}, Open  ]],

