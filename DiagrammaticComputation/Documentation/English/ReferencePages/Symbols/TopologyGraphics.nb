 "computes the FeynArts graphics data (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramGraphics"]], 
    "paclet:Wolfram/DiagrammaticComputation/ref/DiagramGraphics", 
    "Wolfram/DiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "cc19a863-6e63-4296-b547-5feb26418e55"],
