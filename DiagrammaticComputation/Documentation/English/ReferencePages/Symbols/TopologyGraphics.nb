Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"6a834b4d-586c-4b01-a95d-d6e0e2ee25f7"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["TopologyGraphics"]], 
     "paclet:Wolfram/DiagrammaticComputation/ref/TopologyGraphics", 
     "Wolfram/DiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["topology", "TI"], " ", "->", " ", 
    StyleBox["insertions", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "74761818-3d15-4811-97bc-6160016ceab6"],
