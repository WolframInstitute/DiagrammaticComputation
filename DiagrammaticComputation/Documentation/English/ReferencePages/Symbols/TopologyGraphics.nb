Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"d7de5924-f2e3-4b25-8a30-e84792c66a12"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["TopologyGraphics"]], 
     "paclet:WolframDiagrammaticComputation/ref/TopologyGraphics", 
     "WolframDiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["topology", "TI"], " ", "->", " ", 
    StyleBox["insertions", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "918ab0ca-dbf9-48b8-b3fb-0989f3561b19"],
