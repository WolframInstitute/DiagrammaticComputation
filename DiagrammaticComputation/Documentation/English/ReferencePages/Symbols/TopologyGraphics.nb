   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b28cc0df-dd9b-4100-8903-2299ee338a5f"],
 " wraps this and renders the result to ordinary ",
 Cell[BoxData[
  TemplateBox[{
