Cell[BoxData[
 RowBox[{"DiagramReplaceList", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"DiagramComposition", "[", 
    RowBox[{
     RowBox[{"Diagram", "[", 
      RowBox[{"\"\<A\>\"", ",", " ", "b", ",", " ", "a"}], "]"}], ",", " ", 
     RowBox[{"Diagram", "[", 
      RowBox[{"\"\<A\>\"", ",", " ", "c", ",", " ", "b"}], "]"}]}], "]"}], ",",
    "\n", "  ", 
   RowBox[{
    RowBox[{"Diagram", "[", 
     RowBox[{"\"\<A\>\"", ",", " ", "\[FormalY]", ",", " ", "\[FormalX]"}], 
     "]"}], " ", "->", " ", 
    RowBox[{"Diagram", "[", 
     RowBox[{"\"\<X\>\"", ",", " ", "\[FormalY]", ",", " ", "\[FormalX]"}], 
     "]"}]}]}], "\n", "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"b6be2c6c-7ca4-4d13-bd85-e5849045fd59"],

