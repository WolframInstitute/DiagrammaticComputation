Cell["DiagramGraphSimplify", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"8d84ff4e-1703-4971-a0c9-f938c9738291"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["DiagramGraphSimplify",
    BaseStyle->"Link",
    ButtonData->
     "paclet:Wolfram/DiagrammaticComputation/ref/DiagramGraphSimplify"], "[", 
   
   StyleBox["d", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "2ea00af4-de63-47a6-9c64-6795fa8d1087"],
 " ",
 "simplifies the underlying port graph of the diagram ",
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "75ba1887-9ff8-4624-93e0-e866ad0661e3"],
 " by contracting redundant wires and merging spiders.",
 "\n"
}], "Usage",ExpressionUUID->"ec039494-a43c-41ba-b4b6-7930a411e7e6"],

Cell[TextData[{
 "Operates on the graph view of a diagram (see ",
 Cell[BoxData[
  ButtonBox["DiagramsPortGraph",
   BaseStyle->"Link",
   ButtonData->
    "paclet:Wolfram/DiagrammaticComputation/ref/DiagramsPortGraph"]], 
  "InlineFormula",ExpressionUUID->"c4395dc7-c193-4113-b107-a7f8743fffba"],
 ") rather than its expression structure. Use after ",
 Cell[BoxData[
  ButtonBox["ToDiagramNetwork",
   BaseStyle->"Link",
   ButtonData->
    "paclet:Wolfram/DiagrammaticComputation/ref/ToDiagramNetwork"]], 
  "InlineFormula",ExpressionUUID->"d3f0384a-ac41-4fc6-b5aa-823d6a3a798c"],
 " to clean up redundant connections."
}], "Notes",ExpressionUUID->"1eddcd1a-4108-4fc2-981a-175240c1e7fc"],

Cell[TextData[{
 "The expression-level analogue is ",
 Cell[BoxData[
  ButtonBox["SimplifyDiagram",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/SimplifyDiagram"]],
   "InlineFormula",ExpressionUUID->"5a9ea96c-06a5-4766-84b8-b6eedebb328c"],
 "."
}], "Notes",ExpressionUUID->"bb9eeb7c-dc54-4b09-b6e1-d958704f6e1e"]
}, Open  ]],

