Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"601318f8-8e4a-4b4d-af65-fe50c5f976ac"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DiagramGraphSimplify"]], 
     "paclet:WolframDiagrammaticComputation/ref/DiagramGraphSimplify", 
     "WolframDiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["d", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "59e91ce9-f826-4abb-9eb1-43c225adadee"],
 " ",
 "simplifies the underlying port graph of the diagram ",
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "98664d3b-48ec-4412-9eb3-74a1059bade8"],
 " by contracting redundant wires and merging spiders.",
 "\n"
}], "Usage",ExpressionUUID->"fee21447-9125-4f09-a5e0-d9048d472eb4"],

Cell[TextData[{
 "Operates on the graph view of a diagram (see ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramsPortGraph"]], 
    "paclet:WolframDiagrammaticComputation/ref/DiagramsPortGraph", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "43dde131-7d2c-4782-b76d-eab869c2f126"],
 ") rather than its expression structure. Use after ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ToDiagramNetwork"]], 
    "paclet:WolframDiagrammaticComputation/ref/ToDiagramNetwork", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6740af02-2986-4f77-8665-7b2bcf6ecc48"],
 " to clean up redundant connections."
}], "Notes",ExpressionUUID->"ec0389db-b6f1-4f9d-9296-238f829e5e69"],

Cell[TextData[{
 "The expression-level analogue is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SimplifyDiagram"]], 
    "paclet:WolframDiagrammaticComputation/ref/SimplifyDiagram", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "00ee0a74-f9d7-47a8-8558-f26c2d157b13"],
 "."
}], "Notes",ExpressionUUID->"1d728905-ad5e-446c-9545-6b668e6ce374"]
