Cell[CellGroupData[{
Cell["DiagramGraphSimplify", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"a952575d-f6f0-467a-a69e-f88e60b676d0"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DiagramGraphSimplify"]], 
     "paclet:Wolfram/DiagrammaticComputation/ref/DiagramGraphSimplify", 
     "Wolfram/DiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["g", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "71dc5fa1-0e73-4216-b626-2976fd7c0d94"],
 " ",
 "simplifies a diagram graph ",
 Cell[BoxData[
  FormBox[
   StyleBox["g", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d0c6a123-2565-42b9-963e-ddb677f16723"],
 " by deleting wire-shaped vertices and reconnecting the edges that passed \
through them.",
 "\n"
}], "Usage",ExpressionUUID->"66332520-f1b4-4d29-99ff-46fe25a56496"],

Cell[TextData[{
 "The argument is a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Graph"]], "paclet:ref/Graph"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d89c117b-faf5-4e26-99fe-0e1ebb801118"],
 " whose vertices carry ",
 Cell[BoxData["\"\<Diagram\>\""], "InlineFormula",ExpressionUUID->
  "cc47765c-c663-484e-9841-9c0758b6123e"],
 " annotations \[LongDash] the form produced by a diagram's ",
 Cell[BoxData["\"\<Graph\>\""], "InlineFormula",ExpressionUUID->
  "5a647997-12e6-43cb-bb48-5f3023c82ceb"],
 " property."
}], "Notes",ExpressionUUID->"16b92311-5d84-4889-b962-e82f8a561d37"],

Cell[TextData[{
 "Vertices whose diagram is empty, or whose shape is a pure wire bundle (",
 Cell[BoxData[
  RowBox[{"\"\<Wires\>\"", "[", "\[Ellipsis]", "]"}]], "InlineFormula",
  ExpressionUUID->"6f33fc49-fac5-4f67-a706-6dd52a9a08e5"],
 " \[LongDash] identities, permutations), are removed; their incoming and \
outgoing edges are joined according to the wire connectivity."
}], "Notes",ExpressionUUID->"7b333304-8ecc-49bc-9acb-6aef58a92aa0"],

Cell[TextData[{
 "This is the graph-level engine behind a diagram's ",
 Cell[BoxData["\"\<Simplify\>\""], "InlineFormula",ExpressionUUID->
  "dcb88663-570c-4830-bd18-90d0c2a4a29b"],
 " option; the diagram-level counterpart is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SimplifyDiagram"]], 
    "paclet:Wolfram/DiagrammaticComputation/ref/SimplifyDiagram", 
    "Wolfram/DiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e9790c45-2790-4689-b152-0f3fa1c32912"],
 "."
}], "Notes",ExpressionUUID->"9037ed74-47a8-49ca-9f62-3d8e8e2d108e"]
}, Open  ]],

