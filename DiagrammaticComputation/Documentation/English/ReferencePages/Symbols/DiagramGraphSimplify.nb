Cell[BoxData[
 RowBox[{"g", " ", "=", " ", 
  RowBox[{
   RowBox[{"DiagramComposition", "[", 
    RowBox[{
     RowBox[{"IdentityDiagram", "[", "a", "]"}], ",", " ", 
     RowBox[{"Diagram", "[", 
      RowBox[{"\"\<A\>\"", ",", " ", "b", ",", " ", "a"}], "]"}]}], "]"}], 
