Cell["Build a sum of two ports:", "ExampleText",ExpressionUUID->"6a784a2c-119a-4668-93ff-20956c329cbd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Port", "[", 
  RowBox[{"a", " ", "\[CirclePlus]", " ", "b"}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"f57eb276-3cbf-422e-a488-86afb01cdbc8"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{
   TagBox["a",
    HoldForm], "\[CirclePlus]", 
   TagBox["b",
    HoldForm]}],
  Wolfram`DiagrammaticComputation`Port`Port[<|
   "Expression" :> Wolfram`DiagrammaticComputation`Port`PortSum[
      Wolfram`DiagrammaticComputation`Port`Port[<|
       "Expression" :> 
        Wolfram`DiagrammaticComputation`Diagram`Rewriting`Rules`a, "NeutralQ" -> 
        False, "Tags" -> {}, "Type" -> \[FormalCapitalT]|>], 
      Wolfram`DiagrammaticComputation`Port`Port[<|
       "Expression" :> 
        Wolfram`DiagrammaticComputation`Diagram`Rewriting`Rules`b, "NeutralQ" -> 
        False, "Tags" -> {}, "Type" -> \[FormalCapitalT]|>]], "NeutralQ" -> 
    False, "Tags" -> {}, "Type" -> 
    CirclePlus[\[FormalCapitalT], \[FormalCapitalT]]|>],
  Tooltip->
   RowBox[{"\[FormalCapitalT]", "\[CirclePlus]", 
     "\[FormalCapitalT]"}]]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"7ca02027-286e-4371-a504-0b720e111ea8"]
}, Open  ]],

