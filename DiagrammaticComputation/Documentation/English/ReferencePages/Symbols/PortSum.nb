Notebook[{

Cell[CellGroupData[{
Cell["PortSum", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"c1da1296-bf06-4c00-91f9-1b842e657687"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["PortSum",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/PortSum"], "[", 
   RowBox[{
    SubscriptBox[
     StyleBox["p", "TI"], 
     StyleBox["1", "TR"]], ",", " ", 
    SubscriptBox[
     StyleBox["p", "TI"], 
     StyleBox["2", "TR"]], ",", " ", "\[Ellipsis]"}], "]"}]], "InlineFormula",
  ExpressionUUID->"3cf1916d-d9f1-4af0-8c66-bce379aaad39"],
 " ",
 "represents the direct sum of the ports ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["p", "TI"], 
    StyleBox["i", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d6fb64f1-52f2-423c-ba40-b46a9b85b40e"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"c08e2553-ebda-4976-be2f-6df8e66ba6f1"],

Cell[TextData[{
 "The sum of ports is again a port whose type is the ",
 Cell[BoxData[
  ButtonBox["CirclePlus",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/CirclePlus"]], "InlineFormula",ExpressionUUID->
  "0d7e6b9e-4a4d-4b74-9173-01679ce1793f"],
 " of the component types."
}], "Notes",ExpressionUUID->"de17bd35-cf21-4ec4-a3cf-afeabb874df9"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["PortSum",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/PortSum"]], 
  "InlineFormula",ExpressionUUID->"518461cf-d027-4488-9711-b5626225c71c"],
 " is associative; the unit is the zero port ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Port",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/Port"], 
   "[", "\"\<0\>\"", "]"}]], "InlineFormula",ExpressionUUID->
  "495b8d7b-79bd-4a4a-a9ed-5b7234f40087"],
 "."
}], "Notes",ExpressionUUID->"bfa9a644-2297-437f-b907-798fc57daca9"],

Cell[TextData[{
 "The infix shorthand ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["p", "TI"], 
    StyleBox["1", "TR"]], " ", "\[CirclePlus]", " ", 
   SubscriptBox[
    StyleBox["p", "TI"], 
    StyleBox["2", "TR"]]}]], "InlineFormula",ExpressionUUID->
  "aa88aa70-26aa-408a-9aff-bfe895e89905"],
 " evaluated inside ",
 Cell[BoxData[
  ButtonBox["Port",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/Port"]], 
  "InlineFormula",ExpressionUUID->"0d07d607-9f89-4a8f-ab08-5ea097f6e331"],
 " produces a ",
 Cell[BoxData[
  ButtonBox["PortSum",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/PortSum"]], 
  "InlineFormula",ExpressionUUID->"9ce64333-8684-44ac-b0de-4ba8995dd846"],
 "."
}], "Notes",ExpressionUUID->"e8985312-a09f-4bd9-878e-0c2df25ea31e"]
}, Open  ]],

