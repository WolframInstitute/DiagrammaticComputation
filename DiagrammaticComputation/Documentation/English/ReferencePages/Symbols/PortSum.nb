Cell["Build a sum of two ports:", "ExampleText",ExpressionUUID->"946f08bb-2e6d-4044-b3aa-bebaba1d637e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Port", "[", 
  RowBox[{"a", " ", "\[CirclePlus]", " ", "b"}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"817c601c-a29a-4f24-ba9d-4a52c917cb10"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{
   TagBox["a",
    HoldForm], "\[CirclePlus]", 
   TagBox["b",
    HoldForm]}],
  Wolfram`DiagrammaticComputation`Port`Port[<|
   "Expression" :> Wolfram`DiagrammaticComputation`Port`PortSum[
      Wolfram`DiagrammaticComputation`Port`Port[<|
       "Expression" :> FunctionRepository`$955258636fa042ac87af26c7567e2d7f`a,
         "NeutralQ" -> False, "Tags" -> {}, "Type" -> \[FormalCapitalT]|>], 
      Wolfram`DiagrammaticComputation`Port`Port[<|
       "Expression" :> FunctionRepository`$955258636fa042ac87af26c7567e2d7f`b,
         "NeutralQ" -> False, "Tags" -> {}, "Type" -> \[FormalCapitalT]|>]], 
    "NeutralQ" -> False, "Tags" -> {}, "Type" -> 
    CirclePlus[\[FormalCapitalT], \[FormalCapitalT]]|>],
  Tooltip->
   RowBox[{"\[FormalCapitalT]", "\[CirclePlus]", 
     "\[FormalCapitalT]"}]]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"cf61cbb1-4eba-4478-a7b8-b8f55ec05ba7"]
}, Open  ]],

