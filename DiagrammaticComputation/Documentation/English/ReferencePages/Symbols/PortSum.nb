Cell["Build a sum of two ports:", "ExampleText",ExpressionUUID->"2c9922f1-f36d-42f2-9d2d-10bb36f5c5dd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Port", "[", 
  RowBox[{"a", " ", "\[CirclePlus]", " ", "b"}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"3e11954f-d0ea-4520-8534-113de70454b0"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{
   TagBox["a",
    HoldForm], "\[CirclePlus]", 
   TagBox["b",
    HoldForm]}],
  Wolfram`DiagrammaticComputation`Port`Port[<|
   "Expression" :> Wolfram`DiagrammaticComputation`Port`PortSum[
      Wolfram`DiagrammaticComputation`Port`Port[<|
       "Expression" :> MTNB$12sboy17b9mgy`a, "NeutralQ" -> False, 
        "Tags" -> {}, "Type" -> \[FormalCapitalT]|>], 
      Wolfram`DiagrammaticComputation`Port`Port[<|
       "Expression" :> MTNB$12sboy17b9mgy`b, "NeutralQ" -> False, 
        "Tags" -> {}, "Type" -> \[FormalCapitalT]|>]], "NeutralQ" -> False, 
    "Tags" -> {}, "Type" -> 
    CirclePlus[\[FormalCapitalT], \[FormalCapitalT]]|>],
  Tooltip->
   RowBox[{"\[FormalCapitalT]", "\[CirclePlus]", 
     "\[FormalCapitalT]"}]]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"eb40367e-ca85-4a18-8175-52c44141c36b"]
}, Open  ]],

