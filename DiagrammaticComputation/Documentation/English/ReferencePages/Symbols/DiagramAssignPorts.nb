Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"65489476-8a34-43a9-95c6-264d4a9a2385"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["DiagramAssignPorts",
    BaseStyle->"Link",
    ButtonData->
     "paclet:Wolfram/DiagrammaticComputation/ref/DiagramAssignPorts"], "[", 
   RowBox[{
    StyleBox["d", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["i", "TI"], 
       StyleBox["1", "TR"]], ",", " ", "\[Ellipsis]"}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["o", "TI"], 
       StyleBox["1", "TR"]], ",", " ", "\[Ellipsis]"}], "}"}]}], "]"}]], 
  "InlineFormula",ExpressionUUID->"9009fc54-8006-4200-933b-d80848582fd5"],
 " ",
 "assigns the explicit input ports ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["i", "TI"], "1"], ",", 
    RowBox[{"\[AHat]", "\[Hyphen]", "\.a6"}]}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"c0ad1488-1c2c-4e03-8da5-e4a8edd5fb98"],
 " and output ports ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["o", "TI"], "1"], ",", 
    RowBox[{"\[AHat]", "\[Hyphen]", "\.a6"}]}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"9cd04019-8d7e-4928-8552-0abb334f62ad"],
 " to the diagram ",
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d313a0b0-8b7f-4266-aad9-fff5e05b01fd"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"041797d9-2213-4374-adbe-b210b0e30f64"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["DiagramAssignPorts",
    BaseStyle->"Link",
    ButtonData->
     "paclet:Wolfram/DiagrammaticComputation/ref/DiagramAssignPorts"], "[", 
   RowBox[{
    StyleBox["d", "TI"], ",", " ", 
    StyleBox["rules", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "a0d64f4e-a13d-4374-826a-0f67856f71dc"],
 " ",
 "renames ports according to a list of ",
 Cell[BoxData[
  RowBox[{
   StyleBox["oldName", "TI"], " ", "->", " ", 
   StyleBox["newName", "TI"]}]], "InlineFormula",ExpressionUUID->
  "2a95ecce-6698-4ef7-a66f-c024072f9eeb"],
 " rules."
}], "Usage",ExpressionUUID->"afe04f9b-f570-480a-bf9b-401be590cb7c"],

Cell["\<\
Useful when grafting a diagram into a network with specific port-name \
conventions.\
\>", "Notes",ExpressionUUID->"99623376-5e65-4df0-b56d-e04dd76edc45"],

Cell["\<\
The number of new input and output ports must match the existing arities.\
\>", "Notes",ExpressionUUID->"3a158faf-8dd9-422c-a416-84949c0200b1"]
}, Open  ]],

