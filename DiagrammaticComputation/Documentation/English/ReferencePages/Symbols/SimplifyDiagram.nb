Cell[CellGroupData[{
Cell["SimplifyDiagram", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"3b3ba277-5b3c-4ed1-ab3a-6b947a4286c1"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SimplifyDiagram",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/SimplifyDiagram"],
    "[", 
   StyleBox["d", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "1fafd712-98e5-4e18-8ab3-b22b9cbe365d"],
 " ",
 "simplifies the diagram ",
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "3e6165e0-74fa-4ec8-abfc-d9d864d970c2"],
 " by absorbing identity wires and other trivially-redundant structure.",
 "\n"
}], "Usage",ExpressionUUID->"7e9ea70b-8ce6-46bd-a4f5-82d9d4c5e2a9"],

Cell[TextData[{
 "Removes ",
 Cell[BoxData[
  ButtonBox["IdentityDiagram",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/IdentityDiagram"]],
   "InlineFormula",ExpressionUUID->"a3f68268-cea7-4fcd-979b-38d6480c82d7"],
 " wires from compositions and contracts unary spiders, leaving a \
structurally simpler diagram with the same meaning."
}], "Notes",ExpressionUUID->"08af0efd-c67f-46d3-ad8a-bdb9c7793ac8"],

Cell[TextData[{
 "Does ",
 StyleBox["not", "TI"],
 " apply rewriting rules \[LongDash] those go through ",
