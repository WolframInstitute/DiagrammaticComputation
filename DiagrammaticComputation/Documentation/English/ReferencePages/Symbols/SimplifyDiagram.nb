 "simplifies the diagram ",
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "c9bb48de-0680-4569-955b-325c28526b66"],
 " by absorbing identity wires and other trivially-redundant structure.",
 "\n"
}], "Usage",ExpressionUUID->"25cb4d53-7827-49bb-8586-d9c737d06124"],

Cell[TextData[{
 "Removes ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["IdentityDiagram"]], 
    "paclet:Wolfram/DiagrammaticComputation/ref/IdentityDiagram", 
    "Wolfram/DiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "12a759ed-7729-4f9b-88e0-ec99d9e5b69e"],
 " wires from compositions and contracts unary spiders, leaving a \
structurally simpler diagram with the same meaning."
}], "Notes",ExpressionUUID->"b39586fb-b468-4787-b17a-eae63c2f9c4c"],

