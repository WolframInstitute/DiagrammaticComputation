Cell[CellGroupData[{
Cell["PortNeutral", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"7eecd2a1-5efc-49c0-9e1e-1f66a2274ad8"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["PortNeutral"]], 
     "paclet:Wolfram/DiagrammaticComputation/ref/PortNeutral", 
     "Wolfram/DiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["p", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "711bdc4c-0d7c-4bc0-be0e-386ee416d8bb"],
 " ",
 "marks the port ",
 Cell[BoxData[
  FormBox[
   StyleBox["p", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "fb9d6aff-6b9c-4d77-aa51-a0dab38e975e"],
 " as ",
 StyleBox["neutral", "TI"],
 " \[LongDash] a unit-like port that acts as the identity under \
composition.",
 "\n"
}], "Usage",ExpressionUUID->"1f277596-899e-43d3-9fc3-2f412d51de97"],

Cell["\<\
A neutral port is invisible to composition: connecting a diagram to a neutral \
port leaves it unchanged.\
\>", "Notes",ExpressionUUID->"0c8c6cb3-0f4e-41c2-bed3-24bddcc12dd0"],

Cell["\<\
This is useful for marking \"ambient\" inputs (e.g. a constant context) that \
should not consume external wires.\
\>", "Notes",ExpressionUUID->"5a236273-7ef0-4862-9690-28672107cdd6"],

Cell[TextData[{
 "Neutrality is recorded as the ",
 Cell[BoxData["\"\<NeutralQ\>\""], "InlineFormula",ExpressionUUID->
  "efcce9f6-d622-47e5-a7b8-a716dc66edb4"],
 " option of the underlying ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Port"]], "paclet:Wolfram/DiagrammaticComputation/ref/Port", 
    "Wolfram/DiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "857ee7de-2d70-4f98-883d-2616918842ab"],
 "."
}], "Notes",ExpressionUUID->"7dfa25eb-5747-4b4a-a988-31628e042ce1"]
}, Open  ]],

