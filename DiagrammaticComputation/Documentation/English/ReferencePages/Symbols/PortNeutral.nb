Cell["PortNeutral", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"4b631cd7-ee08-4e3e-8f9f-d8dd907ab31e"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["PortNeutral"]], 
     "paclet:WolframDiagrammaticComputation/ref/PortNeutral", 
     "WolframDiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["p", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "73dd04af-9b2d-47b9-8532-946399ba83f4"],
 " ",
 "marks the port ",
 Cell[BoxData[
  FormBox[
   StyleBox["p", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "5a831d00-dc53-4a6b-833e-798745ab8ea7"],
 " as ",
 StyleBox["neutral", "TI"],
 " \[LongDash] a unit-like port that acts as the identity under \
composition.",
 "\n"
}], "Usage",ExpressionUUID->"d29ff9c2-8b08-46a4-a208-46a6474370c3"],

Cell["\<\
A neutral port is invisible to composition: connecting a diagram to a neutral \
port leaves it unchanged.\
\>", "Notes",ExpressionUUID->"52c20cb3-6c62-4cd0-bdbb-4c6c63f61f28"],

Cell["\<\
This is useful for marking \"ambient\" inputs (e.g. a constant context) that \
should not consume external wires.\
\>", "Notes",ExpressionUUID->"f982ed89-c445-4f61-a4d0-dc959012f661"],

Cell[TextData[{
 "Neutrality is recorded as the ",
 Cell[BoxData["\"\<NeutralQ\>\""], "InlineFormula",ExpressionUUID->
  "dc0970e0-70a9-4ff1-a728-9c220b963aa5"],
 " option of the underlying ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Port"]], "paclet:WolframDiagrammaticComputation/ref/Port", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7075637e-1424-4780-8ba5-15a70b776600"],
 "."
}], "Notes",ExpressionUUID->"ca70ce08-9eda-44ab-a21e-db1681353b97"]
}, Open  ]],

