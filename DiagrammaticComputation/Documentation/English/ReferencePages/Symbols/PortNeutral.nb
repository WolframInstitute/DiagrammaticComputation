Cell[CellGroupData[{
Cell["PortNeutral", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"b4d3f90d-bd7c-484f-9db3-636953c9f6e4"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["PortNeutral",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/PortNeutral"], "[", 
   StyleBox["p", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "b164639f-0a81-404e-afcb-f9fd1b3ec939"],
 " ",
 "marks the port ",
 Cell[BoxData[
  FormBox[
   StyleBox["p", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "8d871649-8eec-42eb-8089-613a6e8426b9"],
 " as ",
 StyleBox["neutral", "TI"],
 " \[LongDash] a unit-like port that acts as the identity under \
composition.",
 "\n"
}], "Usage",ExpressionUUID->"38331e99-964e-4b91-b2bd-55b0aa41e971"],

Cell["\<\
A neutral port is invisible to composition: connecting a diagram to a neutral \
port leaves it unchanged.\
\>", "Notes",ExpressionUUID->"1669c888-5329-4ab8-a994-50c2854d86f2"],

Cell["\<\
This is useful for marking \"ambient\" inputs (e.g. a constant context) that \
should not consume external wires.\
\>", "Notes",ExpressionUUID->"017bad22-fc30-4d9a-91a8-076b698ad623"],

Cell[TextData[{
 "Neutrality is recorded as the ",
 Cell[BoxData["\"\<NeutralQ\>\""], "InlineFormula",ExpressionUUID->
  "6f02e26d-3970-4eb5-8923-ec5e9bc1aff2"],
 " option of the underlying ",
 Cell[BoxData[
  ButtonBox["Port",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/Port"]], 
  "InlineFormula",ExpressionUUID->"ba9e7003-645f-4eb0-8728-1afa443d83ee"],
 "."
}], "Notes",ExpressionUUID->"d994034b-6095-4eb4-8a6e-f9993f826741"]
}, Open  ]],

