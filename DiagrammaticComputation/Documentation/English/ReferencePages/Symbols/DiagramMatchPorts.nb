Cell["Align ports of a composition:", "ExampleText",ExpressionUUID->"1272ce39-d197-41d4-ae22-cc60b027e468"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"DiagramMatchPorts", "[", 
  RowBox[{"DiagramComposition", "[", 
   RowBox[{
    RowBox[{"Diagram", "[", 
     RowBox[{"\"\<A\>\"", ",", " ", "b", ",", " ", "a"}], "]"}], ",", " ", 
    RowBox[{"Diagram", "[", 
     RowBox[{"\"\<B\>\"", ",", " ", "c", ",", " ", "b"}], "]"}]}], "]"}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"26cdd9a0-bcc2-4692-961d-e8be60c68b2f"],

Cell[BoxData[
 RowBox[{"Wolfram`DiagrammaticComputation`Diagram`Grid`DiagramMatchPorts", "[", 
  GraphicsBox[
   NamespaceBox["Diagram",
    DynamicModuleBox[{Typeset`d = HoldComplete[
      Wolfram`DiagrammaticComputation`Diagram`Diagram[<|
       "DiagramOptions" -> {
         "PortArrows" -> {{Automatic}, {Automatic}}, 
          "PortLabels" -> {{Automatic}, {Automatic}}}, "Expression" :> 
        Wolfram`DiagrammaticComputation`Diagram`DiagramComposition[
          
          Wolfram`DiagrammaticComputation`Diagram`Diagram[<|
           "DiagramOptions" -> {
             "PortArrows" -> {{Automatic}, {Automatic}}, 
              "PortLabels" -> {{Automatic}, {Automatic}}}, "Expression" :> 
            "A", "InputPorts" -> {
              
              Wolfram`DiagrammaticComputation`Port`Port[<|
               "Expression" :> 
                Wolfram`DiagrammaticComputation`Port`PortDual[
                 MTNB$wlat2sbt7zet`b], "NeutralQ" -> False, "Tags" -> {}, 
                "Type" -> SuperStar[\[FormalCapitalT]]|>]}, 
            "OutputPorts" -> {
              
              Wolfram`DiagrammaticComputation`Port`Port[<|
               "Expression" :> MTNB$wlat2sbt7zet`a, "NeutralQ" -> False, 
                "Tags" -> {}, "Type" -> \[FormalCapitalT]|>]}|>], 
          
          Wolfram`DiagrammaticComputation`Diagram`Diagram[<|
           "DiagramOptions" -> {
             "PortArrows" -> {{Automatic}, {Automatic}}, 
              "PortLabels" -> {{Automatic}, {Automatic}}}, "Expression" :> 
            "B", "InputPorts" -> {
              
              Wolfram`DiagrammaticComputation`Port`Port[<|
               "Expression" :> 
                Wolfram`DiagrammaticComputation`Port`PortDual[
                 MTNB$wlat2sbt7zet`c], "NeutralQ" -> False, "Tags" -> {}, 
                "Type" -> SuperStar[\[FormalCapitalT]]|>]}, 
            "OutputPorts" -> {
              
              Wolfram`DiagrammaticComputation`Port`Port[<|
               "Expression" :> MTNB$wlat2sbt7zet`b, "NeutralQ" -> False, 
                "Tags" -> {}, "Type" -> \[FormalCapitalT]|>]}|>]], 
        "InputPorts" -> {
          
          Wolfram`DiagrammaticComputation`Port`Port[<|
           "Expression" :> 
            Wolfram`DiagrammaticComputation`Port`PortDual[
             MTNB$wlat2sbt7zet`c], "NeutralQ" -> False, "Tags" -> {}, "Type" -> 
            SuperStar[\[FormalCapitalT]]|>]}, "OutputPorts" -> {
          
          Wolfram`DiagrammaticComputation`Port`Port[<|
           "Expression" :> MTNB$wlat2sbt7zet`a, "NeutralQ" -> False, 
            "Tags" -> {}, "Type" -> \[FormalCapitalT]|>]}|>]]}, {{
       {Arrowheads[Small], 
        {EdgeForm[{LightDarkSwitched[
          GrayLevel[0], 
          GrayLevel[1]], Opacity[0.5]}], FaceForm[LightDarkSwitched[
          RGBColor[0.952941188969422, 0.9529411889694224, 0.9529411889694221], 
          GrayLevel[0.62]]], 
         GeometricTransformationBox[
          RectangleBox[{0.5, 0.5}], {{{1., 0.}, {0., 1.}}, {0., 0.}}]}, {{}, {
          ArrowBox[{{1., 0.5}, {1., 0.25}}], InsetBox[
           InterpretationBox[
            TagBox["a",
             HoldForm],
            
            Wolfram`DiagrammaticComputation`Port`Port[<|
             "Expression" :> MTNB$wlat2sbt7zet`a, "NeutralQ" -> False, 
              "Tags" -> {}, "Type" -> \[FormalCapitalT]|>],
            Tooltip->"\[FormalCapitalT]"], {1., 0.125}]}}, 
        {LightDarkSwitched[
          GrayLevel[0], 
          GrayLevel[1]], InsetBox[
          TagBox["\<\"A\"\>",
           HoldForm], {1., 1.}]}}, 
       {Arrowheads[Small], 
        {EdgeForm[{LightDarkSwitched[
          GrayLevel[0], 
          GrayLevel[1]], Opacity[0.5]}], FaceForm[LightDarkSwitched[
          RGBColor[0.952941188969422, 0.9529411889694224, 0.9529411889694221], 
          GrayLevel[0.62]]], 
         GeometricTransformationBox[
          RectangleBox[{0.5, 2.5}], {{{1., 0.}, {0., 1.}}, {0., 0.}}]}, {{
          ArrowBox[{{1., 3.75}, {1., 3.5}}], InsetBox[
           InterpretationBox[
            TagBox["c",
             HoldForm],
            
            Wolfram`DiagrammaticComputation`Port`Port[<|
             "Expression" :> MTNB$wlat2sbt7zet`c, "NeutralQ" -> False, 
              "Tags" -> {}, "Type" -> \[FormalCapitalT]|>],
            Tooltip->"\[FormalCapitalT]"], {1., 3.875}]}, {}}, 
        {LightDarkSwitched[
          GrayLevel[0], 
          GrayLevel[1]], InsetBox[
          TagBox["\<\"B\"\>",
           HoldForm], {1., 3.}]}}}, 
      {Arrowheads[{{Small, 0.5}}], {}, 
       ArrowBox[
        BSplineCurveBox[{{1., 2.5}, {1., 2.25}, {1., 1.75}, {1., 1.5}}]], 
       InsetBox[
        TemplateBox[{"b"},
         "ClickToCopy"], {0.9, 2.}]}, {}, {}, 
      {EdgeForm[{LightDarkSwitched[
        GrayLevel[0], 
        GrayLevel[1]], Thickness[Tiny]}], FaceForm[None]}}]],
   BaseStyle->{
    GraphicsBoxOptions -> {ImageSize -> Medium}, 
     Wolfram`DiagrammaticComputation`Diagram`Private`GraphicsHighlightColor -> 
     RGBColor[1, 0, 1]},
   FormatType->StandardForm], "]"}]], "Output",
