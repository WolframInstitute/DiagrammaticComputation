   StyleBox["d", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "2ed4797a-48c0-47a4-a1e9-95480041a657"],
 " ",
 "aligns the ports of adjacent subdiagrams in a grid layout so that matching \
ports line up vertically.",
 "\n"
}], "Usage",ExpressionUUID->"5084e186-462f-4ff2-bf3f-045dbfce7d69"],

Cell[TextData[{
 "A grid-layout helper used by ",
 Cell[BoxData[
  ButtonBox["DiagramGrid",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/DiagramGrid"]], 
  "InlineFormula",ExpressionUUID->"943d755e-8587-4e0f-9b8e-27e890d8f8e8"],
 " to decide how wires are drawn between adjacent cells. Useful directly when \
constructing custom layouts."
}], "Notes",ExpressionUUID->"cee90ef2-c6f2-4dda-bdbc-6bb7637a8ece"]
}, Open  ]],

