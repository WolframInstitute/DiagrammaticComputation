 Cell["   ", "ModInfo",ExpressionUUID->"b90a1cbe-372e-4f0b-8b95-6a66038a0c1a"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["UntagPort",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/UntagPort"], "[", 
   
   RowBox[{
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["tag", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "034d9736-b5fa-466e-9c3d-af887cefe216"],
 " ",
 "strips a specific tag from the port."
}], "Usage",ExpressionUUID->"caae4788-290d-4569-8b15-51d5d6ace349"],

Cell[TextData[{
 "The inverse of ",
 Cell[BoxData[
  ButtonBox["TagPort",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/TagPort"]], 
  "InlineFormula",ExpressionUUID->"c93a2d6b-2815-4bd8-8600-fc3f7ba30bc7"],
 ": removes the entries set in the port's ",
 Cell[BoxData["\"\<Tags\>\""], "InlineFormula",ExpressionUUID->
  "d8c0698b-f89b-461c-8ded-4bcba6d2fe53"],
 " option."
}], "Notes",ExpressionUUID->"86d1f0f8-a688-4782-9cc2-8c15b8e1d2ce"],

Cell[TextData[{
 "Calling ",
 Cell[BoxData[
  ButtonBox["UntagPort",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/UntagPort"]], 
  "InlineFormula",ExpressionUUID->"b20f9f3d-44dc-4231-a67f-be8f1010f081"],
 " with no second argument clears the tag list entirely."
}], "Notes",ExpressionUUID->"4a709e70-ce8d-411f-a52f-e6a4b39957a3"]
