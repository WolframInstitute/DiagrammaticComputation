Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"UntagPort", "[", 
  RowBox[{"TagPort", "[", 
   RowBox[{
    RowBox[{"Port", "[", "a", "]"}], ",", " ", "\"\<input\>\""}], "]"}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"ff6af22d-f13c-4041-ab39-33cc6eb3b494"],

Cell[BoxData[
