Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"19506c1f-f4fa-42d5-8c3a-ab2e61f61b18"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["UntagPort",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/UntagPort"], "[", 
   
   StyleBox["p", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "0473559a-b2b1-4993-8ed0-044d178d978f"],
 " ",
 "strips all tag annotations from the port ",
 Cell[BoxData[
  FormBox[
   StyleBox["p", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "4ab4d1b9-178d-4645-a4b1-225f47bcce79"],
