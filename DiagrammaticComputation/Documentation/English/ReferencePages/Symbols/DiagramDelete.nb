Cell[TextData[{
 "Deletion does not break port matching; surrounding subdiagrams are \
reconnected as if the deleted piece had been replaced by an ",
 Cell[BoxData[
  ButtonBox["IdentityDiagram",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/IdentityDiagram"]],
   "InlineFormula",ExpressionUUID->"e1a0b195-5906-4b36-89f1-33660fc1b531"],
 " of matching ports."
}], "Notes",ExpressionUUID->"c465944c-6f14-49c9-8c7b-a3b57ca641c8"]
}, Open  ]],

