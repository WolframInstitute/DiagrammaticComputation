Cell["\<\
Drop the first stage of a composition; the remaining single stage normalizes \
to a plain diagram:\
\>", "ExampleText",ExpressionUUID->"091b7728-2d91-4eb4-9647-9f10c80a119f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"DiagramDelete", "[", 
  RowBox[{
   RowBox[{"DiagramComposition", "[", 
    RowBox[{
     RowBox[{"Diagram", "[", 
      RowBox[{"\"\<A\>\"", ",", " ", "b", ",", " ", "a"}], "]"}], ",", " ", 
     RowBox[{"Diagram", "[", 
      RowBox[{"\"\<B\>\"", ",", " ", "c", ",", " ", "b"}], "]"}]}], "]"}], ",",
    " ", 
   RowBox[{"{", "1", "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"5c7c54d3-1e9c-4c15-bd92-949c21422a7c"],

Cell[BoxData[
 GraphicsBox[
  NamespaceBox["Diagram",
   DynamicModuleBox[{Typeset`d = HoldComplete[
     Wolfram`DiagrammaticComputation`Diagram`Diagram[<|
      "DiagramOptions" -> {
        "PortArrows" -> {{Automatic}, {Automatic}}, 
         "PortLabels" -> {{Automatic}, {Automatic}}}, "Expression" :> "B", 
       "InputPorts" -> {
         Wolfram`DiagrammaticComputation`Port`Port[<|
          "Expression" :> 
           Wolfram`DiagrammaticComputation`Port`PortDual[
            Wolfram`DiagrammaticComputation`Diagram`Rewriting`Rules`c], 
           "NeutralQ" -> False, "Tags" -> {}, "Type" -> 
           SuperStar[\[FormalCapitalT]]|>]}, "OutputPorts" -> {
         Wolfram`DiagrammaticComputation`Port`Port[<|
          "Expression" :> 
           Wolfram`DiagrammaticComputation`Diagram`Rewriting`Rules`b, 
           "NeutralQ" -> False, "Tags" -> {}, 
           "Type" -> \[FormalCapitalT]|>]}|>]]}, 
    {Arrowheads[Small], 
     {EdgeForm[{LightDarkSwitched[
       GrayLevel[0], 
       GrayLevel[1]], Opacity[0.5]}], FaceForm[LightDarkSwitched[
       RGBColor[0.952941188969422, 0.9529411889694224, 0.9529411889694221], 
       GrayLevel[0.62]]], 
      GeometricTransformationBox[
       RectangleBox[
        NCache[{Rational[-1, 2], Rational[-1, 2]}, {-0.5, -0.5}]], {{{1, 0}, {
        0, 1}}, {0, 0}}]}, {{ArrowBox[{{0., 0.75}, {0., 0.5}}], InsetBox[
        InterpretationBox[
         TagBox["c",
          HoldForm],
         Wolfram`DiagrammaticComputation`Port`Port[<|
          "Expression" :> 
           Wolfram`DiagrammaticComputation`Diagram`Rewriting`Rules`c, 
           "NeutralQ" -> False, "Tags" -> {}, "Type" -> \[FormalCapitalT]|>],
         Tooltip->"\[FormalCapitalT]"], {0., 0.875}]}, {
       ArrowBox[{{0., -0.5}, {0., -0.75}}], InsetBox[
        InterpretationBox[
         TagBox["b",
          HoldForm],
         Wolfram`DiagrammaticComputation`Port`Port[<|
          "Expression" :> 
           Wolfram`DiagrammaticComputation`Diagram`Rewriting`Rules`b, 
           "NeutralQ" -> False, "Tags" -> {}, "Type" -> \[FormalCapitalT]|>],
         Tooltip->"\[FormalCapitalT]"], {0., -0.875}]}}, 
     {LightDarkSwitched[
       GrayLevel[0], 
       GrayLevel[1]], InsetBox[
       TagBox["\<\"B\"\>",
        HoldForm], {0, 0}]}}]],
  BaseStyle->{
   GraphicsBoxOptions -> {ImageSize -> Tiny}, 
    Wolfram`DiagrammaticComputation`Diagram`Private`GraphicsHighlightColor -> 
    RGBColor[1, 0, 1]},
  FormatType->StandardForm]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"79335687-9a31-4e00-b974-362ce91301ee"]
}, Open  ]],

Cell["Delete one factor inside a nested product:", "ExampleText",ExpressionUUID->"73ef71f9-7f67-4a5a-b475-f5d19ffd51fe"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"DiagramDelete", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"Diagram", "[", 
    RowBox[{
     RowBox[{"DiagramProduct", "[", 
      RowBox[{
       RowBox[{"Diagram", "[", 
        RowBox[{"\"\<A\>\"", ",", " ", "a", ",", " ", "c"}], "]"}], ",", " ", 
       
       RowBox[{"Diagram", "[", 
        RowBox[{"\"\<B\>\"", ",", " ", "b"}], "]"}]}], "]"}], " ", "/*", " ", 
     
     RowBox[{"Diagram", "[", 
      RowBox[{"\"\<C\>\"", ",", " ", 
       RowBox[{"{", 
        RowBox[{"c", ",", " ", "b"}], "}"}], ",", " ", "e"}], "]"}]}], "]"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"2", ",", " ", "1"}], "}"}]}], "\n", "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"032f2796-0e8d-4804-b1c7-201bc9d901f2"],

