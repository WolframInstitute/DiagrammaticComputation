Cell[TextData[{
 "Deletion does not break port matching; surrounding subdiagrams are \
reconnected as if the deleted piece had been replaced by an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["IdentityDiagram"]], 
    "paclet:WolframDiagrammaticComputation/ref/IdentityDiagram", 
