Cell[CellGroupData[{
Cell["TopologyGraph", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"efab166a-ccbe-4e0e-80fd-8b0e3e7679b7"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["TopologyGraph"]], 
     "paclet:Wolfram/DiagrammaticComputation/ref/TopologyGraph", 
     "Wolfram/DiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["topology", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "7dcac071-a19a-4d60-b426-d6c5adfc187a"],
 " ",
 "converts a FeynArts ",
 Cell[BoxData[
 "Topology"], "InlineFormula",ExpressionUUID->
  "d4eb719b-9693-43e2-b083-eeb7817cd7a9"],
 " object into a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Graph"]], "paclet:ref/Graph"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "cda7c93a-0f7b-460a-968c-a04cefe96d77"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"91cebdcf-e8b7-41a5-bc4e-dc08d3bc2a3f"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"t", "o", "p", "o", "l", "o", "g", "y"}], "TI"], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "ffd83772-2476-4a8b-a6d5-43ec42d7252a"],
 " is a ",
 Cell[BoxData[
  RowBox[{"FeynArts`Topology", "[", "\[Ellipsis]", "]"}]], "InlineFormula",
  ExpressionUUID->"ee7a3029-3b18-4b6a-ae74-4dd154d28e8f"],
 " expression as produced by ",
 Cell[BoxData[
 "FeynArts`CreateTopologies"], "InlineFormula",ExpressionUUID->
  "2760751c-e134-48b2-95e5-f33a5475e14e"],
 "."
}], "Notes",ExpressionUUID->"423041f1-85b7-46b1-9114-f78eb505b9cc"],

Cell[TextData[{
 "Incoming and outgoing external legs become ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DirectedEdge"]], "paclet:ref/DirectedEdge"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6dceb8d7-8157-4aa4-b063-8d9fb49c260d"],
 "s; internal propagators become ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["UndirectedEdge"]], "paclet:ref/UndirectedEdge"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "bfcfe55e-584f-43e4-909c-40b896a6320f"],
 "s. Each edge is tagged with its propagator type and field content."
}], "Notes",ExpressionUUID->"0cdd2a2e-386b-408e-b773-a4eec786bde5"],

Cell["\<\
Vertex coordinates are taken from the FeynArts shape data, so the graph lays \
out like the conventional FeynArts rendering.\
\>", "Notes",ExpressionUUID->"677fc902-2428-4d99-8b0f-89ca47460fcc"]
}, Open  ]],

