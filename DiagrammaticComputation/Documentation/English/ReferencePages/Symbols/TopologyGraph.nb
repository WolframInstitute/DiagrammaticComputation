Cell[CellGroupData[{
Cell["TopologyGraph", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"7732656b-f05a-4ee0-85bc-0b8b61ec5287"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["TopologyGraph"]], 
     "paclet:WolframDiagrammaticComputation/ref/TopologyGraph", 
     "WolframDiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["topology", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "caf02a3d-50fb-46df-9224-69cfb57f128e"],
 " ",
 "converts a FeynArts ",
 Cell[BoxData[
 "Topology"], "InlineFormula",ExpressionUUID->
  "7f6af3b4-2b19-48d6-9f23-2081a295dd14"],
 " object into a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Graph"]], "paclet:ref/Graph"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ce3cd61b-ad77-449f-bb7b-2e534d2e15c4"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"e7d15906-548b-4e28-9d22-e189dc49e5d8"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"t", "o", "p", "o", "l", "o", "g", "y"}], "TI"], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "936d32b9-0e70-40e3-ae1a-905d313d681c"],
 " is a ",
 Cell[BoxData[
  RowBox[{"FeynArts`Topology", "[", "\[Ellipsis]", "]"}]], "InlineFormula",
  ExpressionUUID->"a3132ba9-c84c-4ec7-b7cc-16f1d766f8a0"],
 " expression as produced by ",
 Cell[BoxData[
 "FeynArts`CreateTopologies"], "InlineFormula",ExpressionUUID->
  "d17f8ef0-5cfd-40a6-a1c6-5985f55f14f9"],
 "."
}], "Notes",ExpressionUUID->"d9e519b1-2af0-4eaf-a5ac-3a53b393475f"],

Cell[TextData[{
 "Incoming and outgoing external legs become ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DirectedEdge"]], "paclet:ref/DirectedEdge"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3d0a7b6c-a31f-4321-a577-7d658f13bf6f"],
 "s; internal propagators become ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["UndirectedEdge"]], "paclet:ref/UndirectedEdge"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e6130f73-d13e-4f3d-a11b-c9444d2584de"],
 "s. Each edge is tagged with its propagator type and field content."
}], "Notes",ExpressionUUID->"04827a4f-1b64-41dd-b646-56fb81199800"],

Cell["\<\
Vertex coordinates are taken from the FeynArts shape data, so the graph lays \
out like the conventional FeynArts rendering.\
\>", "Notes",ExpressionUUID->"2ef6f0cf-c328-4dcc-bb55-1f860118703c"]
}, Open  ]],

