Cell[CellGroupData[{
Cell["TopologyGraph", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"35f86944-a9f8-4781-b6ec-fc54e574d25b"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["TopologyGraph"]], 
     "paclet:WolframDiagrammaticComputation/ref/TopologyGraph", 
     "WolframDiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["topology", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "aedd9dcd-50c8-433e-866b-b07396e33930"],
 " ",
 "converts a FeynArts ",
 Cell[BoxData[
 "Topology"], "InlineFormula",ExpressionUUID->
  "9c1adc30-3ddd-40dd-94ba-1d7b1d6ae4fd"],
 " object into a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Graph"]], "paclet:ref/Graph"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5480802e-b34f-41ed-9325-d22f05bfa701"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"7860849e-7f84-413a-a8d2-48be59c1e856"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"t", "o", "p", "o", "l", "o", "g", "y"}], "TI"], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "9511c6b2-809f-454a-98e0-637b02ac3a65"],
 " is a ",
 Cell[BoxData[
  RowBox[{"FeynArts`Topology", "[", "\[Ellipsis]", "]"}]], "InlineFormula",
  ExpressionUUID->"8966af5f-40e3-4533-ba1e-f2c6833af001"],
 " expression as produced by ",
 Cell[BoxData[
 "FeynArts`CreateTopologies"], "InlineFormula",ExpressionUUID->
  "eb51d5ac-b1be-4b0b-8927-a8b33251619f"],
 "."
}], "Notes",ExpressionUUID->"bc7de1a5-15ac-495e-9152-66e097c64f5c"],

Cell[TextData[{
 "Incoming and outgoing external legs become ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DirectedEdge"]], "paclet:ref/DirectedEdge"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5618af89-39ff-45ab-95f9-9775c70085d2"],
 "s; internal propagators become ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["UndirectedEdge"]], "paclet:ref/UndirectedEdge"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0e96c5dc-82cc-4957-a3d9-b335cff1fe29"],
 "s. Each edge is tagged with its propagator type and field content."
}], "Notes",ExpressionUUID->"250f8efd-90d3-4c9a-acbf-db9a5088e33c"],

Cell["\<\
Vertex coordinates are taken from the FeynArts shape data, so the graph lays \
out like the conventional FeynArts rendering.\
\>", "Notes",ExpressionUUID->"bafeb838-ed29-4ae2-9dd4-b8a715b110b7"]
}, Open  ]],

