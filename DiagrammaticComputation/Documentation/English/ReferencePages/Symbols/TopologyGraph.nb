Cell["Load FeynArts:", "ExampleText",ExpressionUUID->"a06a57f1-a99b-40e3-b5fc-e26434ef3d43"],

Cell[BoxData[{
 RowBox[{"Needs", "[", "\"\<FeynArts`\>\"", "]"}], "\n", 
 RowBox[{
  RowBox[{"FeynArts`$FAVerbose", " ", "=", " ", "0"}], ";"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"498b1cbf-bb13-462b-8e93-f14b40d8f6bb"],

Cell["\<\
Create the tree-level 2 \[RightArrow] 2 topologies and convert the first one \
to a graph:\
\>", "ExampleText",ExpressionUUID->"a76d3b18-2ac5-4f28-b85f-54ca3eca1254"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"top", " ", "=", " ", 
   RowBox[{"First", " ", "@", " ", 
    RowBox[{"CreateTopologies", "[", 
     RowBox[{"0", ",", " ", 
      RowBox[{"2", " ", "->", " ", "2"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{"TopologyGraph", "[", "top", "]"}]}], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"78f6ca31-9541-4c00-aa6c-31e116c7d4d5"],

Cell[BoxData[
 GraphicsBox[
  NamespaceBox["NetworkGraphics",
   DynamicModuleBox[{Typeset`graph = HoldComplete[
     Graph[{1, 2, 3, 4, 
      5}, {{{1, 5}, {2, 5}, {5, 3}, {5, 4}}, 
       Null, {{FeynArts`Incoming}, {FeynArts`Incoming}, {FeynArts`Outgoing}, {
        FeynArts`Outgoing}}}, {
      VertexCoordinates -> {{0., 15.}, {0., 5.}, {20, 15.}, {20, 5.}, {10., 
         10.}}}]]}, 
    TagBox[
     GraphicsGroupBox[
      GraphicsComplexBox[{{0., 15.}, {0., 5.}, {20., 15.}, {20., 5.}, {10., 
       10.}}, {
        {Hue[0.6, 0.7, 0.7], Opacity[0.7], CapForm["Round"], Arrowheads[
         Medium], ArrowBox[{1, 5}, 0.09065281899109792], 
         ArrowBox[{2, 5}, 0.09065281899109792], 
         ArrowBox[{5, 3}, 0.09065281899109792], 
         ArrowBox[{5, 4}, 0.09065281899109792]}, 
        {Hue[0.6, 0.5, 1.], EdgeForm[{GrayLevel[0], Opacity[0.7]}], 
         DiskBox[1, 0.09065281899109792], DiskBox[2, 0.09065281899109792], 
         DiskBox[3, 0.09065281899109792], DiskBox[4, 0.09065281899109792], 
         DiskBox[5, 0.09065281899109792]}}]],
     MouseAppearanceTag["NetworkGraphics"]],
    AllowKernelInitialization->False]],
  DefaultBaseStyle->"NetworkGraphics",
  FormatType->TraditionalForm,
  FrameTicks->None]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"a68c9b10-d6ab-4085-ab0c-4b43b3687f4d"]
}, Open  ]],

