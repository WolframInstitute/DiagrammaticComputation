Cell["Get the second subdiagram of a composition:", "ExampleText",ExpressionUUID->"e0baa1da-cb03-49ee-8203-f37d27a7cb04"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"DiagramExtract", "[", 
  RowBox[{
   RowBox[{"DiagramComposition", "[", 
    RowBox[{
     RowBox[{"Diagram", "[", 
      RowBox[{"\"\<A\>\"", ",", " ", "b", ",", " ", "a"}], "]"}], ",", " ", 
     RowBox[{"Diagram", "[", 
      RowBox[{"\"\<B\>\"", ",", " ", "c", ",", " ", "b"}], "]"}]}], "]"}], ",",
    " ", 
   RowBox[{"{", "2", "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"d9a29d38-04e6-4cdc-8844-6f1b10a6d9e9"],

Cell[BoxData[
 GraphicsBox[
  NamespaceBox["Diagram",
   DynamicModuleBox[{Typeset`d = HoldComplete[
     Wolfram`DiagrammaticComputation`Diagram`Diagram[<|
      "DiagramOptions" -> {
        "PortArrows" -> {{Automatic}, {Automatic}}, 
         "PortLabels" -> {{Automatic}, {Automatic}}}, "Expression" :> "B", 
       "InputPorts" -> {
         Wolfram`DiagrammaticComputation`Port`Port[<|
          "Expression" :> 
           Wolfram`DiagrammaticComputation`Port`PortDual[
            MTNB$19vhce9wdppt9`c], "NeutralQ" -> False, "Tags" -> {}, "Type" -> 
           SuperStar[\[FormalCapitalT]]|>]}, "OutputPorts" -> {
         Wolfram`DiagrammaticComputation`Port`Port[<|
          "Expression" :> MTNB$19vhce9wdppt9`b, "NeutralQ" -> False, 
           "Tags" -> {}, "Type" -> \[FormalCapitalT]|>]}|>]]}, 
    {Arrowheads[Small], 
     {EdgeForm[{LightDarkSwitched[
       GrayLevel[0], 
       GrayLevel[1]], Opacity[0.5]}], FaceForm[LightDarkSwitched[
       RGBColor[0.952941188969422, 0.9529411889694224, 0.9529411889694221], 
       GrayLevel[0.62]]], 
      GeometricTransformationBox[
       RectangleBox[
        NCache[{Rational[-1, 2], Rational[-1, 2]}, {-0.5, -0.5}]], {{{1, 0}, {
        0, 1}}, {0, 0}}]}, {{ArrowBox[{{0., 0.75}, {0., 0.5}}], InsetBox[
        InterpretationBox[
         TagBox["c",
          HoldForm],
         Wolfram`DiagrammaticComputation`Port`Port[<|
          "Expression" :> MTNB$19vhce9wdppt9`c, "NeutralQ" -> False, 
           "Tags" -> {}, "Type" -> \[FormalCapitalT]|>],
         Tooltip->"\[FormalCapitalT]"], {0., 0.875}]}, {
       ArrowBox[{{0., -0.5}, {0., -0.75}}], InsetBox[
        InterpretationBox[
         TagBox["b",
          HoldForm],
         Wolfram`DiagrammaticComputation`Port`Port[<|
          "Expression" :> MTNB$19vhce9wdppt9`b, "NeutralQ" -> False, 
           "Tags" -> {}, "Type" -> \[FormalCapitalT]|>],
         Tooltip->"\[FormalCapitalT]"], {0., -0.875}]}}, 
     {LightDarkSwitched[
       GrayLevel[0], 
       GrayLevel[1]], InsetBox[
       TagBox["\<\"B\"\>",
        HoldForm], {0, 0}]}}]],
  BaseStyle->{
   GraphicsBoxOptions -> {ImageSize -> Tiny}, 
    Wolfram`DiagrammaticComputation`Diagram`Private`GraphicsHighlightColor -> 
    RGBColor[1, 0, 1]},
  FormatType->StandardForm]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"34ad8c54-ab22-45af-8b82-5ad9055f9392"]
}, Open  ]],

