Cell["Reach into a nested diagram:", "ExampleText",ExpressionUUID->"882d31da-6f14-4a0e-b724-2b91716005ed"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"DiagramExtract", "[", 
  RowBox[{
   RowBox[{"Diagram", "[", 
    RowBox[{
     RowBox[{"DiagramProduct", "[", 
      RowBox[{
       RowBox[{"Diagram", "[", 
        RowBox[{"\"\<A\>\"", ",", " ", "a", ",", " ", "c"}], "]"}], ",", " ", 
       
       RowBox[{"Diagram", "[", 
        RowBox[{"\"\<B\>\"", ",", " ", "b"}], "]"}]}], "]"}], " ", "/*", " ", 
     
     RowBox[{"Diagram", "[", 
      RowBox[{"\"\<C\>\"", ",", " ", 
       RowBox[{"{", 
        RowBox[{"c", ",", " ", "b"}], "}"}], ",", " ", "e"}], "]"}]}], "]"}], 
   ",", " ", 
   RowBox[{"{", 
    RowBox[{"2", ",", " ", "1"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"d1ee3331-cfaf-4b09-80cf-8303bed6a32e"],

