Cell[TextData[{
 "A cup has no inputs and two outputs; it is the ",
 StyleBox["unit", "TI"],
 " / coevaluation morphism that \"creates a pair\" of a port and its dual."
}], "Notes",ExpressionUUID->"f272684f-9b0a-4cca-ba31-d29c07244fe2"],

