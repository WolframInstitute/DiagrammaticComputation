Cell["CupDiagram", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"13a8fc9f-7588-46f1-9606-b168e09611c6"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CupDiagram",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/CupDiagram"], "[", 
   StyleBox["p", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "2b7d18ac-70e3-4346-90de-8f2efb57d3d2"],
 " ",
 "creates a diagram connecting two output ports ",
 Cell[BoxData[
  FormBox[
   StyleBox["p", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "2c959eab-a13e-46f1-b8bb-6b8348caaf4d"],
 " and ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["PortDual",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/PortDual"], "[", 
   StyleBox["p", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "4caa536a-ab60-41a9-b2cb-5494e81b7fce"],
 " with a cup.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"73194b6b-13d7-4b4a-afed-3211090b6b3e"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CupDiagram",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/CupDiagram"], "[", 
   RowBox[{
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["q", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "dc06ad9d-8b42-40fd-943a-287d28b1a13b"],
 " ",
 "connects two specified output ports."
}], "Usage",ExpressionUUID->"945a2436-69be-4df2-a823-b99d0b49d696"],

Cell[TextData[{
 "A cup has no inputs and two outputs; it is the ",
 StyleBox["unit", "TI"],
 " / coevaluation morphism that \"creates a pair\" of a port and its dual."
}], "Notes",ExpressionUUID->"34a941e3-33e1-4987-be03-004a90ab2c4e"],

Cell[TextData[{
 "Together with ",
 Cell[BoxData[
  ButtonBox["CapDiagram",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/CapDiagram"]], 
  "InlineFormula",ExpressionUUID->"37e82004-08f9-4903-85a6-c7a718f0aa38"],
 " it gives the snake equations of a compact-closed category."
}], "Notes",ExpressionUUID->"8fe72d72-8e23-47a0-8a5e-c980af3bbaa6"]
}, Open  ]],

