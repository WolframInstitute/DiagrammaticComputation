Cell[CellGroupData[{
Cell["DiagramComposition", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"5bffa45a-e46d-4894-8eeb-7ca60a990722"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DiagramComposition"]], 
     "paclet:WolframDiagrammaticComputation/ref/DiagramComposition", 
     "WolframDiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    SubscriptBox[
     StyleBox["d", "TI"], 
     StyleBox["1", "TR"]], ",", " ", 
    SubscriptBox[
     StyleBox["d", "TI"], 
     StyleBox["2", "TR"]], ",", " ", 
    SubscriptBox[
     StyleBox["d", "TI"], 
     StyleBox["3", "TR"]], ",", " ", "\[Ellipsis]"}], "]"}]], "InlineFormula",
  ExpressionUUID->"f953e893-e750-4f14-9003-662b524dac4f"],
 " ",
 "represents the sequential composition of the diagrams ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["d", "TI"], 
    StyleBox["i", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "2453b048-847c-4387-9702-52771f00744d"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"635cbc99-d0a5-4a3f-b468-7746f68de4d8"],

Cell[TextData[{
 "Reads right-to-left, matching the convention for function composition: in \
",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DiagramComposition"]], 
     "paclet:WolframDiagrammaticComputation/ref/DiagramComposition", 
     "WolframDiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    SubscriptBox[
     StyleBox["d", "TI"], 
     StyleBox["1", "TR"]], ",", " ", 
    SubscriptBox[
     StyleBox["d", "TI"], 
     StyleBox["2", "TR"]]}], "]"}]], "InlineFormula",ExpressionUUID->
  "dcec263e-1250-41db-8e47-9a7edb5d3340"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["d", "TI"], "2"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"f74ae182-824e-437f-9582-62ad05958291"],
 " runs first and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["d", "TI"], "1"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"9bc944de-a969-419b-9510-deb82d4e6998"],
 " runs second."
}], "Notes",ExpressionUUID->"634936e8-a439-4b6b-aef7-32cf422c0e95"],

Cell[TextData[{
 "The output ports of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["d", "TI"], 
    RowBox[{
     StyleBox["i", "TI"], "+", "1"}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"b3aead74-ebff-4c50-9710-1e866b9a6463"],
 " must match the input ports of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["d", "TI"], 
    StyleBox["i", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "38cc5d04-2eeb-462f-8dc0-621162e475f5"],
 " pairwise. The resulting diagram has the inputs of the rightmost diagram \
and the outputs of the leftmost."
}], "Notes",ExpressionUUID->"e614dd13-ca0b-410d-a58c-0282e0a4fde1"],

Cell[TextData[{
 "The shorthand ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["d", "TI"], 
    StyleBox["1", "TR"]], " ", "@*", " ", 
