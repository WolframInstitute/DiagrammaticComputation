    "paclet:WolframDiagrammaticComputation/ref/DiagramComposition", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9ba5faae-015c-4773-8cd5-33cc47e17e69"],
 ", matching ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Composition"]], "paclet:ref/Composition"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "fe2d6452-87f5-4bd9-a060-729f5becb169"],
 ". The left-to-right reading is available as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramRightComposition"]], 
    "paclet:WolframDiagrammaticComputation/ref/DiagramRightComposition", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4f20580f-5b16-416b-ae75-4d7177239149"],
 " and the ",
 Cell[BoxData["/*"], "InlineFormula",ExpressionUUID->
  "3321e01c-313c-4179-b3dc-4474e9f2c490"],
 " operator."
}], "Notes",ExpressionUUID->"43de64ff-7c2f-4c92-af8c-c331b58977f3"],

