 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramNetwork"]], 
    "paclet:WolframDiagrammaticComputation/ref/DiagramNetwork", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "225404f6-9406-44a2-bc44-f4ad615428af"],
 ", which composes by port name rather than position."
}], "ExampleText",ExpressionUUID->"441052da-9dc0-4bd3-97d9-ee5b952977fe"],

