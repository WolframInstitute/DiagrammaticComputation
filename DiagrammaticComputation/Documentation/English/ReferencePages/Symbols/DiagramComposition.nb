Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramComposition"]], 
    "paclet:Wolfram/DiagrammaticComputation/ref/DiagramComposition", 
    "Wolfram/DiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "bc962269-efec-42ee-9134-dda20f09a724"],
 " is the sequential analogue of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramProduct"]], 
    "paclet:Wolfram/DiagrammaticComputation/ref/DiagramProduct", 
    "Wolfram/DiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "54fc4ffd-d280-473c-aad9-820d5a1826ab"],
 " (parallel) and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramSum"]], 
    "paclet:Wolfram/DiagrammaticComputation/ref/DiagramSum", 
    "Wolfram/DiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "aa3fbea0-a862-48dd-8fb6-3a5283004e60"],
