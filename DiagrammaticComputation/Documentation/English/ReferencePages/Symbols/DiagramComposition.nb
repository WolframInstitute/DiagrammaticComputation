Cell[CellGroupData[{
Cell["DiagramComposition", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"f3cc22c0-e8a2-4505-aaa3-2018c4de039d"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["DiagramComposition",
    BaseStyle->"Link",
    ButtonData->
     "paclet:Wolfram/DiagrammaticComputation/ref/DiagramComposition"], "[", 
   RowBox[{
    SubscriptBox[
     StyleBox["d", "TI"], 
     StyleBox["1", "TR"]], ",", " ", 
    SubscriptBox[
     StyleBox["d", "TI"], 
     StyleBox["2", "TR"]], ",", " ", 
    SubscriptBox[
     StyleBox["d", "TI"], 
     StyleBox["3", "TR"]], ",", " ", "\[Ellipsis]"}], "]"}]], "InlineFormula",
  ExpressionUUID->"665cc620-1b20-4a18-bb58-bb4af32f7082"],
 " ",
 "represents the sequential composition of the diagrams ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["d", "TI"], 
    StyleBox["i", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "f083c408-36e5-4b33-b9ed-78fc1652e344"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"17f508f3-9375-4644-bf22-5ea3f3f8b1f4"],

Cell[TextData[{
 "Reads right-to-left, matching the convention for function composition: in \
",
 Cell[BoxData[
  RowBox[{
   ButtonBox["DiagramComposition",
    BaseStyle->"Link",
    ButtonData->
     "paclet:Wolfram/DiagrammaticComputation/ref/DiagramComposition"], "[", 
   RowBox[{
    SubscriptBox[
     StyleBox["d", "TI"], 
     StyleBox["1", "TR"]], ",", " ", 
    SubscriptBox[
     StyleBox["d", "TI"], 
     StyleBox["2", "TR"]]}], "]"}]], "InlineFormula",ExpressionUUID->
  "00cd4489-0dd8-4694-b286-faf67ff2bb72"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["d", "TI"], "2"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"d8895adc-eafc-4b9a-a30c-034411eb5ec1"],
 " runs first and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["d", "TI"], "1"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"48d50c6a-d498-40c4-9507-9afb89c8b890"],
 " runs second."
}], "Notes",ExpressionUUID->"531f8385-d128-4eb9-ad04-3bd4b228fb40"],

Cell[TextData[{
 "The output ports of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["d", "TI"], 
    RowBox[{
     StyleBox["i", "TI"], "+", "1"}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"28238511-4645-4b2c-8730-6430a0f8e38e"],
 " must match the input ports of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["d", "TI"], 
    StyleBox["i", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "cd0cd76a-289b-4d83-8065-5c92a8c8419c"],
 " pairwise. The resulting diagram has the inputs of the rightmost diagram \
and the outputs of the leftmost."
}], "Notes",ExpressionUUID->"7d2eb392-dcc9-45a0-a9a1-8d6d882d6ed3"],

Cell[TextData[{
 "The shorthand ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["d", "TI"], 
    StyleBox["1", "TR"]], " ", "@*", " ", 
   SubscriptBox[
    StyleBox["d", "TI"], 
    StyleBox["2", "TR"]]}]], "InlineFormula",ExpressionUUID->
  "3bbac150-57e9-4f5e-ab8f-323d92d69e97"],
 " produces a ",
 Cell[BoxData[
  ButtonBox["DiagramComposition",
   BaseStyle->"Link",
   ButtonData->
    "paclet:Wolfram/DiagrammaticComputation/ref/DiagramComposition"]], 
  "InlineFormula",ExpressionUUID->"4be33d4a-d285-41f0-849c-11930218088f"],
 ", matching ",
 Cell[BoxData[
  ButtonBox["Composition",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Composition"]], "InlineFormula",ExpressionUUID->
  "02d66409-b756-4a58-9837-7a6bed45ea63"],
 ". The left-to-right reading is available as ",
 Cell[BoxData[
  ButtonBox["DiagramRightComposition",
   BaseStyle->"Link",
   ButtonData->
    "paclet:Wolfram/DiagrammaticComputation/ref/DiagramRightComposition"]], 
  "InlineFormula",ExpressionUUID->"f54cf6c1-e115-4907-a6fe-b34fd3e748c8"],
 " and the ",
 Cell[BoxData["/*"], "InlineFormula",ExpressionUUID->
  "acba48f4-169d-44d4-8124-9223c71ef346"],
 " operator."
}], "Notes",ExpressionUUID->"9213a081-09fd-4d10-a83b-81be96af662b"],

Cell[TextData[{
 "The identity for ",
 Cell[BoxData[
  ButtonBox["DiagramComposition",
   BaseStyle->"Link",
   ButtonData->
    "paclet:Wolfram/DiagrammaticComputation/ref/DiagramComposition"]], 
  "InlineFormula",ExpressionUUID->"1a6d8690-0ca7-481a-8e82-aff8a56aeb49"],
