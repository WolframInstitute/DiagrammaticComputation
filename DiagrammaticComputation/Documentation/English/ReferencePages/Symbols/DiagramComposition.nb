Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"98a30add-b0e1-4501-8ca8-ce9849c4f36d"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DiagramComposition"]], 
     "paclet:Wolfram/DiagrammaticComputation/ref/DiagramComposition", 
     "Wolfram/DiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    SubscriptBox[
     StyleBox["d", "TI"], 
     StyleBox["1", "TR"]], ",", " ", 
    SubscriptBox[
     StyleBox["d", "TI"], 
     StyleBox["2", "TR"]], ",", " ", 
    SubscriptBox[
     StyleBox["d", "TI"], 
     StyleBox["3", "TR"]], ",", " ", "\[Ellipsis]"}], "]"}]], "InlineFormula",
  ExpressionUUID->"9f3b0238-9a4f-4b75-8f6b-4b47e8d67a8f"],
 " ",
 "represents the sequential composition of the diagrams ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["d", "TI"], 
    StyleBox["i", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "06f5611e-1908-48a3-b4e2-779216aee941"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"785cb611-c984-4649-b022-287869b518e0"],

Cell[TextData[{
 "Reads right-to-left, matching the convention for function composition: in \
",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DiagramComposition"]], 
     "paclet:Wolfram/DiagrammaticComputation/ref/DiagramComposition", 
     "Wolfram/DiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    SubscriptBox[
     StyleBox["d", "TI"], 
     StyleBox["1", "TR"]], ",", " ", 
    SubscriptBox[
     StyleBox["d", "TI"], 
     StyleBox["2", "TR"]]}], "]"}]], "InlineFormula",ExpressionUUID->
  "f474d056-d62d-4d15-857f-4b675a528c41"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["d", "TI"], "2"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"1dbaa67f-ebbe-4b2c-9f5c-35e26a4bbca8"],
 " runs first and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["d", "TI"], "1"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"248c34da-bf1b-482e-a257-9d99d531288d"],
 " runs second."
}], "Notes",ExpressionUUID->"80139652-0280-4785-bd97-fe8ba2da4868"],

Cell[TextData[{
 "The output ports of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["d", "TI"], 
    RowBox[{
     StyleBox["i", "TI"], "+", "1"}]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"1243ae18-c239-4bca-a98f-e73553dd4eb8"],
 " must match the input ports of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["d", "TI"], 
    StyleBox["i", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "89e37240-6c3b-4812-8ab9-464f4d7b779d"],
 " pairwise. The resulting diagram has the inputs of the rightmost diagram \
and the outputs of the leftmost."
}], "Notes",ExpressionUUID->"3ca06b75-a11d-45d0-827c-2bf6d6ea32cc"],

Cell[TextData[{
 "The shorthand ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
