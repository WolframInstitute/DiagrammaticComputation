Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramComposition"]], 
    "paclet:WolframDiagrammaticComputation/ref/DiagramComposition", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b520327e-0151-4988-a2e9-c02857b1b641"],
 " is the sequential analogue of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramProduct"]], 
    "paclet:WolframDiagrammaticComputation/ref/DiagramProduct", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4f4a00c5-d801-4501-9d79-d958ecc0923b"],
 " (parallel) and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramSum"]], 
    "paclet:WolframDiagrammaticComputation/ref/DiagramSum", 
    "WolframDiagrammaticComputation Package Symbol"},
