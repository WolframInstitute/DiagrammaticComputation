   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6c22aa7f-3f0d-4478-8153-cc5bf547db9d"],
 ", matching ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Composition"]], "paclet:ref/Composition"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e782eb14-3d17-445d-8035-1813ecda79e6"],
 ". The left-to-right reading is available as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramRightComposition"]], 
    "paclet:Wolfram/DiagrammaticComputation/ref/DiagramRightComposition", 
    "Wolfram/DiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "fb44d195-1b94-4132-903f-f67a76015bbe"],
 " and the ",
 Cell[BoxData["/*"], "InlineFormula",ExpressionUUID->
  "21f938a4-477f-422c-af05-ddb4ebe4c3fc"],
 " operator."
}], "Notes",ExpressionUUID->"14c25568-0f1f-42b9-98a5-947bd9f7e9c5"],

