Cell[TextData[{
 Cell[BoxData[
  ButtonBox["DiagramComposition",
   BaseStyle->"Link",
   ButtonData->
    "paclet:Wolfram/DiagrammaticComputation/ref/DiagramComposition"]], 
  "InlineFormula",ExpressionUUID->"4edc38c4-1af4-49cd-b9eb-ebbbc992e2e7"],
 " is the sequential analogue of ",
 Cell[BoxData[
  ButtonBox["DiagramProduct",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/DiagramProduct"]], 
  "InlineFormula",ExpressionUUID->"e551f3d0-aa0a-417b-a5ba-1b48cd89b76a"],
 " (parallel) and ",
 Cell[BoxData[
  ButtonBox["DiagramSum",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/DiagramSum"]], 
  "InlineFormula",ExpressionUUID->"8d458c0f-c26b-4e97-9076-2a66e758c68e"],
 " (additive). All three are subsumed by ",
 Cell[BoxData[
  ButtonBox["DiagramNetwork",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/DiagramNetwork"]], 
  "InlineFormula",ExpressionUUID->"b34a2e64-ed09-484f-b16a-7bfcdc7c2d19"],
 ", which composes by port name rather than position."
}], "ExampleText",ExpressionUUID->"18abe7b5-d3f5-47d5-a321-71eb03f74fe5"],

Cell[TextData[{
 "The tensor-level analogue is ",
 Cell[BoxData[
  ButtonBox["Dot",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Dot"]], "InlineFormula",ExpressionUUID->
  "826cd6f5-9409-423c-9844-4622fde1c9a2"],
 " / ",
 Cell[BoxData[
  ButtonBox["TensorContract",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/TensorContract"]], "InlineFormula",ExpressionUUID->
  "d6ddc94d-bc35-47ff-80c7-b23e07878597"],
 "."
}], "ExampleText",ExpressionUUID->"df0d1572-0cd6-4c03-8899-bef6ef8be95f"]
}, Open  ]]
