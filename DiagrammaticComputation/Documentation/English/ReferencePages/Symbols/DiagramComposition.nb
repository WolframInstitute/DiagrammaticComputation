 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramNetwork"]], 
    "paclet:Wolfram/DiagrammaticComputation/ref/DiagramNetwork", 
    "Wolfram/DiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "09d7fd8a-c3e6-43de-8910-6f3057afddcc"],
 ", which composes by port name rather than position."
}], "ExampleText",ExpressionUUID->"2201f39b-efb9-491b-831a-a61cc3f5891d"],

