 Cell[BoxData[
  ButtonBox["DiagramNetwork",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/DiagramNetwork"]], 
  "InlineFormula",ExpressionUUID->"330bc960-2828-44a1-8831-099d60d37a9d"],
 ", exposing the port-name connectivity.",
 "\n"
}], "Usage",ExpressionUUID->"e8972caf-7f85-4783-a107-5b85f50d211b"],

Cell[TextData[{
 "Flattens nested ",
 Cell[BoxData[
  ButtonBox["DiagramComposition",
   BaseStyle->"Link",
   ButtonData->
    "paclet:Wolfram/DiagrammaticComputation/ref/DiagramComposition"]], 
  "InlineFormula",ExpressionUUID->"745cda76-390b-494a-9568-d3e042efd282"],
 " and ",
 Cell[BoxData[
  ButtonBox["DiagramProduct",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/DiagramProduct"]], 
  "InlineFormula",ExpressionUUID->"96394871-e7e1-46d0-b4c6-65880950f919"],
 " structure into a single network whose subdiagrams are joined by shared \
port names."
}], "Notes",ExpressionUUID->"1a0983c2-50c7-4229-b7e3-10cb0f3b15ff"],

Cell[TextData[{
 "The reverse direction is implicit in ",
