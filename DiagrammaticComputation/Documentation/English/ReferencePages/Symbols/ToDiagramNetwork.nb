  ButtonBox["DiagramArrange",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/DiagramArrange"]], 
  "InlineFormula",ExpressionUUID->"cb127461-b66f-4641-a408-9a803aeacb18"],
 ", which converts an arbitrary diagram into a layout-friendly form."
}], "Notes",ExpressionUUID->"3cc34cba-a97d-419f-a72c-ce78dc234c0e"]
}, Open  ]],

