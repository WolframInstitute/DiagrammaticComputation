Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"79eeafdb-e516-472c-b15b-b445bde0f8a2"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ToDiagramNetwork",
    BaseStyle->"Link",
    ButtonData->
     "paclet:Wolfram/DiagrammaticComputation/ref/ToDiagramNetwork"], "[", 
   StyleBox["d", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "6fb55e0e-2ec6-4d15-a6cf-fc5175e6bddb"],
 " ",
 "rewrites a composite diagram ",
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "7e901b15-da65-4eeb-a7cf-7676b8b41ddc"],
