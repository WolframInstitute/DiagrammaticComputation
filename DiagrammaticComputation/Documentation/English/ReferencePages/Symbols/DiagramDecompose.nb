Cell["Decompose a composition of a product:", "ExampleText",ExpressionUUID->"2b79d093-2e02-404a-a54c-2714b32956aa"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"d", " ", "=", " ", 
   RowBox[{"DiagramRightComposition", "[", 
    RowBox[{
     RowBox[{"Diagram", "[", 
      RowBox[{"A", ",", " ", "a", ",", " ", 
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"DiagramProduct", "[", 
      RowBox[{
       RowBox[{"Diagram", "[", 
        RowBox[{"B", ",", " ", "x", ",", " ", "b"}], "]"}], ",", " ", 
       RowBox[{"Diagram", "[", 
        RowBox[{"C", ",", " ", "y", ",", " ", "c"}], "]"}]}], "]"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"DiagramDecompose", "[", "d", "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"ea375287-52e3-4ec8-b4e8-3bd94952f0a8"],

