Cell[CellGroupData[{
Cell["DiagramDecompose", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"aad0236f-fa51-45f8-a6d9-a7f908223eaa"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["DiagramDecompose",
    BaseStyle->"Link",
    ButtonData->
     "paclet:Wolfram/DiagrammaticComputation/ref/DiagramDecompose"], "[", 
   StyleBox["d", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "31d0ce2b-8f1e-42ef-b64c-c32dcaeaebdb"],
 " ",
 "decomposes the diagram ",
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "0fb0b692-f585-4f16-af29-8694f9af4fb2"],
 " into an expression tree of subdiagrams.",
 "\n"
}], "Usage",ExpressionUUID->"a41b13de-1a64-40ee-a1e5-95ce14a0e73d"],

Cell[TextData[{
 "The result is the structural skeleton of ",
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "49acb76e-417a-44d0-bc4c-7e712e4c16b3"],
 " \[LongDash] a nested ",
 Cell[BoxData[
  ButtonBox["DiagramComposition",
   BaseStyle->"Link",
   ButtonData->
    "paclet:Wolfram/DiagrammaticComputation/ref/DiagramComposition"]], 
  "InlineFormula",ExpressionUUID->"22a99bc6-7a6e-4fb6-82cf-f570510b487e"],
 " / ",
 Cell[BoxData[
  ButtonBox["DiagramProduct",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/DiagramProduct"]], 
  "InlineFormula",ExpressionUUID->"4f88071e-1915-4a3b-a6fa-2b7b68881b71"],
 " / ",
 Cell[BoxData[
  ButtonBox["DiagramNetwork",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/DiagramNetwork"]], 
  "InlineFormula",ExpressionUUID->"ae1e6851-32b5-4a8c-80d2-f7b1e3bb975c"],
 " expression whose leaves are the singleton subdiagrams of ",
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "6c30af91-b242-4f5d-a57c-5d3a2f929d4e"],
 "."
}], "Notes",ExpressionUUID->"0a1ce84e-9257-42d9-a376-e47174b21220"],

Cell[TextData[{
 "This is the canonical way to ",
 StyleBox["read", "TI"],
 " the structure of a built diagram; for ",
 StyleBox["patterns over", "TI"],
 " this structure, use ",
 Cell[BoxData[
  ButtonBox["DiagramSubdiagrams",
   BaseStyle->"Link",
   ButtonData->
    "paclet:Wolfram/DiagrammaticComputation/ref/DiagramSubdiagrams"]], 
  "InlineFormula",ExpressionUUID->"e9466e73-6840-498e-8885-f74634afcb6d"],
 " and the surgery functions."
}], "Notes",ExpressionUUID->"3a52c6bb-987e-4efa-a436-9529788a6ef8"]
}, Open  ]],

