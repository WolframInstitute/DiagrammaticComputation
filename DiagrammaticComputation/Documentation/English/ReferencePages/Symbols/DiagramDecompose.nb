Cell["Decompose a composition of a product:", "ExampleText",ExpressionUUID->"32691753-096b-4b36-988e-b896b5ac33f0"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"d", " ", "=", " ", 
   RowBox[{"DiagramRightComposition", "[", 
    RowBox[{
     RowBox[{"Diagram", "[", 
      RowBox[{"A", ",", " ", "a", ",", " ", 
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"DiagramProduct", "[", 
      RowBox[{
       RowBox[{"Diagram", "[", 
        RowBox[{"B", ",", " ", "x", ",", " ", "b"}], "]"}], ",", " ", 
       RowBox[{"Diagram", "[", 
        RowBox[{"C", ",", " ", "y", ",", " ", "c"}], "]"}]}], "]"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"DiagramDecompose", "[", "d", "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"cde6d247-cc8f-4466-91eb-479c07eeb620"],

