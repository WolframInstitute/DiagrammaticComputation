Cell["Decompose a composition of a product:", "ExampleText",ExpressionUUID->"f51076fe-8bc0-452d-9cb0-087da3750522"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"d", " ", "=", " ", 
   RowBox[{"DiagramRightComposition", "[", 
    RowBox[{
     RowBox[{"Diagram", "[", 
      RowBox[{"A", ",", " ", "a", ",", " ", 
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"DiagramProduct", "[", 
      RowBox[{
       RowBox[{"Diagram", "[", 
        RowBox[{"B", ",", " ", "x", ",", " ", "b"}], "]"}], ",", " ", 
       RowBox[{"Diagram", "[", 
        RowBox[{"C", ",", " ", "y", ",", " ", "c"}], "]"}]}], "]"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"DiagramDecompose", "[", "d", "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"27b8b9b7-6292-489a-92e3-e625b7a0024d"],

