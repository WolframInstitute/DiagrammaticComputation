Cell[BoxData[
 RowBox[{"DiagramNestReplace", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"DiagramComposition", "[", 
    RowBox[{
     RowBox[{"Diagram", "[", 
      RowBox[{"\"\<A\>\"", ",", " ", "b", ",", " ", "a"}], "]"}], ",", " ", 
     RowBox[{"Diagram", "[", 
      RowBox[{"\"\<A\>\"", ",", " ", "c", ",", " ", "b"}], "]"}]}], "]"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Diagram", "[", 
      RowBox[{"\"\<A\>\"", ",", " ", "\[FormalY]", ",", " ", "\[FormalX]"}], 
      "]"}], " ", "->", " ", 
     RowBox[{"Diagram", "[", 
      RowBox[{"\"\<X\>\"", ",", " ", "\[FormalY]", ",", " ", "\[FormalX]"}], 
      "]"}]}], "}"}], ",", "\n", "  ", "2"}], "\n", "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"3ca52727-d414-4a56-ac1f-ab3cd665d70c"],

