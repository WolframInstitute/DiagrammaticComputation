      "]"}], " ", "->", " ", 
     RowBox[{"Diagram", "[", 
      RowBox[{"\"\<X\>\"", ",", " ", "\[FormalY]", ",", " ", "\[FormalX]"}], 
      "]"}]}], "}"}], ",", "\n", "  ", "2"}], "\n", "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"15883dd4-c4a8-4dc3-a532-75bdee340089"],

