Cell[CellGroupData[{
Cell["DiagramArrange", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"7595a9f4-576c-4532-8df4-bf5247848ea6"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["DiagramArrange",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/DiagramArrange"], 
   "[", 
   StyleBox["d", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "3fa0ea96-6529-482c-97c1-f9a85a7b49a7"],
 " ",
 "rewrites the diagram ",
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "38f767fb-0382-490f-91f5-0665710aeaf6"],
 " into an equivalent diagram that can be laid out as a hierarchical grid, by \
inserting identity wires, permutations and (for networks) cap/cup/spider \
auxiliary diagrams.",
 "\n"
}], "Usage",ExpressionUUID->"edd8f814-292d-4b48-9aec-32aa15040b87"],

Cell[TextData[{
 "Arrangement does not change the meaning of the diagram \[LongDash] only its \
presentation. Composition with ",
 Cell[BoxData[
  ButtonBox["DiagramGrid",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/DiagramGrid"]], 
  "InlineFormula",ExpressionUUID->"52fe2e12-9abc-4ecf-a0d4-f9d79b0d40c1"],
 " is the usual workflow: ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["DiagramGrid",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/DiagramGrid"], 
   " ", "@", " ", 
   RowBox[{"DiagramArrange", "[", 
    StyleBox["d", "TI"], "]"}]}]], "InlineFormula",ExpressionUUID->
  "cf58ee4e-47ba-4e62-9db8-8a986fc4d993"],
 "."
}], "Notes",ExpressionUUID->"fb945d5c-d346-4d37-a8a7-f3ff70227842"],

Cell[TextData[{
 "For ordinary compositions and products, ",
 Cell[BoxData[
  ButtonBox["DiagramArrange",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/DiagramArrange"]], 
  "InlineFormula",ExpressionUUID->"c9525976-1726-4a8e-9f6b-2cddb75bc70b"],
 " inserts ",
 Cell[BoxData[
  ButtonBox["IdentityDiagram",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/IdentityDiagram"]],
   "InlineFormula",ExpressionUUID->"6464a472-ff36-4089-bde3-ba760ea098b7"],
 " and ",
 Cell[BoxData[
  ButtonBox["PermutationDiagram",
   BaseStyle->"Link",
   ButtonData->
    "paclet:Wolfram/DiagrammaticComputation/ref/PermutationDiagram"]], 
  "InlineFormula",ExpressionUUID->"169b1d72-8e00-4821-aa4a-959dfb439f7b"],
 " to align rows and columns."
}], "Notes",ExpressionUUID->"2f90e8a2-ce1d-4978-937c-0c80d2e21919"],

Cell[TextData[{
 "For networks, it additionally introduces ",
 Cell[BoxData[
  ButtonBox["CapDiagram",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/CapDiagram"]], 
  "InlineFormula",ExpressionUUID->"b7d291b1-ac60-447a-8728-28fd1960e815"],
 ", ",
 Cell[BoxData[
  ButtonBox["CupDiagram",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/CupDiagram"]], 
  "InlineFormula",ExpressionUUID->"b7ecb356-3d8b-4972-9ce2-88a0013eeadb"],
 " and ",
 Cell[BoxData[
  ButtonBox["SpiderDiagram",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/SpiderDiagram"]], 
  "InlineFormula",ExpressionUUID->"aa2d7e52-da93-4698-aa79-4bf49d1b8676"],
 " to make port matching explicit."
}], "Notes",ExpressionUUID->"05b9d267-7e97-4cb4-ab03-f976f1751eb5"]
}, Open  ]],

