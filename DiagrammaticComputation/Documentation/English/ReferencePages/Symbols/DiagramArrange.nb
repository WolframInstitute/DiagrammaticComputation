Cell["\<\
Arrangement of a composition introduces wires to align ports: Arrangement of \
a network introduces caps, cups and spiders:\
\>", "ExampleText",ExpressionUUID->"62a64b29-1fdf-4023-8f6b-3bdfd0d15944"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"d", " ", "=", " ", 
   RowBox[{"DiagramRightComposition", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"Diagram", "[", 
      RowBox[{"A", ",", " ", "a", ",", " ", "x"}], "]"}], ",", "\n", "  ", 
     RowBox[{"DiagramProduct", "[", 
      RowBox[{
       RowBox[{"Diagram", "[", 
        RowBox[{"B", ",", " ", "x", ",", " ", "b"}], "]"}], ",", " ", 
       RowBox[{"Diagram", "[", 
        RowBox[{"C", ",", " ", "y", ",", " ", "c"}], "]"}]}], "]"}], ",", 
     "\n", "  ", 
     RowBox[{"Diagram", "[", 
      RowBox[{"D", ",", " ", 
       RowBox[{"{", 
        RowBox[{"c", ",", " ", "b"}], "}"}], ",", " ", 
       RowBox[{"{", "}"}]}], "]"}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{"DiagramDecompose", " ", "@", " ", 
  RowBox[{"DiagramArrange", "[", "d", "]"}]}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"d2706540-25c3-4840-8f3c-8d1112d573c5"],

