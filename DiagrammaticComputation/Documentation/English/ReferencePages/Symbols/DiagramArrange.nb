Cell[CellGroupData[{
Cell["DiagramArrange", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"19acc5ab-ccb7-4124-b005-2e79ecb8413b"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DiagramArrange"]], 
     "paclet:WolframDiagrammaticComputation/ref/DiagramArrange", 
     "WolframDiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["d", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "11ee06f5-45f3-432e-bb68-ed1198ddf9fd"],
 " ",
 "rewrites the diagram ",
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "7e818f23-fae8-4930-bca3-041049865a6f"],
 " into an equivalent diagram that can be laid out as a hierarchical grid, by \
inserting identity wires, permutations and (for networks) cap/cup/spider \
auxiliary diagrams.",
 "\n"
}], "Usage",ExpressionUUID->"7f1806b6-d5d4-4be5-bbaa-89a0e27b38f6"],

Cell[TextData[{
 "Arrangement does not change the meaning of the diagram \[LongDash] only its \
presentation. Composition with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramGrid"]], 
    "paclet:WolframDiagrammaticComputation/ref/DiagramGrid", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "603e14b6-ab94-4d55-bb95-290092332bd9"],
 " is the usual workflow: ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DiagramGrid"]], 
     "paclet:WolframDiagrammaticComputation/ref/DiagramGrid", 
     "WolframDiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], " ", "@", " ", 
   RowBox[{"DiagramArrange", "[", 
    StyleBox["d", "TI"], "]"}]}]], "InlineFormula",ExpressionUUID->
  "ab3c2a06-1d66-4079-a220-fd1cb896ecbe"],
 "."
}], "Notes",ExpressionUUID->"dce7ad81-bb26-4725-8723-9697f9e21bd3"],

Cell[TextData[{
 "For ordinary compositions and products, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramArrange"]], 
    "paclet:WolframDiagrammaticComputation/ref/DiagramArrange", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a6b77ebe-6e3a-420b-bc5e-9e548de0079c"],
 " inserts ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["IdentityDiagram"]], 
    "paclet:WolframDiagrammaticComputation/ref/IdentityDiagram", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "398c80e9-4f67-418c-9246-37668d000b1d"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["PermutationDiagram"]], 
    "paclet:WolframDiagrammaticComputation/ref/PermutationDiagram", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ff92e889-2f49-4e97-8a1b-e38ff9b680b7"],
 " to align rows and columns."
}], "Notes",ExpressionUUID->"e2d25974-81d1-46fa-858f-1938154bc288"],

Cell[TextData[{
 "For networks, it additionally introduces ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CapDiagram"]], 
    "paclet:WolframDiagrammaticComputation/ref/CapDiagram", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "709955b6-4f92-4084-8f39-e88b61e5f7d8"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CupDiagram"]], 
    "paclet:WolframDiagrammaticComputation/ref/CupDiagram", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2616c923-d25a-4ac9-a106-e83e699b4a2d"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SpiderDiagram"]], 
    "paclet:WolframDiagrammaticComputation/ref/SpiderDiagram", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "91add941-6d06-480e-ab1f-2327594d0eb6"],
 " to make port matching explicit."
}], "Notes",ExpressionUUID->"66eec019-26d6-4268-93da-0cc86f857b32"]
}, Open  ]],

