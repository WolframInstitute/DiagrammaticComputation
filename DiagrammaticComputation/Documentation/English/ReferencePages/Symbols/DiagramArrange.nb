Cell[CellGroupData[{
Cell["DiagramArrange", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"ca547a6d-a17f-4f3a-8140-be8f376e278e"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DiagramArrange"]], 
     "paclet:Wolfram/DiagrammaticComputation/ref/DiagramArrange", 
     "Wolfram/DiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["d", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "7139ead3-08c3-4986-8334-f603eec9cbf5"],
 " ",
 "rewrites the diagram ",
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "67516412-f8f0-47b6-9eb0-28de39185c43"],
 " into an equivalent diagram that can be laid out as a hierarchical grid, by \
inserting identity wires, permutations and (for networks) cap/cup/spider \
auxiliary diagrams.",
 "\n"
}], "Usage",ExpressionUUID->"9837ebb4-30fc-485e-ac29-fe1e6809aaac"],

Cell[TextData[{
 "Arrangement does not change the meaning of the diagram \[LongDash] only its \
presentation. Composition with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramGrid"]], 
    "paclet:Wolfram/DiagrammaticComputation/ref/DiagramGrid", 
    "Wolfram/DiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ea8c5c56-f5c0-4dd7-bb27-3e3c74d9c0fb"],
 " is the usual workflow: ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DiagramGrid"]], 
     "paclet:Wolfram/DiagrammaticComputation/ref/DiagramGrid", 
     "Wolfram/DiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], " ", "@", " ", 
   RowBox[{"DiagramArrange", "[", 
    StyleBox["d", "TI"], "]"}]}]], "InlineFormula",ExpressionUUID->
  "631f6c13-5ba0-48cf-b143-63e9109535c7"],
 "."
}], "Notes",ExpressionUUID->"e2a6b29e-cfc6-4c37-b99e-ef6942c27fc2"],

Cell[TextData[{
 "For ordinary compositions and products, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramArrange"]], 
    "paclet:Wolfram/DiagrammaticComputation/ref/DiagramArrange", 
    "Wolfram/DiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a815a2da-e51c-4f19-adea-b718a6bbd3c1"],
 " inserts ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["IdentityDiagram"]], 
    "paclet:Wolfram/DiagrammaticComputation/ref/IdentityDiagram", 
    "Wolfram/DiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "594d38fc-e880-4fe5-8f6b-106334a7bb3c"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["PermutationDiagram"]], 
    "paclet:Wolfram/DiagrammaticComputation/ref/PermutationDiagram", 
    "Wolfram/DiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5f0053b1-2634-4493-ac53-504e53be1f64"],
 " to align rows and columns."
}], "Notes",ExpressionUUID->"e3f44321-7957-4ece-a52f-65ac7cc17711"],

Cell[TextData[{
 "For networks, it additionally introduces ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CapDiagram"]], 
    "paclet:Wolfram/DiagrammaticComputation/ref/CapDiagram", 
    "Wolfram/DiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6d78d369-801a-4a19-ac0a-e3664b70f9bb"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CupDiagram"]], 
    "paclet:Wolfram/DiagrammaticComputation/ref/CupDiagram", 
    "Wolfram/DiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "eb2b7e18-5dfe-420f-9bad-3663c9a590b4"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SpiderDiagram"]], 
    "paclet:Wolfram/DiagrammaticComputation/ref/SpiderDiagram", 
    "Wolfram/DiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8c709cb7-36b5-470b-b944-ef5490afced9"],
 " to make port matching explicit."
}], "Notes",ExpressionUUID->"60c49c3f-e92b-42da-a4ca-2d9668c262a6"]
}, Open  ]],

