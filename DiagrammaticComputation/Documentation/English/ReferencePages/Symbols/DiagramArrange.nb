Cell["\<\
Arrangement of a composition introduces wires to align ports:\
\>", "ExampleText",ExpressionUUID->"b28b33c2-a4b3-482a-85eb-17345f7b92bc"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"d", " ", "=", " ", 
   RowBox[{"DiagramRightComposition", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"Diagram", "[", 
      RowBox[{"A", ",", " ", "a", ",", " ", "x"}], "]"}], ",", "\n", "  ", 
     RowBox[{"DiagramProduct", "[", 
      RowBox[{
       RowBox[{"Diagram", "[", 
        RowBox[{"B", ",", " ", "x", ",", " ", "b"}], "]"}], ",", " ", 
       RowBox[{"Diagram", "[", 
        RowBox[{"C", ",", " ", "y", ",", " ", "c"}], "]"}]}], "]"}], ",", 
     "\n", "  ", 
     RowBox[{"Diagram", "[", 
      RowBox[{"D", ",", " ", 
       RowBox[{"{", 
        RowBox[{"c", ",", " ", "b"}], "}"}], ",", " ", 
       RowBox[{"{", "}"}]}], "]"}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{"DiagramDecompose", " ", "@", " ", 
  RowBox[{"DiagramArrange", "[", "d", "]"}]}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"f609fa34-a383-4b0f-a647-699e2fd03f6f"],

