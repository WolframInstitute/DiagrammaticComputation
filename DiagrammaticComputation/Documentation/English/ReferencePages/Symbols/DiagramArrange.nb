Cell["\<\
Arrangement of a composition introduces wires to align ports:\
\>", "ExampleText",ExpressionUUID->"78a028cb-6479-4c86-94d0-03bb5eaa2362"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"d", " ", "=", " ", 
   RowBox[{"DiagramRightComposition", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"Diagram", "[", 
      RowBox[{"A", ",", " ", "a", ",", " ", "x"}], "]"}], ",", "\n", "  ", 
     RowBox[{"DiagramProduct", "[", 
      RowBox[{
       RowBox[{"Diagram", "[", 
        RowBox[{"B", ",", " ", "x", ",", " ", "b"}], "]"}], ",", " ", 
       RowBox[{"Diagram", "[", 
        RowBox[{"C", ",", " ", "y", ",", " ", "c"}], "]"}]}], "]"}], ",", 
     "\n", "  ", 
     RowBox[{"Diagram", "[", 
      RowBox[{"D", ",", " ", 
       RowBox[{"{", 
        RowBox[{"c", ",", " ", "b"}], "}"}], ",", " ", 
       RowBox[{"{", "}"}]}], "]"}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{"DiagramDecompose", " ", "@", " ", 
  RowBox[{"DiagramArrange", "[", "d", "]"}]}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"3c4764be-ec0a-4010-ac50-0a4e4ccfe3f3"],

