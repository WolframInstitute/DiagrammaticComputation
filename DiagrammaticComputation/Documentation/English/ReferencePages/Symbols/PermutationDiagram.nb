Cell["PermutationDiagram", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"509d9f81-4508-49e4-aaad-d1ea61368766"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["PermutationDiagram"]], 
     "paclet:Wolfram/DiagrammaticComputation/ref/PermutationDiagram", 
     "Wolfram/DiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"{", 
    RowBox[{
     SubscriptBox[
      StyleBox["p", "TI"], 
      StyleBox["1", "TR"]], ",", " ", 
     SubscriptBox[
      StyleBox["p", "TI"], 
      StyleBox["2", "TR"]], ",", " ", "\[Ellipsis]"}], "}"}], "]"}]], 
  "InlineFormula",ExpressionUUID->"90607900-ea75-4a0d-9f94-246146faa185"],
 " ",
 "creates a diagram connecting the input ports ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["p", "TI"], 
    StyleBox["i", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "f311eebb-b434-4742-8633-a1407c699f0f"],
 " to their ordered sequence as outputs.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"6f53aae4-3191-49bc-998d-2f158ac989d0"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["PermutationDiagram"]], 
     "paclet:Wolfram/DiagrammaticComputation/ref/PermutationDiagram", 
     "Wolfram/DiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["p", "TI"], 
       StyleBox["1", "TR"]], ",", " ", "\[Ellipsis]", ",", " ", 
      SubscriptBox[
       StyleBox["p", "TI"], 
       StyleBox["n", "TI"]]}], "}"}], " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       SubscriptBox[
        StyleBox["p", "TI"], 
        StyleBox["i_", "TI"]], "1"}], ",", " ", "\[Ellipsis]", ",", " ", 
      SubscriptBox[
       StyleBox["p", "TI"], 
       StyleBox["i_n", "TI"]]}], "}"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"4b6b510f-756d-4aca-9c7f-c66013f47c05"],
 " ",
 "provides input ports and their explicit permutation as outputs.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"5920dd34-f3bc-4a92-83ad-aff756b24a1e"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["PermutationDiagram"]], 
     "paclet:Wolfram/DiagrammaticComputation/ref/PermutationDiagram", 
     "Wolfram/DiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["p", "TI"], 
       StyleBox["1", "TR"]], ",", " ", "\[Ellipsis]"}], "}"}], ",", " ", 
    StyleBox["perm", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "9f69dd64-672f-4e26-ad61-9f0f2612e62b"],
 " ",
 "applies the permutation ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"p", "e", "r", "m"}], "TI"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"e564963c-37e8-40a8-a344-6f6e02137c2b"],
 " (as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Cycles"]], "paclet:ref/Cycles"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "44267ef1-c12e-47a7-b749-86e6c8eb78cd"],
 " or list) to the input ports.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"d2c4140f-9bc4-4920-aed0-6f61d1704549"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["PermutationDiagram"]], 
     "paclet:Wolfram/DiagrammaticComputation/ref/PermutationDiagram", 
     "Wolfram/DiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["p", "TI"], 
       StyleBox["1", "TR"]], ",", " ", "\[Ellipsis]", ",", " ", 
      SubscriptBox[
       StyleBox["p", "TI"], 
       StyleBox["n", "TI"]]}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["q", "TI"], 
       StyleBox["1", "TR"]], ",", " ", "\[Ellipsis]", ",", " ", 
      SubscriptBox[
       StyleBox["q", "TI"], 
       StyleBox["n", "TI"]]}], "}"}], ",", " ", 
    StyleBox["perm", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "21e63cb9-3f9b-4ab3-bd79-29b94ab591d8"],
 " ",
 "permutes the inputs and renames the outputs."
}], "Usage",ExpressionUUID->"2d42b061-f4c9-4e6e-a885-dc33667a8555"],

Cell[TextData[{
 "Permutation diagrams are pure wires with crossings; they have no internal \
node and rendered shape ",
 Cell[BoxData[
  RowBox[{"\"\<Wires\>\"", "[", "\[Ellipsis]", "]"}]], "InlineFormula",
  ExpressionUUID->"355c45dd-7aed-40b8-a43d-9872b2e8468c"],
 "."
}], "Notes",ExpressionUUID->"ca6b229a-3c81-4f73-9c94-26a571ccba41"],

Cell[TextData[{
 "They carry an ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Interpretation",
    BaseStyle->"Link"], "[", 
   RowBox[{"\"\<\!\(\*StyleBox[\"\[Pi]\", \"TR\"]\)\>\"", ",", " ", 
    "\[Ellipsis]"}], "]"}]], "InlineFormula",ExpressionUUID->
  "79694240-c9bd-49af-a46f-8b87d257088d"],
 " label so the underlying permutation is preserved through composition."
}], "Notes",ExpressionUUID->"16c82970-b971-4876-b2e7-03203d78b550"]
}, Open  ]],

