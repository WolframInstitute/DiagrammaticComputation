Cell["PermutationDiagram", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"140ec9ec-db48-4987-ac75-1ad9c1d426f8"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["PermutationDiagram"]], 
     "paclet:WolframDiagrammaticComputation/ref/PermutationDiagram", 
     "WolframDiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"{", 
    RowBox[{
     SubscriptBox[
      StyleBox["p", "TI"], 
      StyleBox["1", "TR"]], ",", " ", 
     SubscriptBox[
      StyleBox["p", "TI"], 
      StyleBox["2", "TR"]], ",", " ", "\[Ellipsis]"}], "}"}], "]"}]], 
  "InlineFormula",ExpressionUUID->"16710959-263b-42bb-94e1-7a44137e8164"],
 " ",
 "creates a diagram connecting the input ports ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["p", "TI"], 
    StyleBox["i", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "9d2b9ae3-a961-4e51-bc85-9088bc0c2000"],
 " to their ordered sequence as outputs.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"2b3f39c4-437a-4556-a0c8-ea1bbcb233c3"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["PermutationDiagram"]], 
     "paclet:WolframDiagrammaticComputation/ref/PermutationDiagram", 
     "WolframDiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["p", "TI"], 
       StyleBox["1", "TR"]], ",", " ", "\[Ellipsis]", ",", " ", 
      SubscriptBox[
       StyleBox["p", "TI"], 
       StyleBox["n", "TI"]]}], "}"}], " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       SubscriptBox[
        StyleBox["p", "TI"], 
        StyleBox["i_", "TI"]], "1"}], ",", " ", "\[Ellipsis]", ",", " ", 
      SubscriptBox[
       StyleBox["p", "TI"], 
       StyleBox["i_n", "TI"]]}], "}"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"5aff0370-a8f1-4c24-96ac-1f9529e294d9"],
 " ",
 "provides input ports and their explicit permutation as outputs.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"4c7a27ad-4361-4412-8ced-4ad79611c634"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["PermutationDiagram"]], 
     "paclet:WolframDiagrammaticComputation/ref/PermutationDiagram", 
     "WolframDiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["p", "TI"], 
       StyleBox["1", "TR"]], ",", " ", "\[Ellipsis]"}], "}"}], ",", " ", 
    StyleBox["perm", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "8d0eca31-2f3e-4453-bb90-751f0f60e6a9"],
 " ",
 "applies the permutation ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"p", "e", "r", "m"}], "TI"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"2bedfcc2-0a49-404e-bf8e-0dea5fa6e040"],
 " (as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Cycles"]], "paclet:ref/Cycles"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "25550127-524a-4a10-a7f7-5ce204942a9f"],
 " or list) to the input ports.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"cf945436-0972-4c04-b2b0-92213aed983b"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["PermutationDiagram"]], 
     "paclet:WolframDiagrammaticComputation/ref/PermutationDiagram", 
     "WolframDiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["p", "TI"], 
       StyleBox["1", "TR"]], ",", " ", "\[Ellipsis]", ",", " ", 
      SubscriptBox[
       StyleBox["p", "TI"], 
       StyleBox["n", "TI"]]}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["q", "TI"], 
       StyleBox["1", "TR"]], ",", " ", "\[Ellipsis]", ",", " ", 
      SubscriptBox[
       StyleBox["q", "TI"], 
       StyleBox["n", "TI"]]}], "}"}], ",", " ", 
    StyleBox["perm", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "13079c53-114c-45c3-a8ec-9af6ae331e3a"],
 " ",
 "permutes the inputs and renames the outputs."
}], "Usage",ExpressionUUID->"5b1d3686-d78c-45b7-b514-4702cc49f7df"],

Cell[TextData[{
 "Permutation diagrams are pure wires with crossings; they have no internal \
node and rendered shape ",
 Cell[BoxData[
  RowBox[{"\"\<Wires\>\"", "[", "\[Ellipsis]", "]"}]], "InlineFormula",
  ExpressionUUID->"5090ce0b-340a-4b76-8e8a-f2b1b94198db"],
 "."
}], "Notes",ExpressionUUID->"c3d049b5-7561-4ce4-ba93-7ef1803b17a8"],

Cell[TextData[{
 "They carry an ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Interpretation",
    BaseStyle->"Link"], "[", 
   RowBox[{"\"\<\!\(\*StyleBox[\"\[Pi]\", \"TR\"]\)\>\"", ",", " ", 
    "\[Ellipsis]"}], "]"}]], "InlineFormula",ExpressionUUID->
  "fcb3fe19-9b92-4696-911c-9cd96d821a0b"],
 " label so the underlying permutation is preserved through composition."
}], "Notes",ExpressionUUID->"222df660-05d8-452a-af89-6770c2616b96"]
}, Open  ]],

