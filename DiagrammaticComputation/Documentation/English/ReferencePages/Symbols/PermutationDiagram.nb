Cell[CellGroupData[{
Cell["PermutationDiagram", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"76b650e2-adc7-4a90-a0b8-4e692909eff7"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["PermutationDiagram",
    BaseStyle->"Link",
    ButtonData->
     "paclet:Wolfram/DiagrammaticComputation/ref/PermutationDiagram"], "[", 
   RowBox[{"{", 
    RowBox[{
     SubscriptBox[
      StyleBox["p", "TI"], 
      StyleBox["1", "TR"]], ",", " ", 
     SubscriptBox[
      StyleBox["p", "TI"], 
      StyleBox["2", "TR"]], ",", " ", "\[Ellipsis]"}], "}"}], "]"}]], 
  "InlineFormula",ExpressionUUID->"54a04174-7a2e-44c9-bd52-3a4481b8db07"],
 " ",
 "creates a diagram connecting the input ports ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["p", "TI"], 
    StyleBox["i", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "ad2f2ebd-37e5-45b3-b714-be3c67575b2e"],
 " to their ordered sequence as outputs.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"fb82d238-10cd-4cb3-b4e0-dc320b273373"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["PermutationDiagram",
    BaseStyle->"Link",
    ButtonData->
     "paclet:Wolfram/DiagrammaticComputation/ref/PermutationDiagram"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["p", "TI"], 
       StyleBox["1", "TR"]], ",", " ", "\[Ellipsis]", ",", " ", 
      SubscriptBox[
       StyleBox["p", "TI"], 
       StyleBox["n", "TI"]]}], "}"}], " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       SubscriptBox[
        StyleBox["p", "TI"], 
        StyleBox["i_", "TI"]], "1"}], ",", " ", "\[Ellipsis]", ",", " ", 
      SubscriptBox[
       StyleBox["p", "TI"], 
       StyleBox["i_n", "TI"]]}], "}"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"540a9c1a-4cd2-4bce-a9a0-8e401745d952"],
 " ",
 "provides input ports and their explicit permutation as outputs.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"a91e7894-8a7f-4445-b434-c676be09d401"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["PermutationDiagram",
    BaseStyle->"Link",
    ButtonData->
     "paclet:Wolfram/DiagrammaticComputation/ref/PermutationDiagram"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["p", "TI"], 
       StyleBox["1", "TR"]], ",", " ", "\[Ellipsis]"}], "}"}], ",", " ", 
    StyleBox["perm", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "d7cce643-4078-43b7-a55c-c651e16f7617"],
 " ",
 "applies the permutation ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"p", "e", "r", "m"}], "TI"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"6f163ecd-a105-4b5f-9d3c-977d418ebc65"],
 " (as ",
 Cell[BoxData[
  ButtonBox["Cycles",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Cycles"]], "InlineFormula",ExpressionUUID->
  "8e34f4c4-da54-40b1-a5d5-1835bcf1fe8d"],
 " or list) to the input ports.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"f1d85403-4187-4437-a70d-d340f2b93108"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["PermutationDiagram",
    BaseStyle->"Link",
    ButtonData->
     "paclet:Wolfram/DiagrammaticComputation/ref/PermutationDiagram"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["p", "TI"], 
       StyleBox["1", "TR"]], ",", " ", "\[Ellipsis]", ",", " ", 
      SubscriptBox[
       StyleBox["p", "TI"], 
       StyleBox["n", "TI"]]}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["q", "TI"], 
       StyleBox["1", "TR"]], ",", " ", "\[Ellipsis]", ",", " ", 
      SubscriptBox[
       StyleBox["q", "TI"], 
       StyleBox["n", "TI"]]}], "}"}], ",", " ", 
    StyleBox["perm", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "a3d3a9d9-81b1-4a6a-915f-084e3542a8d5"],
 " ",
 "permutes the inputs and renames the outputs."
}], "Usage",ExpressionUUID->"0ecc45ce-133e-40cb-a7a1-c80fd90107bd"],

Cell[TextData[{
 "Permutation diagrams are pure wires with crossings; they have no internal \
node and rendered shape ",
 Cell[BoxData[
  RowBox[{"\"\<Wires\>\"", "[", "\[Ellipsis]", "]"}]], "InlineFormula",
  ExpressionUUID->"3d5acbe6-14d3-4c29-a9dd-fc8db9ec1f84"],
 "."
}], "Notes",ExpressionUUID->"37ebd023-6cc0-4caa-b8e4-530612df3230"],

Cell[TextData[{
 "They carry an ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Interpretation",
    BaseStyle->"Link"], "[", 
   RowBox[{"\"\<\!\(\*StyleBox[\"\[Pi]\", \"TR\"]\)\>\"", ",", " ", 
    "\[Ellipsis]"}], "]"}]], "InlineFormula",ExpressionUUID->
  "dcc59126-98cd-4b20-bd7f-2ea8ef2d3b1c"],
 " label so the underlying permutation is preserved through composition."
}], "Notes",ExpressionUUID->"44647c82-e1a2-43ee-af14-9a350410dae2"]
}, Open  ]],

