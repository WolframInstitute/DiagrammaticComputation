Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"0a618d15-117e-4706-bb15-848e4de50adc"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["DiagramPosition",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/DiagramPosition"],
    "[", 
   RowBox[{
    StyleBox["d", "TI"], ",", " ", 
    StyleBox["patt", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "f65d3bf5-25de-4f44-8747-cb416fed9c50"],
 " ",
 "returns the positions of subdiagrams of ",
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "9ca67d30-8427-4a51-9601-da6a3eea382d"],
 " matching the ",
 Cell[BoxData[
  ButtonBox["DiagramPattern",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/DiagramPattern"]], 
  "InlineFormula",ExpressionUUID->"656a9dc9-1a51-4114-abc7-835d2439387c"],
 " ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"p", "a", "t", "t"}], "TI"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"6c60dbaa-aa42-4c33-945e-d4b8719a27c5"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"faf50423-8371-4f8b-809d-a1e66adfdcad"],

Cell[TextData[{
 "Behaves like ",
 Cell[BoxData[
  ButtonBox["Position",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Position"]], "InlineFormula",ExpressionUUID->
  "1b9dc07f-b233-49e5-85d7-2f4584b17b29"],
 ", but matching is by diagram structure (via ",
 Cell[BoxData[
  ButtonBox["DiagramPattern",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/DiagramPattern"]], 
  "InlineFormula",ExpressionUUID->"7d48ba9f-5c45-4206-b5ab-144cecd7d5f1"],
 ") rather than by raw expression."
}], "Notes",ExpressionUUID->"b8eb19b4-a6b3-4869-9bbe-1f8571e42405"]
}, Open  ]],

