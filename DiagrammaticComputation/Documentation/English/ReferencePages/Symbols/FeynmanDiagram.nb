Cell[CellGroupData[{
Cell["FeynmanDiagram", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"226718fd-bf6b-46ef-a548-868e7d0f4ae2"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FeynmanDiagram"]], 
     "paclet:WolframDiagrammaticComputation/ref/FeynmanDiagram", 
     "WolframDiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["graph", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "f51625c8-749b-44fb-9f5d-cac3c4421d16"],
 " ",
 "constructs a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Diagram"]], 
    "paclet:WolframDiagrammaticComputation/ref/Diagram", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "73ad1855-f4f4-473d-b429-1a1b58a6618d"],
 " network from the topology graph ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"g", "r", "a", "p", "h"}], "TI"], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"abe0fb60-2c38-4cf2-8c9e-b67ba89ab803"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"a22803ad-7816-4153-b5d9-6643abc6111e"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"g", "r", "a", "p", "h"}], "TI"], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"74f65963-8e0c-40f9-960b-3d392e926eec"],
 " is a topology graph as produced by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TopologyGraph"]], 
    "paclet:WolframDiagrammaticComputation/ref/TopologyGraph", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b73428cd-7cb8-42af-8281-c208feef8277"],
 " or ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TopologyGraphs"]], 
    "paclet:WolframDiagrammaticComputation/ref/TopologyGraphs", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "bd32c8e8-30ca-49e7-90ec-9505ffb2d1b8"],
 " \[LongDash] its vertices are interaction points and external legs, its \
tagged edges are propagators."
}], "Notes",ExpressionUUID->"5feaed29-da2a-4e7d-967e-0389c364abcc"],

Cell[TextData[{
 "Each vertex becomes a subdiagram (a point for interaction vertices, an \
invisible node for external legs) and each propagator becomes a wire, \
rendered with the line style conventional for its FeynArts propagator type \
(wiggly for gauge bosons, dashed for scalars and ghosts, straight for \
fermions) via ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["WigglyArcFunction"]], 
    "paclet:WolframDiagrammaticComputation/ref/WigglyArcFunction", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7654027f-2d46-4939-88a5-4313ad910dd7"],
 "."
}], "Notes",ExpressionUUID->"43c209c8-9917-4d1c-a536-d0feba1e3317"],

Cell[TextData[{
 "When the edges carry field insertions (from ",
 Cell[BoxData[
 "FeynArts`InsertFields"], "InlineFormula",ExpressionUUID->
  "fcc02249-b001-49f7-bcbb-b9437566aa0a"],
 " via ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TopologyGraphs"]], 
    "paclet:WolframDiagrammaticComputation/ref/TopologyGraphs", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "55bbbc96-b8fa-4fa2-9ef7-b58eee3153e9"],
 "), the wires are labelled with the LaTeX-typeset field names."
}], "Notes",ExpressionUUID->"ef2f1ec3-596c-4f86-8576-1df3a71f0829"],

