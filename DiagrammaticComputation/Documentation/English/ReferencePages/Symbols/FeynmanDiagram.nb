Cell[BoxData[
 RowBox[{"FeynmanDiagram", "[", 
  RowBox[{"TopologyGraph", "[", 
   RowBox[{"First", " ", "@", " ", 
    RowBox[{"CreateTopologies", "[", 
     RowBox[{"0", ",", " ", 
      RowBox[{"2", " ", "->", " ", "2"}]}], "]"}]}], "]"}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"dd46c475-c06e-462e-8c85-6032ada358f6"],

Cell[BoxData[
 GraphicsBox[
  NamespaceBox["Diagram",
   DynamicModuleBox[{Typeset`d = HoldComplete[
     Wolfram`DiagrammaticComputation`Diagram`Diagram[<|
      "DiagramOptions" -> {
        "PortArrows" -> {{}, {}}, "PortLabels" -> {{}, {}}, "ShowWireLabels" -> 
         True, "WireLabelFunction" -> (Placed[
           Replace[
            Quiet[
             FeynArts`TheLabel[
              Part[
               Replace[
                #3["Expression"], Interpretation[
                  Pattern[
                  Wolfram`DiagrammaticComputation`Diagram`Feynman`Private`x, 
                   Blank[]], 
                  Blank[]] :> 
                Wolfram`DiagrammaticComputation`Diagram`Feynman`Private`x], 
               3, -1]]], {
            Pattern[Wolfram`DiagrammaticComputation`Diagram`Feynman`Private`l, 
               Blank[String]] :> 
             MaTeX`MaTeX[
              Wolfram`DiagrammaticComputation`Diagram`Feynman`Private`l], 
             Blank[] -> ""}], 
           Offset[{-0.02, 0.05}]]& ), "Arrange" -> False, Alignment -> 
         Center}, "Expression" :> 
       Wolfram`DiagrammaticComputation`Diagram`DiagramNetwork[
         Wolfram`DiagrammaticComputation`Diagram`Diagram[<|
          "DiagramOptions" -> {
            "PortArrows" -> {{}, {
               Wolfram`DiagrammaticComputation`Diagram`Feynman`\
WigglyArcFunction[
                 ToString[
                  FeynArts`PropagatorType[
                   Part[
                    DirectedEdge[1, 5, {1, FeynArts`Incoming}], 3, -1]]], 0, 
                 Replace[
                  FeynArts`PropagatorArrow[
                   Part[
                    DirectedEdge[1, 5, {1, FeynArts`Incoming}], 3, -1]], {
                  Forward -> -1, Backward -> 1, None -> 0}], "Amplitude" -> 
                 If[#2 === "Net", 0.01, 0.005] 11.180339887498949`, 
                 "Frequency" -> If[#2 === "Net", 10, 30]/11.180339887498949`, 
                 "TaperFraction" -> 0][
                 If[#2 === "Net", 
                  Line[{{0., 15.}, {10., 10.}}], 
                  BSplineCurve[#]]]& }}, 
             "PortLabels" -> {Automatic, {Automatic}}, "Shape" -> None, 
             "LabelFunction" -> (""& ), "Center" -> {0., 15.}}, "Expression" :> 
           1, "InputPorts" -> {}, "OutputPorts" -> {
             
             Wolfram`DiagrammaticComputation`Port`Port[<|
              "Expression" :> DirectedEdge[1, 5, {1, FeynArts`Incoming}], 
               "NeutralQ" -> False, "Tags" -> {}, 
               "Type" -> \[FormalCapitalT]|>]}|>], 
         Wolfram`DiagrammaticComputation`Diagram`Diagram[<|
          "DiagramOptions" -> {
            "PortArrows" -> {{}, {
               Wolfram`DiagrammaticComputation`Diagram`Feynman`\
WigglyArcFunction[
                 ToString[
                  FeynArts`PropagatorType[
                   Part[
                    DirectedEdge[2, 5, {1, FeynArts`Incoming}], 3, -1]]], 0, 
                 Replace[
                  FeynArts`PropagatorArrow[
                   Part[
                    DirectedEdge[2, 5, {1, FeynArts`Incoming}], 3, -1]], {
                  Forward -> -1, Backward -> 1, None -> 0}], "Amplitude" -> 
                 If[#2 === "Net", 0.01, 0.005] 11.180339887498949`, 
                 "Frequency" -> If[#2 === "Net", 10, 30]/11.180339887498949`, 
                 "TaperFraction" -> 0][
                 If[#2 === "Net", 
                  Line[{{0., 5.}, {10., 10.}}], 
                  BSplineCurve[#]]]& }}, 
             "PortLabels" -> {Automatic, {Automatic}}, "Shape" -> None, 
             "LabelFunction" -> (""& ), "Center" -> {0., 5.}}, "Expression" :> 
           2, "InputPorts" -> {}, "OutputPorts" -> {
             
             Wolfram`DiagrammaticComputation`Port`Port[<|
              "Expression" :> DirectedEdge[2, 5, {1, FeynArts`Incoming}], 
               "NeutralQ" -> False, "Tags" -> {}, 
               "Type" -> \[FormalCapitalT]|>]}|>], 
         Wolfram`DiagrammaticComputation`Diagram`Diagram[<|
          "DiagramOptions" -> {
            "PortArrows" -> {{Automatic}, {}}, 
             "PortLabels" -> {{Automatic}, Automatic}, "Shape" -> None, 
             "LabelFunction" -> (""& ), "Center" -> {20, 15.}}, "Expression" :> 
           3, "InputPorts" -> {
             
             Wolfram`DiagrammaticComputation`Port`Port[<|
              "Expression" :> Wolfram`DiagrammaticComputation`Port`PortDual[
                 DirectedEdge[5, 3, {1, FeynArts`Outgoing}]], "NeutralQ" -> 
               False, "Tags" -> {}, "Type" -> 
               SuperStar[\[FormalCapitalT]]|>]}, "OutputPorts" -> {}|>], 
         Wolfram`DiagrammaticComputation`Diagram`Diagram[<|
          "DiagramOptions" -> {
            "PortArrows" -> {{Automatic}, {}}, 
             "PortLabels" -> {{Automatic}, Automatic}, "Shape" -> None, 
             "LabelFunction" -> (""& ), "Center" -> {20, 5.}}, "Expression" :> 
           4, "InputPorts" -> {
             
             Wolfram`DiagrammaticComputation`Port`Port[<|
              "Expression" :> Wolfram`DiagrammaticComputation`Port`PortDual[
                 DirectedEdge[5, 4, {1, FeynArts`Outgoing}]], "NeutralQ" -> 
               False, "Tags" -> {}, "Type" -> 
               SuperStar[\[FormalCapitalT]]|>]}, "OutputPorts" -> {}|>], 
         Wolfram`DiagrammaticComputation`Diagram`Diagram[<|
          "DiagramOptions" -> {
            "PortArrows" -> {{Automatic, Automatic}, {
               Wolfram`DiagrammaticComputation`Diagram`Feynman`\
WigglyArcFunction[
                 ToString[
                  FeynArts`PropagatorType[
                   Part[
                    DirectedEdge[5, 3, {1, FeynArts`Outgoing}], 3, -1]]], 0, 
                 Replace[
                  FeynArts`PropagatorArrow[
                   Part[
                    DirectedEdge[5, 3, {1, FeynArts`Outgoing}], 3, -1]], {
                  Forward -> -1, Backward -> 1, None -> 0}], "Amplitude" -> 
                 If[#2 === "Net", 0.01, 0.005] 11.180339887498949`, 
                 "Frequency" -> If[#2 === "Net", 10, 30]/11.180339887498949`, 
                 "TaperFraction" -> 0][
                 If[#2 === "Net", 
                  Line[{{10., 10.}, {20., 15.}}], 
                  BSplineCurve[#]]]& , 
                Wolfram`DiagrammaticComputation`Diagram`Feynman`\
WigglyArcFunction[
                 ToString[
                  FeynArts`PropagatorType[
                   Part[
                    DirectedEdge[5, 4, {1, FeynArts`Outgoing}], 3, -1]]], 0, 
                 Replace[
                  FeynArts`PropagatorArrow[
                   Part[
                    DirectedEdge[5, 4, {1, FeynArts`Outgoing}], 3, -1]], {
                  Forward -> -1, Backward -> 1, None -> 0}], "Amplitude" -> 
                 If[#2 === "Net", 0.01, 0.005] 11.180339887498949`, 
                 "Frequency" -> If[#2 === "Net", 10, 30]/11.180339887498949`, 
                 "TaperFraction" -> 0][
                 If[#2 === "Net", 
                  Line[{{10., 10.}, {20., 5.}}], 
                  BSplineCurve[#]]]& }}, 
             "PortLabels" -> {{Automatic, Automatic}, {Automatic, Automatic}},
              "Shape" -> "Point", "LabelFunction" -> (""& ), 
             "Center" -> {10., 10.}}, "Expression" :> 5, "InputPorts" -> {
             
             Wolfram`DiagrammaticComputation`Port`Port[<|
              "Expression" :> Wolfram`DiagrammaticComputation`Port`PortDual[
                 DirectedEdge[1, 5, {1, FeynArts`Incoming}]], "NeutralQ" -> 
               False, "Tags" -> {}, "Type" -> SuperStar[\[FormalCapitalT]]|>], 
             
             Wolfram`DiagrammaticComputation`Port`Port[<|
              "Expression" :> Wolfram`DiagrammaticComputation`Port`PortDual[
                 DirectedEdge[2, 5, {1, FeynArts`Incoming}]], "NeutralQ" -> 
