Cell[BoxData[{
 RowBox[{
  RowBox[{"ins", " ", "=", " ", 
   RowBox[{"InsertFields", "[", 
    RowBox[{
     RowBox[{"CreateTopologies", "[", 
      RowBox[{"0", ",", " ", 
       RowBox[{"2", " ", "->", " ", "2"}]}], "]"}], ",", "\n", "  ", 
