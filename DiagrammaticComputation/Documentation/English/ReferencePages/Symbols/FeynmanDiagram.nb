Cell[CellGroupData[{
Cell["FeynmanDiagram", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"a351d8a0-7dd5-4c72-84b0-a97d56ea17f1"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FeynmanDiagram"]], 
     "paclet:Wolfram/DiagrammaticComputation/ref/FeynmanDiagram", 
     "Wolfram/DiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["graph", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "ce395503-d4b4-46d7-b73d-978d6796fb88"],
 " ",
 "constructs a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Diagram"]], 
    "paclet:Wolfram/DiagrammaticComputation/ref/Diagram", 
    "Wolfram/DiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d5c83d59-8b0c-4f40-8397-4ecb20ab16fd"],
 " network from the topology graph ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"g", "r", "a", "p", "h"}], "TI"], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"c94471a7-dfd2-4956-bf3d-e7291cd780d8"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"e0125e7e-158c-4ef1-bf15-ab12b9936792"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"g", "r", "a", "p", "h"}], "TI"], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"59751fb7-46b6-4844-abd2-00cb51a7c9ad"],
 " is a topology graph as produced by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TopologyGraph"]], 
    "paclet:Wolfram/DiagrammaticComputation/ref/TopologyGraph", 
    "Wolfram/DiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3920a788-c395-437c-ae22-bef6bc4e5a55"],
 " or ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TopologyGraphs"]], 
    "paclet:Wolfram/DiagrammaticComputation/ref/TopologyGraphs", 
    "Wolfram/DiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e4314934-0764-4481-8699-481b8973be28"],
 " \[LongDash] its vertices are interaction points and external legs, its \
tagged edges are propagators."
}], "Notes",ExpressionUUID->"be49e223-329e-4500-96c9-2ba33b97408e"],

Cell[TextData[{
 "Each vertex becomes a subdiagram (a point for interaction vertices, an \
invisible node for external legs) and each propagator becomes a wire, \
rendered with the line style conventional for its FeynArts propagator type \
(wiggly for gauge bosons, dashed for scalars and ghosts, straight for \
fermions) via ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["WigglyArcFunction"]], 
    "paclet:Wolfram/DiagrammaticComputation/ref/WigglyArcFunction", 
    "Wolfram/DiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "615d668e-5fe2-4359-81a3-307e45381683"],
 "."
}], "Notes",ExpressionUUID->"63e8a73f-d8cf-4eca-8a06-75abcaebdf00"],

Cell[TextData[{
 "When the edges carry field insertions (from ",
 Cell[BoxData[
 "FeynArts`InsertFields"], "InlineFormula",ExpressionUUID->
  "b5143a9a-1a01-49ce-9348-5e5487bdfb66"],
 " via ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TopologyGraphs"]], 
    "paclet:Wolfram/DiagrammaticComputation/ref/TopologyGraphs", 
    "Wolfram/DiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c60b8841-a241-4d75-950f-2e43d705a71f"],
 "), the wires are labelled with the LaTeX-typeset field names."
}], "Notes",ExpressionUUID->"32a647b0-d610-4091-bef1-955879b0ef66"],

Cell[TextData[{
 "Additional options are passed through to ",
