Cell[TextData[{
 "The result is an ordinary ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Diagram"]], 
    "paclet:Wolfram/DiagrammaticComputation/ref/Diagram", 
    "Wolfram/DiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "146c2c66-ffb3-488f-a39a-23493e92c3c4"],
 ", so all diagram operations (composition, surgery, rewriting) apply. For \
pure FeynArts-style rendering without the diagram structure, use ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FeynArtsTopologyGraphics"]], 
    "paclet:Wolfram/DiagrammaticComputation/ref/FeynArtsTopologyGraphics", 
    "Wolfram/DiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f32d3359-3f98-452f-875b-dff1e672be1f"],
 "."
}], "ExampleText",ExpressionUUID->"9cc30655-5610-4b79-8726-42c4346a20cf"]
}, Open  ]]
