    "paclet:Wolfram/DiagrammaticComputation/ref/DiagramNetwork", 
    "Wolfram/DiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7ce4294c-3e1f-40d9-b2d6-53774fad98cd"],
 "."
}], "Notes",ExpressionUUID->"070840cd-dc52-44cc-bd48-54ed3b6d8400"]
}, Open  ]],

