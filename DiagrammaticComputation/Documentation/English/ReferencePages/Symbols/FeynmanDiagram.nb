Cell[TextData[{
 "The result is an ordinary ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Diagram"]], 
    "paclet:WolframDiagrammaticComputation/ref/Diagram", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b9b6a2f7-274d-45d1-a06a-e6eefbf88c75"],
 ", so all diagram operations (composition, surgery, rewriting) apply. For \
pure FeynArts-style rendering without the diagram structure, use ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FeynArtsTopologyGraphics"]], 
    "paclet:WolframDiagrammaticComputation/ref/FeynArtsTopologyGraphics", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "27bf7362-f623-4ec1-b19e-72636c46c266"],
 "."
}], "ExampleText",ExpressionUUID->"5e5dd78e-e01b-4a53-a116-73ca1160d94a"]
}, Open  ]]
