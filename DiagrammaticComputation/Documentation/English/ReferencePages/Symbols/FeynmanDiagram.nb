   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8254b657-7221-408d-8a7d-9ae6665c119c"],
 "."
}], "Notes",ExpressionUUID->"61701392-72b4-4097-ace1-cec190f36b2e"]
}, Open  ]],

