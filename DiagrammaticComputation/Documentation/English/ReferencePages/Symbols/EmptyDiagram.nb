Cell["\<\
The empty diagram has no subdiagrams and identity port mappings (its input \
and output port lists are empty).\
\>", "Notes",ExpressionUUID->"58c337b4-2713-433b-a915-0bf2df0f97d4"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   RowBox[{"DiagramProduct", "[", 
    RowBox[{
     StyleBox["d", "TI"], ",", " ", 
     RowBox[{"EmptyDiagram", "[", "]"}]}], "]"}], " ", "==", " ", 
   StyleBox["d", "TI"]}]], "InlineFormula",ExpressionUUID->
  "2fea4107-85c0-4ea9-850f-3bb266720b1a"],
 " and similarly for any other position."
}], "Notes",ExpressionUUID->"3de9da74-630d-454f-a347-1f7d9e76f870"]
