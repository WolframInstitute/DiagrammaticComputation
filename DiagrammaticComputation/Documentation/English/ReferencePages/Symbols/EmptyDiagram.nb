Cell["EmptyDiagram", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"7e63105c-8fe8-4267-a961-2bb5d8657012"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["EmptyDiagram",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/EmptyDiagram"], "[",
    "]"}]], "InlineFormula",ExpressionUUID->
  "7ae82e36-265d-4df3-9db8-d2fa18a5d89e"],
 " ",
 "is the empty diagram \[LongDash] the unit of ",
 Cell[BoxData[
  ButtonBox["DiagramProduct",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/DiagramProduct"]], 
  "InlineFormula",ExpressionUUID->"a7741fb5-e46f-4784-b352-0f253462a4fa"],
 " and ",
 Cell[BoxData[
  ButtonBox["DiagramComposition",
   BaseStyle->"Link",
   ButtonData->
    "paclet:Wolfram/DiagrammaticComputation/ref/DiagramComposition"]], 
  "InlineFormula",ExpressionUUID->"2238db18-b3ca-493b-a7c1-5bca77fcb4d1"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"9d60e3ac-fc1b-4c38-a552-27be25011dd1"],

Cell["\<\
The empty diagram has no subdiagrams and identity port mappings (its input \
and output port lists are empty).\
\>", "Notes",ExpressionUUID->"e5d1f824-b365-4ff6-85a4-90a660cfb7d5"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   RowBox[{"DiagramProduct", "[", 
    RowBox[{
     StyleBox["d", "TI"], ",", " ", 
     RowBox[{"EmptyDiagram", "[", "]"}]}], "]"}], " ", "==", " ", 
   StyleBox["d", "TI"]}]], "InlineFormula",ExpressionUUID->
  "e6117a32-2b7c-440e-9625-4220ce18688f"],
 " and similarly for any other position."
}], "Notes",ExpressionUUID->"cadeafd7-98f1-4a92-adb2-fcaec9de1ccb"]
}, Open  ]],

