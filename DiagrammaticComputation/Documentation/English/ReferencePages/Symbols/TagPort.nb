 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["TagPort"]], 
     "paclet:Wolfram/DiagrammaticComputation/ref/TagPort", 
     "Wolfram/DiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["tag", "TI"], 
       StyleBox["1", "TR"]], ",", " ", 
      SubscriptBox[
       StyleBox["tag", "TI"], 
       StyleBox["2", "TR"]], ",", " ", "\[Ellipsis]"}], "}"}]}], "]"}]], 
  "InlineFormula",ExpressionUUID->"4e5919ba-d5e5-4fb5-9a8e-c0d89dd0bdc7"],
 " ",
 "attaches a list of tags."
}], "Usage",ExpressionUUID->"7ad103c8-b47b-4102-8cb9-7aa0e341db92"],

Cell[TextData[{
 "Tags are user-defined annotations stored in the port's ",
 Cell[BoxData["\"\<Tags\>\""], "InlineFormula",ExpressionUUID->
  "fc7d9490-597c-4afa-af5b-ae4fc986aefa"],
 " option. They are preserved by diagram composition and surgery but do not \
affect type matching."
}], "Notes",ExpressionUUID->"f4dabba6-aa15-4ebf-b1e5-c41584541858"],

Cell["\<\
Multiple tags accumulate: a second call adds to the existing tag list rather \
than replacing it.\
\>", "Notes",ExpressionUUID->"c5f117f0-23fb-4017-b30c-82a863e4ab52"]
}, Open  ]],

