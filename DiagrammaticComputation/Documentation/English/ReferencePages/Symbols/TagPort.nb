 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["TagPort"]], 
     "paclet:Wolfram/DiagrammaticComputation/ref/TagPort", 
     "Wolfram/DiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["tag", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "83143462-d0e5-47cc-a5fd-9cb9779b2773"],
 " ",
 "attaches the tag ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"t", "a", "g"}], "TI"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"ca1c7b18-661e-4a42-9041-35d2abd1200d"],
