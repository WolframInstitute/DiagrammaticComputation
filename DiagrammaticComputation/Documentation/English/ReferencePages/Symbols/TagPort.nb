Cell["TagPort", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"adf42326-33e2-4866-bfd1-91b961023b1c"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TagPort",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/TagPort"], "[", 
   RowBox[{
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["tag", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "976fe1aa-1b57-4acb-87dc-4b709d74aa6f"],
 " ",
 "attaches the tag ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"t", "a", "g"}], "TI"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"31ff0caf-81ea-40e5-860e-f914c636968c"],
 " to the port ",
 Cell[BoxData[
  FormBox[
   StyleBox["p", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "04b8701c-7e2f-4ef0-9015-124ff248bf02"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"5e24355e-cc98-48c6-a80b-665c9e456c40"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TagPort",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/TagPort"], "[", 
   RowBox[{
    StyleBox["p", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["tag", "TI"], 
       StyleBox["1", "TR"]], ",", " ", 
      SubscriptBox[
       StyleBox["tag", "TI"], 
       StyleBox["2", "TR"]], ",", " ", "\[Ellipsis]"}], "}"}]}], "]"}]], 
  "InlineFormula",ExpressionUUID->"2a65d6ce-2ed4-4e4e-af0c-fa4ec8561e2f"],
 " ",
 "attaches a list of tags."
}], "Usage",ExpressionUUID->"e82496ae-35db-416d-81a9-519f90c7f817"],

Cell[TextData[{
 "Tags are user-defined annotations stored in the port's ",
 Cell[BoxData["\"\<Tags\>\""], "InlineFormula",ExpressionUUID->
  "ea1c0612-0f4d-4734-a15f-1aba91d42d14"],
 " option. They are preserved by diagram composition and surgery but do not \
affect type matching."
}], "Notes",ExpressionUUID->"633f7c69-bf0e-418d-a584-3957b87c5c94"],

Cell["\<\
Multiple tags accumulate: a second call adds to the existing tag list rather \
than replacing it.\
\>", "Notes",ExpressionUUID->"aa6d514a-3e3e-454e-a7f0-3b46cafb1cda"]
}, Open  ]],

