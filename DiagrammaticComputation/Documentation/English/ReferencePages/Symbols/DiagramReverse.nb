Cell["Reverse the port order of a diagram:", "ExampleText",ExpressionUUID->"d39f6428-247c-4d4b-aa8d-967477bdc794"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"DiagramReverse", "[", 
  RowBox[{"Diagram", "[", 
   RowBox[{"\"\<A\>\"", ",", " ", 
    RowBox[{"{", 
     RowBox[{"a", ",", " ", "b", ",", " ", "c"}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"x", ",", " ", "y"}], "}"}]}], "]"}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"e9b26080-b0c5-44d8-b93a-cf9928c1d9af"],

Cell[BoxData[
 GraphicsBox[
  NamespaceBox["Diagram",
   DynamicModuleBox[{Typeset`d = HoldComplete[
     Wolfram`DiagrammaticComputation`Diagram`Diagram[<|
      "DiagramOptions" -> {"PortArrows" -> {{
            Placed[Automatic, {{-0.4, 0.5}, {-0.4, 0.75}}], 
            Placed[Automatic, {{0., 0.5}, {0., 0.75}}], 
            Placed[Automatic, {{0.4, 0.5}, {0.4, 0.75}}]}, {
            Placed[
            Automatic, {{-0.2666666666666666, -0.5}, {-0.2666666666666666, \
-0.75}}], 
            Placed[
            Automatic, {{0.2666666666666667, -0.5}, {
             0.2666666666666667, -0.75}}]}}, 
         "PortLabels" -> {{Automatic, Automatic, Automatic}, {
           Automatic, Automatic}}}, "Expression" :> 
       Wolfram`DiagrammaticComputation`Diagram`DiagramReverse[
         Wolfram`DiagrammaticComputation`Diagram`Diagram[<|
          "DiagramOptions" -> {
            "PortArrows" -> {{Automatic, Automatic, Automatic}, {
               Automatic, Automatic}}, 
             "PortLabels" -> {{Automatic, Automatic, Automatic}, {
               Automatic, Automatic}}}, "Expression" :> "A", 
           "InputPorts" -> {
             
             Wolfram`DiagrammaticComputation`Port`Port[<|
              "Expression" :> 
               Wolfram`DiagrammaticComputation`Port`PortDual[
                FunctionRepository`$955258636fa042ac87af26c7567e2d7f`a], 
               "NeutralQ" -> False, "Tags" -> {}, "Type" -> 
               SuperStar[\[FormalCapitalT]]|>], 
             
             Wolfram`DiagrammaticComputation`Port`Port[<|
              "Expression" :> 
               Wolfram`DiagrammaticComputation`Port`PortDual[
                FunctionRepository`$955258636fa042ac87af26c7567e2d7f`b], 
