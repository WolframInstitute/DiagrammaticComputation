Cell[CellGroupData[{
Cell["DiagramReverse", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"80d96027-ff95-4c65-b4de-afb1d4921652"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["DiagramReverse",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/DiagramReverse"], 
   "[", 
   StyleBox["d", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "1c22247f-4ee3-4adc-a174-b32a05ff2323"],
 " ",
 "reflects the diagram ",
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "41a7e5e4-71ce-469c-b745-3ec043e4c989"],
 " horizontally \[LongDash] reverses the order of its input ports and the \
order of its output ports.",
 "\n"
}], "Usage",ExpressionUUID->"fac3df30-47df-4e37-813d-05cb2278d362"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["DiagramReverse",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/DiagramReverse"]], 
  "InlineFormula",ExpressionUUID->"7a41b597-f938-4808-991d-6dfdf14ea235"],
 " is an involution."
}], "Notes",ExpressionUUID->"adb2444e-fd6e-4c66-a9fb-2c81aed2dee3"],

Cell["\<\
It does not change port directions; only the ordering of inputs and outputs \
is reversed.\
\>", "Notes",ExpressionUUID->"d7537861-fc92-4270-ad37-9e27fd8b2153"]
}, Open  ]],

