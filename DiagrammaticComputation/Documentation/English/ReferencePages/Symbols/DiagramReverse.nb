Cell[CellGroupData[{
Cell["DiagramReverse", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"36200a28-63f3-4d62-962f-65433b4c893f"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DiagramReverse"]], 
     "paclet:WolframDiagrammaticComputation/ref/DiagramReverse", 
     "WolframDiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["d", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "858d5edd-8bbe-4849-88b8-72cbd50cfe1e"],
 " ",
 "reflects the diagram ",
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "270f66d8-676f-4c57-afda-6625df5e9c07"],
 " horizontally \[LongDash] reverses the order of its input ports and the \
order of its output ports.",
 "\n"
}], "Usage",ExpressionUUID->"8e8d8415-414b-476a-9d5e-6aed53d0551d"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramReverse"]], 
    "paclet:WolframDiagrammaticComputation/ref/DiagramReverse", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1cc86d65-0a51-4591-82d6-b51c16262be8"],
 " is an involution."
}], "Notes",ExpressionUUID->"71ca3031-ef87-4e4f-acc1-f3261eb9a4ff"],

Cell["\<\
It does not change port directions; only the ordering of inputs and outputs \
is reversed.\
\>", "Notes",ExpressionUUID->"3f9a2f12-8c45-41bf-8683-bd79930da2b5"]
}, Open  ]],

