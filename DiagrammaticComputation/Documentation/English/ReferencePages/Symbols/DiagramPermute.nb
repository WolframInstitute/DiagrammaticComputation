   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5a6a3ab2-0796-4420-9c19-32306e3a2138"],
 " after ",
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "f2b4c6ff-6537-41b9-924d-a426e8894ed9"],
 "; one within the inputs composes it before; a permutation crossing the \
boundary additionally bends wires like ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramSplit"]], 
    "paclet:Wolfram/DiagrammaticComputation/ref/DiagramSplit", 
    "Wolfram/DiagrammaticComputation Package Symbol"},
