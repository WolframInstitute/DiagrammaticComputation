 " ",
 "controls whether ports moved across the input/output boundary are \
dualised."
}], "Usage",ExpressionUUID->"62054d77-8689-472e-9db1-9a2596534141"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"p", "e", "r", "m"}], "TI"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"94447b43-01fb-479d-b43b-9ed0ccc96f8b"],
 " is a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Cycles"]], "paclet:ref/Cycles"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2fe66b49-3764-4ba5-9e08-8595e926b3ca"],
