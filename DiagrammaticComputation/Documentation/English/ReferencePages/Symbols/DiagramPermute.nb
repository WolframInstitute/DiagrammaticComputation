 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Permute"]], "paclet:ref/Permute"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "636ed75e-ddd8-4480-b492-5f9f8bbea6fb"],
 " accepts) acting on the flattened port list \[LongDash] output ports first, \
then input ports."
}], "Notes",ExpressionUUID->"f6fe4ec8-335e-42cf-9238-3f327a22af2b"],

Cell[TextData[{
 "A permutation within the outputs composes a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["PermutationDiagram"]], 
    "paclet:Wolfram/DiagrammaticComputation/ref/PermutationDiagram", 
    "Wolfram/DiagrammaticComputation Package Symbol"},
