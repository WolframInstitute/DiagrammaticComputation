Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"DiagramPermute", "[", 
  RowBox[{
   RowBox[{"Diagram", "[", 
    RowBox[{"A", ",", " ", 
     RowBox[{"{", 
      RowBox[{"a", ",", " ", "b"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"x", ",", " ", "y"}], "}"}]}], "]"}], ",", " ", 
   RowBox[{"Cycles", "[", 
