Cell[TextData[{
 "The rendering goes through the FeynArts shape database and renderer (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TopologyGraphics"]], 
    "paclet:Wolfram/DiagrammaticComputation/ref/TopologyGraphics", 
    "Wolfram/DiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8b9ed022-b163-473b-8e72-7e003b3348a2"],
 " + ",
 Cell[BoxData[
 "FeynArts`Graphics`DoRender"], "InlineFormula",ExpressionUUID->
  "621832e4-9512-409f-a6aa-7869e0b7fb34"],
 "), so the output matches what ",
 Cell[BoxData[
 "FeynArts`Paint"], "InlineFormula",ExpressionUUID->
  "e86ae454-48e7-4904-8833-a3b955e62b9f"],
 " produces."
}], "Notes",ExpressionUUID->"489e8735-15ef-46dc-9255-0ac46123c935"],

