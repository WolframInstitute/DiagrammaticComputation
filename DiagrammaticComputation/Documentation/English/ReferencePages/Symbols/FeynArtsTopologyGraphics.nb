Cell["FeynArtsTopologyGraphics", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"19e1a838-b86d-496d-9a9a-15edab9dff29"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FeynArtsTopologyGraphics"]], 
     "paclet:WolframDiagrammaticComputation/ref/FeynArtsTopologyGraphics", 
