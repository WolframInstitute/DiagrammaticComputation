 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Graphics"]], "paclet:ref/Graphics"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f5bc6d90-813b-4446-8fb3-19abcc296cc6"],
 " in the FeynArts house style.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"ba96bb81-ba2f-45fe-8b3f-bdd189679ab4"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FeynArtsTopologyGraphics"]], 
     "paclet:WolframDiagrammaticComputation/ref/FeynArtsTopologyGraphics", 
     "WolframDiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["topology", "TI"], " ", "->", " ", 
    StyleBox["insertions", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "4292ccac-96eb-468c-b896-eb85c3c08a3e"],
 " ",
 "renders one graphic per field insertion.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"2a03c4ed-b64e-424b-a23a-10e3e83b9b30"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
