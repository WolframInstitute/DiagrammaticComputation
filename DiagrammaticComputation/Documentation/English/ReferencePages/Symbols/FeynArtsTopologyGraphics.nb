 "."
}], "Usage",ExpressionUUID->"6aae74d1-a2fb-4a56-9d33-f11e83c5051b"],

Cell[TextData[{
 "The rendering goes through the FeynArts shape database and renderer (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TopologyGraphics"]], 
    "paclet:WolframDiagrammaticComputation/ref/TopologyGraphics", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b9b99812-4f89-48bd-bb85-4a9a470cb1c3"],
 " + ",
 Cell[BoxData[
 "FeynArts`Graphics`DoRender"], "InlineFormula",ExpressionUUID->
  "282891d3-64ab-4f71-bd33-52a0dbfe10dc"],
 "), so the output matches what ",
 Cell[BoxData[
 "FeynArts`Paint"], "InlineFormula",ExpressionUUID->
  "2db07d6f-f365-49f6-9973-a00726b6aef8"],
 " produces."
}], "Notes",ExpressionUUID->"b7a4de14-40a7-463e-bb5f-03114020a327"],

Cell[TextData[{
 "Returns a list of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Graphics"]], "paclet:ref/Graphics"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f5629ddc-1e13-487e-b5c8-d68bfc3a263a"],
 " objects, one per insertion (a single-element list when called on a bare \
topology)."
}], "Notes",ExpressionUUID->"f48a3331-cba5-49ea-a8e7-5d810efe78aa"]
