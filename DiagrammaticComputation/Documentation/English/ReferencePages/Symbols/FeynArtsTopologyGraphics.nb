Cell[TextData[{
 "The rendering goes through the FeynArts shape database and renderer (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TopologyGraphics"]], 
    "paclet:WolframDiagrammaticComputation/ref/TopologyGraphics", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "bb501a57-7aa1-46e8-a5ac-18461a09544f"],
 " + ",
 Cell[BoxData[
 "FeynArts`Graphics`DoRender"], "InlineFormula",ExpressionUUID->
  "506b61b6-f477-48b2-81ec-757d62c85067"],
 "), so the output matches what ",
 Cell[BoxData[
 "FeynArts`Paint"], "InlineFormula",ExpressionUUID->
  "d52ee591-d857-41a0-9deb-c46004b210a2"],
 " produces."
}], "Notes",ExpressionUUID->"5d555f6a-0ab4-4513-857e-2978d41f3a5c"],

Cell[TextData[{
 "Returns a list of ",
 Cell[BoxData[
  TemplateBox[{
