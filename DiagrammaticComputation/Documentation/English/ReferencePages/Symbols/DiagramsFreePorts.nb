Cell[CellGroupData[{
Cell["DiagramsFreePorts", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"0ac9df64-84d4-42b2-895e-ef1d28740e36"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DiagramsFreePorts"]], 
     "paclet:Wolfram/DiagrammaticComputation/ref/DiagramsFreePorts", 
     "Wolfram/DiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"{", 
    RowBox[{
     SubscriptBox[
      StyleBox["d", "TI"], 
      StyleBox["1", "TR"]], ",", " ", 
     SubscriptBox[
      StyleBox["d", "TI"], 
      StyleBox["2", "TR"]], ",", " ", "\[Ellipsis]"}], "}"}], "]"}]], 
  "InlineFormula",ExpressionUUID->"95f4a44f-45b1-4362-92d5-c6572548594f"],
 " ",
 "returns the free ports of the diagrams ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["d", "TI"], 
    StyleBox["i", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "b7d60997-6d17-485a-bffa-6c576408a847"],
 " \[LongDash] the ports whose expression occurs exactly once across all of \
them.",
 "\n"
}], "Usage",ExpressionUUID->"6b9512df-dd5a-43f7-adf1-d74cd04dc5e6"],

Cell[TextData[{
 "A port occurring twice (or more) is shared between subdiagrams and would be \
joined in a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramNetwork"]], 
    "paclet:Wolfram/DiagrammaticComputation/ref/DiagramNetwork", 
    "Wolfram/DiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "171c68c4-8e06-4df8-8905-c82b20a2b595"],
 " of the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["d", "TI"], 
    StyleBox["i", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "8a931045-b9d0-402b-b003-dcffe2e0a408"],
 "; the remaining single-occurrence ports are the network's boundary."
}], "Notes",ExpressionUUID->"4eb7fcbc-f755-4240-914e-39c33ac567e2"],

Cell[TextData[{
 "The result is a list of held port expressions; input ports appear wrapped \
in ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["PortDual"]], 
    "paclet:Wolfram/DiagrammaticComputation/ref/PortDual", 
    "Wolfram/DiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "754585ed-dc55-46c5-98c6-94dfe78d3e55"],
 "."
}], "Notes",ExpressionUUID->"1b42e011-e9b3-4ce1-891c-0237c7b6355a"]
}, Open  ]],

