Cell[CellGroupData[{
Cell["DiagramsFreePorts", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"89c149a0-f8d3-4bb5-aebb-853be6bfb20d"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DiagramsFreePorts"]], 
     "paclet:WolframDiagrammaticComputation/ref/DiagramsFreePorts", 
     "WolframDiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"{", 
    RowBox[{
     SubscriptBox[
      StyleBox["d", "TI"], 
      StyleBox["1", "TR"]], ",", " ", 
     SubscriptBox[
      StyleBox["d", "TI"], 
      StyleBox["2", "TR"]], ",", " ", "\[Ellipsis]"}], "}"}], "]"}]], 
  "InlineFormula",ExpressionUUID->"9175aa7c-a9d2-440f-be7b-89de01386d97"],
 " ",
 "returns the free ports of the diagrams ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["d", "TI"], 
    StyleBox["i", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "f7cff95c-919e-435d-8a71-c6565b327e1d"],
 " \[LongDash] the ports whose expression occurs exactly once across all of \
them.",
 "\n"
}], "Usage",ExpressionUUID->"38604200-a381-4a0f-a6ea-60e219467ba4"],

Cell[TextData[{
 "A port occurring twice (or more) is shared between subdiagrams and would be \
joined in a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramNetwork"]], 
    "paclet:WolframDiagrammaticComputation/ref/DiagramNetwork", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "99abec0a-5c88-4d75-9068-c26cb34b6f9c"],
 " of the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["d", "TI"], 
    StyleBox["i", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "730a4b16-8bb5-43f7-94b6-e69201cfa089"],
 "; the remaining single-occurrence ports are the network's boundary."
}], "Notes",ExpressionUUID->"1d73d99b-58f0-4fb1-a07c-bf173ad292be"],

Cell[TextData[{
 "The result is a list of held port expressions; input ports appear wrapped \
in ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["PortDual"]], 
    "paclet:WolframDiagrammaticComputation/ref/PortDual", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c042c70a-dfe9-4787-8858-c7fea4858bf4"],
 "."
}], "Notes",ExpressionUUID->"e3655073-24a6-4d51-aff3-3c5ec80f285a"]
}, Open  ]],

