Cell[CellGroupData[{
Cell["DiagramsFreePorts", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"e8ba22a3-ed8e-4879-8914-f6b8ea97fa18"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DiagramsFreePorts"]], 
     "paclet:WolframDiagrammaticComputation/ref/DiagramsFreePorts", 
     "WolframDiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"{", 
    RowBox[{
     SubscriptBox[
      StyleBox["d", "TI"], 
      StyleBox["1", "TR"]], ",", " ", 
     SubscriptBox[
      StyleBox["d", "TI"], 
      StyleBox["2", "TR"]], ",", " ", "\[Ellipsis]"}], "}"}], "]"}]], 
  "InlineFormula",ExpressionUUID->"22ffa1d7-7e24-46d7-a79b-ebc6a04f0a83"],
 " ",
 "returns the free ports of the diagrams ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["d", "TI"], 
    StyleBox["i", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "9a9bde38-75c0-4f43-9c15-82560caab343"],
 " \[LongDash] the ports whose expression occurs exactly once across all of \
them.",
 "\n"
}], "Usage",ExpressionUUID->"99349f41-19e9-44c0-b53e-11d451921ae5"],

Cell[TextData[{
 "A port occurring twice (or more) is shared between subdiagrams and would be \
joined in a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramNetwork"]], 
    "paclet:WolframDiagrammaticComputation/ref/DiagramNetwork", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0e0e9498-5443-4411-a1cb-7758df93ed33"],
 " of the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["d", "TI"], 
    StyleBox["i", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "f3ed3113-d34d-4648-b034-febe68dcfa54"],
 "; the remaining single-occurrence ports are the network's boundary."
}], "Notes",ExpressionUUID->"7733b6fe-824a-4a65-8642-9a036af184ad"],

Cell[TextData[{
 "The result is a list of held port expressions; input ports appear wrapped \
in ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["PortDual"]], 
    "paclet:WolframDiagrammaticComputation/ref/PortDual", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1f1d4e2d-8281-4016-a368-cfd842444699"],
 "."
}], "Notes",ExpressionUUID->"754f7627-bb72-4113-9ff3-3107d710f940"]
}, Open  ]],

