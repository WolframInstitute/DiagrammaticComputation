Cell["Build a product of two ports:", "ExampleText",ExpressionUUID->"6d8882c6-50d4-48ba-a9f5-bb38bc496cc1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"PortProduct", "[", 
  RowBox[{
   RowBox[{"Port", "[", "a", "]"}], ",", " ", 
   RowBox[{"Port", "[", "b", "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"f8505eda-300b-4ea1-8b3a-78a251e2f963"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{
   TagBox["a",
    HoldForm], "\[CircleTimes]", 
   TagBox["b",
    HoldForm]}],
  Wolfram`DiagrammaticComputation`Port`Port[<|
   "Expression" :> Wolfram`DiagrammaticComputation`Port`PortProduct[
      Wolfram`DiagrammaticComputation`Port`Port[<|
       "Expression" :> 
        Wolfram`DiagrammaticComputation`Diagram`Rewriting`Rules`a, "NeutralQ" -> 
        False, "Tags" -> {}, "Type" -> \[FormalCapitalT]|>], 
      Wolfram`DiagrammaticComputation`Port`Port[<|
       "Expression" :> 
        Wolfram`DiagrammaticComputation`Diagram`Rewriting`Rules`b, "NeutralQ" -> 
        False, "Tags" -> {}, "Type" -> \[FormalCapitalT]|>]], "NeutralQ" -> 
    False, "Tags" -> {}, "Type" -> 
    CircleTimes[\[FormalCapitalT], \[FormalCapitalT]]|>],
  Tooltip->
   RowBox[{"\[FormalCapitalT]", "\[CircleTimes]", 
     "\[FormalCapitalT]"}]]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"a6c09fa7-20c3-48ba-8a03-c2c1c21d7f87"]
}, Open  ]],

