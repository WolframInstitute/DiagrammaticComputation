Notebook[{

Cell[CellGroupData[{
Cell["PortProduct", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"69736183-e524-44c0-a098-95de83311678"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["PortProduct",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/PortProduct"], "[", 
   RowBox[{
    SubscriptBox[
     StyleBox["p", "TI"], 
     StyleBox["1", "TR"]], ",", " ", 
    SubscriptBox[
     StyleBox["p", "TI"], 
     StyleBox["2", "TR"]], ",", " ", "\[Ellipsis]"}], "]"}]], "InlineFormula",
  ExpressionUUID->"78780e04-b66b-4cce-89b7-23a58d028683"],
 " ",
 "represents the parallel (tensor) product of the ports ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["p", "TI"], 
    StyleBox["i", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "42a5bef3-e06a-4da0-8e33-dab8129768fe"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"dae45eb5-8fa7-468e-94a3-fda4ead4a981"],

Cell[TextData[{
 "The product of ports is again a port whose type is the ",
 Cell[BoxData[
  ButtonBox["CircleTimes",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/CircleTimes"]], "InlineFormula",ExpressionUUID->
  "9bf4c8b9-6fac-4bd9-bf8b-504d7c93dc54"],
 " of the component types."
}], "Notes",ExpressionUUID->"4f45469d-b0a3-4164-b311-71894b9cc11f"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["PortProduct",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/PortProduct"]], 
  "InlineFormula",ExpressionUUID->"e6300ea6-c1a0-4faf-af2a-11b92ad6ef75"],
 " is associative; the unit is the empty port ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Port",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/Port"], 
   "[", "\"\<1\>\"", "]"}]], "InlineFormula",ExpressionUUID->
  "b6180888-f877-4ca3-adea-bf93f469f568"],
 "."
}], "Notes",ExpressionUUID->"ecc1eba9-36ae-4f57-8726-3a2aebbe5106"],

Cell[TextData[{
 "The infix shorthand ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["p", "TI"], 
    StyleBox["1", "TR"]], " ", "\[CircleTimes]", " ", 
   SubscriptBox[
    StyleBox["p", "TI"], 
    StyleBox["2", "TR"]]}]], "InlineFormula",ExpressionUUID->
  "143702ec-2b13-49e6-b472-51f596e7931a"],
 " evaluated inside ",
 Cell[BoxData[
  ButtonBox["Port",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/Port"]], 
  "InlineFormula",ExpressionUUID->"9340de64-63fe-4ce3-9318-b17c58c8f094"],
 " produces a ",
 Cell[BoxData[
  ButtonBox["PortProduct",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/PortProduct"]], 
  "InlineFormula",ExpressionUUID->"1885bda2-995d-40b3-8512-22ad01afbb33"],
 "."
}], "Notes",ExpressionUUID->"8a955784-06a6-406f-a636-3c30aa5d882f"],

Cell[TextData[{
 "Dualising distributes with reversal: ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"PortDual", "[", 
    RowBox[{"PortProduct", "[", 
     RowBox[{
      SubscriptBox[
       StyleBox["p", "TI"], 
       StyleBox["1", "TR"]], ",", " ", 
      SubscriptBox[
       StyleBox["p", "TI"], 
       StyleBox["2", "TR"]]}], "]"}], "]"}], " ", "==", " ", 
   RowBox[{"PortProduct", "[", 
    RowBox[{
     RowBox[{"PortDual", "[", 
      SubscriptBox[
       StyleBox["p", "TI"], 
       StyleBox["2", "TR"]], "]"}], ",", " ", 
     RowBox[{"PortDual", "[", 
      SubscriptBox[
       StyleBox["p", "TI"], 
       StyleBox["1", "TR"]], "]"}]}], "]"}]}]], "InlineFormula",
  ExpressionUUID->"6ebdf1c0-321e-4781-81e4-c9591fc122c3"],
 "."
}], "Notes",ExpressionUUID->"061d982e-96cb-4e49-ba0d-ceffbe62f15d"]
}, Open  ]],

