Cell["Build a product of two ports:", "ExampleText",ExpressionUUID->"2261f208-893c-46fa-8877-536e4107aeae"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"PortProduct", "[", 
  RowBox[{
   RowBox[{"Port", "[", "a", "]"}], ",", " ", 
   RowBox[{"Port", "[", "b", "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"22475c7e-1c70-474b-9b6e-361d8e8b6cf1"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{
   TagBox["a",
    HoldForm], "\[CircleTimes]", 
   TagBox["b",
    HoldForm]}],
  Wolfram`DiagrammaticComputation`Port`Port[<|
   "Expression" :> Wolfram`DiagrammaticComputation`Port`PortProduct[
      Wolfram`DiagrammaticComputation`Port`Port[<|
       "Expression" :> MTNB$17l2fh66ukd4q`a, "NeutralQ" -> False, 
        "Tags" -> {}, "Type" -> \[FormalCapitalT]|>], 
      Wolfram`DiagrammaticComputation`Port`Port[<|
       "Expression" :> MTNB$17l2fh66ukd4q`b, "NeutralQ" -> False, 
        "Tags" -> {}, "Type" -> \[FormalCapitalT]|>]], "NeutralQ" -> False, 
    "Tags" -> {}, "Type" -> 
    CircleTimes[\[FormalCapitalT], \[FormalCapitalT]]|>],
  Tooltip->
   RowBox[{"\[FormalCapitalT]", "\[CircleTimes]", 
     "\[FormalCapitalT]"}]]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"c40dcf09-28c5-4707-9957-68a3f8eb94a7"]
}, Open  ]],

