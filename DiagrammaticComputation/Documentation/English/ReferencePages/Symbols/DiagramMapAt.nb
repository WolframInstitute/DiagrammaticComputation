Cell[BoxData[
 RowBox[{"DiagramMapAt", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Diagram", "[", 
     RowBox[{
      RowBox[{"Style", "[", 
       RowBox[{
        RowBox[{"#", "[", "\"\<Expression\>\"", "]"}], ",", " ", "Red"}], 
       "]"}], ",", " ", "##2"}], "]"}], " ", "&"}], ",", "\n", "  ", 
   RowBox[{"DiagramComposition", "[", 
    RowBox[{
     RowBox[{"Diagram", "[", 
      RowBox[{"\"\<A\>\"", ",", " ", "b", ",", " ", "a"}], "]"}], ",", " ", 
     RowBox[{"Diagram", "[", 
      RowBox[{"\"\<B\>\"", ",", " ", "c", ",", " ", "b"}], "]"}]}], "]"}], ",",
    "\n", "  ", 
   RowBox[{"{", "1", "}"}]}], "\n", "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"fa01f349-6d1f-417d-8149-a238b18432d9"],

