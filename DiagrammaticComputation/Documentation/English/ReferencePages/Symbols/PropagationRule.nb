Cell[CellGroupData[{
Cell["PropagationRule", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"4b8e1081-83e5-4794-8acc-01f784d21689"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["PropagationRule"]], 
     "paclet:Wolfram/DiagrammaticComputation/ref/PropagationRule", 
     "Wolfram/DiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["a", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["b", "TI"], 
       StyleBox["1", "TR"]], ",", " ", "\[Ellipsis]", ",", " ", 
      SubscriptBox[
       StyleBox["b", "TI"], 
       StyleBox["n", "TI"]]}], "}"}], ",", " ", 
    StyleBox["f", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "b4f3d53a-5d51-4991-8a00-ab3e5dbf5a23"],
 " ",
 "returns a rewrite rule propagating a unary process with input ",
 Cell[BoxData[
  FormBox[
   StyleBox["a", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "907717a5-7ef2-4f29-ba04-962b4181fae1"],
 " through an ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "13dab16b-ef89-4992-bb39-4b842825ab69"],
 "-ary node with outputs ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["b", "TI"], "1"], ",", 
    RowBox[{"\[AHat]", "\[Hyphen]", "\.a6"}], ",", 
    SubscriptBox[
     StyleBox["b", "TI"], 
     StyleBox["n", "TI"]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"1e5feb1d-de0a-4d01-abed-62f7bbecaf95"],
 ", applying ",
 Cell[BoxData[
  FormBox[
   StyleBox["f", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "e51cf98c-3f3e-4829-90bb-6bb7241628a6"],
 " to the node's label.",
 "\n"
}], "Usage",ExpressionUUID->"d1a5f8de-8a95-4c2e-be68-0ff71e114736"],

Cell[TextData[{
 "Encodes the interaction-net commutation law: the process is duplicated onto \
each branch of the node, and the node's label is transformed by ",
 Cell[BoxData[
  FormBox[
   StyleBox["f", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "a78f5e4d-103e-4415-bb26-ec3ab04e5ca1"],
 " as it passes through."
}], "Notes",ExpressionUUID->"5820817c-276f-4313-a7e3-be5b0c62e3ad"],

