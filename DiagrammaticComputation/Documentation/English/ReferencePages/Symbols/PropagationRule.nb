Cell["PropagationRule", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"70ca72c0-c5d5-4451-bf50-c813f317d538"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["PropagationRule"]], 
     "paclet:WolframDiagrammaticComputation/ref/PropagationRule", 
     "WolframDiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["a", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["b", "TI"], 
       StyleBox["1", "TR"]], ",", " ", "\[Ellipsis]", ",", " ", 
      SubscriptBox[
       StyleBox["b", "TI"], 
       StyleBox["n", "TI"]]}], "}"}], ",", " ", 
    StyleBox["f", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "f6f0a44e-1487-4459-a2ea-6a5d9b26e759"],
 " ",
 "returns a rewrite rule propagating a unary process with input ",
 Cell[BoxData[
  FormBox[
   StyleBox["a", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "6c1351be-dcbe-4362-9678-d1cdd75fc5dd"],
 " through an ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "a9eb432e-659a-4393-8495-a6cff4e7ccd7"],
 "-ary node with outputs ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["b", "TI"], "1"], ",", 
    RowBox[{"\[AHat]", "\[Hyphen]", "\.a6"}], ",", 
    SubscriptBox[
     StyleBox["b", "TI"], 
     StyleBox["n", "TI"]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"3302a333-5d8b-436c-b4a2-e92dc30fb7e2"],
 ", applying ",
 Cell[BoxData[
  FormBox[
   StyleBox["f", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "4f4fff87-95e5-4d97-aa33-34ec05436c24"],
 " to the node's label.",
 "\n"
}], "Usage",ExpressionUUID->"e38a2e03-3b9e-418c-8df0-70b02b986da5"],

Cell[TextData[{
 "Encodes the interaction-net commutation law: the process is duplicated onto \
each branch of the node, and the node's label is transformed by ",
 Cell[BoxData[
  FormBox[
   StyleBox["f", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "c274b062-326c-487c-9ef9-f2c21c3be3c8"],
 " as it passes through."
}], "Notes",ExpressionUUID->"59a8217c-49c2-4679-8c66-1952b6bb0ce2"],

