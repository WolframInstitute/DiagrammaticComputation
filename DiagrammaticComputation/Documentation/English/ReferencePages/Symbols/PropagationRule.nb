Cell["PropagationRule", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"d11155f2-8e86-44ef-9333-175b52c788f2"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["PropagationRule"]], 
     "paclet:WolframDiagrammaticComputation/ref/PropagationRule", 
     "WolframDiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["a", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["b", "TI"], 
       StyleBox["1", "TR"]], ",", " ", "\[Ellipsis]", ",", " ", 
      SubscriptBox[
       StyleBox["b", "TI"], 
       StyleBox["n", "TI"]]}], "}"}], ",", " ", 
    StyleBox["f", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "5ae7e289-e5d1-4023-a500-b601fa759ab0"],
 " ",
 "returns a rewrite rule propagating a unary process with input ",
 Cell[BoxData[
  FormBox[
   StyleBox["a", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "051965b9-6aed-41e9-aa5b-d9da20bb46e9"],
 " through an ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "c556ac25-8a32-47c8-beb4-217cd738afb8"],
 "-ary node with outputs ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["b", "TI"], "1"], ",", 
    RowBox[{"\[AHat]", "\[Hyphen]", "\.a6"}], ",", 
    SubscriptBox[
     StyleBox["b", "TI"], 
     StyleBox["n", "TI"]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"1a537489-0c2d-4e9d-96ef-01deab5e1835"],
 ", applying ",
 Cell[BoxData[
  FormBox[
   StyleBox["f", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d88ac28d-7634-4095-ac6c-8489591be289"],
 " to the node's label.",
 "\n"
}], "Usage",ExpressionUUID->"ea69d0e8-dfac-4fbe-85ec-f7a288248a71"],

Cell[TextData[{
 "Encodes the interaction-net commutation law: the process is duplicated onto \
each branch of the node, and the node's label is transformed by ",
 Cell[BoxData[
  FormBox[
   StyleBox["f", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "89afee54-0619-4444-8c23-2ea0e5337b61"],
 " as it passes through."
}], "Notes",ExpressionUUID->"72aa8c3e-868d-4bf7-94fd-59c5bf7aac59"],

