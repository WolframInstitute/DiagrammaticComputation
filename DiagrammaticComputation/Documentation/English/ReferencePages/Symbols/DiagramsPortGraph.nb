Cell[CellGroupData[{
Cell["DiagramsPortGraph", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"74e9f17e-cb9b-480c-a9f3-c14ac6429cab"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["DiagramsPortGraph",
    BaseStyle->"Link",
    ButtonData->
     "paclet:Wolfram/DiagrammaticComputation/ref/DiagramsPortGraph"], "[", 
   RowBox[{"{", 
    RowBox[{
     SubscriptBox[
      StyleBox["d", "TI"], 
      StyleBox["1", "TR"]], ",", " ", "\[Ellipsis]"}], "}"}], "]"}]], 
  "InlineFormula",ExpressionUUID->"a3bfea28-8d65-4373-bec1-70a809cbcf79"],
 " ",
 "returns the port graph of the list of diagrams \[LongDash] a graph whose \
vertices are individual ports and whose edges are the matchings between dual \
ports.",
 "\n"
}], "Usage",ExpressionUUID->"e41dca3c-219d-49cf-8ea1-928cb4fa7d4e"],

Cell["\<\
The port graph is the finest-grained graph view of a diagram network. Each \
diagram contributes one vertex per port.\
\>", "Notes",ExpressionUUID->"cd55fdc8-2b13-4fdd-9ae0-6fd5b6a9850a"],

Cell["\<\
Use it as input to graph-theoretic queries (cycles, components, matchings) \
that do not care about subdiagram structure.\
\>", "Notes",ExpressionUUID->"d5cd68a0-2ce3-47c8-8e45-76acf8d46184"]
}, Open  ]],

