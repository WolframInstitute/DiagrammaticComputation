Cell["DiagramsPortGraph", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"9b55cc14-1ab6-40e0-acf2-0c77ea846145"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DiagramsPortGraph"]], 
     "paclet:Wolfram/DiagrammaticComputation/ref/DiagramsPortGraph", 
     "Wolfram/DiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"{", 
    RowBox[{
     SubscriptBox[
      StyleBox["d", "TI"], 
      StyleBox["1", "TR"]], ",", " ", "\[Ellipsis]"}], "}"}], "]"}]], 
  "InlineFormula",ExpressionUUID->"adafa740-7cad-4648-8a96-b0df2c38f676"],
 " ",
 "returns the port graph of the list of diagrams \[LongDash] a graph whose \
vertices are individual ports and whose edges are the matchings between dual \
ports.",
 "\n"
}], "Usage",ExpressionUUID->"786e6d0b-53f2-4179-908b-f7f5eef5a0fe"],

Cell["\<\
The port graph is the finest-grained graph view of a diagram network. Each \
diagram contributes one vertex per port.\
\>", "Notes",ExpressionUUID->"5a5c3b65-e70c-47fc-8f8e-63fe73726957"],

Cell["\<\
Use it as input to graph-theoretic queries (cycles, components, matchings) \
that do not care about subdiagram structure.\
\>", "Notes",ExpressionUUID->"443c054e-7a40-43cb-a6f2-db40bbf143a9"]
}, Open  ]],

