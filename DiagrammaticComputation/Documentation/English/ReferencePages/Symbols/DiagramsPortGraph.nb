Cell["DiagramsPortGraph", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"d4e7cc04-7431-4144-8d66-7ec95c0de94f"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DiagramsPortGraph"]], 
     "paclet:WolframDiagrammaticComputation/ref/DiagramsPortGraph", 
     "WolframDiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"{", 
    RowBox[{
     SubscriptBox[
      StyleBox["d", "TI"], 
      StyleBox["1", "TR"]], ",", " ", "\[Ellipsis]"}], "}"}], "]"}]], 
  "InlineFormula",ExpressionUUID->"b7445cc1-b7c6-48b5-854e-bdee6fea0191"],
 " ",
 "returns the port graph of the list of diagrams \[LongDash] a graph whose \
vertices are individual ports and whose edges are the matchings between dual \
ports.",
 "\n"
}], "Usage",ExpressionUUID->"ac8ab3c9-02d4-4aee-b859-e87350619df7"],

Cell["\<\
The port graph is the finest-grained graph view of a diagram network. Each \
diagram contributes one vertex per port.\
\>", "Notes",ExpressionUUID->"d45e2b58-8e38-435c-ac6d-643cfec71848"],

Cell["\<\
Use it as input to graph-theoretic queries (cycles, components, matchings) \
that do not care about subdiagram structure.\
\>", "Notes",ExpressionUUID->"8964abd6-2ff3-4c61-9d7b-da5a7619fc36"]
}, Open  ]],

