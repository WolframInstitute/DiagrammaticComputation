Cell[BoxData[
 RowBox[{"DiagramsPortGraph", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"Diagram", "[", 
     RowBox[{"\"\<A\>\"", ",", " ", "a", ",", " ", "b"}], "]"}], ",", " ", 
    RowBox[{"Diagram", "[", 
     RowBox[{"\"\<B\>\"", ",", " ", "b", ",", " ", "c"}], "]"}]}], "}"}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"9c01578c-d914-404f-a06d-4065d14b3374"],

