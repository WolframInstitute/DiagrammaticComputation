Cell["Port graph of two diagrams sharing a wire:", "ExampleText",ExpressionUUID->"32508188-33f8-447d-ac31-c81222c18839"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"DiagramsPortGraph", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"Diagram", "[", 
     RowBox[{"\"\<A\>\"", ",", " ", "a", ",", " ", "b"}], "]"}], ",", " ", 
    RowBox[{"Diagram", "[", 
     RowBox[{"\"\<B\>\"", ",", " ", "b", ",", " ", "c"}], "]"}]}], "}"}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"18527e5e-81ce-4323-b4b4-bbc2221164a6"],

Cell[BoxData[
 GraphicsBox[
  NamespaceBox["NetworkGraphics",
   DynamicModuleBox[{Typeset`graph = HoldComplete[
     Graph[{
       HoldForm[Wolfram`DiagrammaticComputation`Diagram`Rewriting`Rules`b], 
       HoldForm[Wolfram`DiagrammaticComputation`Diagram`Rewriting`Rules`c], 
       HoldForm[
        Wolfram`DiagrammaticComputation`Port`PortDual[
        Wolfram`DiagrammaticComputation`Diagram`Rewriting`Rules`a]], 
       HoldForm[
        Wolfram`DiagrammaticComputation`Port`PortDual[
        Wolfram`DiagrammaticComputation`Diagram`Rewriting`Rules`b]]}, {
      Null, {{1, 3}, {2, 4}}}, {VertexLabels -> {Automatic}}]]}, 
    TagBox[GraphicsGroupBox[{
       {Hue[0.6, 0.7, 0.7], Opacity[0.7], CapForm["Round"], Arrowheads[0.], 
        ArrowBox[{{{1.12501, -0.12501}, {0.12501000000000007`, -0.12501}}, {{
         1.12501, -0.37503000000000003`}, {
         0.12501000000000007`, -0.37503000000000003`}}}, 0.01273]}, 
       {Hue[0.6, 0.5, 1.], EdgeForm[{GrayLevel[0], Opacity[
        0.7]}], {DiskBox[{1.12501, -0.12501}, 0.01273], 
         InsetBox["b", Offset[{2, 2}, {1.13774, -0.11228}], ImageScaled[{0, 0}],
          BaseStyle->"Graphics"]}, {
         DiskBox[{1.12501, -0.37503000000000003`}, 0.01273], 
         InsetBox["c", Offset[{2, 2}, {1.13774, -0.3623}], ImageScaled[{0, 0}],
          BaseStyle->"Graphics"]}, {
         DiskBox[{0.12501000000000007`, -0.12501}, 0.01273], InsetBox[
          InterpretationBox[
           FormBox[
            SuperscriptBox["a", "*"],
            TraditionalForm],
           Wolfram`DiagrammaticComputation`Port`PortDual[
           Wolfram`DiagrammaticComputation`Diagram`Rewriting`Rules`a]], 
          Offset[{2, 2}, {0.13774000000000006, -0.11228}], ImageScaled[{0, 0}],
          BaseStyle->"Graphics"]}, {
         DiskBox[{0.12501000000000007`, -0.37503000000000003`}, 0.01273], 
         InsetBox[
          InterpretationBox[
           FormBox[
            SuperscriptBox["b", "*"],
            TraditionalForm],
           Wolfram`DiagrammaticComputation`Port`PortDual[
           Wolfram`DiagrammaticComputation`Diagram`Rewriting`Rules`b]], 
          Offset[{2, 2}, {0.13774000000000006, -0.3623}], ImageScaled[{0, 0}],
          
          BaseStyle->"Graphics"]}}}],
     MouseAppearanceTag["NetworkGraphics"]],
    AllowKernelInitialization->False]],
  DefaultBaseStyle->"NetworkGraphics",
  FormatType->TraditionalForm,
  FrameTicks->None]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"f39b3d22-b0b8-4c5f-a7fd-b025abf655a6"]
}, Open  ]],

