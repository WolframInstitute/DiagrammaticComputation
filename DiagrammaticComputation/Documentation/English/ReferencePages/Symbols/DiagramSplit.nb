Notebook[{

Cell[CellGroupData[{
Cell["DiagramSplit", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"c9b1dbc4-9a48-4375-acd0-744ab7fe5c76"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["DiagramSplit",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/DiagramSplit"], "[", 
   RowBox[{
    StyleBox["d", "TI"], ",", " ", 
    StyleBox["k", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "dae02a44-8acb-4f8f-94a1-88265653c716"],
 " ",
 "moves ",
 Cell[BoxData[
  FormBox[
   StyleBox["k", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "e04d5b05-a889-484b-87e5-71856f6dbfc6"],
 " ports from the output side of ",
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "0612f9c0-e98d-4816-ae45-5c0c670648df"],
 " to the input side (or, with ",
 Cell[BoxData[
  FormBox[
   StyleBox["k", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "eae6a3d0-1676-4abe-acaa-f7a82860b8b9"],
 " negative, the other direction), repartitioning its ports.",
 "\n"
}], "Usage",ExpressionUUID->"9112db37-99e2-4b52-81b4-c0404e9f164e"],

Cell["\<\
Repartitioning a diagram is the diagrammatic analogue of currying / \
uncurrying a function: it shifts the boundary between inputs and outputs \
while leaving the underlying process untouched.\
\>", "Notes",ExpressionUUID->"9d206164-0821-43ea-b2dc-2f68abe108a3"],

Cell[TextData[{
 "Used together with ",
 Cell[BoxData[
  ButtonBox["CapDiagram",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/CapDiagram"]], 
  "InlineFormula",ExpressionUUID->"42dd7cdf-9fbd-48ae-851c-b01761f2e14e"],
 " and ",
 Cell[BoxData[
  ButtonBox["CupDiagram",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/CupDiagram"]], 
  "InlineFormula",ExpressionUUID->"a696057d-b4eb-4967-b218-b8314ce7ec33"],
 " it implements process / state duality."
}], "Notes",ExpressionUUID->"c8601b32-f253-49c4-ae3f-7a7cd17cdaac"]
}, Open  ]],

