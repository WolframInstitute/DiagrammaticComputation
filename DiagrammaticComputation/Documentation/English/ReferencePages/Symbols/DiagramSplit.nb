Notebook[{

Cell[CellGroupData[{
Cell["DiagramSplit", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"d3002e2e-6ede-4ae0-913e-46bc587bbe83"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DiagramSplit"]], 
     "paclet:WolframDiagrammaticComputation/ref/DiagramSplit", 
     "WolframDiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["d", "TI"], ",", " ", 
    StyleBox["k", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "64181623-d51f-4565-9d8a-7b03e17074d1"],
 " ",
 "moves ",
 Cell[BoxData[
  FormBox[
   StyleBox["k", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "9492d474-8279-46fd-8c78-c5a9ae697836"],
 " ports from the output side of ",
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "66e1e9f6-fac7-47de-a2b6-ccd2071b1dd8"],
 " to the input side (or, with ",
 Cell[BoxData[
  FormBox[
   StyleBox["k", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d1ac7d3e-4a29-4e15-8b61-75d6025f821d"],
 " negative, the other direction), repartitioning its ports.",
 "\n"
}], "Usage",ExpressionUUID->"0ab26b1c-83a0-4d70-9b44-977a3d5a718a"],

Cell["\<\
Repartitioning a diagram is the diagrammatic analogue of currying / \
uncurrying a function: it shifts the boundary between inputs and outputs \
while leaving the underlying process untouched.\
\>", "Notes",ExpressionUUID->"95d95296-9b4e-4a0b-91eb-bfd84930f729"],

Cell[TextData[{
 "Used together with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CapDiagram"]], 
    "paclet:WolframDiagrammaticComputation/ref/CapDiagram", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "14fd13ff-55fa-4a69-8b50-c95c5180e95d"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CupDiagram"]], 
    "paclet:WolframDiagrammaticComputation/ref/CupDiagram", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b84c7315-ad39-4cbc-8369-c3849cfd661c"],
 " it implements process / state duality."
}], "Notes",ExpressionUUID->"99156220-3050-4330-bf3e-1194828f4627"]
}, Open  ]],

