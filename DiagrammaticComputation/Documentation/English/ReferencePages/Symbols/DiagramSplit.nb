Cell[CellGroupData[{
Cell["DiagramSplit", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"09802f87-1302-4760-ad62-3e2b205ecfdc"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DiagramSplit"]], 
     "paclet:Wolfram/DiagrammaticComputation/ref/DiagramSplit", 
     "Wolfram/DiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["d", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "3ef3a7c9-61a6-4e22-b73b-e95ead2693a6"],
 " ",
 "repartitions the ports of ",
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "ab649f14-fed9-46a6-aceb-aed43e9713b9"],
 " so that its first ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "f3ccb662-51d1-4e22-92c2-80cbf28b88bd"],
 " ports become outputs and the remaining ones inputs.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"2edeec47-5456-4f6c-8df8-0c305e4202a8"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DiagramSplit"]], 
     "paclet:Wolfram/DiagrammaticComputation/ref/DiagramSplit", 
     "Wolfram/DiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["d", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "631c5665-a5e2-4d51-9191-72df23f626b0"],
 " ",
 "turns every port into an output, making ",
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "04574210-1688-4430-8b55-bd53caf6dac0"],
 " a state.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"f94f65fd-f64c-43fb-ae85-d5962a07b17b"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DiagramSplit"]], 
     "paclet:Wolfram/DiagrammaticComputation/ref/DiagramSplit", 
     "Wolfram/DiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["d", "TI"], ",", " ", 
    StyleBox["n", "TI"], ",", " ", 
    StyleBox["dualQ", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "4773653c-f0b5-480c-8d66-c56da1e299b8"],
 " ",
 "controls whether the moved ports are dualised.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"f177a8d8-d5d7-48f3-ae6b-cd30beef60cb"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DiagramSplit"]], 
     "paclet:Wolfram/DiagrammaticComputation/ref/DiagramSplit", 
     "Wolfram/DiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["d", "TI"], ",", " ", 
    StyleBox["n", "TI"], ",", " ", 
    StyleBox["dualQ", "TI"], ",", " ", 
    StyleBox["flipQ", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "25d5970e-b90c-402b-b190-dd2d55401459"],
 " ",
 "bends the moved wires around the other side."
}], "Usage",ExpressionUUID->"025c3a56-f9fa-45ef-86f2-d1eeaeaee339"],

Cell[TextData[{
 "Ports are counted in the flattened order: outputs first, then inputs. A \
negative ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "4194116c-c18b-4c85-a3f1-66d566556530"],
 " counts back from the total arity, ",
 Cell[BoxData[
  RowBox[{"-", 
   ButtonBox["Infinity",
    BaseStyle->"Link"]}]], "InlineFormula",ExpressionUUID->
  "2e31bc5e-0f0b-4a19-90d8-d7fd90af3254"],
 " makes every port an input, and the default ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Infinity"]], "paclet:ref/Infinity"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9a2ced5e-301a-43c3-a7ad-f678dac41610"],
 " makes every port an output."
}], "Notes",ExpressionUUID->"06fd0dc8-85c1-4292-a63b-cf6dae0a3b8e"],

Cell[TextData[{
 "The repartitioning composes ",
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "1725a699-3a22-4540-942a-7e196792f880"],
 " with a pure wire diagram that bends the moved ports around, so the \
underlying process is unchanged \[LongDash] this is the diagrammatic analogue \
of currying a function or transposing tensor legs between covariant and \
contravariant positions."
}], "Notes",ExpressionUUID->"967fd787-1455-44d7-a5a3-dcda39048a0d"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"d", "u", "a", "l", "Q"}], "TI"], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"014e61c4-b77a-4435-9356-6211f0471c3e"],
 " set to ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["False"]], "paclet:ref/False"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "aa0f9c76-46a5-453d-a36f-567b53f6a246"],
 ", the moved ports keep their direction and are wrapped in ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["PortDual"]], 
    "paclet:Wolfram/DiagrammaticComputation/ref/PortDual", 
    "Wolfram/DiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "bc8a545b-01bb-40ba-bd47-644b864df9bc"],
 " instead."
}], "Notes",ExpressionUUID->"d5a2fd72-6c74-4dfc-8441-60bd2de79a44"],

Cell[TextData[{
 "With ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"f", "l", "i", "p", "Q"}], "TI"], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"0c45d7eb-a6d0-4623-8268-ef33d2762700"],
 " set to ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["True"]], "paclet:ref/True"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4807b0cb-ee6c-4ea2-82fd-9261d5bd447f"],
 ", the bending wires pass on the opposite side of the retained ports."
}], "Notes",ExpressionUUID->"a33ffa20-5e02-4c7a-b6c9-0787bfae59b2"]
