Cell[TextData[{
 "A ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Port"]], "paclet:WolframDiagrammaticComputation/ref/Port", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e9efe0dd-701e-4d91-920a-e6322955f5a0"],
 " is the typed endpoint of a diagram. Diagrams compose by matching ports of \
compatible types."
}], "Notes",ExpressionUUID->"cc13fb97-715d-4e96-a52a-293be7c3da22"],

Cell[TextData[{
 "The default type is ",
 Cell[BoxData[
 "\[FormalCapitalT]"], "InlineFormula",ExpressionUUID->
  "f34df8c4-2f91-4589-bb68-e57cd96d3023"],
 ", the generic placeholder type used when no further structure is given."
}], "Notes",ExpressionUUID->"c931c61b-0329-409d-bc60-f2824cb53e2d"],

Cell[TextData[{
