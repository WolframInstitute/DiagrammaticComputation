Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Port", "[", 
  RowBox[{"a", ",", " ", "\"\<Real\>\""}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"9ce43655-6c47-49cd-8bdf-1866ad7a92e1"],

Cell[BoxData[
 InterpretationBox[
  TagBox["a",
   HoldForm],
  Wolfram`DiagrammaticComputation`Port`Port[<|
