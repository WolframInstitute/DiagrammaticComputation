    "NeutralQ" -> False, "Tags" -> {}, "Type" -> "Real"|>],
  Tooltip->"\"Real\""]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"4e7b9b13-01da-44d9-baa4-3f71453a8820"]
}, Open  ]],

Cell["Compose two ports into a product:", "ExampleText",ExpressionUUID->"ffa42491-1762-41ea-9459-f4acc41b3217"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Port", "[", 
  RowBox[{"a", " ", "\[CircleTimes]", " ", "b"}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"e9e6a39a-f834-405b-a32f-844b447e21da"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{
   TagBox["a",
    HoldForm], "\[CircleTimes]", 
   TagBox["b",
    HoldForm]}],
  Wolfram`DiagrammaticComputation`Port`Port[<|
   "Expression" :> Wolfram`DiagrammaticComputation`Port`PortProduct[
      Wolfram`DiagrammaticComputation`Port`Port[<|
       "Expression" :> 
        Wolfram`DiagrammaticComputation`Diagram`Rewriting`Rules`a, "NeutralQ" -> 
        False, "Tags" -> {}, "Type" -> \[FormalCapitalT]|>], 
      Wolfram`DiagrammaticComputation`Port`Port[<|
       "Expression" :> 
        Wolfram`DiagrammaticComputation`Diagram`Rewriting`Rules`b, "NeutralQ" -> 
        False, "Tags" -> {}, "Type" -> \[FormalCapitalT]|>]], "NeutralQ" -> 
    False, "Tags" -> {}, "Type" -> 
    CircleTimes[\[FormalCapitalT], \[FormalCapitalT]]|>],
  Tooltip->
   RowBox[{"\[FormalCapitalT]", "\[CircleTimes]", 
     "\[FormalCapitalT]"}]]], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"071a404c-f7e7-42ea-9a07-f3968ba76bf5"]
}, Open  ]],

