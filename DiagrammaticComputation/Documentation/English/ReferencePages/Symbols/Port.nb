Cell[TextData[{
 "A ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Port"]], "paclet:Wolfram/DiagrammaticComputation/ref/Port", 
    "Wolfram/DiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b1e3a2e5-c7af-4925-9bdf-54f27b17aa1d"],
 " is the typed endpoint of a diagram. Diagrams compose by matching ports of \
compatible types."
}], "Notes",ExpressionUUID->"784408d2-8b72-4dfd-a730-ad38717012f4"],

Cell[TextData[{
 "The default type is ",
 Cell[BoxData[
 "\[FormalCapitalT]"], "InlineFormula",ExpressionUUID->
  "213bf200-b057-4afb-9544-880119bc07ee"],
 ", the generic placeholder type used when no further structure is given."
}], "Notes",ExpressionUUID->"3eaed806-2f3f-4c1b-89ff-64ad8081c2b6"],

Cell[TextData[{
