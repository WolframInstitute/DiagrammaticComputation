Cell["Construct a generic port:", "ExampleText",ExpressionUUID->"a7196d1c-94d5-4d39-9af2-ba6c6a5f272b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Port", "[", "a", "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"113c8f27-f223-462e-b446-6f1e8fb66617"],

Cell[BoxData[
 InterpretationBox[
  TagBox["a",
   HoldForm],
  Wolfram`DiagrammaticComputation`Port`Port[<|
   "Expression" :> Wolfram`DiagrammaticComputation`Diagram`Rewriting`Rules`a, 
    "NeutralQ" -> False, "Tags" -> {}, "Type" -> \[FormalCapitalT]|>],
  Tooltip->"\[FormalCapitalT]"]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"7ff91dd8-b89b-4bcc-897d-a21048a82cbc"]
}, Open  ]],

