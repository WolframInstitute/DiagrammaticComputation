Cell[TextData[{
 "A ",
 Cell[BoxData[
  ButtonBox["Port",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/Port"]], 
  "InlineFormula",ExpressionUUID->"e24eb1e7-f920-4f2b-a754-e6dc250b0218"],
 " is the typed endpoint of a diagram. Diagrams compose by matching ports of \
compatible types."
}], "Notes",ExpressionUUID->"949de231-6b3d-4fc4-bb7e-1c1fc7fa4ee5"],

Cell[TextData[{
 "The default type is ",
 Cell[BoxData[
 "\[FormalCapitalT]"], "InlineFormula",ExpressionUUID->
  "a1c028c2-37a8-40b9-b466-2895322114cf"],
 ", the generic placeholder type used when no further structure is given."
}], "Notes",ExpressionUUID->"2dac26ab-c447-4934-9d30-d7503d3614a7"],

Cell[TextData[{
 "The expression is held with ",
 Cell[BoxData[
  ButtonBox["HoldForm",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/HoldForm"]], "InlineFormula",ExpressionUUID->
  "385bb49c-5a27-4494-b57f-77768b303ce0"],
 "-style semantics; reading a port out via its ",
 Cell[BoxData["\"\<Expression\>\""], "InlineFormula",ExpressionUUID->
  "2618b8a7-d33e-4e93-a23b-6e3fb031a6a6"],
 " property returns the original held form."
}], "Notes",ExpressionUUID->"63046d3e-cda4-4348-9c91-a2be76d3bce0"],

Cell[TextData[{
 "Products and powers of ports are expanded automatically: ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Port",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/Port"], "[", 
   RowBox[{
    SubscriptBox[
     StyleBox["p", "TI"], 
     StyleBox["1", "TR"]], " ", "\[CircleTimes]", " ", 
    SubscriptBox[
     StyleBox["p", "TI"], 
     StyleBox["2", "TR"]]}], "]"}]], "InlineFormula",ExpressionUUID->
  "a4f42689-130e-4ce5-b266-c4fed0e574d0"],
 " reduces to ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["PortProduct",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/PortProduct"], "[", 
   RowBox[{
    RowBox[{"Port", "[", 
     SubscriptBox[
      StyleBox["p", "TI"], 
      StyleBox["1", "TR"]], "]"}], ",", " ", 
    RowBox[{"Port", "[", 
     SubscriptBox[
      StyleBox["p", "TI"], 
      StyleBox["2", "TR"]], "]"}]}], "]"}]], "InlineFormula",ExpressionUUID->
  "13ce960a-0b09-4d88-8d6c-0427507154fa"],
 ", and ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Port",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/Port"], "[", 
   RowBox[{"$p", "^", 
    SubscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["", "TR"]]}], "]"}]], "InlineFormula",ExpressionUUID->
  "2485b4a7-ca1e-4729-8b78-7b13d6a55ba3"],
 " to ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["PortProduct",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/PortProduct"], "[", 
   RowBox[{
    RowBox[{"Port", "[", 
     StyleBox["p", "TI"], "]"}], ",", " ", "\[Ellipsis]"}], "]"}]], 
  "InlineFormula",ExpressionUUID->"c1349553-08fe-4ed4-b3cb-8cb4852595fd"],
 " with ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "cfcbcacd-ea33-41aa-be11-badb6a45e3d6"],
 " factors."
}], "Notes",ExpressionUUID->"159932cd-e837-4ea1-a2e1-d31bef999699"],

Cell[TextData[{
 "The unit and zero ports are constructed by ",
 Cell[BoxData[
