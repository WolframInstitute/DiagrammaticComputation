Cell["Compose two ports into a product:", "ExampleText",ExpressionUUID->"90889bb7-38b5-4709-9579-656967bee21b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Port", "[", 
  RowBox[{"a", " ", "\[CircleTimes]", " ", "b"}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"ef5b954a-4663-4ae5-91d5-609c11327b4f"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{
   TagBox["a",
    HoldForm], "\[CircleTimes]", 
   TagBox["b",
    HoldForm]}],
  Wolfram`DiagrammaticComputation`Port`Port[<|
   "Expression" :> Wolfram`DiagrammaticComputation`Port`PortProduct[
      Wolfram`DiagrammaticComputation`Port`Port[<|
       "Expression" :> MTNB$1njk4i6rj21b6`a, "NeutralQ" -> False, 
        "Tags" -> {}, "Type" -> \[FormalCapitalT]|>], 
      Wolfram`DiagrammaticComputation`Port`Port[<|
       "Expression" :> MTNB$1njk4i6rj21b6`b, "NeutralQ" -> False, 
        "Tags" -> {}, "Type" -> \[FormalCapitalT]|>]], "NeutralQ" -> False, 
    "Tags" -> {}, "Type" -> 
    CircleTimes[\[FormalCapitalT], \[FormalCapitalT]]|>],
  Tooltip->
   RowBox[{"\[FormalCapitalT]", "\[CircleTimes]", 
     "\[FormalCapitalT]"}]]], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"692b3646-9426-4b7c-9f55-fb2c3ff8b419"]
}, Open  ]],

