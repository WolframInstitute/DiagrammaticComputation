Cell[TextData[{
 "Products and powers of ports are expanded automatically: ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["Port"]], "paclet:Wolfram/DiagrammaticComputation/ref/Port", 
     "Wolfram/DiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    SubscriptBox[
     StyleBox["p", "TI"], 
     StyleBox["1", "TR"]], " ", "\[CircleTimes]", " ", 
    SubscriptBox[
     StyleBox["p", "TI"], 
     StyleBox["2", "TR"]]}], "]"}]], "InlineFormula",ExpressionUUID->
  "1321de2a-276f-47bb-872b-2d6119a68932"],
 " reduces to ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["PortProduct"]], 
     "paclet:Wolfram/DiagrammaticComputation/ref/PortProduct", 
     "Wolfram/DiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"Port", "[", 
     SubscriptBox[
      StyleBox["p", "TI"], 
      StyleBox["1", "TR"]], "]"}], ",", " ", 
    RowBox[{"Port", "[", 
     SubscriptBox[
      StyleBox["p", "TI"], 
      StyleBox["2", "TR"]], "]"}]}], "]"}]], "InlineFormula",ExpressionUUID->
  "037139ed-cd18-48b7-8c5a-9eaeea51ffc0"],
 ", and ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["Port"]], "paclet:Wolfram/DiagrammaticComputation/ref/Port", 
     "Wolfram/DiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"$p", "^", 
    SubscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["", "TR"]]}], "]"}]], "InlineFormula",ExpressionUUID->
  "956ff09e-804a-4d8b-895c-3a3890a9a3e6"],
 " to ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["PortProduct"]], 
     "paclet:Wolfram/DiagrammaticComputation/ref/PortProduct", 
     "Wolfram/DiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"Port", "[", 
     StyleBox["p", "TI"], "]"}], ",", " ", "\[Ellipsis]"}], "]"}]], 
  "InlineFormula",ExpressionUUID->"9ae8335f-6b7d-4aef-87fe-3b6192bd1a0e"],
 " with ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "5e1cbbe9-7a5a-4121-9e61-4ec6b4acc827"],
 " factors."
}], "Notes",ExpressionUUID->"7b9fbf39-b2c7-4445-9b39-82e2f248a281"],

