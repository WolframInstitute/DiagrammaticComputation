 " property returns the original held form."
}], "Notes",ExpressionUUID->"54cf7c4a-5508-4f70-8fd2-9fa47c5dac3c"],

Cell[TextData[{
 "Products and powers of ports are expanded automatically: ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["Port"]], "paclet:WolframDiagrammaticComputation/ref/Port", 
     "WolframDiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    SubscriptBox[
     StyleBox["p", "TI"], 
     StyleBox["1", "TR"]], " ", "\[CircleTimes]", " ", 
    SubscriptBox[
     StyleBox["p", "TI"], 
     StyleBox["2", "TR"]]}], "]"}]], "InlineFormula",ExpressionUUID->
  "3e6c389b-4ff8-47cf-a177-9ea6e4753998"],
 " reduces to ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["PortProduct"]], 
     "paclet:WolframDiagrammaticComputation/ref/PortProduct", 
     "WolframDiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"Port", "[", 
     SubscriptBox[
      StyleBox["p", "TI"], 
      StyleBox["1", "TR"]], "]"}], ",", " ", 
    RowBox[{"Port", "[", 
     SubscriptBox[
      StyleBox["p", "TI"], 
      StyleBox["2", "TR"]], "]"}]}], "]"}]], "InlineFormula",ExpressionUUID->
  "d0c0a189-e9ec-4004-9724-79adce8ffb8b"],
 ", and ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["Port"]], "paclet:WolframDiagrammaticComputation/ref/Port", 
     "WolframDiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"$p", "^", 
    SubscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["", "TR"]]}], "]"}]], "InlineFormula",ExpressionUUID->
  "2c80f4df-6fee-49f4-880f-a38f9b228572"],
 " to ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["PortProduct"]], 
     "paclet:WolframDiagrammaticComputation/ref/PortProduct", 
     "WolframDiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"Port", "[", 
     StyleBox["p", "TI"], "]"}], ",", " ", "\[Ellipsis]"}], "]"}]], 
  "InlineFormula",ExpressionUUID->"cd04759f-6869-441f-b063-86b47326c080"],
 " with ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "2504cb6c-6ada-4167-b39b-ebefca50f222"],
 " factors."
}], "Notes",ExpressionUUID->"795e0bd7-34c1-4e56-9a72-b07cc31dd688"],

