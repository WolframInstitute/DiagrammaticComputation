   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7c293d56-f131-47aa-b69b-0c28e6e87ce1"],
 ": summing any port with the zero port returns it unchanged."
}], "Notes",ExpressionUUID->"eb635b32-ad39-4925-a3b7-2f41c25a3335"],

