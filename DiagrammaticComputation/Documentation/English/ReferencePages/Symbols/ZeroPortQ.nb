Cell["ZeroPortQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"96153ef9-dfff-4f3e-bb80-0577718df539"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ZeroPortQ",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/ZeroPortQ"], "[", 
   
   StyleBox["p", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "d1588b72-5832-46ea-a551-0c5cf584a90f"],
 " ",
 "gives ",
 Cell[BoxData[
  ButtonBox["True",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/True"]], "InlineFormula",ExpressionUUID->
  "f6ad32e5-108b-40c6-99e2-675c25e45b15"],
 " if ",
 Cell[BoxData[
  FormBox[
   StyleBox["p", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "559dd1cf-c75a-4f43-90e3-c40615bd814e"],
 " is the unit port for ",
 Cell[BoxData[
  ButtonBox["PortSum",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/PortSum"]], 
  "InlineFormula",ExpressionUUID->"c1b50d01-30e6-49fe-8c9a-47c63cce4a2b"],
 " (the zero port).",
 "\n"
}], "Usage",ExpressionUUID->"ee0c9911-e3c2-4ba7-97a2-a6493ab0595f"],

Cell[TextData[{
 "The zero port is the identity element of ",
 Cell[BoxData[
  ButtonBox["PortSum",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/PortSum"]], 
  "InlineFormula",ExpressionUUID->"6c1b77fc-8d3f-429e-9b39-34301318c3c5"],
 ": summing any port with the zero port returns it unchanged."
}], "Notes",ExpressionUUID->"89e158f6-752d-425f-a447-b0cc3440f4fb"],

Cell[TextData[{
 "It is constructed by ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Port",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/Port"], 
   "[", "\"\<0\>\"", "]"}]], "InlineFormula",ExpressionUUID->
  "dde38842-9fe9-4d09-90aa-cde6f5c95adc"],
 "."
}], "Notes",ExpressionUUID->"8748551c-25ad-4bfd-b3ed-b11f67627336"]
}, Open  ]],

