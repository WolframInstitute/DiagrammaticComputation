Cell[TextData[{
 "Positions are integer-list addresses into the diagram's expression tree, in \
the same convention as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Position"]], "paclet:ref/Position"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "dd5c3ef9-b8e9-4efe-a8bb-396a368d3d0c"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Extract"]], "paclet:ref/Extract"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "312f5b54-bd3b-4d68-95e1-fac4006a842e"],
 "; the empty position ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",ExpressionUUID->
  "c717a4a7-c3c5-49f6-879a-e1cd03ed0219"],
 " is the diagram itself."
}], "Notes",ExpressionUUID->"03478e8c-d454-40ee-84d5-80e458c0915f"],

Cell[TextData[{
 "The level specification follows the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Level"]], "paclet:ref/Level"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9dd41f48-3281-47b1-979b-22f4a33047c2"],
 " conventions: ",
 Cell[BoxData[
  RowBox[{"{", 
   StyleBox["lvl", "TI"], "}"}]], "InlineFormula",ExpressionUUID->
  "e9c9c319-e7d4-4d49-a8f8-f0ce88289ae7"],
 " is exactly level ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"l", "v", "l"}], "TI"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"e8f8d70b-095b-4596-856f-ee0bd2306bfd"],
 ", and negative levels count from the deepest position."
}], "Notes",ExpressionUUID->"14b4f1a8-f91f-46e4-a9f5-c70a7f0fef23"]
}, Open  ]],

