Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ColumnDiagram", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"Diagram", "[", 
     RowBox[{"\"\<A\>\"", ",", " ", "a", ",", " ", "b"}], "]"}], ",", " ", 
    RowBox[{"Diagram", "[", 
     RowBox[{"\"\<B\>\"", ",", " ", "b", ",", " ", "c"}], "]"}]}], "}"}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"306c75e0-ff17-4a5a-b6b7-95417fa417fc"],

Cell[BoxData[
 GraphicsBox[
  NamespaceBox["Diagram",
   DynamicModuleBox[{Typeset`d = HoldComplete[
     Wolfram`DiagrammaticComputation`Diagram`Diagram[<|
      "DiagramOptions" -> {
        "PortArrows" -> {{Automatic}, {Automatic}}, 
