Cell[TextData[{
 "A cap has two inputs and no outputs; it is the ",
 StyleBox["counit", "TI"],
 " / evaluation morphism that pairs a port with its dual."
}], "Notes",ExpressionUUID->"76361020-5981-46b4-9918-8425cb416e22"],

Cell[TextData[{
 "Together with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["CupDiagram"]], 
    "paclet:Wolfram/DiagrammaticComputation/ref/CupDiagram", 
    "Wolfram/DiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "125610a8-5331-4de9-ac35-25399e402f97"],
 " it provides the snake-equation duals that make the category compact-closed."
}], "Notes",ExpressionUUID->"5bf585da-615f-476c-95f7-b6ec4a903e6b"]
}, Open  ]],

