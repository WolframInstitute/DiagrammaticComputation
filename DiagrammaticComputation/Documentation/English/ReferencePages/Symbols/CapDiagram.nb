Cell[CellGroupData[{
Cell["CapDiagram", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"648301c5-1b9f-4e11-a613-f3bb7fe088cb"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CapDiagram",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/CapDiagram"], "[", 
   StyleBox["p", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "ad14e445-0b19-4820-bacc-5e7fe9f851ac"],
 " ",
 "creates a diagram connecting two input ports ",
 Cell[BoxData[
  FormBox[
   StyleBox["p", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "63155410-f116-4c2d-aecf-28c990815834"],
 " and ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["PortDual",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/PortDual"], "[", 
   StyleBox["p", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "d848a688-8612-4482-bf53-1d23d521af18"],
 " with a cap.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"20761899-04ef-4dea-bf09-2979d5951312"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CapDiagram",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/CapDiagram"], "[", 
   RowBox[{
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["q", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "5fe58f3a-6f14-4dd2-8992-ee7a9410ae89"],
 " ",
 "connects two specified input ports."
}], "Usage",ExpressionUUID->"0cc59096-3c45-404d-880d-beeb34eb9778"],

Cell[TextData[{
 "A cap has two inputs and no outputs; it is the ",
 StyleBox["counit", "TI"],
 " / evaluation morphism that pairs a port with its dual."
}], "Notes",ExpressionUUID->"b1aabd43-03fe-4367-b7f0-ea614b1e33c8"],

Cell[TextData[{
 "Together with ",
 Cell[BoxData[
  ButtonBox["CupDiagram",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/CupDiagram"]], 
  "InlineFormula",ExpressionUUID->"84d355e6-ad7b-472e-b83f-86be801105b6"],
 " it provides the snake-equation duals that make the category compact-closed."
}], "Notes",ExpressionUUID->"215096a1-8f83-4f84-95ff-aebce0e70b42"]
}, Open  ]],

