Cell[CellGroupData[{
Cell["EraserDiagram", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"5c518c62-31e4-4b6b-90cf-9d2978828eb6"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["EraserDiagram",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/EraserDiagram"], "[", 
   StyleBox["p", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "1e0444d6-ee87-4dff-b1c4-d3a510352983"],
 " ",
 "is the canonical erase / discard diagram on the port ",
 Cell[BoxData[
  FormBox[
   StyleBox["p", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "2a20c405-d491-4fb7-9f07-1ad89df22faf"],
 " \[LongDash] one input, no outputs.",
 "\n"
}], "Usage",ExpressionUUID->"3001b7d8-a92b-4f97-bcd6-2e2f1faa0dce"],

Cell[TextData[{
 "The eraser is the counit of the classical-structure on a wire: composing it \
with ",
 Cell[BoxData[
  ButtonBox["CopyDiagram",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/CopyDiagram"]], 
  "InlineFormula",ExpressionUUID->"a58f29d0-a906-44f1-b270-8c5a4bddb183"],
 " projects out one of the copies."
}], "Notes",ExpressionUUID->"43ec4235-5189-4614-9519-bfbee480f109"],

Cell[TextData[{
 "Together with ",
 Cell[BoxData[
  ButtonBox["CopyDiagram",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/CopyDiagram"]], 
  "InlineFormula",ExpressionUUID->"c5a19ae7-fb9e-4a2b-94ca-d97528ac16f9"],
 " and ",
 Cell[BoxData[
  ButtonBox["MergeDiagram",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/MergeDiagram"]], 
  "InlineFormula",ExpressionUUID->"63c4de2f-c750-4e81-a094-a5795afb9fac"],
 " it generates the standard structural rewrites in ",
 Cell[BoxData[
  ButtonBox["EraserRule",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/EraserRule"]], 
  "InlineFormula",ExpressionUUID->"93d0bbab-af06-4654-9488-452afe5afed9"],
 " and friends."
}], "Notes",ExpressionUUID->"61f46cf7-6980-4e47-941f-f0ffc6923642"]
}, Open  ]],

