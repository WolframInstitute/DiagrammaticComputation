Cell["DiagramExpressionReplace", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"6cde991a-a595-4c14-af32-af9249ae6192"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DiagramExpressionReplace"]], 
     "paclet:Wolfram/DiagrammaticComputation/ref/DiagramExpressionReplace", 
     "Wolfram/DiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["d", "TI"], ",", " ", 
    StyleBox["rules", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "f1f0008b-c2b9-4d59-b14e-2c1b0ab2d420"],
 " ",
 "applies the ordinary Wolfram Language replacement ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"r", "u", "l", "e", "s"}], "TI"], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"53041b28-4c9a-4529-b6ed-cfeb4f7636c8"],
 " to the expression carried inside every subdiagram of ",
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "5f7be92d-645e-46f6-a3d3-820838a43943"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"7109be0d-a592-45f7-bad2-70fae8fd4d93"],

Cell[TextData[{
 "Operates at the ",
 StyleBox["data", "TI"],
 " level: it rewrites the ",
 Cell[BoxData["\"\<Expression\>\""], "InlineFormula",ExpressionUUID->
  "2c3a53c0-51b3-46e0-9ae4-f80a7b58685c"],
 " field of each subdiagram, leaving port structure intact."
}], "Notes",ExpressionUUID->"2c3f9988-79b5-4d5a-a8b2-a203bcff0f7d"],

Cell["\<\
Use this when you need to rename or rewrite the symbols labelling diagrams \
without touching their connectivity.\
\>", "Notes",ExpressionUUID->"c0416e6c-3d1d-4445-a9ea-eb8ac66c88a6"]
}, Open  ]],

