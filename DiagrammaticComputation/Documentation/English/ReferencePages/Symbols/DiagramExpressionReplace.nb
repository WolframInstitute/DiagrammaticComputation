Cell["DiagramExpressionReplace", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"85288685-7ea0-40e8-ae37-68144a379f10"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DiagramExpressionReplace"]], 
     "paclet:WolframDiagrammaticComputation/ref/DiagramExpressionReplace", 
     "WolframDiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["d", "TI"], ",", " ", 
    StyleBox["rules", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "c98c3b4a-cbcf-4d70-8e79-c5d5f6e5c854"],
 " ",
 "applies the ordinary Wolfram Language replacement ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"r", "u", "l", "e", "s"}], "TI"], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"1438c8d3-fc07-457a-8723-63e6dd9fa28a"],
 " to the expression carried inside every subdiagram of ",
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "0abd094a-b5de-40da-a7b1-7928a387422e"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"5c07a325-a660-477a-9ffd-0699bf1652e7"],

Cell[TextData[{
 "Operates at the ",
 StyleBox["data", "TI"],
 " level: it rewrites the ",
 Cell[BoxData["\"\<Expression\>\""], "InlineFormula",ExpressionUUID->
  "6f633064-163a-4893-9915-d6163b52cfac"],
 " field of each subdiagram, leaving port structure intact."
}], "Notes",ExpressionUUID->"00d94083-ed42-48d6-8e70-6704f516ff79"],

Cell["\<\
Use this when you need to rename or rewrite the symbols labelling diagrams \
without touching their connectivity.\
\>", "Notes",ExpressionUUID->"6be51ca9-efb1-4bae-a4fc-4985ed5a1222"]
}, Open  ]],

