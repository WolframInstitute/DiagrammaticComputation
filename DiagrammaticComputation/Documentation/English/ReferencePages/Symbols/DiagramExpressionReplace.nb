Notebook[{

Cell[CellGroupData[{
Cell["DiagramExpressionReplace", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"32bd8dc7-205d-4c81-ace7-091a2d26d763"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["DiagramExpressionReplace",
    BaseStyle->"Link",
    ButtonData->
     "paclet:Wolfram/DiagrammaticComputation/ref/DiagramExpressionReplace"], "[", 
   RowBox[{
    StyleBox["d", "TI"], ",", " ", 
    StyleBox["rules", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "53da8b77-135b-44df-b0d7-4d920145be08"],
 " ",
 "applies the ordinary Wolfram Language replacement ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"r", "u", "l", "e", "s"}], "TI"], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"902f5b64-db23-48ba-9f44-a70bd0c3d28c"],
 " to the expression carried inside every subdiagram of ",
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "b352c542-331c-455e-84b4-bd54702e822e"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"8d8ab89c-4d37-4a4a-bc30-44a6fd971836"],

Cell[TextData[{
 "Operates at the ",
 StyleBox["data", "TI"],
 " level: it rewrites the ",
 Cell[BoxData["\"\<Expression\>\""], "InlineFormula",ExpressionUUID->
  "f1b296e8-e2f3-4370-ba46-46350bec84d6"],
 " field of each subdiagram, leaving port structure intact."
}], "Notes",ExpressionUUID->"d7d08412-f974-4955-aa35-7b24f5768442"],

Cell["\<\
Use this when you need to rename or rewrite the symbols labelling diagrams \
without touching their connectivity.\
\>", "Notes",ExpressionUUID->"b3131c37-08d6-475f-bedd-16a40bfd7aae"]
}, Open  ]],

