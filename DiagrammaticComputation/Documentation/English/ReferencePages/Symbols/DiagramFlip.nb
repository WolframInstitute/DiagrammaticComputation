Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"DiagramFlip", "[", 
  RowBox[{"Diagram", "[", 
   RowBox[{"\"\<A\>\"", ",", " ", 
    RowBox[{"{", 
