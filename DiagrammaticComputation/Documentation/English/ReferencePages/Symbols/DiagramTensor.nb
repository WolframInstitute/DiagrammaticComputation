Cell[BoxData[
 RowBox[{"TensorDimensions", "[", 
  RowBox[{"Activate", " ", "@", " ", 
   RowBox[{"DiagramTensor", "[", "diagram", "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"40ddc903-b068-4794-84fd-c45404e727d0"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   TagBox["b",
    HoldForm], ",", 
   TagBox["e",
    HoldForm], ",", 
   TagBox["a",
    HoldForm], ",", 
   TagBox["c",
    HoldForm]}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"570330e5-90c9-434d-bd3c-5cece9636e7f"]
}, Open  ]],

