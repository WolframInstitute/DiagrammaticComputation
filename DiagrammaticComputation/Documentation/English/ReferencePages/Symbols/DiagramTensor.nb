Notebook[{

Cell[CellGroupData[{
Cell["DiagramTensor", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"82d87f64-32d6-45f3-a0eb-8c8609d8a71c"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DiagramTensor"]], 
     "paclet:WolframDiagrammaticComputation/ref/DiagramTensor", 
     "WolframDiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["d", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "d7bf637b-82d6-4829-a119-24a439ec9c8f"],
 " ",
 "returns a symbolic tensor expression representing the diagram ",
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "a003144b-73eb-4cbd-b2f9-11d030fd18ff"],
 " as a tensor contraction.",
 "\n"
}], "Usage",ExpressionUUID->"1b702651-23e6-47c7-9b06-6d570b8a0e16"],

Cell[TextData[{
 "Composition becomes ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ArrayDot"]], "paclet:ref/ArrayDot"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "cb357bef-5540-4b52-bd6d-a1db91a5456b"],
 " / ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TensorContract"]], "paclet:ref/TensorContract"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e205d3cd-5430-4591-9a13-b5b38cc6f5fa"],
 " and product becomes ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TensorProduct"]], "paclet:ref/TensorProduct"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "78877017-1e40-474b-898c-cd542fa127cb"],
 ". Singleton diagrams become symbolic arrays whose dimensions are taken from \
the diagram's port types."
}], "Notes",ExpressionUUID->"e4bfb116-5177-4b4a-8027-fcd45f63d0a8"],

Cell[TextData[{
 "The result is an inactive tensor expression \[LongDash] wrap in ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Activate"]], "paclet:ref/Activate"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "33529f04-279e-4fc7-8a15-f3fe227c949e"],
 " to evaluate when the underlying tensors are concrete."
}], "Notes",ExpressionUUID->"c5fd8c67-1bec-4763-a5cf-b9040fcca2a5"],

Cell[TextData[{
 "Inverse direction: ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TensorDiagram"]], 
    "paclet:WolframDiagrammaticComputation/ref/TensorDiagram", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f4c19561-9563-449c-b722-a90552de13b4"],
 " lifts a tensor expression back to a diagram."
}], "Notes",ExpressionUUID->"8d25eaeb-9230-4356-9f72-d9f38f2a3f5d"]
}, Open  ]],

