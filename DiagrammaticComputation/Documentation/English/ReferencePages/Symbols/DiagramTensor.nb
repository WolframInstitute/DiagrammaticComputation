Cell["Express a composite diagram as a contracted tensor:", "ExampleText",ExpressionUUID->"8684ceeb-568b-46df-97c3-a418d738f912"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"diagram", " ", "=", " ", 
   RowBox[{"Diagram", "[", 
    RowBox[{
     RowBox[{"Diagram", "[", 
      RowBox[{"\"\<A\>\"", ",", " ", "a", ",", " ", "b"}], "]"}], " ", "\[CircleTimes]",
      " ", 
     RowBox[{
      RowBox[{"Diagram", "[", 
       RowBox[{"\"\<C\>\"", ",", " ", "d", ",", " ", "e"}], "]"}], " ", "\[CircleDot]",
       " ", 
      RowBox[{"Diagram", "[", 
       RowBox[{"\"\<B\>\"", ",", " ", "c", ",", " ", "d"}], "]"}]}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"DiagramTensor", "[", "diagram", "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"35d4265a-3bab-4cd4-a8dc-a5f411992ccf"],

Cell[BoxData[
 RowBox[{
  TemplateBox[{"Transpose"},
   "InactiveHead",
   BaseStyle->"Inactive",
   SyntaxForm->"Symbol",
   Tooltip->"Inactive[Transpose]"], "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     TemplateBox[{"ArrayDot"},
      "InactiveHead",
      BaseStyle->"Inactive",
      SyntaxForm->"Symbol",
      Tooltip->"Inactive[ArrayDot]"], "[", 
     RowBox[{
      TemplateBox[{"\"A\"", 
        TagBox["b", HoldForm], 
        TagBox["a", HoldForm]},
       "MatrixSymbol2"], ",", 
      TemplateBox[{
        TemplateBox[{
          TagBox["a", HoldForm]}, "ImplicitList"]},
       "SymbolicIdentityArray"], ",", "1"}], "]"}], 
    TagBox["\[TensorProduct]",
     "InactiveToken",
     BaseStyle->"Inactive",
     SyntaxForm->"\[TensorProduct]"], 
    RowBox[{
     TemplateBox[{"ArrayDot"},
      "InactiveHead",
      BaseStyle->"Inactive",
      SyntaxForm->"Symbol",
      Tooltip->"Inactive[ArrayDot]"], "[", 
     RowBox[{
      TemplateBox[{"\"C\"", 
        TagBox["e", HoldForm], 
        TagBox["d", HoldForm]},
       "MatrixSymbol2"], ",", 
      TemplateBox[{"\"B\"", 
        TagBox["d", HoldForm], 
        TagBox["c", HoldForm]},
       "MatrixSymbol2"], ",", "1"}], "]"}]}], ",", 
   RowBox[{"Cycles", "[", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"2", ",", "3"}], "}"}], "}"}], "]"}]}], "]"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"1e4598bd-89f8-497a-9445-b612ed47f1a5"]
}, Open  ]],

Cell["Inspect the dimensions of the result:", "ExampleText",ExpressionUUID->"aef3c59a-73d3-447a-899d-8cf3c2cce3cb"],

