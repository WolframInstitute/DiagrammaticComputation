Cell["Express a composite diagram as a contracted tensor:", "ExampleText",ExpressionUUID->"2c04f95c-781e-4c8c-9626-7d8a64b512e1"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"diagram", " ", "=", " ", 
   RowBox[{"Diagram", "[", 
    RowBox[{
     RowBox[{"Diagram", "[", 
      RowBox[{"\"\<A\>\"", ",", " ", "a", ",", " ", "b"}], "]"}], " ", "\[CircleTimes]",
      " ", 
     RowBox[{
      RowBox[{"Diagram", "[", 
       RowBox[{"\"\<C\>\"", ",", " ", "d", ",", " ", "e"}], "]"}], " ", "\[CircleDot]",
       " ", 
      RowBox[{"Diagram", "[", 
       RowBox[{"\"\<B\>\"", ",", " ", "c", ",", " ", "d"}], "]"}]}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"DiagramTensor", "[", "diagram", "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"d3df29d3-29df-4326-91ca-2ded5f8f6ab9"],

Cell[BoxData[
 RowBox[{
  TemplateBox[{"Transpose"},
   "InactiveHead",
   BaseStyle->"Inactive",
   SyntaxForm->"Symbol",
   Tooltip->"Inactive[Transpose]"], "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     TemplateBox[{"ArrayDot"},
      "InactiveHead",
      BaseStyle->"Inactive",
      SyntaxForm->"Symbol",
      Tooltip->"Inactive[ArrayDot]"], "[", 
     RowBox[{
      TemplateBox[{"\"A\"", 
        TagBox["b", HoldForm], 
        TagBox["a", HoldForm]},
       "MatrixSymbol2"], ",", 
      TemplateBox[{
        TemplateBox[{
          TagBox["a", HoldForm]}, "ImplicitList"]},
       "SymbolicIdentityArray"], ",", "1"}], "]"}], 
    TagBox["\[TensorProduct]",
     "InactiveToken",
     BaseStyle->"Inactive",
     SyntaxForm->"\[TensorProduct]"], 
    RowBox[{
     TemplateBox[{"ArrayDot"},
      "InactiveHead",
      BaseStyle->"Inactive",
      SyntaxForm->"Symbol",
      Tooltip->"Inactive[ArrayDot]"], "[", 
     RowBox[{
      TemplateBox[{"\"C\"", 
        TagBox["e", HoldForm], 
        TagBox["d", HoldForm]},
       "MatrixSymbol2"], ",", 
      TemplateBox[{"\"B\"", 
        TagBox["d", HoldForm], 
        TagBox["c", HoldForm]},
       "MatrixSymbol2"], ",", "1"}], "]"}]}], ",", 
   RowBox[{"Cycles", "[", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"2", ",", "3"}], "}"}], "}"}], "]"}]}], "]"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"0539a420-5225-45e0-993e-c71912109dc8"]
}, Open  ]],

Cell["Inspect the dimensions of the result:", "ExampleText",ExpressionUUID->"1621a36d-0f88-43e8-a706-976461ebe192"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TensorDimensions", "[", 
  RowBox[{"Activate", " ", "@", " ", 
   RowBox[{"DiagramTensor", "[", "diagram", "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"fe882b6e-e5ed-4dfd-a2d8-e5d74a7a67ac"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   TagBox["b",
    HoldForm], ",", 
   TagBox["e",
    HoldForm], ",", 
   TagBox["a",
    HoldForm], ",", 
   TagBox["c",
    HoldForm]}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"f802c5ac-aef6-4a2a-a424-2cdd32fa00a0"]
}, Open  ]],

