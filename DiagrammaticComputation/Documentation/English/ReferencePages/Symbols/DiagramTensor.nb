Notebook[{

Cell[CellGroupData[{
Cell["DiagramTensor", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"c1f3ef17-a6fe-4681-bd5b-365756d24849"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DiagramTensor"]], 
     "paclet:Wolfram/DiagrammaticComputation/ref/DiagramTensor", 
     "Wolfram/DiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["d", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "0a037535-2e49-4362-9071-604dc43accad"],
 " ",
 "returns a symbolic tensor expression representing the diagram ",
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "acbc6a21-8bdf-48d2-8eb7-3b77f66473b5"],
 " as a tensor contraction.",
 "\n"
}], "Usage",ExpressionUUID->"56166160-6b47-4441-9d99-6d969bc53312"],

Cell[TextData[{
 "Composition becomes ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ArrayDot"]], "paclet:ref/ArrayDot"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "986cbe55-0219-49fa-bc1a-f66b5389d457"],
 " / ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TensorContract"]], "paclet:ref/TensorContract"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8b3e057d-d976-479f-af1c-69b533c4a97e"],
 " and product becomes ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TensorProduct"]], "paclet:ref/TensorProduct"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8340c658-9ce4-4f14-a1b7-0a305b6d7f92"],
 ". Singleton diagrams become symbolic arrays whose dimensions are taken from \
the diagram's port types."
}], "Notes",ExpressionUUID->"cd86ef77-2887-4523-bd16-0cf140ce5db6"],

Cell[TextData[{
 "The result is an inactive tensor expression \[LongDash] wrap in ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Activate"]], "paclet:ref/Activate"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "00721f3f-4b28-413b-8846-ab972a0211ee"],
 " to evaluate when the underlying tensors are concrete."
}], "Notes",ExpressionUUID->"9d105d35-fcdb-4a71-aab6-6c2c5699ba60"],

Cell[TextData[{
 "Inverse direction: ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TensorDiagram"]], 
    "paclet:Wolfram/DiagrammaticComputation/ref/TensorDiagram", 
    "Wolfram/DiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "615b6ddf-83da-414c-b41d-002816c25df6"],
 " lifts a tensor expression back to a diagram."
}], "Notes",ExpressionUUID->"201496dc-238c-4308-80d9-0b502bb821a0"]
}, Open  ]],

