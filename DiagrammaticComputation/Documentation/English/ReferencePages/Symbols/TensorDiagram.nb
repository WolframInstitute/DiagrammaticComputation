  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "3df7e967-96da-4a7e-89bf-5543ebdaed2c"],
 " ports."
}], "Notes",ExpressionUUID->"8940b2eb-a1c6-4567-9f5e-80f66cd33800"],

