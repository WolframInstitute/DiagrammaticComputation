   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "dd689f8b-a35e-4844-922a-7adba9349143"],
 " ports."
}], "Notes",ExpressionUUID->"8a697d82-a905-4507-9b13-c86d080bc134"],

