Cell["Build a dual port:", "ExampleText",ExpressionUUID->"7bc60a61-645f-4c50-be6d-c8acc0d50eb6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"PortDual", "[", "a", "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"66d0e528-eece-4214-b7df-94dcbc6173a1"],

Cell[BoxData[
 InterpretationBox[
  SuperscriptBox[
   TagBox["a",
    HoldForm], "*"],
  Wolfram`DiagrammaticComputation`Port`Port[<|
   "Expression" :> 
    Wolfram`DiagrammaticComputation`Port`PortDual[MTNB$1txbeacs4q27u`a], 
    "NeutralQ" -> False, "Tags" -> {}, "Type" -> 
    SuperStar[\[FormalCapitalT]]|>],
  Tooltip->SuperscriptBox["\[FormalCapitalT]", "*"]]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"809f8703-2f52-4e97-bb5f-9a5f4502e69c"]
}, Open  ]],

