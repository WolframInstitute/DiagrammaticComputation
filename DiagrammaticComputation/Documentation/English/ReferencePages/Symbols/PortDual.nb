Cell["PortDual", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"dc2ccde3-cd36-4e21-81f8-391886ad58c5"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["PortDual",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/PortDual"], "[", 
   StyleBox["p", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "7159a716-782a-45e7-846a-2da6fcb240eb"],
 " ",
 "represents the dual of the port ",
 Cell[BoxData[
  FormBox[
   StyleBox["p", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "2e2267b2-910e-4244-bbe5-c35cef90c523"],
 " \[LongDash] same expression and type, opposite direction.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"0e00830a-8889-4049-a94d-8b8a3218e56d"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["PortDual",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/PortDual"], "[", 
   RowBox[{
    StyleBox["expr", "TI"], ",", " ", 
    StyleBox["type", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "ad38f109-b50e-409b-b537-477a6f482d7c"],
 " ",
 "constructs a dual port directly from an expression and type."
}], "Usage",ExpressionUUID->"aa4f859b-743a-4237-bd72-fc4b70b03e78"],

Cell[TextData[{
 "An input port and its dual output port have the same name but opposite \
roles in composition: a ",
 Cell[BoxData[
  ButtonBox["Diagram",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/Diagram"]], 
  "InlineFormula",ExpressionUUID->"76a9583e-dbab-4662-82f0-cf7a3dde3c5b"],
 " accepting input ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Port",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/Port"], "[", 
   StyleBox["a", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "a8d60a96-494d-4924-b261-300236040238"],
 " connects to one producing output ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["PortDual",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/PortDual"], "[", 
   StyleBox["a", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "cd3159e4-09db-4f5b-b648-c20656a7fe17"],
 "."
}], "Notes",ExpressionUUID->"92a6a67f-f322-4205-9033-da476f2180bd"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["PortDual",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/PortDual"]], 
  "InlineFormula",ExpressionUUID->"47f6f1c0-c356-4857-8e25-d0ffbc5807c4"],
 " is an involution: ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"PortDual", "[", 
    RowBox[{"PortDual", "[", 
     StyleBox["p", "TI"], "]"}], "]"}], " ", "==", " ", 
   StyleBox["p", "TI"]}]], "InlineFormula",ExpressionUUID->
  "a4411d3d-b04b-49c0-b13a-7de945d68f81"],
 "."
}], "Notes",ExpressionUUID->"497948d1-dc8e-4781-bdce-b1b316fea9b5"],

Cell[TextData[{
 "For composite ports, duality distributes: ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"PortDual", "[", 
    RowBox[{"PortProduct", "[", 
     RowBox[{
      SubscriptBox[
       StyleBox["p", "TI"], 
       StyleBox["1", "TR"]], ",", " ", 
      SubscriptBox[
       StyleBox["p", "TI"], 
       StyleBox["2", "TR"]]}], "]"}], "]"}], " ", "==", " ", 
   RowBox[{"PortProduct", "[", 
    RowBox[{
     RowBox[{"PortDual", "[", 
      SubscriptBox[
       StyleBox["p", "TI"], 
       StyleBox["2", "TR"]], "]"}], ",", " ", 
     RowBox[{"PortDual", "[", 
      SubscriptBox[
       StyleBox["p", "TI"], 
       StyleBox["1", "TR"]], "]"}]}], "]"}]}]], "InlineFormula",
  ExpressionUUID->"5fc65ecf-a829-4c86-acd1-141a71ee1bf8"],
 " (note the reversal)."
}], "Notes",ExpressionUUID->"dca08b8d-9c21-403b-acd9-6a290eb61d0a"]
}, Open  ]],

