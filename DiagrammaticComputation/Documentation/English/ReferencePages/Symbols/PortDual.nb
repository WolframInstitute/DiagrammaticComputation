   RowBox[{
    StyleBox["expr", "TI"], ",", " ", 
    StyleBox["type", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "2cb55eb6-c78a-4dd8-abb5-605b71e47102"],
 " ",
 "constructs a dual port directly from an expression and type."
}], "Usage",ExpressionUUID->"ff2bcadb-8faf-45c9-a16e-336212597a11"],

Cell[TextData[{
 "An input port and its dual output port have the same name but opposite \
roles in composition: a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Diagram"]], 
    "paclet:WolframDiagrammaticComputation/ref/Diagram", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a515322e-26a3-49d9-837d-1d7c2db558ae"],
 " accepting input ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["Port"]], "paclet:WolframDiagrammaticComputation/ref/Port", 
     "WolframDiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["a", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "3db4a7ec-4ff6-467c-9a86-42f6c131f92d"],
 " connects to one producing output ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["PortDual"]], 
     "paclet:WolframDiagrammaticComputation/ref/PortDual", 
     "WolframDiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["a", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "2ce76029-e0ba-4de4-bd44-35774e4af1cf"],
 "."
}], "Notes",ExpressionUUID->"eb8ebd3e-d14d-431d-b77c-4be2de6634ca"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["PortDual"]], 
    "paclet:WolframDiagrammaticComputation/ref/PortDual", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "82940f40-e017-438f-893f-89155b0559ce"],
 " is an involution: ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"PortDual", "[", 
    RowBox[{"PortDual", "[", 
     StyleBox["p", "TI"], "]"}], "]"}], " ", "==", " ", 
   StyleBox["p", "TI"]}]], "InlineFormula",ExpressionUUID->
  "ed7e4567-ca45-499d-a3ae-046d902968f3"],
 "."
}], "Notes",ExpressionUUID->"42996af6-2e11-475f-9b53-25d16a1880dd"],

Cell[TextData[{
 "For composite ports, duality distributes: ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"PortDual", "[", 
    RowBox[{"PortProduct", "[", 
     RowBox[{
      SubscriptBox[
       StyleBox["p", "TI"], 
       StyleBox["1", "TR"]], ",", " ", 
      SubscriptBox[
       StyleBox["p", "TI"], 
       StyleBox["2", "TR"]]}], "]"}], "]"}], " ", "==", " ", 
   RowBox[{"PortProduct", "[", 
    RowBox[{
     RowBox[{"PortDual", "[", 
      SubscriptBox[
       StyleBox["p", "TI"], 
       StyleBox["2", "TR"]], "]"}], ",", " ", 
     RowBox[{"PortDual", "[", 
      SubscriptBox[
       StyleBox["p", "TI"], 
       StyleBox["1", "TR"]], "]"}]}], "]"}]}]], "InlineFormula",
  ExpressionUUID->"4c50e13f-0ac4-4e0b-bc46-0a3a1f294fbc"],
 " (note the reversal)."
}], "Notes",ExpressionUUID->"9db44076-f99e-49b5-be00-e918e1d69d92"]
}, Open  ]],

