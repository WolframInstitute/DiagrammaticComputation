Cell["\<\
Encodes the interaction-net erase law: a process meeting an eraser on one \
wire is replaced by erasers on all its other wires.\
\>", "Notes",ExpressionUUID->"d4909a6e-4c2e-4b11-b88e-020178766cd8"],

Cell[TextData[{
 "A dual port (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SuperStar"]], "paclet:ref/SuperStar"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "048a94cb-a71c-43b3-91a0-a67a41a5acb8"],
 ") marks the side on which the eraser arrives."
}], "Notes",ExpressionUUID->"45e4b957-c720-4673-9c3a-98142cfb8eb5"],

