Cell["\<\
Encodes the interaction-net erase law: a process meeting an eraser on one \
wire is replaced by erasers on all its other wires.\
\>", "Notes",ExpressionUUID->"0844af47-fe38-423b-85aa-5a6adcd6f3b4"],

Cell[TextData[{
 "A dual port (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SuperStar"]], "paclet:ref/SuperStar"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "55263d45-5df3-42a6-bd3c-4e8c72167f06"],
 ") marks the side on which the eraser arrives."
}], "Notes",ExpressionUUID->"051c6c41-9ac1-4605-bd06-33f5de2df334"],

