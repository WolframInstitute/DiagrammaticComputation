Cell[TextData[{
 "The sum diagram has as inputs the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["PortSum"]], 
    "paclet:Wolfram/DiagrammaticComputation/ref/PortSum", 
    "Wolfram/DiagrammaticComputation Package Symbol"},
