 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["d", "TI"], 
    StyleBox["i", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "e6bd8260-59d1-45df-9853-96ea11417b2d"],
 ", and as outputs the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["PortSum"]], 
    "paclet:Wolfram/DiagrammaticComputation/ref/PortSum", 
    "Wolfram/DiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "66eb39ac-abf5-4f36-bd55-a64fe30a5907"],
 " of the outputs. Categorically, this is the biproduct in additive monoidal \
categories."
}], "Notes",ExpressionUUID->"79a3dd4a-20dd-4cb0-9a46-9967c4b5612c"],

