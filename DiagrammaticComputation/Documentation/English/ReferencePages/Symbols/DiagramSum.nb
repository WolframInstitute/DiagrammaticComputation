Cell[TextData[{
 "The sum diagram has as inputs the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["PortSum"]], 
    "paclet:WolframDiagrammaticComputation/ref/PortSum", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7722b574-c234-406a-85de-5c0ce2e6f813"],
 " of the inputs of the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["d", "TI"], 
    StyleBox["i", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "df4f3b3a-ddb3-415b-a742-2c52ad9368e3"],
 ", and as outputs the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["PortSum"]], 
    "paclet:WolframDiagrammaticComputation/ref/PortSum", 
    "WolframDiagrammaticComputation Package Symbol"},
