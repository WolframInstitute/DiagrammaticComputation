Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"be256905-ec3d-4f60-b712-344b39e1bd63"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["DiagramSum",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/DiagramSum"], "[", 
   RowBox[{
    SubscriptBox[
     StyleBox["d", "TI"], 
     StyleBox["1", "TR"]], ",", " ", 
    SubscriptBox[
     StyleBox["d", "TI"], 
     StyleBox["2", "TR"]], ",", " ", 
    SubscriptBox[
     StyleBox["d", "TI"], 
     StyleBox["3", "TR"]], ",", " ", "\[Ellipsis]"}], "]"}]], "InlineFormula",
  ExpressionUUID->"9f7d4178-8ff6-439b-a319-70c09391c735"],
 " ",
 "represents the direct sum (additive choice) of the diagrams ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["d", "TI"], 
    StyleBox["i", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "6c2aa72b-9d05-462c-b7bc-195e98fd7ec9"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"49b27134-1bf4-4ec9-b8c5-3591315104f2"],

Cell[TextData[{
 "The sum diagram has as inputs the ",
 Cell[BoxData[
  ButtonBox["PortSum",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/PortSum"]], 
  "InlineFormula",ExpressionUUID->"7fe9a53d-50ef-415b-96e5-9c4b4d3352e5"],
 " of the inputs of the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["d", "TI"], 
    StyleBox["i", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "ba7f5506-4fed-48a9-add9-c63793ddace7"],
 ", and as outputs the ",
 Cell[BoxData[
  ButtonBox["PortSum",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/PortSum"]], 
  "InlineFormula",ExpressionUUID->"67791344-3ca8-43d0-8309-a2f5ec6112f1"],
 " of the outputs. Categorically, this is the biproduct in additive monoidal \
categories."
}], "Notes",ExpressionUUID->"0b057ff6-c690-47ba-9623-164e3c62b57a"],

Cell[TextData[{
