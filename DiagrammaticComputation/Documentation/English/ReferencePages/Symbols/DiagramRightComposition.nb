  FormBox[
   SubscriptBox[
    StyleBox["d", "TI"], "1"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"3b54a606-1001-4dfd-a823-1023f8560549"],
 " runs first, then ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["d", "TI"], "2"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"ec58c96b-71d4-448b-bfad-b05ee1ee39b2"],
 ", then ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["d", "TI"], "3"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"f01e34b0-5aa3-4c5a-94f1-ad8f7e69d77a"],
 ", \[Ellipsis].",
 "\n"
}], "Usage",ExpressionUUID->"eea07515-f370-448e-914a-f9325c2cc96d"],

