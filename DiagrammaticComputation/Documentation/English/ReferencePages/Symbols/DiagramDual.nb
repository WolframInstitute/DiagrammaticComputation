Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramDual"]], 
    "paclet:WolframDiagrammaticComputation/ref/DiagramDual", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "bc920b9d-b887-4ebe-8f1b-009052d7ffd4"],
 " is one of three involutions on diagrams: ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramFlip"]], 
    "paclet:WolframDiagrammaticComputation/ref/DiagramFlip", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8772daf6-05df-4cd3-8581-922fdacfa2bf"],
 " swaps inputs and outputs without dualising ports, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramReverse"]], 
    "paclet:WolframDiagrammaticComputation/ref/DiagramReverse", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "89af6731-6ccf-4b48-acaf-abe55644dca3"],
 " reverses the ",
 StyleBox["order", "TI"],
 " of the ports without changing their direction."
}], "ExampleText",ExpressionUUID->"a6762851-1ff8-40bc-bdb0-63f12c8ee722"]
