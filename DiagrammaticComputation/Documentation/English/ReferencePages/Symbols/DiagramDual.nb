Cell[CellGroupData[{
Cell["DiagramDual", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"39ced536-a70c-43ac-8a4a-b98c943100d2"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DiagramDual"]], 
     "paclet:Wolfram/DiagrammaticComputation/ref/DiagramDual", 
     "Wolfram/DiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["d", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "00265a96-63c7-4288-bd8c-1c87c7ee4f61"],
 " ",
 "changes the direction of every port of the diagram ",
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "5477ee8e-85e3-4711-b30d-bd214faa552e"],
 " \[LongDash] outputs become inputs and vice versa, with each port dualised.",
 "\n"
}], "Usage",ExpressionUUID->"a7863166-ebe2-4374-9588-3484a3f0b486"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramDual"]], 
    "paclet:Wolfram/DiagrammaticComputation/ref/DiagramDual", 
    "Wolfram/DiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "dea5820a-84ee-4816-8148-49a1d7452da5"],
 " is an involution: ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"DiagramDual", "[", 
    RowBox[{"DiagramDual", "[", 
     StyleBox["d", "TI"], "]"}], "]"}], " ", "==", " ", 
   StyleBox["d", "TI"]}]], "InlineFormula",ExpressionUUID->
  "353eeb31-475b-428c-90ae-f713a00e645a"],
 "."
}], "Notes",ExpressionUUID->"ec9b5e49-d128-4159-a9e8-095e71e6de97"],

Cell[TextData[{
 "It is ",
 StyleBox["port-wise", "TI"],
 " duality: each port is replaced by its ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["PortDual"]], 
    "paclet:Wolfram/DiagrammaticComputation/ref/PortDual", 
    "Wolfram/DiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d89ae233-0efa-4c98-aca6-cc2f66a03ec2"],
 ", and the input/output lists are swapped."
}], "Notes",ExpressionUUID->"dfdce1a2-ba1c-4fd6-b902-afa6aa41e682"],

Cell[TextData[{
 "The shorthand ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"$d", "^"}], "*", "$"}]], "InlineFormula",ExpressionUUID->
  "92d9cfc5-8e04-47fb-a65e-f749b582dad2"],
 " produces a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramDual"]], 
    "paclet:Wolfram/DiagrammaticComputation/ref/DiagramDual", 
    "Wolfram/DiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "bff8be0b-bba8-4964-b7e2-13b2e9b182ea"],
 "."
}], "Notes",ExpressionUUID->"b7dd7c97-e107-4b11-ab48-c95119961590"]
}, Open  ]],

