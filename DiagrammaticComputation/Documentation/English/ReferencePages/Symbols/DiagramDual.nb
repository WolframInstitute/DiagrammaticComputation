       "OutputPorts" -> {
         Wolfram`DiagrammaticComputation`Port`Port[<|
          "Expression" :> 
           Wolfram`DiagrammaticComputation`Port`PortDual[
            FunctionRepository`$955258636fa042ac87af26c7567e2d7f`x], 
           "NeutralQ" -> False, "Tags" -> {}, "Type" -> 
           SuperStar[\[FormalCapitalT]]|>], 
         Wolfram`DiagrammaticComputation`Port`Port[<|
