Cell[CellGroupData[{
Cell["DiagramDual", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"90263b3b-0b2a-4c28-82de-80e20fad2fc7"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DiagramDual"]], 
     "paclet:WolframDiagrammaticComputation/ref/DiagramDual", 
     "WolframDiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["d", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "382b8931-8566-4627-a135-806f231d187b"],
 " ",
 "changes the direction of every port of the diagram ",
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "0c94697f-3f0f-47e1-b4bd-3ed4b81dd67c"],
 " \[LongDash] outputs become inputs and vice versa, with each port dualised.",
 "\n"
}], "Usage",ExpressionUUID->"9456f001-7838-44c8-a81f-031c3c443e54"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramDual"]], 
    "paclet:WolframDiagrammaticComputation/ref/DiagramDual", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "034743af-d947-4264-bfc3-ced5f25bb91a"],
 " is an involution: ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"DiagramDual", "[", 
    RowBox[{"DiagramDual", "[", 
     StyleBox["d", "TI"], "]"}], "]"}], " ", "==", " ", 
   StyleBox["d", "TI"]}]], "InlineFormula",ExpressionUUID->
  "8e4e3d28-9588-4f88-be24-c42bb5dcb179"],
 "."
}], "Notes",ExpressionUUID->"87d3988c-29a7-49ad-bf5f-83cd9357cdfc"],

Cell[TextData[{
 "It is ",
 StyleBox["port-wise", "TI"],
 " duality: each port is replaced by its ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["PortDual"]], 
    "paclet:WolframDiagrammaticComputation/ref/PortDual", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0756fa00-530b-4187-ab1f-1c7f33821ebe"],
 ", and the input/output lists are swapped."
}], "Notes",ExpressionUUID->"af4eabb2-2acc-43f2-a644-8e44e75a99d1"],

Cell[TextData[{
 "The shorthand ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"$d", "^"}], "*", "$"}]], "InlineFormula",ExpressionUUID->
  "cadf093e-7669-43dc-a3b8-14d1d1bcd48f"],
 " produces a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramDual"]], 
    "paclet:WolframDiagrammaticComputation/ref/DiagramDual", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "34cf4b39-0659-471d-80eb-586c922a30bf"],
 "."
}], "Notes",ExpressionUUID->"ac150eac-4b7f-42f2-9687-3fa9ec83b088"]
}, Open  ]],

