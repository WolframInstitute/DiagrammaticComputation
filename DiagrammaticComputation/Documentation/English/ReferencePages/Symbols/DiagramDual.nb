Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramDual"]], 
    "paclet:Wolfram/DiagrammaticComputation/ref/DiagramDual", 
    "Wolfram/DiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f3817b7a-2f7a-4588-9bd5-55ecb465ed05"],
 " is one of three involutions on diagrams: ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramFlip"]], 
    "paclet:Wolfram/DiagrammaticComputation/ref/DiagramFlip", 
    "Wolfram/DiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f4037067-08f3-4f34-b982-386ff2df18b0"],
 " swaps inputs and outputs without dualising ports, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramReverse"]], 
    "paclet:Wolfram/DiagrammaticComputation/ref/DiagramReverse", 
    "Wolfram/DiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "826f1746-98a5-4b52-b710-87fb6012c14a"],
 " reverses the ",
 StyleBox["order", "TI"],
 " of the ports without changing their direction."
}], "ExampleText",ExpressionUUID->"da1836ef-0c21-4a34-a22b-160ef21cb14b"]
}, Open  ]]
}, Open  ]],

