Notebook[{

Cell[CellGroupData[{
Cell["DiagramDual", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"dba2372e-1833-4e98-8d09-8c16bcba2767"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["DiagramDual",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/DiagramDual"], "[", 
   StyleBox["d", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "b1f959e7-e2f8-4dca-8e6b-bbad832bbd79"],
 " ",
 "changes the direction of every port of the diagram ",
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "f50e0bab-3131-43ca-acf1-c14a5cb82ea4"],
 " \[LongDash] outputs become inputs and vice versa, with each port dualised.",
 "\n"
}], "Usage",ExpressionUUID->"4873744f-6ecc-41a2-9df5-4b964acb363e"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["DiagramDual",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/DiagramDual"]], 
  "InlineFormula",ExpressionUUID->"0fe0c61f-bfc2-4827-ad97-f69a8a1c1bd3"],
 " is an involution: ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"DiagramDual", "[", 
    RowBox[{"DiagramDual", "[", 
     StyleBox["d", "TI"], "]"}], "]"}], " ", "==", " ", 
   StyleBox["d", "TI"]}]], "InlineFormula",ExpressionUUID->
  "1523d429-042f-4b81-90f5-13b711d97e5a"],
 "."
}], "Notes",ExpressionUUID->"3e6d9dd0-e7a4-4137-b2df-345e95b1d81e"],

Cell[TextData[{
 "It is ",
 StyleBox["port-wise", "TI"],
 " duality: each port is replaced by its ",
 Cell[BoxData[
  ButtonBox["PortDual",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/PortDual"]], 
  "InlineFormula",ExpressionUUID->"b043304d-b64d-482d-87f3-11484e06b27d"],
 ", and the input/output lists are swapped."
}], "Notes",ExpressionUUID->"4e068d39-cce0-4bef-9574-3841b41fcb0a"],

Cell[TextData[{
 "The shorthand ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"$d", "^"}], "*", "$"}]], "InlineFormula",ExpressionUUID->
  "e0c38720-3caf-46db-929a-de173ebbfe46"],
 " produces a ",
 Cell[BoxData[
  ButtonBox["DiagramDual",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/DiagramDual"]], 
  "InlineFormula",ExpressionUUID->"d3f4f8b9-50d9-41d2-8b05-707249a19dac"],
 "."
}], "Notes",ExpressionUUID->"31a1dad2-4b95-4018-925d-cfa0a0c8329c"]
}, Open  ]],

