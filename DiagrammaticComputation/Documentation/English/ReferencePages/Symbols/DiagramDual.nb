Cell[TextData[{
 Cell[BoxData[
  ButtonBox["DiagramDual",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/DiagramDual"]], 
  "InlineFormula",ExpressionUUID->"84dfcb1f-e0cb-467e-88b8-6cd9331fe7b5"],
 " is one of three involutions on diagrams: ",
 Cell[BoxData[
  ButtonBox["DiagramFlip",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/DiagramFlip"]], 
  "InlineFormula",ExpressionUUID->"2e44ba32-0fa2-44e5-b18c-61d7302318e0"],
 " swaps inputs and outputs without dualising ports, and ",
 Cell[BoxData[
  ButtonBox["DiagramReverse",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/DiagramReverse"]], 
  "InlineFormula",ExpressionUUID->"b20d9696-7adb-46ff-b981-f3f589bc00c0"],
 " reverses the ",
 StyleBox["order", "TI"],
 " of the ports without changing their direction."
}], "ExampleText",ExpressionUUID->"2576ea14-2e9a-4b42-8c64-d6aca1b7db4f"]
