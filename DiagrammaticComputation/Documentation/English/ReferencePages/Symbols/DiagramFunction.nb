Cell["Convert a permutation diagram to its function:", "ExampleText",ExpressionUUID->"a20f560b-1be6-466c-95c1-b89897ccd1b6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"DiagramFunction", " ", "@", " ", 
  RowBox[{"PermutationDiagram", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"a", ",", " ", "c", ",", " ", "b"}], "}"}], " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"c", ",", " ", "b", ",", " ", "a"}], "}"}]}], "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"474ef59d-320a-48be-9eeb-6e9f0167b791"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Sequence", "@@", 
    RowBox[{"{", 
     RowBox[{
      TemplateBox[{"#1", "1"},
       "IndexedDefault"], ",", 
      TemplateBox[{"#1", "2"},
       "IndexedDefault"], ",", 
      TemplateBox[{"#1", "3"},
       "IndexedDefault"]}], "}"}]}], "&"}], "@*", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"Permute", "[", 
     RowBox[{"#1", ",", 
      RowBox[{"Cycles", "[", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"1", ",", "3", ",", "2"}], "}"}], "}"}], "]"}]}], "]"}], 
    "&"}], ")"}], "@*", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"#1", ",", "#2", ",", "#3"}], "}"}], "&"}], ")"}]}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"5f5e82fb-7687-48a0-af92-f0591eb69456"]
}, Open  ]],

