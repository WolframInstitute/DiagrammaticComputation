Cell[CellGroupData[{
Cell["DiagramFunction", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"2be31951-77a5-4bd5-933c-e7f6c20ecc7f"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DiagramFunction"]], 
     "paclet:Wolfram/DiagrammaticComputation/ref/DiagramFunction", 
     "Wolfram/DiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["d", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "e628aaed-d1c1-484e-a2e9-2c78300c8ada"],
 " ",
 "returns a pure function whose input/output signature matches the ports of \
the diagram ",
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "f228d83c-400d-4bd9-812f-92ddca911f0f"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"4c23d5b7-2ce7-4fd1-bb62-6219011c6f44"],

Cell["\<\
The function reads input arguments as the input ports of the diagram, threads \
them through each subdiagram according to its composition, and returns a \
tuple of values for the output ports.\
\>", "Notes",ExpressionUUID->"996e9731-945f-41ca-85dc-8595c72e08f2"],

Cell[TextData[{
 "Useful for executing a symbolic diagram as code; complementary to ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramTensor"]], 
    "paclet:Wolfram/DiagrammaticComputation/ref/DiagramTensor", 
    "Wolfram/DiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1990c90b-fde6-4cda-beb9-57ac8bc9eae8"],
 ", which executes the diagram as a tensor contraction."
}], "Notes",ExpressionUUID->"b5526eeb-d821-4fe4-b2dc-7651e12c01bb"]
}, Open  ]],

