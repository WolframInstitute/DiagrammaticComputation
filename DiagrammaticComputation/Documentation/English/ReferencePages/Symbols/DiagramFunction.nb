Cell[CellGroupData[{
Cell["DiagramFunction", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"def961a2-3daa-4e7c-add2-cf4025d8c205"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DiagramFunction"]], 
     "paclet:WolframDiagrammaticComputation/ref/DiagramFunction", 
     "WolframDiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["d", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "cb3c006d-ec8a-4f3a-90e8-1d063df36d4b"],
 " ",
 "returns a pure function whose input/output signature matches the ports of \
the diagram ",
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "c118c746-7664-4e45-9762-5e8c0171d274"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"a640f7b3-65a2-45d8-a8ea-e54527e998c4"],

Cell["\<\
The function reads input arguments as the input ports of the diagram, threads \
them through each subdiagram according to its composition, and returns a \
tuple of values for the output ports.\
\>", "Notes",ExpressionUUID->"7bda7127-196e-4c16-bdf4-4c31383892ca"],

Cell[TextData[{
 "Useful for executing a symbolic diagram as code; complementary to ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramTensor"]], 
    "paclet:WolframDiagrammaticComputation/ref/DiagramTensor", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "cddc1af5-f665-44a9-9925-49de55478fd1"],
 ", which executes the diagram as a tensor contraction."
}], "Notes",ExpressionUUID->"ed64bf8e-d3ce-4d7d-a9f7-cc9d99291031"]
}, Open  ]],

