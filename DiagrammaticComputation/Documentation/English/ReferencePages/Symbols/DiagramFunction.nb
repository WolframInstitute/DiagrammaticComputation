Cell["Convert a permutation diagram to its function:", "ExampleText",ExpressionUUID->"ddeededa-e844-4fd8-a3a7-67e7dc70dfba"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"DiagramFunction", " ", "@", " ", 
  RowBox[{"PermutationDiagram", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"a", ",", " ", "c", ",", " ", "b"}], "}"}], " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"c", ",", " ", "b", ",", " ", "a"}], "}"}]}], "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"e1117de9-8fdc-448f-8281-c4bd11df667f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Sequence", "@@", 
    RowBox[{"{", 
     RowBox[{
      TemplateBox[{"#1", "1"},
       "IndexedDefault"], ",", 
      TemplateBox[{"#1", "2"},
       "IndexedDefault"], ",", 
      TemplateBox[{"#1", "3"},
       "IndexedDefault"]}], "}"}]}], "&"}], "@*", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"Permute", "[", 
     RowBox[{"#1", ",", 
      RowBox[{"Cycles", "[", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"1", ",", "3", ",", "2"}], "}"}], "}"}], "]"}]}], "]"}], 
    "&"}], ")"}], "@*", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"#1", ",", "#2", ",", "#3"}], "}"}], "&"}], ")"}]}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"7a142dae-3d46-4fbd-b586-ee503e1f78cd"]
}, Open  ]],

