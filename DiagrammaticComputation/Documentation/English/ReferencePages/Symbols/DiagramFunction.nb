Cell["Convert a permutation diagram to its function:", "ExampleText",ExpressionUUID->"e9a38ac6-2e53-4271-a233-3b31fc4d76ca"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"DiagramFunction", " ", "@", " ", 
  RowBox[{"PermutationDiagram", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"a", ",", " ", "c", ",", " ", "b"}], "}"}], " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"c", ",", " ", "b", ",", " ", "a"}], "}"}]}], "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"c23d694c-d26a-41d6-8938-79f9c462ff10"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Sequence", "@@", 
    RowBox[{"{", 
     RowBox[{
      TemplateBox[{"#1", "1"},
       "IndexedDefault"], ",", 
      TemplateBox[{"#1", "2"},
       "IndexedDefault"], ",", 
      TemplateBox[{"#1", "3"},
       "IndexedDefault"]}], "}"}]}], "&"}], "@*", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"Permute", "[", 
     RowBox[{"#1", ",", 
      RowBox[{"Cycles", "[", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"1", ",", "3", ",", "2"}], "}"}], "}"}], "]"}]}], "]"}], 
    "&"}], ")"}], "@*", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"#1", ",", "#2", ",", "#3"}], "}"}], "&"}], ")"}]}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"acc4964d-268a-4006-acf8-bffc181a6353"]
}, Open  ]],

