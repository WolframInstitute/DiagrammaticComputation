Notebook[{

Cell[CellGroupData[{
Cell["DiagramFunction", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"fabee673-85f2-46cc-a930-77768b106995"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["DiagramFunction",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/DiagramFunction"],
    "[", 
   StyleBox["d", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "f04d7fb0-1e5f-48be-9b45-fdb64ce99fb2"],
 " ",
 "returns a pure function whose input/output signature matches the ports of \
the diagram ",
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "b7659ea7-2f9d-4188-af77-83ad94bd714c"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"0cfff797-dbe6-4a4a-86d7-bdc71379df89"],

Cell["\<\
The function reads input arguments as the input ports of the diagram, threads \
them through each subdiagram according to its composition, and returns a \
tuple of values for the output ports.\
\>", "Notes",ExpressionUUID->"b55a45e9-4090-42b0-abf9-1e26db9aad66"],

Cell[TextData[{
 "Useful for executing a symbolic diagram as code; complementary to ",
 Cell[BoxData[
  ButtonBox["DiagramTensor",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/DiagramTensor"]], 
  "InlineFormula",ExpressionUUID->"ae4e0771-dd3c-4688-80cd-0d8dba921395"],
 ", which executes the diagram as a tensor contraction."
}], "Notes",ExpressionUUID->"4a624736-d6d6-42f8-aa82-68c7e71fa660"]
}, Open  ]],

