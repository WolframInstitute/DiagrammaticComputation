Cell[CellGroupData[{
Cell["SingletonDiagram", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"b9293dde-dd1d-4080-993a-8cfb97cc8435"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SingletonDiagram",
    BaseStyle->"Link",
    ButtonData->
     "paclet:Wolfram/DiagrammaticComputation/ref/SingletonDiagram"], "[", 
   StyleBox["d", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "a6041faf-ede3-4299-a013-401bf495262f"],
 " ",
 "wraps the diagram ",
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d49ae100-94b6-4474-ab1a-0f1f985da496"],
 " as a single opaque node, hiding its internal structure.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"2f54ed83-d763-4e5b-b32b-97107f758faa"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SingletonDiagram",
    BaseStyle->"Link",
    ButtonData->
     "paclet:Wolfram/DiagrammaticComputation/ref/SingletonDiagram"], "[", 
   RowBox[{
    StyleBox["d", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["i", "TI"], 
       StyleBox["1", "TR"]], ",", " ", "\[Ellipsis]"}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["o", "TI"], 
       StyleBox["1", "TR"]], ",", " ", "\[Ellipsis]"}], "}"}]}], "]"}]], 
  "InlineFormula",ExpressionUUID->"7933d80d-1389-46e1-adc4-75204a3f151f"],
 " ",
 "wraps ",
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "4dc7bb5e-6737-419c-a203-7aa4284fc3a4"],
 " with explicit input and output ports ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["i", "TI"], "1"], ",", 
    RowBox[{"\[AHat]", "\[Hyphen]", "\.a6"}]}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"475e298b-efc1-42ad-a9be-324570b6b55a"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["o", "TI"], "1"], ",", 
    RowBox[{"\[AHat]", "\[Hyphen]", "\.a6"}]}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"eb721b53-7547-48a8-a286-8d26f9ef5f52"],
 "."
}], "Usage",ExpressionUUID->"97c07dbb-e327-47ee-bcec-863b1aa735c1"],

Cell["\<\
Useful when an already-built diagram should be treated as an atomic process \
\[LongDash] for example, to display it as a single box rather than \
decomposed, or to compose it with others without exposing its substructure.\
\>", "Notes",ExpressionUUID->"a898fc53-aeab-40a8-883c-1251b8d29e3d"],

Cell[TextData[{
 "The wrapped diagram preserves its data and behaviour under composition, but \
",
 Cell[BoxData[
  ButtonBox["DiagramDecompose",
   BaseStyle->"Link",
   ButtonData->
    "paclet:Wolfram/DiagrammaticComputation/ref/DiagramDecompose"]], 
  "InlineFormula",ExpressionUUID->"728e1adf-4f56-4d26-9ec8-cb79f9390403"],
 " and surgery tools see it as a single node."
}], "Notes",ExpressionUUID->"aec9edca-da11-4a65-bdd0-d7dfb22836c4"]
}, Open  ]],

