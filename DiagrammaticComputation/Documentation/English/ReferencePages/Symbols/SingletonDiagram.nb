 "."
}], "Usage",ExpressionUUID->"45b64531-8c2e-4da4-a8b3-866e06f18549"],

Cell["\<\
Useful when an already-built diagram should be treated as an atomic process \
\[LongDash] for example, to display it as a single box rather than \
decomposed, or to compose it with others without exposing its substructure.\
\>", "Notes",ExpressionUUID->"d1d460a2-3b31-4125-bbc3-4e1e1b8071eb"],

Cell[TextData[{
 "The wrapped diagram preserves its data and behaviour under composition, but \
",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramDecompose"]], 
    "paclet:WolframDiagrammaticComputation/ref/DiagramDecompose", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "82c068bb-d48e-49c3-99a4-e821cfbc4d75"],
 " and surgery tools see it as a single node."
}], "Notes",ExpressionUUID->"ac6f07ea-80ae-4fcc-b349-74645b69c77e"]
}, Open  ]],

