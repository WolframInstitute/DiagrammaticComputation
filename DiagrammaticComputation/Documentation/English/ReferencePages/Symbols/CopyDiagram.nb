Cell[CellGroupData[{
Cell["CopyDiagram", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"53dc430f-dd0c-4dea-a928-1444faff5f3d"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CopyDiagram",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/CopyDiagram"], "[", 
   RowBox[{
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "527479ee-2101-4a6d-ad18-bcc0dff58063"],
 " ",
 "creates a diagram with one input port ",
 Cell[BoxData[
  FormBox[
   StyleBox["p", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "29a353df-b35c-439a-8b86-bb87611bdadc"],
 " and ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "5d125941-37e1-4ef5-92c8-6080348a8e9c"],
 " output copies of ",
 Cell[BoxData[
  FormBox[
   StyleBox["p", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "25597a45-b853-441c-82fe-1944141ffe83"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"d03bb5b7-0f9d-485c-8d48-552776794d8a"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CopyDiagram",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/CopyDiagram"], "[", 
   RowBox[{
    StyleBox["p", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["q", "TI"], 
       StyleBox["1", "TR"]], ",", " ", "\[Ellipsis]", ",", " ", 
      SubscriptBox[
       StyleBox["q", "TI"], 
       StyleBox["n", "TI"]]}], "}"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"fe245ee6-a7f8-4d9e-94a6-fa823f5e1e84"],
 " ",
 "copies ",
 Cell[BoxData[
  FormBox[
   StyleBox["p", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "437db47b-e815-48ee-84d9-fbccee855334"],
 " onto the explicit output ports ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["q", "TI"], "1"], ",", 
    RowBox[{"\[AHat]", "\[Hyphen]", "\.a6"}], ",", 
    SubscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["n", "TI"]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"c667ced2-cde2-4b84-a1c3-5502490db261"],
 "."
}], "Usage",ExpressionUUID->"ddfda35f-b25e-4e78-b97a-06289dd37aaf"],

Cell[TextData[{
 "A copy diagram is a special case of ",
 Cell[BoxData[
  ButtonBox["SpiderDiagram",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/SpiderDiagram"]], 
  "InlineFormula",ExpressionUUID->"8f3f43a2-5c0f-49a0-819a-e0ccef083e8b"],
 " with one input and many outputs."
}], "Notes",ExpressionUUID->"d8922470-931b-406d-81b2-d6b626bb8c5e"],

Cell["\<\
It is the comultiplication morphism of a Frobenius / classical-structure on \
its wire.\
\>", "Notes",ExpressionUUID->"9912ac91-0711-434f-945a-fd84add6fe34"]
}, Open  ]],

