          TagBox["a",
           HoldForm],
          
          Wolfram`DiagrammaticComputation`Port`Port[<|
           "Expression" :> 
            FunctionRepository`$955258636fa042ac87af26c7567e2d7f`a, 
            "NeutralQ" -> False, "Tags" -> {}, "Type" -> \[FormalCapitalT]|>],
          
          Tooltip->"\[FormalCapitalT]"], {-0.4, -0.875}]}, {
        ArrowBox[{{0., -0.5}, {0., -0.75}}], InsetBox[
