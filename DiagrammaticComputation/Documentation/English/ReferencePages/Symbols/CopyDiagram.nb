Cell[TextData[{
 "The dual operation is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["MergeDiagram"]], 
    "paclet:Wolfram/DiagrammaticComputation/ref/MergeDiagram", 
    "Wolfram/DiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9e9ee155-b1a8-4747-867f-383a064c3a77"],
 ". Copy and merge satisfy the (co)associativity and (co)commutativity laws \
of a commutative Frobenius algebra."
}], "ExampleText",ExpressionUUID->"fc1081a9-3d83-4339-9a45-cc249f75e60e"]
}, Open  ]]
}, Open  ]],

