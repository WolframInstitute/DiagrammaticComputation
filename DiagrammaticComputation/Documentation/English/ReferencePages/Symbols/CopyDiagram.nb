Cell[TextData[{
 "The dual operation is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["MergeDiagram"]], 
    "paclet:WolframDiagrammaticComputation/ref/MergeDiagram", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8ad62881-c763-4dd6-9b85-a3348c716942"],
 ". Copy and merge satisfy the (co)associativity and (co)commutativity laws \
of a commutative Frobenius algebra."
}], "ExampleText",ExpressionUUID->"ecdb3b53-92f1-420d-ba42-9c99f8c91be4"]
}, Open  ]]
}, Open  ]],

