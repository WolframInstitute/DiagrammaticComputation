Cell[CellGroupData[{
Cell["RemoveDiagramRule", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"6119d1d7-f3bd-419b-b339-1b3c4526a670"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["RemoveDiagramRule"]], 
     "paclet:WolframDiagrammaticComputation/ref/RemoveDiagramRule", 
     "WolframDiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["d", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "9550d897-5f77-46cb-979e-314f8fa7f188"],
 " ",
 "constructs a rewrite rule that deletes subdiagrams matching the diagram ",
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "04de8bc9-7923-45fd-bb3b-b19294b13a4d"],
 ", reconnecting the wires it leaves behind.",
 "\n"
}], "Usage",ExpressionUUID->"3c76d7de-5e79-4622-af82-c50932bfd9f7"],

Cell[TextData[{
 "The resulting rule replaces a match of ",
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "6c31a7dd-fc4e-4711-8ea0-ababc8cea581"],
 " with identity wires on its ports, so the surrounding diagram stays \
connected."
}], "Notes",ExpressionUUID->"eba93dbe-f7ed-409c-8e34-8f5ad5d7d46d"],

