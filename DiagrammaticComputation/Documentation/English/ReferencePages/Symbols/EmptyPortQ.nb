Cell[CellGroupData[{
Cell["EmptyPortQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"aedfe27b-b7e5-4a39-955e-cba902d81fc3"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["EmptyPortQ",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/EmptyPortQ"], "[", 
   StyleBox["p", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "d4258444-37c6-4469-b1c8-f1a0bdd53468"],
 " ",
 "gives ",
 Cell[BoxData[
  ButtonBox["True",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/True"]], "InlineFormula",ExpressionUUID->
  "f3388c00-5b0e-4dfd-a1a6-eb2a1747d0a2"],
 " if ",
 Cell[BoxData[
  FormBox[
   StyleBox["p", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "125af858-3bad-475c-94f5-0b4866b43a7b"],
 " is the unit port for ",
 Cell[BoxData[
  ButtonBox["PortProduct",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/PortProduct"]], 
  "InlineFormula",ExpressionUUID->"5777f592-0a0e-4a43-8308-8cc99f18dc88"],
 " (the empty product).",
 "\n"
}], "Usage",ExpressionUUID->"56508fbc-7b01-44c8-8f0c-67f814cc5c1f"],

Cell[TextData[{
 "The empty port is the identity element of ",
 Cell[BoxData[
  ButtonBox["PortProduct",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/PortProduct"]], 
  "InlineFormula",ExpressionUUID->"6eec040d-3205-4620-85a5-b07751a13814"],
 ": composing any port with the empty port returns it unchanged."
}], "Notes",ExpressionUUID->"8c86a7ad-f50d-47be-a5bf-18012179f467"],

Cell[TextData[{
 "It is constructed by ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Port",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/Port"], 
   "[", "\"\<1\>\"", "]"}]], "InlineFormula",ExpressionUUID->
  "5ac23242-5be9-4fd0-aef6-467331f21e43"],
 " or ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Port",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/Port"], "[", 
   RowBox[{
    RowBox[{"$p", "^", "0"}], "$"}], "]"}]], "InlineFormula",ExpressionUUID->
  "3f79053b-0e8c-4263-b68d-e819b7590057"],
 "."
}], "Notes",ExpressionUUID->"3f273df6-d7b7-4330-b342-2f8033e0064e"]
}, Open  ]],

