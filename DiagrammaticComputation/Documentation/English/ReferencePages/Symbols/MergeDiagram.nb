Cell[BoxData[
 GraphicsBox[
  NamespaceBox["Diagram",
   DynamicModuleBox[{Typeset`d = HoldComplete[
     Wolfram`DiagrammaticComputation`Diagram`Diagram[<|
      "DiagramOptions" -> {
        "Shape" -> "Wires"[{{4, 1}, {4, 2}, {4, 3}}], "PortArrows" -> {{
            Placed[Automatic, {{-0.4, 0.5}, {-0.4, 0.75}}], 
            Placed[Automatic, {{0., 0.5}, {0., 0.75}}], 
            Placed[Automatic, {{0.4, 0.5}, {0.4, 0.75}}]}, {
            Placed[Automatic, {{0., -0.5}, {0., -0.75}}]}}, 
         "PortLabels" -> {{Automatic, Automatic, Automatic}, {Automatic}}, 
         "FloatingPorts" -> {True, False}, "ShowLabel" -> False}, 
       "Expression" :> "Copy", "InputPorts" -> {
         Wolfram`DiagrammaticComputation`Port`Port[<|
          "Expression" :> 
           Wolfram`DiagrammaticComputation`Port`PortDual[
            Wolfram`DiagrammaticComputation`Diagram`Rewriting`Rules`a], 
           "NeutralQ" -> False, "Tags" -> {}, "Type" -> 
           SuperStar[\[FormalCapitalT]]|>], 
         Wolfram`DiagrammaticComputation`Port`Port[<|
          "Expression" :> 
           Wolfram`DiagrammaticComputation`Port`PortDual[
            Wolfram`DiagrammaticComputation`Diagram`Rewriting`Rules`a], 
           "NeutralQ" -> False, "Tags" -> {}, "Type" -> 
           SuperStar[\[FormalCapitalT]]|>], 
         Wolfram`DiagrammaticComputation`Port`Port[<|
          "Expression" :> 
           Wolfram`DiagrammaticComputation`Port`PortDual[
            Wolfram`DiagrammaticComputation`Diagram`Rewriting`Rules`a], 
           "NeutralQ" -> False, "Tags" -> {}, "Type" -> 
           SuperStar[\[FormalCapitalT]]|>]}, "OutputPorts" -> {
         Wolfram`DiagrammaticComputation`Port`Port[<|
          "Expression" :> 
           Wolfram`DiagrammaticComputation`Diagram`Rewriting`Rules`a, 
           "NeutralQ" -> False, "Tags" -> {}, 
           "Type" -> \[FormalCapitalT]|>]}|>]]}, 
    {Arrowheads[Small], 
     {EdgeForm[{LightDarkSwitched[
       GrayLevel[0], 
       GrayLevel[1]], Opacity[0.5]}], FaceForm[LightDarkSwitched[
       RGBColor[0.952941188969422, 0.9529411889694224, 0.9529411889694221], 
       GrayLevel[0.62]]], 
      {Haloing[], 
       BSplineCurveBox[{{-0.4, 0.5}, {-0.4, 0.25}, {0., -0.25}, {0., -0.5}}], 
       BSplineCurveBox[{{0., 0.5}, {0., 0.25}, {0., -0.25}, {0., -0.5}}], 
       BSplineCurveBox[{{0.4, 0.5}, {0.4, 0.25}, {0., -0.25}, {
        0., -0.5}}]}}, {{{ArrowBox[{{-0.4, 0.75}, {-0.4, 0.5}}], InsetBox[
         InterpretationBox[
          TagBox["a",
           HoldForm],
          
          Wolfram`DiagrammaticComputation`Port`Port[<|
           "Expression" :> 
            Wolfram`DiagrammaticComputation`Diagram`Rewriting`Rules`a, 
            "NeutralQ" -> False, "Tags" -> {}, "Type" -> \[FormalCapitalT]|>],
          
          Tooltip->"\[FormalCapitalT]"], {-0.4, 0.875}]}, {
        ArrowBox[{{0., 0.75}, {0., 0.5}}], InsetBox[
         InterpretationBox[
          TagBox["a",
           HoldForm],
          
          Wolfram`DiagrammaticComputation`Port`Port[<|
           "Expression" :> 
            Wolfram`DiagrammaticComputation`Diagram`Rewriting`Rules`a, 
            "NeutralQ" -> False, "Tags" -> {}, "Type" -> \[FormalCapitalT]|>],
          
          Tooltip->"\[FormalCapitalT]"], {0., 0.875}]}, {
        ArrowBox[{{0.4, 0.75}, {0.4, 0.5}}], InsetBox[
         InterpretationBox[
          TagBox["a",
           HoldForm],
          
          Wolfram`DiagrammaticComputation`Port`Port[<|
           "Expression" :> 
            Wolfram`DiagrammaticComputation`Diagram`Rewriting`Rules`a, 
            "NeutralQ" -> False, "Tags" -> {}, "Type" -> \[FormalCapitalT]|>],
          
          Tooltip->"\[FormalCapitalT]"], {0.4, 0.875}]}}, {
       ArrowBox[{{0., -0.5}, {0., -0.75}}], InsetBox[
        InterpretationBox[
         TagBox["a",
          HoldForm],
         Wolfram`DiagrammaticComputation`Port`Port[<|
          "Expression" :> 
           Wolfram`DiagrammaticComputation`Diagram`Rewriting`Rules`a, 
           "NeutralQ" -> False, "Tags" -> {}, "Type" -> \[FormalCapitalT]|>],
         Tooltip->"\[FormalCapitalT]"], {0., -0.875}]}}, 
     {LightDarkSwitched[
       GrayLevel[0], 
       GrayLevel[1]], InsetBox["\<\"\\t\\t\\t\"\>", {0, 0}]}}]],
  BaseStyle->{
   GraphicsBoxOptions -> {ImageSize -> Tiny}, 
    Wolfram`DiagrammaticComputation`Diagram`Private`GraphicsHighlightColor -> 
    RGBColor[1, 0, 1]},
  FormatType->StandardForm]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"7c9a4a49-10d5-4a70-ae77-e2bd95b4d54b"]
