Cell[CellGroupData[{
Cell["MergeDiagram", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"04c0daea-737f-4895-a07b-da764a6c3415"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["MergeDiagram"]], 
     "paclet:WolframDiagrammaticComputation/ref/MergeDiagram", 
     "WolframDiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "8d39f868-9ef7-4e33-9a8c-581835a6cfa5"],
 " ",
 "creates a diagram with ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "7364717a-d212-451c-905f-f753d84d4f93"],
 " input copies of ",
 Cell[BoxData[
  FormBox[
   StyleBox["p", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "bf78f61d-bbd8-413b-9691-e542073010df"],
 " merged into a single output port.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"9be3074c-1f1d-4f6b-b551-3da1167ecfd5"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["MergeDiagram"]], 
     "paclet:WolframDiagrammaticComputation/ref/MergeDiagram", 
     "WolframDiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["p", "TI"], 
       StyleBox["1", "TR"]], ",", " ", "\[Ellipsis]", ",", " ", 
      SubscriptBox[
       StyleBox["p", "TI"], 
       StyleBox["n", "TI"]]}], "}"}], ",", " ", 
    StyleBox["q", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "c520c1e8-532d-404d-b9c9-ba9cd64637aa"],
 " ",
 "merges the explicit input ports ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["p", "TI"], "1"], ",", 
    RowBox[{"\[AHat]", "\[Hyphen]", "\.a6"}], ",", 
    SubscriptBox[
     StyleBox["p", "TI"], 
     StyleBox["n", "TI"]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"bcb88fbe-079d-4a92-8f46-fc159f8c26b8"],
 " into ",
 Cell[BoxData[
  FormBox[
   StyleBox["q", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "a14299ae-5915-4d73-a3a0-8d19dbed615a"],
 "."
}], "Usage",ExpressionUUID->"d6342b58-4a23-4e38-a2ca-1ceee85d23f8"],

Cell[TextData[{
 "A merge diagram is a special case of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SpiderDiagram"]], 
    "paclet:WolframDiagrammaticComputation/ref/SpiderDiagram", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "db23dcd9-3af0-43c1-a337-f996d6939ae5"],
 " with many inputs and one output."
}], "Notes",ExpressionUUID->"847d3f11-b416-4919-b73b-ec287e0f49e0"],

Cell["\<\
It is the multiplication morphism of a Frobenius / classical-structure on its \
wire.\
\>", "Notes",ExpressionUUID->"07167c79-fb74-4077-89b3-ca0bd756c644"]
