Cell[CellGroupData[{
Cell["MergeDiagram", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"7745f531-07f1-4bc3-ad47-aeb287687b00"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MergeDiagram",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/MergeDiagram"], "[", 
   RowBox[{
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "421d5416-a779-449d-9c7c-9c07bf3d6e4f"],
 " ",
 "creates a diagram with ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "b8b9ab8b-aed4-4057-ada8-afdcb148f7ff"],
 " input copies of ",
 Cell[BoxData[
  FormBox[
   StyleBox["p", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "1ebfb20c-79f7-4e49-bcb5-3fb4273e9c85"],
 " merged into a single output port.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"2b439de4-8a36-4468-a269-ad0b6bd02242"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MergeDiagram",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/MergeDiagram"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["p", "TI"], 
       StyleBox["1", "TR"]], ",", " ", "\[Ellipsis]", ",", " ", 
      SubscriptBox[
       StyleBox["p", "TI"], 
       StyleBox["n", "TI"]]}], "}"}], ",", " ", 
    StyleBox["q", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "34deb4d1-dd00-4a75-82df-b4aad410635f"],
 " ",
 "merges the explicit input ports ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["p", "TI"], "1"], ",", 
    RowBox[{"\[AHat]", "\[Hyphen]", "\.a6"}], ",", 
    SubscriptBox[
     StyleBox["p", "TI"], 
     StyleBox["n", "TI"]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"fa15661f-c336-4864-8fec-fecc054b53a4"],
 " into ",
 Cell[BoxData[
  FormBox[
   StyleBox["q", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "92843d7f-e57e-4393-b5ec-4020339076aa"],
 "."
}], "Usage",ExpressionUUID->"4359765a-b6a5-4d6b-8f65-41f367157cdf"],

Cell[TextData[{
 "A merge diagram is a special case of ",
 Cell[BoxData[
  ButtonBox["SpiderDiagram",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/SpiderDiagram"]], 
  "InlineFormula",ExpressionUUID->"85c675cb-3ea6-4ca5-a2d5-5ef5f4f4c24f"],
 " with many inputs and one output."
}], "Notes",ExpressionUUID->"0f0f38a4-6ec4-464c-92a9-4bec3e6b09d5"],

Cell["\<\
It is the multiplication morphism of a Frobenius / classical-structure on its \
wire.\
\>", "Notes",ExpressionUUID->"a512dd85-3f14-42f0-916a-9cb6847ccefd"]
}, Open  ]],

