           "Expression" :> MTNB$1lcmed7auwkr7`a, "NeutralQ" -> False, 
            "Tags" -> {}, "Type" -> \[FormalCapitalT]|>],
          Tooltip->"\[FormalCapitalT]"], {-0.4, 0.875}]}, {
        ArrowBox[{{0., 0.75}, {0., 0.5}}], InsetBox[
         InterpretationBox[
          TagBox["a",
           HoldForm],
          
          Wolfram`DiagrammaticComputation`Port`Port[<|
