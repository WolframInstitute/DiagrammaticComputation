Cell["MergeDiagram", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"c9d38fed-2237-4b69-8acb-4263f3d4f0e2"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["MergeDiagram"]], 
     "paclet:Wolfram/DiagrammaticComputation/ref/MergeDiagram", 
     "Wolfram/DiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "1ec11b17-8ad8-416c-a6d8-2659aa5bbaf5"],
 " ",
 "creates a diagram with ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "59eb82b2-018a-469f-8be7-016c6f6c9b2a"],
 " input copies of ",
 Cell[BoxData[
  FormBox[
   StyleBox["p", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "4338fdd3-7016-4d60-899a-dd8db2facd96"],
 " merged into a single output port.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"7275a31e-f8d2-46c7-b2c1-5362a95f40b4"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["MergeDiagram"]], 
     "paclet:Wolfram/DiagrammaticComputation/ref/MergeDiagram", 
     "Wolfram/DiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["p", "TI"], 
       StyleBox["1", "TR"]], ",", " ", "\[Ellipsis]", ",", " ", 
      SubscriptBox[
       StyleBox["p", "TI"], 
       StyleBox["n", "TI"]]}], "}"}], ",", " ", 
    StyleBox["q", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "d7b4e5f4-4ceb-4516-aa91-c06cc09da638"],
 " ",
 "merges the explicit input ports ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["p", "TI"], "1"], ",", 
    RowBox[{"\[AHat]", "\[Hyphen]", "\.a6"}], ",", 
    SubscriptBox[
     StyleBox["p", "TI"], 
     StyleBox["n", "TI"]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"eeb95fb2-ff25-43f5-a272-1ed1c3404c40"],
 " into ",
 Cell[BoxData[
  FormBox[
   StyleBox["q", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "3a470b33-669d-43a7-8985-5b62d553adbd"],
 "."
}], "Usage",ExpressionUUID->"8962bd07-b568-44e7-a818-44b8f08d5538"],

Cell[TextData[{
 "A merge diagram is a special case of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SpiderDiagram"]], 
    "paclet:Wolfram/DiagrammaticComputation/ref/SpiderDiagram", 
    "Wolfram/DiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "745657a4-74ec-421e-932b-350660f65647"],
 " with many inputs and one output."
}], "Notes",ExpressionUUID->"15018c7f-7ae1-46d8-842d-6fd6570ef74d"],

Cell["\<\
It is the multiplication morphism of a Frobenius / classical-structure on its \
wire.\
\>", "Notes",ExpressionUUID->"518871e9-0f79-4900-8b1b-4d4c3442eefd"]
