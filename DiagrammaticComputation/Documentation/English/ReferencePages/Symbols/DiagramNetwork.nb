Cell[BoxData[
 RowBox[{"DiagramNetwork", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"Diagram", "[", 
    RowBox[{"A", ",", " ", 
     RowBox[{"{", 
      RowBox[{"a", ",", " ", "b"}], "}"}], ",", " ", "d"}], "]"}], ",", "\n", 
   "  ", 
   RowBox[{"Diagram", "[", 
