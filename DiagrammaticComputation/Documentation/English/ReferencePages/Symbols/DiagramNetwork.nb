 RowBox[{
  RowBox[{"diagram", " ", "=", " ", 
   RowBox[{"DiagramComposition", "[", 
    RowBox[{
     RowBox[{"Diagram", "[", 
      RowBox[{"\"\<g\>\"", ",", " ", 
       RowBox[{"{", 
