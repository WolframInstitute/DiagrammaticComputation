Cell["DiagramNetwork", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"1ce043bd-739e-401c-a2df-d33ded6c044c"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DiagramNetwork"]], 
     "paclet:WolframDiagrammaticComputation/ref/DiagramNetwork", 
     "WolframDiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    SubscriptBox[
     StyleBox["d", "TI"], 
     StyleBox["1", "TR"]], ",", " ", 
    SubscriptBox[
     StyleBox["d", "TI"], 
     StyleBox["2", "TR"]], ",", " ", "\[Ellipsis]"}], "]"}]], "InlineFormula",
  ExpressionUUID->"8c594b2e-e900-4ff9-9bc6-7e7cab490695"],
 " ",
 "composes the diagrams ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["d", "TI"], 
    StyleBox["i", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "4c3a70aa-1bdb-4da8-97a8-aed10570a682"],
 " as an orderless network, joining ports of equal name.",
 "\n"
}], "Usage",ExpressionUUID->"a81c7707-5f50-4e35-9ddc-f2fbb49359a5"],

Cell["\<\
Network composition matches ports by name rather than by position. Two \
diagrams sharing a port name are wired through that port; unmatched ports \
become inputs / outputs of the resulting diagram.\
\>", "Notes",ExpressionUUID->"90b287b9-2cfb-4006-8482-9b5e03168db4"],

Cell["This is the diagram analogue of tensor-network contraction.", "Notes",ExpressionUUID->"c350a3a5-b6c3-4b1f-8d36-d76cc9d11c54"],

Cell["\<\
A network is automatically converted to a grid layout when displayed; the \
conversion can be controlled by the network options below.\
\>", "Notes",ExpressionUUID->"68d3ae1f-5ff4-4b4e-86f3-62612c8d60e8"],

Cell["The following options can be given:", "Notes",ExpressionUUID->"13faeb0d-a8ec-4825-b0b4-2b327ee2a7bb"],

