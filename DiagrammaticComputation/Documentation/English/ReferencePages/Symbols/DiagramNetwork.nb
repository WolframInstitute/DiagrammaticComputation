     RowBox[{"Diagram", "[", 
      RowBox[{"\"\<h\>\"", ",", " ", "e", ",", " ", "d"}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"diagram", "[", "\"\<Network\>\"", "]"}]}], "Input",
