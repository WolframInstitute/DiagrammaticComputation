  "6e4c0229-1b2e-4619-a333-bd0a935340b0"],
 " generalises ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramProduct"]], 
    "paclet:Wolfram/DiagrammaticComputation/ref/DiagramProduct", 
    "Wolfram/DiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b81b8af9-b96f-4517-b449-8e6e0b26bc81"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramComposition"]], 
    "paclet:Wolfram/DiagrammaticComputation/ref/DiagramComposition", 
    "Wolfram/DiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "64ee979e-9232-4d00-aadd-7d6d05489991"],
 ": those two arise as special cases where ports match by position. The \
reverse direction is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ToDiagramNetwork"]], 
    "paclet:Wolfram/DiagrammaticComputation/ref/ToDiagramNetwork", 
    "Wolfram/DiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0e01103f-59db-4b87-b0f0-dc2227f1d45c"],
 ", which re-expresses an arbitrary composite diagram in network form."
}], "ExampleText",ExpressionUUID->"88218732-c04e-4743-8408-86c3368e46ca"]
}, Open  ]]
}, Open  ]],

