Cell["\<\
Compose diagrams into a network: Turn a grid diagram into a network:\
\>", "ExampleText",ExpressionUUID->"71c58097-2aa0-44db-ab28-a134bcf4c09a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"DiagramNetwork", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"Diagram", "[", 
    RowBox[{"A", ",", " ", 
     RowBox[{"{", 
      RowBox[{"a", ",", " ", "b"}], "}"}], ",", " ", "d"}], "]"}], ",", "\n", 
   "  ", 
   RowBox[{"Diagram", "[", 
