   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/DiagramNetwork"]], 
  "InlineFormula",ExpressionUUID->"7ba9102e-77d7-4d16-97eb-be8487070ad7"],
 " generalises ",
 Cell[BoxData[
  ButtonBox["DiagramProduct",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/DiagramProduct"]], 
  "InlineFormula",ExpressionUUID->"eaebea93-d12e-469f-9998-493c57acf33f"],
 " and ",
 Cell[BoxData[
  ButtonBox["DiagramComposition",
   BaseStyle->"Link",
   ButtonData->
    "paclet:Wolfram/DiagrammaticComputation/ref/DiagramComposition"]], 
  "InlineFormula",ExpressionUUID->"1a9956d1-20ea-4077-b8fd-e2178d3b76ed"],
 ": those two arise as special cases where ports match by position. The \
reverse direction is ",
 Cell[BoxData[
  ButtonBox["ToDiagramNetwork",
   BaseStyle->"Link",
   ButtonData->
    "paclet:Wolfram/DiagrammaticComputation/ref/ToDiagramNetwork"]], 
  "InlineFormula",ExpressionUUID->"7e3634e4-d0f2-4509-bec3-06479a4b786a"],
 ", which re-expresses an arbitrary composite diagram in network form."
}], "ExampleText",ExpressionUUID->"becd07b9-1a01-4241-b95e-510c6d084ff7"]
}, Open  ]]
}, Open  ]],

