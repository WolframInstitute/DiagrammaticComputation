Cell[CellGroupData[{
Cell["DiagramNetwork", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"6d4d5fe2-ec89-4d47-bc82-624a40d52308"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["DiagramNetwork",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/DiagramNetwork"], 
   "[", 
   RowBox[{
    SubscriptBox[
     StyleBox["d", "TI"], 
     StyleBox["1", "TR"]], ",", " ", 
    SubscriptBox[
     StyleBox["d", "TI"], 
     StyleBox["2", "TR"]], ",", " ", "\[Ellipsis]"}], "]"}]], "InlineFormula",
  ExpressionUUID->"1da9e84d-ef5e-4ead-85a0-5d6f1c47936f"],
 " ",
 "composes the diagrams ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["d", "TI"], 
    StyleBox["i", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "996734fc-e922-4246-b941-7324fd8a4ff4"],
 " as an orderless network, joining ports of equal name.",
 "\n"
}], "Usage",ExpressionUUID->"88cd84b0-0382-46c0-a421-929ba7412b3d"],

Cell["\<\
Network composition matches ports by name rather than by position. Two \
diagrams sharing a port name are wired through that port; unmatched ports \
become inputs / outputs of the resulting diagram.\
\>", "Notes",ExpressionUUID->"d6d6ba69-1627-4ac9-9a37-66c7f1e09570"],

Cell["This is the diagram analogue of tensor-network contraction.", "Notes",ExpressionUUID->"2f50bb1d-11ef-44ac-81b1-b7045809d0b2"],

Cell["\<\
A network is automatically converted to a grid layout when displayed; the \
conversion can be controlled by the network options below.\
\>", "Notes",ExpressionUUID->"93662f14-03f5-41a8-b9d2-3872fd277d2b"],

Cell["The following options can be given:", "Notes",ExpressionUUID->"b33a4f19-8bcf-46f3-8d2d-1d96e60e6198"],

