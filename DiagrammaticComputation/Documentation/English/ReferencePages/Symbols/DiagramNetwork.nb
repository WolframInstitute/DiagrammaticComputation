 " generalises ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramProduct"]], 
    "paclet:WolframDiagrammaticComputation/ref/DiagramProduct", 
    "WolframDiagrammaticComputation Package Symbol"},
