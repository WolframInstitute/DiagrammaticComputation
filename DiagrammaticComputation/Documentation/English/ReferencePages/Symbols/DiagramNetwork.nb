 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"3917df20-4ff7-4b7f-8462-cad330197723"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DiagramNetwork"]], 
     "paclet:Wolfram/DiagrammaticComputation/ref/DiagramNetwork", 
     "Wolfram/DiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    SubscriptBox[
     StyleBox["d", "TI"], 
     StyleBox["1", "TR"]], ",", " ", 
    SubscriptBox[
     StyleBox["d", "TI"], 
     StyleBox["2", "TR"]], ",", " ", "\[Ellipsis]"}], "]"}]], "InlineFormula",
  ExpressionUUID->"41142a0f-cf32-4d2f-b41a-c2e33746c85b"],
 " ",
 "composes the diagrams ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["d", "TI"], 
    StyleBox["i", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "47d0cba5-389d-4e01-9e3b-29e4afa71116"],
 " as an orderless network, joining ports of equal name.",
 "\n"
}], "Usage",ExpressionUUID->"f9f52a06-dd25-438d-8f63-6893a5d5444b"],

Cell["\<\
Network composition matches ports by name rather than by position. Two \
diagrams sharing a port name are wired through that port; unmatched ports \
become inputs / outputs of the resulting diagram.\
\>", "Notes",ExpressionUUID->"3247379f-6bc9-4bd8-b26d-bac7b40e5ee6"],

Cell["This is the diagram analogue of tensor-network contraction.", "Notes",ExpressionUUID->"f20d623a-b074-464c-9e77-cd4110cf7f5e"],

Cell["\<\
A network is automatically converted to a grid layout when displayed; the \
conversion can be controlled by the network options below.\
\>", "Notes",ExpressionUUID->"23a45040-8699-49d0-b4ac-d6d582f30d2b"],

Cell["The following options can be given:", "Notes",ExpressionUUID->"fe637bf8-6e85-42b8-9dd1-2187f857f164"],

