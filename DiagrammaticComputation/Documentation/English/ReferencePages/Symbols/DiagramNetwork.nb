     RowBox[{"{", 
      RowBox[{"x", ",", " ", "c"}], "}"}], ",", " ", "b"}], "]"}]}], "\n", 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"fd7a2c71-ac81-407c-b8fe-3528d666a97c"],

