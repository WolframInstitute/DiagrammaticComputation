Cell[BoxData[{
 RowBox[{
  RowBox[{"diagram", " ", "=", " ", 
   RowBox[{"DiagramComposition", "[", 
    RowBox[{
     RowBox[{"Diagram", "[", 
      RowBox[{"\"\<g\>\"", ",", " ", 
       RowBox[{"{", 
        RowBox[{"a", ",", " ", "d"}], "}"}], ",", " ", "x"}], "]"}], ",", " ", 
     RowBox[{"Diagram", "[", 
      RowBox[{"\"\<A\>\"", ",", " ", "b", ",", " ", "a"}], "]"}], ",", " ", 
     RowBox[{"Diagram", "[", 
      RowBox[{"\"\<h\>\"", ",", " ", "e", ",", " ", "d"}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"diagram", "[", "\"\<Network\>\"", "]"}]}], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"43599204-5ba6-46cf-ba87-f226e963d591"],

