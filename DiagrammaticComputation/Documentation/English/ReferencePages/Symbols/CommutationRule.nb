Cell["\<\
Encodes the interaction-net commutation law: two distinct nodes meeting \
head-on exchange places, each getting duplicated across the other's legs.\
\>", "Notes",ExpressionUUID->"3865d01e-ab28-44f3-9784-44c4bb730b7a"],

Cell[TextData[{
 "A dual port (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SuperStar"]], "paclet:ref/SuperStar"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a92dc13d-7f36-4d5b-8a41-4659259bb9c5"],
 ") marks legs entering from the opposite side."
}], "Notes",ExpressionUUID->"86b150e3-d666-4d9f-a826-b4163d0f9c17"],

