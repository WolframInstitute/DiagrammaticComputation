Cell["\<\
Encodes the interaction-net commutation law: two distinct nodes meeting \
head-on exchange places, each getting duplicated across the other's legs.\
\>", "Notes",ExpressionUUID->"a4d0e631-c75b-452e-b870-fbda6a03ee7b"],

Cell[TextData[{
 "A dual port (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SuperStar"]], "paclet:ref/SuperStar"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4cb1d830-f8de-413d-a26b-e64368529762"],
 ") marks legs entering from the opposite side."
}], "Notes",ExpressionUUID->"7b425744-f4df-425e-8313-43f35b70e9a8"],

