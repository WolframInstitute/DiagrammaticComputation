Cell["\<\
Encodes the interaction-net commutation law: two distinct nodes meeting \
head-on exchange places, each getting duplicated across the other's legs.\
\>", "Notes",ExpressionUUID->"d72268e9-e8a2-45cc-864a-49d0914b2833"],

Cell[TextData[{
 "A dual port (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SuperStar"]], "paclet:ref/SuperStar"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1a052610-3be8-4985-a9cf-1f4ca3f8f4c2"],
 ") marks legs entering from the opposite side."
}], "Notes",ExpressionUUID->"5f88e215-f390-4866-8fb9-8bc9f96884f6"],

