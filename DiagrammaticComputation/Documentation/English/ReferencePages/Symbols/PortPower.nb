Cell[BoxData[
 InterpretationBox[
  SuperscriptBox[
   RowBox[{"(", 
    RowBox[{
     TagBox["a",
      HoldForm], "\[CircleTimes]", 
     TagBox["a",
      HoldForm]}], ")"}], "*"],
  Wolfram`DiagrammaticComputation`Port`Port[<|
