\>", "ExampleText",ExpressionUUID->"4462f180-1085-4947-bc38-e84a29712af9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Port", "[", 
  RowBox[{"a", "^", "3"}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"4ec59b6e-a333-42b4-a739-08a1fb649872"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{
   TagBox["a",
    HoldForm], "\[CircleTimes]", 
   TagBox["a",
    HoldForm], "\[CircleTimes]", 
   TagBox["a",
    HoldForm]}],
  Wolfram`DiagrammaticComputation`Port`Port[<|
   "Expression" :> Wolfram`DiagrammaticComputation`Port`PortProduct[
      Wolfram`DiagrammaticComputation`Port`Port[<|
       "Expression" :> FunctionRepository`$955258636fa042ac87af26c7567e2d7f`a,
         "NeutralQ" -> False, "Tags" -> {}, "Type" -> \[FormalCapitalT]|>], 
      Wolfram`DiagrammaticComputation`Port`Port[<|
       "Expression" :> FunctionRepository`$955258636fa042ac87af26c7567e2d7f`a,
         "NeutralQ" -> False, "Tags" -> {}, "Type" -> \[FormalCapitalT]|>], 
      Wolfram`DiagrammaticComputation`Port`Port[<|
       "Expression" :> FunctionRepository`$955258636fa042ac87af26c7567e2d7f`a,
         "NeutralQ" -> False, "Tags" -> {}, "Type" -> \[FormalCapitalT]|>]], 
    "NeutralQ" -> False, "Tags" -> {}, "Type" -> 
    CircleTimes[\[FormalCapitalT], \[FormalCapitalT], \[FormalCapitalT]]|>],
  Tooltip->
   RowBox[{"\[FormalCapitalT]", "\[CircleTimes]", "\[FormalCapitalT]", 
     "\[CircleTimes]", "\[FormalCapitalT]"}]]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"9a7b91f6-545e-4feb-8eac-73268b1198b6"]
}, Open  ]],

