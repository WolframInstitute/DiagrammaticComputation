   RowBox[{"$p", "^", 
    SubscriptBox[
     StyleBox["n", "TI"], 
     StyleBox["", "TR"]]}], "]"}]], "InlineFormula",ExpressionUUID->
  "8eb4c25f-ec0d-4bde-8fb1-af4a9925ccfa"],
 " expands to ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["PortProduct",
    BaseStyle->"Link",
