Cell["A port tensored with itself three times:", "ExampleText",ExpressionUUID->"fa5358c1-b76f-4dbf-9f53-f4777432799e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Port", "[", 
  RowBox[{"a", "^", "3"}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"aae27e0a-4ed6-4cd0-9179-43ace0136b3d"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{
   TagBox["a",
    HoldForm], "\[CircleTimes]", 
   TagBox["a",
    HoldForm], "\[CircleTimes]", 
   TagBox["a",
    HoldForm]}],
  Wolfram`DiagrammaticComputation`Port`Port[<|
   "Expression" :> Wolfram`DiagrammaticComputation`Port`PortProduct[
      Wolfram`DiagrammaticComputation`Port`Port[<|
       "Expression" :> 
        Wolfram`DiagrammaticComputation`Diagram`Rewriting`Rules`a, "NeutralQ" -> 
        False, "Tags" -> {}, "Type" -> \[FormalCapitalT]|>], 
      Wolfram`DiagrammaticComputation`Port`Port[<|
       "Expression" :> 
        Wolfram`DiagrammaticComputation`Diagram`Rewriting`Rules`a, "NeutralQ" -> 
        False, "Tags" -> {}, "Type" -> \[FormalCapitalT]|>], 
      Wolfram`DiagrammaticComputation`Port`Port[<|
       "Expression" :> 
        Wolfram`DiagrammaticComputation`Diagram`Rewriting`Rules`a, "NeutralQ" -> 
        False, "Tags" -> {}, "Type" -> \[FormalCapitalT]|>]], "NeutralQ" -> 
    False, "Tags" -> {}, "Type" -> 
    CircleTimes[\[FormalCapitalT], \[FormalCapitalT], \[FormalCapitalT]]|>],
  Tooltip->
   RowBox[{"\[FormalCapitalT]", "\[CircleTimes]", "\[FormalCapitalT]", 
     "\[CircleTimes]", "\[FormalCapitalT]"}]]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"1499fb3a-b23f-4b67-96d3-79f7aa43e4a4"]
}, Open  ]],

Cell["A negative power dualises:", "ExampleText",ExpressionUUID->"d8c74b60-dba5-44a3-b226-ee827c3eeef9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Port", "[", 
  RowBox[{"a", "^", 
   RowBox[{"-", "2"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"33276d1c-878a-4789-af79-390df9e5144b"],

Cell[BoxData[
 InterpretationBox[
  SuperscriptBox[
   RowBox[{"(", 
    RowBox[{
     TagBox["a",
      HoldForm], "\[CircleTimes]", 
     TagBox["a",
      HoldForm]}], ")"}], "*"],
  Wolfram`DiagrammaticComputation`Port`Port[<|
   "Expression" :> Wolfram`DiagrammaticComputation`Port`PortDual[
      Wolfram`DiagrammaticComputation`Port`PortProduct[
       Wolfram`DiagrammaticComputation`Port`Port[<|
        "Expression" :> 
         Wolfram`DiagrammaticComputation`Diagram`Rewriting`Rules`a, 
         "NeutralQ" -> False, "Tags" -> {}, "Type" -> \[FormalCapitalT]|>], 
       Wolfram`DiagrammaticComputation`Port`Port[<|
        "Expression" :> 
         Wolfram`DiagrammaticComputation`Diagram`Rewriting`Rules`a, 
         "NeutralQ" -> False, "Tags" -> {}, "Type" -> \[FormalCapitalT]|>]]], 
    "NeutralQ" -> False, "Tags" -> {}, "Type" -> CircleTimes[
      SuperStar[\[FormalCapitalT]], 
      SuperStar[\[FormalCapitalT]]]|>],
  Tooltip->RowBox[{
     SuperscriptBox["\[FormalCapitalT]", "*"], "\[CircleTimes]", 
     SuperscriptBox["\[FormalCapitalT]", "*"]}]]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"83de06d4-fead-4ce5-b474-c55b0a1f5650"]
}, Open  ]],

