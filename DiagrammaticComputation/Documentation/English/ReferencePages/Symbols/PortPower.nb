    StyleBox["p", "TI"], ",", " ", "\[Ellipsis]"}], "]"}]], "InlineFormula",
  ExpressionUUID->"a6b1d000-c032-486d-a3d3-edd990e04ae8"],
 " with ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "91670f1e-695d-4703-b60d-dd3eec069ba1"],
 " factors."
}], "Notes",ExpressionUUID->"63a8bf75-4a23-4aec-8db1-fc9bc976b4c2"],

Cell[TextData[{
