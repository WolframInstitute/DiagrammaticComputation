Cell["A port tensored with itself three times:", "ExampleText",ExpressionUUID->"8e5e4561-7768-4374-96e3-0c9910f3d649"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Port", "[", 
  RowBox[{"a", "^", "3"}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"0747d5b7-8ab4-4b28-9d56-d464277763d8"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{
   TagBox["a",
    HoldForm], "\[CircleTimes]", 
   TagBox["a",
    HoldForm], "\[CircleTimes]", 
   TagBox["a",
    HoldForm]}],
  Wolfram`DiagrammaticComputation`Port`Port[<|
   "Expression" :> Wolfram`DiagrammaticComputation`Port`PortProduct[
      Wolfram`DiagrammaticComputation`Port`Port[<|
       "Expression" :> MTNB$1v7syej0kitmb`a, "NeutralQ" -> False, 
        "Tags" -> {}, "Type" -> \[FormalCapitalT]|>], 
      Wolfram`DiagrammaticComputation`Port`Port[<|
       "Expression" :> MTNB$1v7syej0kitmb`a, "NeutralQ" -> False, 
        "Tags" -> {}, "Type" -> \[FormalCapitalT]|>], 
      Wolfram`DiagrammaticComputation`Port`Port[<|
       "Expression" :> MTNB$1v7syej0kitmb`a, "NeutralQ" -> False, 
        "Tags" -> {}, "Type" -> \[FormalCapitalT]|>]], "NeutralQ" -> False, 
    "Tags" -> {}, "Type" -> 
    CircleTimes[\[FormalCapitalT], \[FormalCapitalT], \[FormalCapitalT]]|>],
  Tooltip->
   RowBox[{"\[FormalCapitalT]", "\[CircleTimes]", "\[FormalCapitalT]", 
     "\[CircleTimes]", "\[FormalCapitalT]"}]]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"102f5ed8-dbf1-4bf8-aa3f-06cabcf92c8c"]
}, Open  ]],

Cell["A negative power dualises:", "ExampleText",ExpressionUUID->"4b681931-3a40-46e3-a984-d0cb45b7aa1b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Port", "[", 
  RowBox[{"a", "^", 
   RowBox[{"-", "2"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"fa580f56-5d9e-4126-bbfb-5e4155df16e3"],

Cell[BoxData[
 InterpretationBox[
  SuperscriptBox[
   RowBox[{"(", 
    RowBox[{
     TagBox["a",
      HoldForm], "\[CircleTimes]", 
     TagBox["a",
      HoldForm]}], ")"}], "*"],
  Wolfram`DiagrammaticComputation`Port`Port[<|
   "Expression" :> Wolfram`DiagrammaticComputation`Port`PortDual[
      Wolfram`DiagrammaticComputation`Port`PortProduct[
       Wolfram`DiagrammaticComputation`Port`Port[<|
        "Expression" :> MTNB$1v7syej0kitmb`a, "NeutralQ" -> False, 
         "Tags" -> {}, "Type" -> \[FormalCapitalT]|>], 
       Wolfram`DiagrammaticComputation`Port`Port[<|
        "Expression" :> MTNB$1v7syej0kitmb`a, "NeutralQ" -> False, 
         "Tags" -> {}, "Type" -> \[FormalCapitalT]|>]]], "NeutralQ" -> False, 
    "Tags" -> {}, "Type" -> CircleTimes[
      SuperStar[\[FormalCapitalT]], 
      SuperStar[\[FormalCapitalT]]]|>],
  Tooltip->RowBox[{
     SuperscriptBox["\[FormalCapitalT]", "*"], "\[CircleTimes]", 
     SuperscriptBox["\[FormalCapitalT]", "*"]}]]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"42572299-78da-4f95-a644-7f5507da0fcd"]
}, Open  ]],

