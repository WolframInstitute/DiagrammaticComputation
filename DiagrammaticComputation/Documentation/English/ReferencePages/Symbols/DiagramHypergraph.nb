Cell["Hypergraph of a small composition:", "ExampleText",ExpressionUUID->"7faf367d-0173-43f7-983d-4f0f324ee570"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"DiagramHypergraph", " ", "@", " ", 
  RowBox[{"DiagramComposition", "[", 
   RowBox[{
    RowBox[{"Diagram", "[", 
     RowBox[{"\"\<A\>\"", ",", " ", "b", ",", " ", "a"}], "]"}], ",", " ", 
    RowBox[{"Diagram", "[", 
     RowBox[{"\"\<B\>\"", ",", " ", "c", ",", " ", "b"}], "]"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"3fad65e4-b4fe-4496-8c9f-ffc064bad4f4"],

