Cell["DiagramHypergraph", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"f6e79022-5a1c-4f8f-9e0f-d2ea5f5f8c10"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DiagramHypergraph"]], 
     "paclet:WolframDiagrammaticComputation/ref/DiagramHypergraph", 
     "WolframDiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["d", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "11cb0342-7a55-48e4-9ecb-3e3381bb6cab"],
 " ",
 "returns the hypergraph representation of the diagram ",
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "0a773bc0-e5af-4a10-a5f0-45e89445564c"],
 " used for rule matching.",
 "\n"
}], "Usage",ExpressionUUID->"82b15180-7afb-4082-841d-b8f9c24b2d59"],

Cell["\<\
In the hypergraph view, each subdiagram becomes a hyperedge labelled with its \
expression, and each shared port becomes a vertex shared by the corresponding \
hyperedges.\
\>", "Notes",ExpressionUUID->"25da75e2-086c-4054-9592-e0c07d6bd7d3"],

Cell[TextData[{
 "The matcher of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramReplace"]], 
    "paclet:WolframDiagrammaticComputation/ref/DiagramReplace", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3e1f9653-bb1d-427f-9552-9d1f7cdd9a68"],
 " operates on this view, so two diagrams that differ only in port naming or \
layout match the same rules."
}], "Notes",ExpressionUUID->"1d7dbacb-9b70-4134-99c1-77c49094c8ad"]
}, Open  ]],

