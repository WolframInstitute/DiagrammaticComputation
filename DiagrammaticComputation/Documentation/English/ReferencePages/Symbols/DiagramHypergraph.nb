Cell["DiagramHypergraph", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"ab899804-e536-44de-9e87-25fe14bbf1c8"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["DiagramHypergraph",
    BaseStyle->"Link",
    ButtonData->
     "paclet:Wolfram/DiagrammaticComputation/ref/DiagramHypergraph"], "[", 
   StyleBox["d", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "ff38a3ff-34fb-40b4-be0b-e1dd4169e3b6"],
 " ",
 "returns the hypergraph representation of the diagram ",
 Cell[BoxData[
  FormBox[
   StyleBox["d", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "81d5c2b3-2f1b-4063-baa3-09eafdf62c7a"],
 " used for rule matching.",
 "\n"
}], "Usage",ExpressionUUID->"4a0fb913-366a-4e2f-823e-fabec13ce26a"],

Cell["\<\
In the hypergraph view, each subdiagram becomes a hyperedge labelled with its \
expression, and each shared port becomes a vertex shared by the corresponding \
hyperedges.\
\>", "Notes",ExpressionUUID->"fc08f250-e380-41d2-ab44-707e2810fa58"],

Cell[TextData[{
 "The matcher of ",
 Cell[BoxData[
  ButtonBox["DiagramReplace",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/DiagramReplace"]], 
  "InlineFormula",ExpressionUUID->"f6a54388-f7ac-4c8a-b5ee-aedc68bb1c11"],
 " operates on this view, so two diagrams that differ only in port naming or \
layout match the same rules."
}], "Notes",ExpressionUUID->"da56d3bf-9bd9-4b92-8cac-295e782a97b6"]
}, Open  ]],

