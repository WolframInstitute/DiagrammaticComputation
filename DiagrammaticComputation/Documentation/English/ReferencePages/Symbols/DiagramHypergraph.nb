Cell["Hypergraph of a small composition:", "ExampleText",ExpressionUUID->"fc15b8cd-12bd-4b2f-8091-3d5293ff8e83"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"DiagramHypergraph", " ", "@", " ", 
  RowBox[{"DiagramComposition", "[", 
   RowBox[{
    RowBox[{"Diagram", "[", 
     RowBox[{"\"\<A\>\"", ",", " ", "b", ",", " ", "a"}], "]"}], ",", " ", 
    RowBox[{"Diagram", "[", 
     RowBox[{"\"\<B\>\"", ",", " ", "c", ",", " ", "b"}], "]"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"8dfb2cf9-de7c-4c56-97d7-16f00e81820c"],

