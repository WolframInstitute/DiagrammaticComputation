Cell[BoxData[
 RowBox[{"DiagramInsert", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"DiagramComposition", "[", 
    RowBox[{
     RowBox[{"Diagram", "[", 
      RowBox[{"\"\<A\>\"", ",", " ", "b", ",", " ", "a"}], "]"}], ",", " ", 
     RowBox[{"Diagram", "[", 
      RowBox[{"\"\<B\>\"", ",", " ", "c", ",", " ", "b"}], "]"}]}], "]"}], ",",
    "\n", "  ", 
   RowBox[{"IdentityDiagram", "[", "b", "]"}], ",", "\n", "  ", 
   RowBox[{"{", "2", "}"}]}], "\n", "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"9f72d87b-3c39-4bdb-85b5-c6bf90feef0f"],

