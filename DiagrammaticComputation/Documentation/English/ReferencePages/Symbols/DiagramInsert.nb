Cell[BoxData[
 RowBox[{"DiagramInsert", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"DiagramComposition", "[", 
    RowBox[{
     RowBox[{"Diagram", "[", 
      RowBox[{"\"\<A\>\"", ",", " ", "b", ",", " ", "a"}], "]"}], ",", " ", 
     RowBox[{"Diagram", "[", 
      RowBox[{"\"\<B\>\"", ",", " ", "c", ",", " ", "b"}], "]"}]}], "]"}], ",",
    "\n", "  ", 
   RowBox[{"IdentityDiagram", "[", "b", "]"}], ",", "\n", "  ", 
   RowBox[{"{", "2", "}"}]}], "\n", "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"8a62fa34-f55b-4161-bb1e-3b6506323885"],

