 ".",
 "\n"
}], "Usage",ExpressionUUID->"c70eb1ef-fbf0-4457-b471-14d3f53dc984"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["PortMinus"]], 
    "paclet:Wolfram/DiagrammaticComputation/ref/PortMinus", 
    "Wolfram/DiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5960eb0b-4a27-4647-b721-1ffb3ed36b1a"],
 " is used to express formal subtractions in a port sum; ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["Port"]], "paclet:Wolfram/DiagrammaticComputation/ref/Port", 
     "Wolfram/DiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["a", "TI"], " ", "-", " ", 
    StyleBox["b", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "4aa5fc05-2010-4eb8-9e59-54d2f5f5b58e"],
 " normalises to ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["PortSum"]], 
     "paclet:Wolfram/DiagrammaticComputation/ref/PortSum", 
     "Wolfram/DiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"Port", "[", 
     StyleBox["a", "TI"], "]"}], ",", " ", 
    RowBox[{"PortMinus", "[", 
     RowBox[{"Port", "[", 
      StyleBox["b", "TI"], "]"}], "]"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"0bf788cb-521e-4f58-bb55-23df15342ff9"],
 "."
}], "Notes",ExpressionUUID->"a1b0b9fd-ec8b-4428-b0c7-44f174bed1a3"],

Cell[TextData[{
 "Sequential negation is involutive: ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"PortMinus", "[", 
    RowBox[{"PortMinus", "[", 
     StyleBox["p", "TI"], "]"}], "]"}], " ", "==", " ", 
