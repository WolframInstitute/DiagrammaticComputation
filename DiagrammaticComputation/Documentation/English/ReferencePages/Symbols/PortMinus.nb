 ".",
 "\n"
}], "Usage",ExpressionUUID->"f339ce55-ea9c-449a-9d27-517e6bbc8f24"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["PortMinus"]], 
    "paclet:WolframDiagrammaticComputation/ref/PortMinus", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "df70e5e9-06c0-41da-8672-432a77923fde"],
 " is used to express formal subtractions in a port sum; ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["Port"]], "paclet:WolframDiagrammaticComputation/ref/Port", 
     "WolframDiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["a", "TI"], " ", "-", " ", 
    StyleBox["b", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "401e53f6-d647-43d9-a4e0-a44670b0ed01"],
 " normalises to ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["PortSum"]], 
     "paclet:WolframDiagrammaticComputation/ref/PortSum", 
     "WolframDiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"Port", "[", 
     StyleBox["a", "TI"], "]"}], ",", " ", 
    RowBox[{"PortMinus", "[", 
     RowBox[{"Port", "[", 
      StyleBox["b", "TI"], "]"}], "]"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"98d983a0-bba3-47fc-85ae-b829cc29aeb6"],
 "."
}], "Notes",ExpressionUUID->"80313aba-eced-4507-bf2c-fcdc6ce6e0e7"],

Cell[TextData[{
 "Sequential negation is involutive: ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"PortMinus", "[", 
    RowBox[{"PortMinus", "[", 
     StyleBox["p", "TI"], "]"}], "]"}], " ", "==", " ", 
