Cell[CellGroupData[{
Cell["PortMinus", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"05486536-f70e-4677-b243-fd4687bfc3d8"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["PortMinus",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/PortMinus"], "[", 
   
   StyleBox["p", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "ff8209e5-15ce-4105-9a60-c886d5369e66"],
 " ",
 "represents the additive inverse of the port ",
 Cell[BoxData[
  FormBox[
   StyleBox["p", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d83dd82e-e20e-4f29-bf94-151553a4e2bd"],
 " inside a ",
 Cell[BoxData[
  ButtonBox["PortSum",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/PortSum"]], 
  "InlineFormula",ExpressionUUID->"537ca290-fdcc-4255-a287-4c49e593903c"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"e5a80328-a256-4b69-8e45-88f431f30ada"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["PortMinus",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/PortMinus"]], 
  "InlineFormula",ExpressionUUID->"46d5c9f9-97a0-40c6-88bf-882826fa33c8"],
 " is used to express formal subtractions in a port sum; ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["Port",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/Port"], "[", 
   RowBox[{
    StyleBox["a", "TI"], " ", "-", " ", 
    StyleBox["b", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "f05ba4dd-1fa9-494c-8cfe-6c6988d2b6bc"],
 " normalises to ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["PortSum",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/PortSum"], "[", 
   RowBox[{
    RowBox[{"Port", "[", 
     StyleBox["a", "TI"], "]"}], ",", " ", 
    RowBox[{"PortMinus", "[", 
     RowBox[{"Port", "[", 
      StyleBox["b", "TI"], "]"}], "]"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"437dd7d6-092f-4c6e-ab35-e223b151797e"],
 "."
}], "Notes",ExpressionUUID->"e90149a0-8449-4959-b248-6f38e5b9352e"],

Cell[TextData[{
 "Sequential negation is involutive: ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"PortMinus", "[", 
    RowBox[{"PortMinus", "[", 
     StyleBox["p", "TI"], "]"}], "]"}], " ", "==", " ", 
   StyleBox["p", "TI"]}]], "InlineFormula",ExpressionUUID->
  "9609ae1e-e7df-4861-ac72-030a87bdae74"],
 "."
}], "Notes",ExpressionUUID->"812a9d03-f31b-471a-a688-917a906caffa"]
}, Open  ]],

