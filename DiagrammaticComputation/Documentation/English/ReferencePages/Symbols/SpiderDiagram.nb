Cell[CellGroupData[{
Cell["SpiderDiagram", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"f38e5050-66dc-4ce1-86c9-07a9bf6070b2"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SpiderDiagram"]], 
     "paclet:WolframDiagrammaticComputation/ref/SpiderDiagram", 
     "WolframDiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["i", "TI"], 
       StyleBox["1", "TR"]], ",", " ", "\[Ellipsis]"}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["o", "TI"], 
       StyleBox["1", "TR"]], ",", " ", "\[Ellipsis]"}], "}"}]}], "]"}]], 
  "InlineFormula",ExpressionUUID->"5c147a3a-9543-4f7e-a801-367f3f466dfd"],
 " ",
 "creates a many-to-many junction with input ports ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["i", "TI"], "1"], ",", 
    RowBox[{"\[AHat]", "\[Hyphen]", "\.a6"}]}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"203d5662-2734-4adc-b3b8-c6d5fe94e04e"],
 " and output ports ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["o", "TI"], "1"], ",", 
    RowBox[{"\[AHat]", "\[Hyphen]", "\.a6"}]}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"32eddda8-4ae9-404d-9a25-25bbc2ef71ae"],
 " all meeting at a single point.",
 "\n"
}], "Usage",ExpressionUUID->"96a45f11-b9df-4a93-a1c5-26e2b043fb54"],

Cell[TextData[{
 "A spider is the multi-port generalisation of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["IdentityDiagram"]], 
    "paclet:WolframDiagrammaticComputation/ref/IdentityDiagram", 
    "WolframDiagrammaticComputation Package Symbol"},
