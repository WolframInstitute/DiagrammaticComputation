  TemplateBox[{
    Cell[
     TextData["CopyDiagram"]], 
    "paclet:Wolfram/DiagrammaticComputation/ref/CopyDiagram", 
    "Wolfram/DiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9bc043ff-b0fe-481e-b127-5f8061aea821"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["MergeDiagram"]], 
    "paclet:Wolfram/DiagrammaticComputation/ref/MergeDiagram", 
    "Wolfram/DiagrammaticComputation Package Symbol"},
