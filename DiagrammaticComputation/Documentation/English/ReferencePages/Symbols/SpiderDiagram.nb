Cell[CellGroupData[{
Cell["SpiderDiagram", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"d9930604-070a-40d3-9734-4e59cc576e38"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SpiderDiagram",
    BaseStyle->"Link",
    ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/SpiderDiagram"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["i", "TI"], 
       StyleBox["1", "TR"]], ",", " ", "\[Ellipsis]"}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["o", "TI"], 
       StyleBox["1", "TR"]], ",", " ", "\[Ellipsis]"}], "}"}]}], "]"}]], 
  "InlineFormula",ExpressionUUID->"26214e1b-02e1-4e69-85b9-6892fe203906"],
 " ",
 "creates a many-to-many junction with input ports ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["i", "TI"], "1"], ",", 
    RowBox[{"\[AHat]", "\[Hyphen]", "\.a6"}]}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"066a6de3-70d3-4da3-81d0-ff20a018fa3b"],
 " and output ports ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["o", "TI"], "1"], ",", 
    RowBox[{"\[AHat]", "\[Hyphen]", "\.a6"}]}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"71bbe448-c39e-4de1-9494-dc652e25b532"],
 " all meeting at a single point.",
 "\n"
}], "Usage",ExpressionUUID->"6e0bd336-bded-4e3c-a69d-3f0003d924c3"],

Cell[TextData[{
 "A spider is the multi-port generalisation of ",
 Cell[BoxData[
  ButtonBox["IdentityDiagram",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/DiagrammaticComputation/ref/IdentityDiagram"]],
   "InlineFormula",ExpressionUUID->"47cd2883-0aec-4762-b9fc-d8d36dcefcc3"],
 ", ",
