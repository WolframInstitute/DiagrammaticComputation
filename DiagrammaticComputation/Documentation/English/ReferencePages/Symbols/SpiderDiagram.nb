            "Tags" -> {}, "Type" -> \[FormalCapitalT]|>],
          Tooltip->"\[FormalCapitalT]"], 
         NCache[{Rational[5, 8] 2^Rational[-1, 2], Rational[-5, 8] 
           2^Rational[-1, 2]}, {
          0.44194173824159216`, -0.44194173824159216`}]]}}}, 
