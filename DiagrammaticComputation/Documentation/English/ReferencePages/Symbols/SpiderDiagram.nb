   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ca7c91c3-13b7-447b-8e46-1387aa1dacea"],
 " \[LongDash] all of these are special cases."
}], "Notes",ExpressionUUID->"6c50ac46-0be3-4104-a408-a2e51e644491"],

Cell["\<\
It is the basic structural junction in ZX-style and other process-theoretic \
calculi.\
\>", "Notes",ExpressionUUID->"15ffc078-d9dd-435b-b499-debaf98a2527"],

Cell["\<\
Spiders fuse: two spiders meeting at a shared wire merge into a single spider \
whose legs are the union (this is the spider law).\
\>", "Notes",ExpressionUUID->"54030e3c-b712-4e3d-9cd8-aabd0b6129fb"]
}, Open  ]],

