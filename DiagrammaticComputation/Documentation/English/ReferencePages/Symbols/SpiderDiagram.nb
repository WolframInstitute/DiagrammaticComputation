Cell[CellGroupData[{
Cell["SpiderDiagram", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"9850cb56-4b0f-46c6-b17c-8967f9a01cf6"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SpiderDiagram"]], 
     "paclet:Wolfram/DiagrammaticComputation/ref/SpiderDiagram", 
     "Wolfram/DiagrammaticComputation Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["i", "TI"], 
       StyleBox["1", "TR"]], ",", " ", "\[Ellipsis]"}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["o", "TI"], 
       StyleBox["1", "TR"]], ",", " ", "\[Ellipsis]"}], "}"}]}], "]"}]], 
  "InlineFormula",ExpressionUUID->"4786cc5c-9140-410d-9183-d291bd34d6b2"],
 " ",
 "creates a many-to-many junction with input ports ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["i", "TI"], "1"], ",", 
    RowBox[{"\[AHat]", "\[Hyphen]", "\.a6"}]}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"6eb79185-5a1e-43f7-b531-c725969d3906"],
 " and output ports ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["o", "TI"], "1"], ",", 
    RowBox[{"\[AHat]", "\[Hyphen]", "\.a6"}]}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"536d8a50-37c5-4ad5-9acd-44af20f0968c"],
 " all meeting at a single point.",
 "\n"
}], "Usage",ExpressionUUID->"82998f95-441a-4150-b3db-38ef47fffeb1"],

Cell[TextData[{
 "A spider is the multi-port generalisation of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["IdentityDiagram"]], 
    "paclet:Wolfram/DiagrammaticComputation/ref/IdentityDiagram", 
    "Wolfram/DiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "608dc163-bf52-4e89-848d-dcfb1a968f94"],
 ", ",
