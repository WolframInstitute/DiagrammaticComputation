Cell[BoxData[
 RowBox[{"DiagramReplacePart", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"DiagramComposition", "[", 
    RowBox[{
     RowBox[{"Diagram", "[", 
      RowBox[{"\"\<A\>\"", ",", " ", "b", ",", " ", "a"}], "]"}], ",", " ", 
     RowBox[{"Diagram", "[", 
      RowBox[{"\"\<B\>\"", ",", " ", "c", ",", " ", "b"}], "]"}]}], "]"}], ",",
    "\n", "  ", 
   RowBox[{
    RowBox[{"{", "2", "}"}], " ", "->", " ", 
    RowBox[{"Diagram", "[", 
     RowBox[{"\"\<B'\>\"", ",", " ", "c", ",", " ", "b"}], "]"}]}]}], "\n", 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"ca3255b6-d446-4823-a435-e09bc068593a"],

