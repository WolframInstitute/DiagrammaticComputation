Cell[BoxData[
 RowBox[{"DiagramReplacePart", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"DiagramComposition", "[", 
    RowBox[{
     RowBox[{"Diagram", "[", 
      RowBox[{"\"\<A\>\"", ",", " ", "b", ",", " ", "a"}], "]"}], ",", " ", 
     RowBox[{"Diagram", "[", 
      RowBox[{"\"\<B\>\"", ",", " ", "c", ",", " ", "b"}], "]"}]}], "]"}], ",",
    "\n", "  ", 
   RowBox[{
    RowBox[{"{", "2", "}"}], " ", "->", " ", 
    RowBox[{"Diagram", "[", 
     RowBox[{"\"\<B'\>\"", ",", " ", "c", ",", " ", "b"}], "]"}]}]}], "\n", 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"1e093342-559a-485a-9e8a-c6f6bd989968"],

