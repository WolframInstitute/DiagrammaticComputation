Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", "\n", "  ", 
    RowBox[{"recipe", " ", "=", " ", 
     RowBox[{"ColumnDiagram", "[", 
      RowBox[{"{", "\n", "    ", 
       RowBox[{
        RowBox[{"RowDiagram", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Diagram", "[", 
            RowBox[{"\"\<Crack Egg\>\"", ",", " ", "\"\<egg\>\"", ",", " ", 
             RowBox[{"{", 
              RowBox[{"\"\<white\>\"", ",", " ", "\"\<yolk\>\""}], "}"}]}], 
            "]"}], ",", " ", 
           RowBox[{"Diagram", "[", 
            RowBox[{"\"\<Crack Egg\>\"", ",", " ", "\"\<egg\>\"", ",", " ", 
             RowBox[{"{", 
              RowBox[{"\"\<white\>\"", ",", " ", "\"\<yolk\>\""}], "}"}]}], 
            "]"}], ",", " ", 
           RowBox[{"IdentityDiagram", "[", "\"\<sugar\>\"", "]"}]}], "}"}], 
         "]"}], ",", "\n", "    ", 
        RowBox[{"RowDiagram", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Diagram", "[", 
            RowBox[{"\"\<Whisk\>\"", ",", " ", 
             RowBox[{"{", 
              RowBox[{"\"\<white\>\"", ",", " ", "\"\<white\>\""}], "}"}], ",",
              " ", "\"\<whisked whites\>\""}], "]"}], ",", " ", 
           RowBox[{"Diagram", "[", 
            RowBox[{"\"\<Beat\>\"", ",", " ", 
             RowBox[{"{", 
              
              RowBox[{"\"\<yolk\>\"", ",", " ", "\"\<yolk\>\"", ",", 
               " ", "\"\<sugar\>\""}], "}"}], ",", 
             " ", "\"\<yolky paste\>\""}], "]"}]}], "}"}], "]"}], ",", "\n", 
        "    ", 
        RowBox[{"Diagram", "[", 
         RowBox[{"\"\<Stir\>\"", ",", " ", 
          RowBox[{"{", 
           RowBox[{"\"\<yolky paste\>\"", ",", " ", "\"\<mascarpone\>\""}], 
           "}"}], ",", " ", "\"\<thick paste\>\""}], "]"}], ",", "\n", "    ", 
        RowBox[{"Diagram", "[", 
         RowBox[{"\"\<Fold\>\"", ",", " ", 
          RowBox[{"{", 
           
           RowBox[{"\"\<whisked whites\>\"", ",", 
            " ", "\"\<thick paste\>\""}], "}"}], ",", 
          " ", "\"\<crema di mascarpone\>\""}], "]"}]}], "\n", "  ", "}"}], 
      "]"}]}], "\n", "}"}], ",", "\n", "  ", 
   RowBox[{"ImageResize", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"Rasterize", "[", "\n", "      ", 
      RowBox[{
       RowBox[{"Notebook", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"Cell", "[", 
           RowBox[{
            RowBox[{"BoxData", "[", 
             RowBox[{"ToBoxes", "[", "\n", "        ", 
              RowBox[{"Framed", "[", "\n", "          ", 
               RowBox[{
                RowBox[{"Column", "[", 
                 RowBox[{
                  RowBox[{"{", "\n", "            ", 
                   RowBox[{
                    RowBox[{"Style", "[", 
                    
                    RowBox[{"\"\<DiagrammaticComputation\>\"", ",", " ", "26",
                     ",", " ", "Bold", ",", " ", 
                    RowBox[{"GrayLevel", "[", "0.15", "]"}], ",", " ", 
                    RowBox[{
                    "FontFamily", " ", "->", 
                    " ", "\"\<Source Sans Pro\>\""}]}], "]"}], ",", "\n", 
                    "            ", 
                    RowBox[{"Style", "[", 
                    
                    RowBox[{"\"\<Abstract compositional diagrammatic calculus\
\>\"", ",", " ", "13", ",", " ", 
                    RowBox[{"GrayLevel", "[", "0.45", "]"}], ",", " ", 
                    RowBox[{
                    "FontFamily", " ", "->", 
                    " ", "\"\<Source Sans Pro\>\""}]}], "]"}], ",", "\n", 
                    "            ", 
                    RowBox[{"Spacer", "[", "10", "]"}], ",", "\n", 
                    "            ", 
                    RowBox[{"recipe", "[", 
                    RowBox[{"\"\<Grid\>\"", ",", " ", 
                    RowBox[{"ImageSize", " ", "->", " ", 
                    RowBox[{"{", 
                    RowBox[{"Automatic", ",", " ", "430"}], "}"}]}]}], 
                    "]"}]}], "\n", "          ", "}"}], ",", " ", 
                  RowBox[{"Alignment", " ", "->", " ", "Center"}], ",", " ", 
                  RowBox[{"Spacings", " ", "->", " ", "0.8"}]}], "]"}], ",", 
                "\n", "          ", 
                RowBox[{"Background", " ", "->", " ", "White"}], ",", " ", 
                RowBox[{"FrameMargins", " ", "->", " ", "30"}], ",", " ", 
                RowBox[{"FrameStyle", " ", "->", " ", "None"}]}], "\n", 
               "        ", "]"}], "\n", "      ", "]"}], "]"}], ",", 
            " ", "\"\<Output\>\""}], "]"}], "}"}], ",", " ", 
         RowBox[{"LightDark", " ", "->", " ", "\"\<Light\>\""}], ",", " ", 
         RowBox[{"StyleDefinitions", " ", "->", " ", "\"\<Default.nb\>\""}]}],
         "]"}], ",", "\n", "      ", 
       RowBox[{"ImageResolution", " ", "->", " ", "144"}], ",", " ", 
       RowBox[{"Background", " ", "->", " ", "White"}]}], "\n", "    ", "]"}],
      ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"Automatic", ",", " ", "600"}], "}"}]}], "\n", "  ", "]"}]}], 
  "\n", "]"}]], "Input",ExpressionUUID->"ca464466-9740-4c3d-9545-\
e2a5982f3654"],

