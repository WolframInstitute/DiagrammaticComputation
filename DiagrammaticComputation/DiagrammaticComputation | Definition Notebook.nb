Cell["\t", "ExampleDelimiter",ExpressionUUID->"068c1129-c3ef-47c1-bbdd-345ff7eccf5c"],

Cell["\<\
Extract the tensor contraction a composite diagram represents:\
\>", "Text",ExpressionUUID->"fa84621e-35f9-4543-ac05-4ed068fa7cfe"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"DiagramTensor", "[", 
  RowBox[{"Diagram", "[", 
   RowBox[{
    RowBox[{"Diagram", "[", 
     RowBox[{"\"\<A\>\"", ",", " ", "a", ",", " ", "b"}], "]"}], " ", "\[CircleTimes]",
     " ", 
    RowBox[{
     RowBox[{"Diagram", "[", 
      RowBox[{"\"\<C\>\"", ",", " ", "d", ",", " ", "e"}], "]"}], " ", "\[CircleDot]",
      " ", 
     RowBox[{"Diagram", "[", 
      RowBox[{"\"\<B\>\"", ",", " ", "c", ",", " ", "d"}], "]"}]}]}], "]"}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"5b3bf268-76d9-4b42-aa91-86f323479ed3"],

