Cell["\<\
Compose diagrams in sequence and in parallel; matching port names wire \
together:\
\>", "Text",ExpressionUUID->"e138e554-b24c-4462-a587-2a2144d5c597"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"DiagramComposition", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"Diagram", "[", 
    RowBox[{"\"\<g\>\"", ",", " ", 
     RowBox[{"{", 
      RowBox[{"a", ",", " ", "d"}], "}"}], ",", " ", 
     RowBox[{"{", "x", "}"}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"DiagramProduct", "[", 
    RowBox[{
     RowBox[{"DiagramComposition", "[", 
      RowBox[{
       RowBox[{"Diagram", "[", 
        RowBox[{"\"\<A\>\"", ",", " ", "b", ",", " ", "a"}], "]"}], ",", " ", 
       
       RowBox[{"Diagram", "[", 
        RowBox[{"\"\<B\>\"", ",", " ", "c", ",", " ", "b"}], "]"}]}], "]"}], ",",
      " ", 
     RowBox[{"Diagram", "[", 
      RowBox[{"\"\<h\>\"", ",", " ", "e", ",", " ", "d"}], "]"}]}], "]"}], ",",
    "\n", "  ", 
   RowBox[{"Diagram", "[", 
    RowBox[{"\"\<i\>\"", ",", " ", 
     RowBox[{"{", 
      RowBox[{"c", ",", " ", "e"}], "}"}]}], "]"}]}], "\n", "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"c7402cf9-9dde-4d7d-8aa7-7a21e61e6d6c"],

