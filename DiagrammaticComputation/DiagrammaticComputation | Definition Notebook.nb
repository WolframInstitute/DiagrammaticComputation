Cell[CellGroupData[{

Cell[TextData[{
 "Details",
 Cell[BoxData[
  PaneSelectorBox[{True->
   TemplateBox[{"Details", 
     Cell[
      BoxData[
       FrameBox[
        Cell[
        "Details may include a long description of the resource's contents, \
history, methodology or other relevant information. Give references here if \
they are directly relevant to the resource. The details will appear above the \
examples on the webpage for the resource.", "MoreInfoText"], Background -> 
        GrayLevel[0.95], FrameMargins -> 20, FrameStyle -> GrayLevel[0.9], 
        RoundingRadius -> 5, ImageSize -> {
          Scaled[0.65], Automatic}]], "MoreInfoText", Deletable -> True, 
      CellTags -> {"SectionMoreInfoDetails"}, 
      CellMargins -> {{66, 66}, {15, 15}}]},
    "MoreInfoOpenerButtonTemplate"]}, Dynamic[
    CurrentValue[
     EvaluationNotebook[], {TaggingRules, "ResourceCreateNotebook"}]],
   ImageSize->Automatic]],ExpressionUUID->
  "83283b0d-e401-4345-9bbd-bf3e640882b9"]
}], "Subsection",
 Editable->False,
 Deletable->False,
 TaggingRules->{"TemplateGroupName" -> "Details"},
 DefaultNewCellStyle->"Notes",
 CellTags->{"Details", "TemplateCellGroup"},
 CellID->280804237,ExpressionUUID->"1b64e191-fd84-4862-9aea-128b957c03ae"],

Cell[TextData[{
 "A ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Diagram"]], 
    "paclet:WolframDiagrammaticComputation/ref/Diagram", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "53ccd514-be89-42a5-8fc4-87fdb2d11b09"],
 " is a symbolic process with typed input and output ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Port"]], "paclet:WolframDiagrammaticComputation/ref/Port", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ab5e43d7-9819-459d-a6a9-0b903605f800"],
 "s \[LongDash] a morphism in a symmetric monoidal category. Diagrams compose \
sequentially (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramComposition"]], 
    "paclet:WolframDiagrammaticComputation/ref/DiagramComposition", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "378eab2b-5a19-46f1-b702-8c4aff7a8f7e"],
 "), in parallel (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramProduct"]], 
    "paclet:WolframDiagrammaticComputation/ref/DiagramProduct", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6086803a-3f23-4d63-8cd3-dedbd08a29c1"],
 "), additively (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramSum"]], 
    "paclet:WolframDiagrammaticComputation/ref/DiagramSum", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c1e19841-279d-429a-bdf5-115ad017c12a"],
 "), or orderlessly by port name (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramNetwork"]], 
    "paclet:WolframDiagrammaticComputation/ref/DiagramNetwork", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c245a67d-7f9a-40e7-be11-457fdf84517a"],
 ")."
}], "Notes",ExpressionUUID->"bb5b713e-941d-473b-83ba-c4bd0f6d27d4"],

Cell[TextData[{
 "Composite diagrams render as 2D grids (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramGrid"]], 
    "paclet:WolframDiagrammaticComputation/ref/DiagramGrid", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d1166fb7-f17a-4f2b-bd21-e6625c623403"],
 ") or single nodes (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramGraphics"]], 
    "paclet:WolframDiagrammaticComputation/ref/DiagramGraphics", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "78f8b406-787f-491b-bfbe-fdff374ffbc5"],
 "); arbitrary networks arrange into grids automatically by inserting \
identities, permutations, caps, cups and spiders (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramArrange"]], 
    "paclet:WolframDiagrammaticComputation/ref/DiagramArrange", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4c7b456b-20dc-4ad6-99e9-9cbfc39deaed"],
 ")."
}], "Notes",ExpressionUUID->"7b0ba8c5-e2e7-4047-a011-6e4c403eba0c"],

Cell[TextData[{
 "Diagrams convert to and from other compositional structures: graphs, trees, \
hypergraphs, neural networks and system models via ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ToDiagram"]], 
    "paclet:WolframDiagrammaticComputation/ref/ToDiagram", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "425baefa-0c03-47d3-932d-bd9f55202d3a"],
 ", symbolic tensor contractions via ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramTensor"]], 
    "paclet:WolframDiagrammaticComputation/ref/DiagramTensor", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "08cf6b2d-b50e-4921-aab1-1ceb28df8f14"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TensorDiagram"]], 
    "paclet:WolframDiagrammaticComputation/ref/TensorDiagram", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "307abe3b-2a06-45da-a108-38c9dc63b2a5"],
 ", and executable dataflow functions via ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramFunction"]], 
    "paclet:WolframDiagrammaticComputation/ref/DiagramFunction", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5d9e8506-8cf0-4da3-a7b3-a2c6d2b2712e"],
 "."
}], "Notes",ExpressionUUID->"3ddb40cd-d585-4499-9ac3-826083ce7987"],

Cell[TextData[{
 "Subdiagrams can be located, mapped over and edited (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramCases"]], 
    "paclet:WolframDiagrammaticComputation/ref/DiagramCases", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "bab4dc63-7288-4b05-bcca-d9577d79eb43"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramMap"]], 
    "paclet:WolframDiagrammaticComputation/ref/DiagramMap", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "64f60b7d-1252-4a2f-b93a-6932a84f83b2"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramReplacePart"]], 
    "paclet:WolframDiagrammaticComputation/ref/DiagramReplacePart", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "824278ab-ed06-494e-a89d-bc3b3e06aba0"],
 ") and rewritten by hypergraph-matched rules (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramReplace"]], 
    "paclet:WolframDiagrammaticComputation/ref/DiagramReplace", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ff799a4d-f912-4648-8e54-d1271d0351c9"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["DiagramRule"]], 
    "paclet:WolframDiagrammaticComputation/ref/DiagramRule", 
    "WolframDiagrammaticComputation Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "033072ec-ef08-4883-8b1e-6ae138b7903d"],
 "), including the standard interaction-net rule schemas."
}], "Notes",ExpressionUUID->"caf47b31-78ba-405b-be69-f09537d87a09"],

Cell[TextData[{
 "The paclet depends on the ",
 ButtonBox["WolframInstitute/Hypergraph",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://resources.wolframcloud.com/PacletRepository/resources/\
WolframInstitute/Hypergraph/"], None}],
 " paclet for rule matching."
}], "Notes",ExpressionUUID->"254365ee-d5de-44f8-905d-733c12d92ca5"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Primary Context",
 Cell[BoxData[
  PaneSelectorBox[{True->
   TemplateBox[{"PrimaryContext", 
     Cell[
      BoxData[
       FrameBox[
        Cell[
         TextData[{
          "Specify the primary context of your paclet that users should load \
with ", 
           Cell[
            BoxData[
             StyleBox[
              TagBox[
               ButtonBox[
                StyleBox[
                "Needs", "SymbolsRefLink", ShowStringCharacters -> True, 
                 FontFamily -> "Source Sans Pro"], BaseStyle -> Dynamic[
                  FEPrivate`If[
                   CurrentValue["MouseOver"], {
                   "Link", FontColor -> RGBColor[0.8549, 0.39608, 0.1451]}, {
                   "Link"}]], ButtonData -> "paclet:ref/Needs", 
                ContentPadding -> False], 
               MouseAppearanceTag["LinkHand"]], ShowStringCharacters -> True, 
              FontFamily -> "Source Sans Pro"]]], " or ", 
           Cell[
            BoxData[
             StyleBox[
              TagBox[
               ButtonBox[
                StyleBox[
                "Get", "SymbolsRefLink", ShowStringCharacters -> True, 
                 FontFamily -> "Source Sans Pro"], BaseStyle -> Dynamic[
                  FEPrivate`If[
                   CurrentValue["MouseOver"], {
                   "Link", FontColor -> RGBColor[0.8549, 0.39608, 0.1451]}, {
                   "Link"}]], ButtonData -> "paclet:ref/Get", ContentPadding -> 
                False], 
               MouseAppearanceTag["LinkHand"]], ShowStringCharacters -> True, 
              FontFamily -> "Source Sans Pro"]]], 
           " in order to access the paclet's functionality. If your paclet is \
not meant to be loaded via a context, this section can be left blank. If \
specified, the primary context will also be displayed on the main web page \
for your paclet."}], "MoreInfoText"], Background -> GrayLevel[0.95], 
        FrameMargins -> 20, FrameStyle -> GrayLevel[0.9], RoundingRadius -> 5,
         ImageSize -> {
          Scaled[0.65], Automatic}]], "MoreInfoText", Deletable -> True, 
      CellTags -> {"SectionMoreInfoPrimaryContext"}, 
      CellMargins -> {{66, 66}, {15, 15}}]},
    "MoreInfoOpenerButtonTemplate"]}, Dynamic[
