Cell["Create a simple diagram with one input and two output ports:", "Text",ExpressionUUID->"fafaf84a-85bf-4c26-a4af-af340a35a477"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Diagram", "[", 
  RowBox[{"A", ",", " ", "x", ",", " ", 
   RowBox[{"{", 
    RowBox[{"y", ",", " ", "z"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"41a0c4b5-844e-44b0-8d15-79df478c85ff"],

