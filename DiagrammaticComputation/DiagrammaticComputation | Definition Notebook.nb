Cell["Scope", "Subsection",ExpressionUUID->"bb612f17-4de1-412a-bc8a-13d05d32b37b"],

Cell["\<\
Annotate diagram labels with functions and run the diagram as a dataflow:\
\>", "Text",ExpressionUUID->"832c3d40-3292-468b-ba81-f95f0e114055"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"DiagramFunction", "[", 
   RowBox[{"ColumnDiagram", "[", 
    RowBox[{
     RowBox[{"{", "\n", "  ", 
      RowBox[{
       RowBox[{"Diagram", "[", 
        RowBox[{
         RowBox[{"Annotation", "[", 
          RowBox[{"\"\<3\>\"", ",", " ", 
           RowBox[{"\"\<Function\>\"", " ", "->", " ", 
            RowBox[{"(", 
             RowBox[{"3", " ", "&"}], ")"}]}]}], "]"}], ",", " ", "input"}], 
        "]"}], ",", "\n", "  ", 
       RowBox[{"Diagram", "[", 
        RowBox[{
         RowBox[{"Annotation", "[", 
          RowBox[{"\"\<[2\[Times]]\>\"", ",", " ", 
           RowBox[{"\"\<Function\>\"", " ", "->", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"2", " ", "#"}], " ", "&"}], ")"}]}]}], "]"}], ",", " ",
          "input", ",", " ", "doubled"}], "]"}], ",", "\n", "  ", 
       RowBox[{"Diagram", "[", 
        RowBox[{
         RowBox[{"Annotation", "[", 
          RowBox[{"\"\<\>\"", ",", " ", 
           RowBox[{"\"\<Function\>\"", " ", "->", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Sequence", " ", "@@", " ", 
               RowBox[{"{", 
                RowBox[{"#", ",", " ", "#"}], "}"}]}], " ", "&"}], ")"}]}]}], 
          "]"}], ",", " ", "doubled", ",", " ", 
         RowBox[{"{", 
          RowBox[{"a", ",", " ", "b"}], "}"}], ",", " ", 
         RowBox[{"\"\<Shape\>\"", " ", "->", " ", "\"\<Point\>\""}]}], "]"}], 
       ",", "\n", "  ", 
       RowBox[{"RowDiagram", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Diagram", "[", 
           RowBox[{
            RowBox[{"Annotation", "[", 
             RowBox[{"\"\<[+1]\>\"", ",", " ", 
              RowBox[{"\"\<Function\>\"", " ", "->", " ", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"#", " ", "+", " ", "1"}], " ", "&"}], ")"}]}]}], 
             "]"}], ",", " ", "a", ",", " ", "incremented"}], "]"}], ",", " ", 
          RowBox[{"Diagram", "[", 
           RowBox[{
            RowBox[{"Annotation", "[", 
             RowBox[{"\"\<[^2]\>\"", ",", " ", 
              RowBox[{"\"\<Function\>\"", " ", "->", " ", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"#", "^", "2"}], " ", "&"}], ")"}]}]}], "]"}], ",", 
            " ", "b", ",", " ", "squared"}], "]"}]}], "}"}], "]"}], ",", "\n",
        "  ", 
       RowBox[{"Diagram", "[", 
        RowBox[{
         RowBox[{"Annotation", "[", 
          RowBox[{"\"\<[+]\>\"", ",", " ", 
           RowBox[{"\"\<Function\>\"", " ", "->", " ", "Plus"}]}], "]"}], ",",
          " ", 
         RowBox[{"{", 
          RowBox[{"incremented", ",", " ", "squared"}], "}"}], ",", " ", 
         "result"}], "]"}]}], "\n", "}"}], ",", " ", 
     RowBox[{"Alignment", " ", "->", " ", "Center"}]}], "]"}], "]"}], "[", 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"1e26c407-c1d5-4763-991e-ff94642f8577"],

